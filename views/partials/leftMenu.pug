// Sidebar container
aside(
  id="sidebar" class="fixed md:static inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-200 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col")

  // Logo
  div(class="h-40 flex items-center justify-center border-b  border-gray-300 bg-[#eae1f2]")
    img(
      src="/img/logo.png"
      alt="Logo"
      class="max-w-40 h-30 object-contain"
    )

  //- ── Filtro de permisos ──────────────────────────────────────────────────
  //- `carpetasAdmin` lo arma el middleware `permisosAdmin` con los módulos que este
  //- usuario tiene asignados. Un botón que lleva a un 403 es peor que no estar: el que
  //- lo aprieta cree que el sistema falla, no que no tiene permiso.
  //-
  //- Si viniera vacío se muestra todo, para no dejar el menú en blanco por un fallo de
  //- lectura: quien no tenga acceso rebota igual en el servidor, que es donde manda.
  - const _cAdmin = (typeof carpetasAdmin !== 'undefined' && carpetasAdmin) || []
  - const ver = (folder) => !_cAdmin.length || _cAdmin.includes(folder)
  - const puede = (recurso, accion) => (typeof puedeAdmin === 'function' ? puedeAdmin(recurso, accion) : true)

  //- ── Pestañas del menú ───────────────────────────────────────────────────
  //- Dos vistas del mismo panel, no dos layouts distintos: "Admin" es el menú de siempre;
  //- "Producción" agrupa los módulos de taller (Confeccionistas, Procesos, Insumos). La
  //- pestaña activa al cargar la decide el servidor por `currentPath` —si la página es de
  //- un folder de Producción, esa pestaña ya viene pintada activa— así nunca hay parpadeo
  //- esperando a que corra el JS. El interruptor en sí (clic + flechas) vive en
  //- menuAdminTabs.js, el único script que lo toca.
  //-
  //- Ninguna de las dos pestañas se muestra si el usuario no tiene NINGÚN permiso de ese
  //- bloque: un botón que lleva a una pestaña vacía es tan confuso como uno que lleva a un
  //- 403. Sin permisos de un bloque, directamente no hay pestañas —se ven las opciones del
  //- otro bloque sueltas, sin el selector— igual que si el menú nunca hubiera tenido tabs.
  - const _folderAdmin = ['/tiendas', '/inventario', '/dosificaciones', '/bankentities', '/provedores', '/clientes', '/personal', '/traslados', '/web', '/configuracion']
  - const _folderProduccion = ['/confeccionistas', '/procesos', '/insumos']
  - const tieneAdmin = !_cAdmin.length || _folderAdmin.some(f => _cAdmin.includes(f))
  - const tieneProduccion = !_cAdmin.length || _folderProduccion.some(f => _cAdmin.includes(f))
  - const mostrarPestanas = tieneAdmin && tieneProduccion
  - const tabInicial = mostrarPestanas ? (_folderProduccion.includes(currentPath) ? 'produccion' : 'admin') : (tieneProduccion ? 'produccion' : 'admin')
  - const mostrarPanelAdmin = tieneAdmin && tabInicial === 'admin'
  - const mostrarPanelProduccion = tieneProduccion && tabInicial === 'produccion'

  if mostrarPestanas
   div(class="px-4 pt-4 pb-1 bg-[#F9F4FD]")
    div#menu-tabs(class="relative grid grid-cols-2 p-1 bg-white rounded-xl border border-gh-grayBorder shadow-sm" role="tablist" aria-label="Secciones del menú")
      span#menu-tabs-indicator(
        class="absolute inset-y-1 left-1 w-[calc(50%-4px)] rounded-lg bg-gradient-to-br from-gh-primary to-gh-primaryHover shadow-sm transition-transform duration-300 ease-out"
        aria-hidden="true"
        style=(tabInicial === 'produccion' ? 'transform:translateX(100%)' : 'transform:translateX(0)')
      )
      button#menu-tab-admin(
        type="button" role="tab" data-menu-tab="admin"
        aria-controls="menu-panel-admin" aria-selected=(tabInicial === 'admin' ? 'true' : 'false')
        tabindex=(tabInicial === 'admin' ? '0' : '-1')
        class=`relative z-10 flex items-center justify-center gap-1.5 py-2 rounded-lg text-xs font-semibold transition-colors duration-200 cursor-pointer ${tabInicial === 'admin' ? 'text-white' : 'text-gh-grayText hover:text-gh-primaryHover'}`
      )
        i(class="fi fi-rr-apps text-sm")
        span Admin
      button#menu-tab-produccion(
        type="button" role="tab" data-menu-tab="produccion"
        aria-controls="menu-panel-produccion" aria-selected=(tabInicial === 'produccion' ? 'true' : 'false')
        tabindex=(tabInicial === 'produccion' ? '0' : '-1')
        class=`relative z-10 flex items-center justify-center gap-1.5 py-2 rounded-lg text-xs font-semibold transition-colors duration-200 cursor-pointer ${tabInicial === 'produccion' ? 'text-white' : 'text-gh-grayText hover:text-gh-primaryHover'}`
      )
        i(class="fi fi-rr-wrench text-sm")
        span Producción

  // Menu
  nav(class="flex-1 px-4 py-4 space-y-1 bg-[#F9F4FD] overflow-y-auto")

   div#menu-panel-admin(role=(mostrarPestanas ? 'tabpanel' : undefined) aria-labelledby=(mostrarPestanas ? 'menu-tab-admin' : undefined) class=`space-y-1 ${mostrarPanelAdmin ? '' : 'hidden'}`)

    a(
      href="/admin"  class=`menu-item ${currentPath === '/' ? 'active' : ''}`)
      i(class="fi fi-rr-home text-lg")
      span Panel Principal

    if ver('/tiendas')
      a(
        href="/admin/tiendas" class=`menu-item ${currentPath === '/tiendas' ? 'active' : ''}`)
        i(class="fi fi-rr-shop text-lg")
        span Tiendas

    if ver('/inventario')
      // Inventario (submenu)
      details(class="group")
        summary(class=`menu-item cursor-pointer flex justify-between items-center menu-item ${currentPath === '/inventario' ? 'active' : ''}`)
          div(class="flex items-center gap-3")
            i(class="fi fi-rr-box text-lg")
            span Inventario y Productos
          i(class="fi fi-rr-angle-small-right transition-transform group-open:rotate-90")

        div(class="ml-9 mt-2 space-y-1 text-sm text-gray-600")
          //- La carpeta ya la filtró `ver('/inventario')`. Acá se distingue por acción:
          //- ofrecer "Ingreso de Nuevo Producto" a quien solo puede leer lo manda a un 403.
          if puede('Inventario y Productos', 'CREATE')
            a(href="/admin/inventario/ingreso" class=`submenu-item`) Ingreso de Nuevo Producto
          if puede('Inventario y Productos', 'READ')
            a(href="/admin/inventario/listado" class="submenu-item") Listado de producto
          if puede('Inventario y Productos', 'CREATE')
            a(href="/admin/inventario/batch" class="submenu-item") Agregar Productos Al inventario

    if ver('/dosificaciones')
      // Dosificador y traslados (submenu)
      details(class="group")
        summary(class=`menu-item cursor-pointer flex justify-between items-center menu-item ${currentPath === '/dosificaciones' ? 'active' : ''}`)
          div(class="flex items-center gap-3")
            i(class="fi fi-rr-warehouse-alt")
            span Dosificación y Repartos
          i(class="fi fi-rr-angle-small-right transition-transform group-open:rotate-90")

        div(class="ml-9 mt-2 space-y-1 text-sm text-gray-600")
          a(href="/admin/dosificaciones/" class="submenu-item") Ver Paquetes Dosificados
          a(href="/admin/dosificaciones/new" class="submenu-item") Dosificar productos

    if ver('/bankentities')
      //- Cajas, bancos y métodos de pago.
      //- `trasladosPendientes` lo inyecta cargarContadoresAdmin: traslados de efectivo en
      //- tránsito, o sea plata que ya salió del cajón de una tienda y todavía no está
      //- asentada en ninguna cuenta. Mismo tratamiento que Tienda Web —badge que alterna
      //- con un banner— porque es el mismo tipo de aviso: algo espera una acción del admin.
      //- El id del enlace y los data-* son los que actualiza adminAlertas.js en vivo.
      - const trasladosPorAceptar = typeof trasladosPendientes === 'number' ? trasladosPendientes : 0
      a#menu-cajas-bancos(
        href="/admin/bankentities/listado"
        class=`menu-item ${trasladosPorAceptar > 0 ? 'has-alert' : ''} ${currentPath === '/bankentities/listado' ? 'active' : ''}`)
        div(class="menu-alert-normal")
          i(class="fi fi-rr-bank text-lg")
          span Cajas, bancos y métodos de pago
          span#menu-traslados-badge(class=`animate-badge-pulse ml-auto min-w-[26px] h-[26px] px-1.5 flex items-center justify-center rounded-full bg-gh-primaryHover text-white text-sm font-bold leading-none shadow-sm shadow-pink-300 ${trasladosPorAceptar > 0 ? '' : 'hidden'}`)= trasladosPorAceptar
        div(class="menu-alert-banner bg-gh-primaryHover text-white")
          i(class="fi fi-rr-bell text-base flex-shrink-0")
          span#menu-traslados-texto(class="text-xs font-semibold leading-snug")
            = trasladosPorAceptar === 1 ? '1 traslado pendiente por aceptar' : `${trasladosPorAceptar} traslados pendientes por aceptar`

    if ver('/provedores')
      a(href="/admin/provedores" class=`menu-item ${currentPath === '/provedores' ? 'active' : ''}`)
        i(class="fi fi-rr-supplier-alt text-lg")
        span Provedores

    if ver('/clientes')
      a(href="/admin/clientes" class=`menu-item ${currentPath === '/clientes' ? 'active' : ''}`)
        i(class="fi fi-rr-users text-lg")
        span Clientes

    if ver('/personal')
      a(href="/admin/personal" class=`menu-item ${currentPath === '/personal' ? 'active' : ''}`)
        i(class="fi fi-rr-user text-lg")
        span Personal

    if ver('/traslados')
      //- Traslados de mercancía. `devolucionesPorRecibir` lo inyecta cargarContadoresAdmin:
      //- lo que una tienda rechazó de producción y espera que la administración lo reciba.
      //- Mismo badge que alterna con un banner que Cajas y bancos y Tienda Web.
      - const devolucionesAdmin = typeof devolucionesPorRecibir === 'number' ? devolucionesPorRecibir : 0
      a#menu-traslados-mercancia(
        href="/admin/traslados"
        class=`menu-item ${devolucionesAdmin > 0 ? 'has-alert' : ''} ${currentPath === '/traslados' ? 'active' : ''}`)
        div(class="menu-alert-normal")
          i(class="fi fi-rr-truck-side text-lg")
          span Traslados
          span(class=`animate-badge-pulse ml-auto min-w-[26px] h-[26px] px-1.5 flex items-center justify-center rounded-full bg-gh-primaryHover text-white text-sm font-bold leading-none shadow-sm shadow-pink-300 ${devolucionesAdmin > 0 ? '' : 'hidden'}`)= devolucionesAdmin
        div(class="menu-alert-banner bg-gh-primaryHover text-white")
          i(class="fi fi-rr-undo text-base flex-shrink-0")
          span(class="text-xs font-semibold leading-snug")
            = devolucionesAdmin === 1 ? '1 devolución por recibir' : `${devolucionesAdmin} devoluciones por recibir`

    if ver('/web')
      //- pedidosWebNuevos lo inyecta cargarContadoresAdmin en res.locals (pedidos 'en_revision',
      //- es decir pagados y todavía sin tienda asignada). Sin pendientes no hay badge ni banner:
      //- el ítem se comporta como cualquier otro del menú.
      - const pedidosPorAtender = typeof pedidosWebNuevos === 'number' ? pedidosWebNuevos : 0
      a#menu-tienda-web(
        href="/admin/web/"
        class=`menu-item ${pedidosPorAtender > 0 ? 'has-alert' : ''} ${currentPath && currentPath.startsWith('/web') ? 'active' : ''}`)
        div(class="menu-alert-normal")
          i(class="fi fi-rr-shop text-lg")
          span Tienda Web
          span#menu-pedidos-badge(class=`animate-badge-pulse ml-auto min-w-[26px] h-[26px] px-1.5 flex items-center justify-center rounded-full bg-gh-primaryHover text-white text-sm font-bold leading-none shadow-sm shadow-pink-300 ${pedidosPorAtender > 0 ? '' : 'hidden'}`)= pedidosPorAtender
        div(class="menu-alert-banner bg-gh-primaryHover text-white")
          i(class="fi fi-rr-bell text-base flex-shrink-0")
          span#menu-pedidos-texto(class="text-xs font-semibold leading-snug")
            = pedidosPorAtender === 1 ? '1 pedido nuevo por atender' : `${pedidosPorAtender} pedidos nuevos por atender`

    if ver('/configuracion')
      a(href="/admin/configuracion" class=`menu-item ${currentPath === '/configuracion' ? 'active' : ''}`)
        i(class="fi fi-rr-settings text-lg")
        span Settings

   //- ── Pestaña "Producción" ────────────────────────────────────────────────
   //- Módulos de taller: proveedores que confeccionan, las etapas por las que pasa una
   //- prenda y las materias primas que las alimentan. Mismo mecanismo de permisos que el
   //- resto del menú (`ver`, con su folder dado de alta en PERMISOS_RECURSOS) — nadie lo
   //- tiene otorgado por defecto, igual que "Mis Clientes" (ver seed/migracionPermisosProduccion.js).
   div#menu-panel-produccion(role=(mostrarPestanas ? 'tabpanel' : undefined) aria-labelledby=(mostrarPestanas ? 'menu-tab-produccion' : undefined) class=`space-y-1 ${mostrarPanelProduccion ? '' : 'hidden'}`)

    if ver('/confeccionistas')
      a(href="/admin/confeccionistas" class=`menu-item ${currentPath === '/confeccionistas' ? 'active' : ''}`)
        i(class="fi fi-rr-tshirt text-lg")
        span Confeccionistas

    if ver('/procesos')
      a(href="/admin/procesos" class=`menu-item ${currentPath === '/procesos' ? 'active' : ''}`)
        i(class="fi fi-rr-workflow-setting text-lg")
        span Procesos

    if ver('/insumos')
      a(href="/admin/insumos" class=`menu-item ${currentPath === '/insumos' ? 'active' : ''}`)
        i(class="fi fi-rr-boxes text-lg")
        span Insumos y Materias Primas

   //- Mantiene los dos avisos del menú al día por SSE, sin recargar la página. Va en el
   //- menú y no en el layout porque el layout lo comparten el panel de tienda y el sitio
   //- web, que no tienen /admin/sse.
   script(src="/js/adminAlertas.js")

   //- Interruptor de las pestañas Admin / Producción (clic + flechas, indicador deslizante).
   script(src="/js/menuAdminTabs.js")

   // Logout
   div(class="p-4 border-t border-gray-300")
     form(action="/logout" method="POST")
         input(type="hidden" name="_csrf" value=csrfToken)
         button(
         class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium shadow-neutral-500 shadow-2xl cursor-pointer"    )
             i(class="fi fi-rr-sign-out-alt")
             span Cerrar sesión
