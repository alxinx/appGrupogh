extends ../layout/index
include ../components/campoContrasena
include ../components/tarjetaAuth
block contenedor
    script(src="/js/verContrasena.js" defer)
    +tarjetaAuth({ titulo: 'Hola de nuevo!! 👋', texto: 'Logueate para empezar a trabajar 😎' })
      if errores 
        p(class="error")=errores.msg

      // Form
      form(action="", method="post") 
        // Email
        div
          label(class="label")
            |Tu Email
          input(
            type="email"
            name = "emailUsuario"
            autocomplete="username"
            value = usuario ? usuario.emailUsuario : ""
            placeholder="Ingresa el email con que estas registrado"
            class="field-text"
          )
          if errores && errores.emailUsuario != null
             p(class="error")=errores.emailUsuario

        // Password
        div
          label(class="label mt-4" for="login-password")
            | Password  
          +campoContrasena({ name: 'password', id: 'login-password', autocomplete: 'current-password' })
          if errores && errores.password != null
           p(class="error")=errores.password
          div
        // Forgot password
        div(class="flex justify-end m-3")
          a(href="/forgot", class="link")
            | Olvidaste la contraseña? 🫣

        // Button
        button(type="submit" class="btn btn-primary w-full")
    
          | Ingresar