extends ../layout/index
include ../components/tarjetaAuth
block contenedor
    +tarjetaAuth({ titulo: '¿Olvidaste tu contraseña?', texto: 'Escribe el correo con el que entras y te enviamos un enlace para crear una nueva 😎' })
        +avisoAuth('error', error)
        +avisoAuth('ok', enviado)

        form(action="/forgot" method="post" class="space-y-4")
            div
                label(class="label" for="forgot-email") Tu email
                input#forgot-email(
                    type="email"
                    name="emailUsuario"
                    autocomplete="username"
                    required
                    maxlength="254"
                    value=emailUsuario || ""
                    placeholder="Ingresa el email con que estás registrado"
                    class="field-text"
                )
            div(class="flex justify-end")
                a(href="/" class="link") Volver a iniciar sesión
            button(type="submit" class="btn btn-primary w-full")= enviado ? 'Enviar otro enlace' : 'Enviarme el enlace'
