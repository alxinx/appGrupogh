//- ── SELECT BUSCABLE ─────────────────────────────────────────────────────────
//- Estilos para window.enhanceSelectBuscable (src/js/helpers.js): convierte un <select>
//- largo en un input de texto + lista filtrable, sin tocar el <select> real. Incluir este
//- partial en cualquier vista que llame a enhanceSelectBuscable — nació en el formulario de
//- clientes (departamento/municipio) pero es genérico para cualquier <select> largo.
//-
//- Escrito como CSS propio y no como utilidades de Tailwind porque la lista de resultados
//- la genera JS después de cargar la página: ese marcado no existe cuando Tailwind escanea
//- el proyecto, así que las clases nuevas no llegarían a output.css. Mismo criterio que
//- modalConfirmacion.pug.
style.
    .select-buscable-wrap {
        position: relative;
    }
    .select-buscable-wrap select {
        display: none;
    }
    .select-buscable-lista {
        position: absolute;
        z-index: 40;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        max-height: 220px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,.12), 0 8px 10px -6px rgba(0,0,0,.08);
        padding: 4px;
        margin: 4px 0 0;
        list-style: none;
    }
    .select-buscable-lista.hidden {
        display: none;
    }
    .select-buscable-item {
        padding: 8px 10px;
        font-size: 13px;
        border-radius: 8px;
        cursor: pointer;
        color: #374151;
    }
    .select-buscable-item:hover,
    .select-buscable-item--activo {
        background: #FDE7F2;
        color: #E24C95;
    }
    .select-buscable-vacio {
        padding: 10px;
        font-size: 12.5px;
        color: #9ca3af;
        text-align: center;
    }
