//- ── CAMPO DE FECHA (Flatpickr) ──────────────────────────────────────────────
//- Skin con la identidad del panel para el calendario de Flatpickr (src/js/fechaInput.js)
//- — reemplaza el <input type="date"> nativo, que no se puede estilizar y cambia de un
//- sistema operativo a otro.
//-
//- Escrito como CSS propio y no utilidades de Tailwind porque Flatpickr inyecta este
//- marcado en tiempo de ejecución: el escaneo de clases de Tailwind nunca lo ve, así que
//- las utilidades nuevas no llegarían a output.css (mismo criterio que modalConfirmacion.pug
//- y selectBuscable.pug). Los colores salen de los mismos tokens del tema que el resto del
//- panel (public/css/input.css, @theme).
style.
    .flatpickr-calendar {
        border-radius: var(--radius-gh, 12px);
        box-shadow: 0 18px 45px -12px rgb(15 23 42 / 0.28), 0 6px 14px -8px rgb(15 23 42 / 0.18);
        border: 1px solid var(--color-gh-grayBorder, #E5E7EB);
        font-family: inherit;
    }
    .flatpickr-calendar.arrowTop:before,
    .flatpickr-calendar.arrowTop:after {
        display: none;
    }
    .flatpickr-months .flatpickr-month {
        background: linear-gradient(135deg, var(--color-gh-primary, #F794C9), var(--color-gh-primaryHover, #E24C95));
        border-radius: var(--radius-gh, 12px) var(--radius-gh, 12px) 0 0;
        color: #fff;
        fill: #fff;
        height: 2.75rem;
    }
    .flatpickr-current-month {
        font-weight: 700;
    }
    .flatpickr-current-month .flatpickr-monthDropdown-months,
    .flatpickr-current-month input.cur-year {
        color: #fff;
        font-weight: 700;
    }
    .flatpickr-current-month .flatpickr-monthDropdown-months option {
        color: #1f2937;
    }
    .flatpickr-months .flatpickr-prev-month,
    .flatpickr-months .flatpickr-next-month {
        fill: #fff;
        color: #fff;
    }
    .flatpickr-months .flatpickr-prev-month:hover svg,
    .flatpickr-months .flatpickr-next-month:hover svg {
        fill: #fff;
        opacity: 0.7;
    }
    .flatpickr-weekdays {
        background: var(--color-gh-primarySoft, #FDE7F2);
    }
    span.flatpickr-weekday {
        background: var(--color-gh-primarySoft, #FDE7F2);
        color: var(--color-gh-primaryHover, #E24C95);
        font-weight: 700;
    }
    .flatpickr-day.selected,
    .flatpickr-day.selected:hover,
    .flatpickr-day.selected:focus {
        background: var(--color-gh-primary, #F794C9);
        border-color: var(--color-gh-primary, #F794C9);
        color: #fff;
    }
    .flatpickr-day.today {
        border-color: var(--color-gh-primaryHover, #E24C95);
    }
    .flatpickr-day.today:hover,
    .flatpickr-day.today:focus {
        background: var(--color-gh-primarySoft, #FDE7F2);
        border-color: var(--color-gh-primaryHover, #E24C95);
        color: var(--color-gh-primaryHover, #E24C95);
    }
    .flatpickr-day:hover {
        background: var(--color-gh-primarySoft, #FDE7F2);
    }
    .flatpickr-day.flatpickr-disabled,
    .flatpickr-day.flatpickr-disabled:hover {
        color: #d1d5db;
    }
    .flatpickr-day.nextMonthDay,
    .flatpickr-day.prevMonthDay {
        color: #cbd5e1;
    }
    input.flatpickr-input[readonly] {
        background: #fff;
        cursor: pointer;
    }
