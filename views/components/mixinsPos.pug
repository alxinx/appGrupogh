//- Mixin para reutilizar la tarjeta de recomendación
mixin tarjetaRecomendacion(titulo, tiempo, imagen, esVentaOnline = false)
  div(class="relative flex w-full max-w-[450px] h-[150px] bg-gh-lila/40 rounded-xl backdrop-blur  overflow-hidden border border-white/30 shadow-2x transition-all hover:scale-[1.02] cursor-pointer group")
    
    div(class="flex-1 bg-gradient-to-br from-white/40 via-gh-primary/60 to-gh-deep/80 backdrop-blur-xl p-6 flex flex-col justify-between")
      div
        h2(class="text-slate-900 font-bold text-xl leading-tight mb-1")= titulo
           if esVentaOnline
             span(class="text-[10px] font-bold bg-white/40 text-gh-deep px-2 py-0.5 rounded-full uppercase") Ventas Online
      
           

    //- Contenedor de Imagen Flotante
    div(class="relative w-44 flex items-center justify-center")
      //- El producto con drop-shadow para realismo 3D
      img(src=imagen, class="w-full h-full object-contain scale-125 translate-x-[1%] filter drop-shadow-[0_25px_25px_rgba(0,0,0,0.4)] transition-transform group-hover:rotate-3")
      
      //- Línea punteada de corte de ticket
      div(class="absolute left-0 top-0 h-full border-l-2 border-dashed border-white/40")

      //- Botón Lateral de Acción (Join/Añadir)
      div(class="w-16 h-full bg-white/20 flex items-center justify-center hover:bg-gh-primary transition-colors")
        span(class="text-white font-black text-2xs uppercase [writing-mode:vertical-lr] rotate-180 tracking-tighter") Recomendación

//- //- Implementación en tu vista de POS



//TARJETA DE PRODUCTO POS PRINCIPAL
mixin tarjetaProducto(id, name, stock, codigo, precioM, precioD, imagen, modalId)
  //- Contenedor principal con ID dinámico para manipular la tarjeta completa si es necesario
  div(
    id=`product-${id}`
    class="product-card product-card-individual group cursor-pointer"
    data-name=name
    data-codigo=codigo
    data-modal-target=modalId
  )
    //- Contenedor de Imagen
    div(class="relative aspect-[4/5] rounded-[1rem] overflow-hidden mb-4 bg-gray-50 shadow-sm")
      img(
        src=imagen, 
        alt=name, 
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
        loading="lazy"
      )
      span(class="absolute bottom-4 left-3 px-3 py-1.5 bg-white/80 backdrop-blur-sm text-[10px] font-bold text-gh-primaryHover uppercase rounded-xl shadow-sm border border-white/20") 
        | #{stock} en stock
    
    //- Información del Producto
    h3(class="font-bold text-gray-900 truncate px-2 text-sm md:text-base")= name
    
    p(class="text-xs text-gray-500 mb-4 px-2 flex items-center")
      i(class="fi-rr-rectangle-barcode pr-2 text-slate-400")
      span(class="font-mono")= codigo
                                                 
    //- Precios
    div(class="flex items-center justify-between px-2 mb-4")
      div(class="flex flex-col")
        span(class="text-[10px] text-slate-400 font-bold uppercase") X Mayor
        span(class="font-bold text-lg text-gray-900") $#{precioM}
      div(class="flex flex-col text-right")
        span(class="text-[10px] text-slate-400 font-bold uppercase") Al Detal
        span(class="font-bold text-lg text-gh-primary") $#{precioD}

    //- Botón con ID y Name para eventos JS
    button(
      id=`btn-add-${id}`
      name=name
      data-id=id
      data-precio=precioD
      class="btn-agregar-pedido w-full h-11 bg-gh-primary/10 text-gh-primary rounded-2xl cursor-pointer flex items-center justify-center gap-2 hover:bg-gh-primary hover:text-white transition-all active:scale-95 shadow-sm"
    )
      i(class="fi-rr-add-document")     
      span(class="font-bold text-sm") Agregar al pedido



//PEFIL DE COMPRADOR,
mixin tarjetaClienteFidelizado(idCliente, nombre, documento, imagen)
  //- Contenedor con Glassmorphism para que resalte sobre el fondo fucsia
  div(
    class="card cardLogin  bg-white/40 backdrop-blur-xl border border-white/30 rounded-2xl p-4 shadow-[0_8px_32px_rgba(0,0,0,0.1)] transition-all hover:bg-white/50"
    id=`cliente-card-${idCliente}`
  )
    div(class="grid grid-cols-12 items-center gap-4")
      //- Foto de Perfil
      div(class="col-span-2 flex justify-center")
        div(class="w-16 h-16 rounded-2xl overflow-hidden shadow-md border-2 border-white")
          img(
            id="cli-display-img"
            src=imagen || "/img/avatars/cliente.webp"
            alt=`Perfil de ${nombre}`
            class="w-full h-full object-cover"
          )

      //- Información Detallada del Cliente
      div(class="col-span-7 pl-2")
        h2(class="text-[10px] font-bold text-gh-primary uppercase tracking-widest mb-1") Datos del Cliente
        h4(id="cli-display-nombre" class="text-lg font-bold text-slate-800 leading-tight truncate")= nombre
        p(id="cli-display-doc" class="text-xs font-semibold text-slate-500 uppercase tracking-tighter")= documento
        p#cli-pedido-web-info(class="hidden text-[11px] font-bold text-gh-primaryHover mt-1")

      //- Botón para abrir el Modal de Edición
      div(class="col-span-3 flex justify-end")
        button(
          type="button"
          id="btn-abrir-modal-cliente"
          class="btn-editar-cliente bg-gh-primary/10 text-gh-primary hover:bg-gh-primary hover:text-white transition-all px-4 py-4 rounded-2xl shadow-sm cursor-pointer group flex items-center justify-center"
          data-id=idCliente
          title="Editar datos del cliente"
        )
          i(class="fi-rr-user-pen text-2xl group-hover:scale-110 transition-transform")


//- MODAL CLIENTE POS
mixin modalCliente(departamentos)
  - const tribSwitches = [['Gran contribuyente','gran_contribuyente','Retiene y declara en volúmenes altos; la DIAN lo designa.'],['Autorretenedor','autorretenedor','Se practica a sí mismo la retención en la fuente.'],['Agente de retención','agente_retencion','Debe retener a sus proveedores y consignarlo a la DIAN.'],['Obligado aduanero','obligado_aduanero','Realiza operaciones de importación o exportación.']]
  //- Códigos del anexo técnico de facturación electrónica. Van tal cual los pide la DIAN
  //- —no se derivan de las casillas de arriba— porque son lo que ella valida contra el RUT.
  - const respFiscales = [['O-13','Gran contribuyente'],['O-15','Autorretenedor'],['O-23','Agente de retención de IVA'],['O-47','Régimen simple de tributación'],['R-99-PN','No aplica']]
  //- Un solo lugar donde vive el aspecto de una etiqueta y de un campo. Antes cada fila
  //- repetía la cadena entera de clases y bastaba con olvidar una para que ese campo
  //- quedara medio píxel más alto que sus vecinos.
  - const lbl   = 'block text-[13px] font-medium text-slate-500 mb-1.5'
  - const opc   = 'text-slate-500 font-normal'
  - const campo = 'cli-campo'
  - const tarjeta = 'bg-white rounded-2xl border border-slate-100 p-6 md:p-7'

  div(id="modal-cliente" class="absolute inset-0 z-50 hidden items-center justify-center p-4 md:p-6 bg-slate-900/25 backdrop-blur-sm")
    div(id="modal-cliente-card" class="cli-card bg-white w-full max-w-[1180px] max-h-[94%] flex flex-col overflow-hidden")

      //- ── Cabecera ─────────────────────────────────────────────────────────
      div(class="px-6 md:px-9 pt-7 pb-5 flex-shrink-0")
        div(class="flex items-start gap-4")
          div(class="relative flex-shrink-0")
            img(id="cli-modal-img" src="/img/avatars/cliente.webp" alt="" class="w-14 h-14 rounded-full object-cover ring-4 ring-white shadow-[0_2px_12px_rgba(15,23,42,.10)]")
            span(class="absolute -bottom-0.5 -right-0.5 w-5 h-5 bg-gh-primaryHover rounded-full flex items-center justify-center border-2 border-white")
              i(class="fi-rr-check text-white text-[8px] leading-none")
          div(class="flex-1 min-w-0 pt-0.5")
            p(id="cli-modal-nombre" class="text-[22px] font-bold text-slate-900 leading-tight truncate") Nuevo cliente
            p(id="cli-modal-doc-display" class="text-[13px] text-slate-500 mt-0.5 truncate") Completa la información para registrar un nuevo cliente
          button(type="button" class="btn-cerrar-modal-cliente flex-shrink-0 w-9 h-9 flex items-center justify-center text-slate-300 hover:text-slate-600 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer")
            i(class="fi-rr-cross-small text-xl")

        //- Selector de tipo. Dos pastillas grandes y no un `select`: es la decisión que
        //- cambia el formulario entero, así que se ve antes de empezar a escribir.
        div(class="grid grid-cols-2 gap-3 mt-6")
          button(type="button" id="tab-btn-natural" class="cli-tab bg-gh-primary/10 cli-tab-activa")
            i(class="fi-rr-user text-sm")
            span Persona Natural
          button(type="button" id="tab-btn-empresa" class="cli-tab text-slate-500")
            i(class="fi-rr-building text-sm")
            span Empresa

      //- ── Cuerpo scrolleable ────────────────────────────────────────────────
      div(class="overflow-y-auto flex-1 custom-scrollbar px-6 md:px-9 pb-6 space-y-4")
        input(type="hidden" id="cli-id-hidden" value="")

        //- ══ PERSONA NATURAL ══════════════════════════════════════════════
        div(class="tab-natural-content " + tarjeta)
          +cliSeccion('fi-rr-user', 'Información personal', 'Datos básicos del cliente')

          div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 gap-y-4")
            div
              label(for="cli-tipo-doc" class=lbl) Tipo de documento
              div(class="cli-wrap")
                i(class="fi-rr-id-badge cli-icono")
                select(id="cli-tipo-doc" name="tipo_documento" class=campo + " cli-con-icono cli-select")
                  option(value="CC") Cédula de Ciudadanía
                  option(value="CE") Cédula de Extranjería
                  option(value="TI") Tarjeta de Identidad
                  option(value="NIT") NIT
                  option(value="PP") Pasaporte
                  option(value="DE") Doc. Extranjero
                i(class="fi-rr-angle-small-down cli-chevron")
            div
              label(for="cli-numero-doc" class=lbl) N° de documento
              div(class="cli-wrap")
                i(class="fi-rr-user cli-icono")
                input(id="cli-numero-doc" name="numero_doc" type="text" placeholder="Número de documento" class=campo + " cli-con-icono pr-9")
                div(id="cli-doc-loader" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gh-primary")
                  i(class="fi-rr-loading animate-spin text-sm")
            div
              label(for="cli-primer-nombre" class=lbl) Nombres
              div(class="cli-wrap")
                i(class="fi-rr-user cli-icono")
                input(id="cli-primer-nombre" name="primer_nombre" type="text" placeholder="Primer nombre" class=campo + " cli-con-icono")
            div
              label(for="cli-segundo-nombre" class=lbl)
                | Segundo nombre
                span(class=opc)  (opcional)
              div(class="cli-wrap")
                i(class="fi-rr-user cli-icono")
                input(id="cli-segundo-nombre" name="segundo_nombre" type="text" placeholder="Segundo nombre" class=campo + " cli-con-icono")

            div
              label(for="cli-primer-apellido" class=lbl) Apellidos
              div(class="cli-wrap")
                i(class="fi-rr-user cli-icono")
                input(id="cli-primer-apellido" name="primer_apellido" type="text" placeholder="Primer apellido" class=campo + " cli-con-icono")
            div
              label(for="cli-segundo-apellido" class=lbl)
                | Segundo apellido
                span(class=opc)  (opcional)
              div(class="cli-wrap")
                i(class="fi-rr-user cli-icono")
                input(id="cli-segundo-apellido" name="segundo_apellido" type="text" placeholder="Segundo apellido" class=campo + " cli-con-icono")
            div
              label(for="cli-email-n" class=lbl) Email
              div(class="cli-wrap")
                i(class="fi-rr-envelope cli-icono")
                input(id="cli-email-n" name="email" type="email" placeholder="correo@ejemplo.com" class=campo + " cli-con-icono")
            div
              label(for="cli-telefono-n" class=lbl) Teléfono
              div(class="cli-wrap")
                i(class="fi-rr-phone-call cli-icono cli-icono--rosa")
                input(id="cli-telefono-n" name="telefono" type="tel" placeholder="3XX XXXXXXX" class=campo + " cli-con-icono")

          //- La ubicación vive DENTRO de la tarjeta y separada por una línea punteada:
          //- es el mismo formulario, no otro paso. Repetirla como tarjeta aparte hacía
          //- ver dos bloques donde hay uno solo.
          div(class="border-t border-dashed border-slate-200 mt-7 pt-6")
            +cliSeccion('fi-rr-marker', 'Ubicación', 'Información de localización del cliente')
            +cliUbicacion(departamentos, 'n')

        //- ══ EMPRESA ══════════════════════════════════════════════════════
        div(class="tab-empresa-content hidden " + tarjeta)
          +cliSeccion('fi-rr-building', 'Información general', 'Datos básicos de la empresa')

          div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-x-5 gap-y-4")
            div(class="lg:col-span-3")
              label(class=lbl) Tipo de documento
              div(class="cli-wrap")
                i(class="fi-rr-id-badge cli-icono")
                //- El `select` real es el de la pestaña natural: el formulario es uno solo
                //- y duplicarlo obligaría a mantener sincronizados dos valores. Acá va un
                //- espejo de solo lectura que lo refleja.
                select(id="cli-tipo-doc-espejo" class=campo + " cli-con-icono cli-select" aria-hidden="true" tabindex="-1")
                i(class="fi-rr-angle-small-down cli-chevron")
            div(class="lg:col-span-4")
              label(class=lbl) N° de documento
              div(class="cli-wrap")
                i(class="fi-rr-envelope cli-icono")
                input(id="cli-numero-doc-espejo" type="text" placeholder="Número de documento" class=campo + " cli-con-icono")
            div(class="lg:col-span-2")
              label(for="cli-digito-verif" class=lbl) Díg. verificación
              input(id="cli-digito-verif" name="digito_verif" type="text" maxlength="1" inputmode="numeric" placeholder="0" class=campo)
            div(class="lg:col-span-3")
              label(for="cli-razon-social" class=lbl) Razón social
              input(id="cli-razon-social" name="razon_social" type="text" placeholder="Nombre de la empresa" class=campo)

            div(class="lg:col-span-3")
              label(for="cli-regimen" class=lbl) Régimen
              div(class="cli-wrap")
                select(id="cli-regimen" name="regimen_fiscal" class=campo + " cli-select")
                  option(value="48") 48 — Responsable IVA
                  option(value="49") 49 — No responsable de IVA
                i(class="fi-rr-angle-small-down cli-chevron")
            div(class="lg:col-span-5")
              label(for="cli-email-e" class=lbl) Email
              div(class="cli-wrap")
                i(class="fi-rr-envelope cli-icono")
                input(id="cli-email-e" name="email_e" type="email" placeholder="correo@empresa.com" class=campo + " cli-con-icono")
            div(class="lg:col-span-4")
              label(for="cli-telefono-e" class=lbl) Teléfono
              div(class="cli-wrap")
                i(class="fi-rr-phone-call cli-icono cli-icono--rosa")
                input(id="cli-telefono-e" name="telefono_e" type="tel" placeholder="3XX XXXXXXX" class=campo + " cli-con-icono")

          //- Condiciones tributarias. Cada una lleva su propia explicación en el tooltip:
          //- son términos de la DIAN y marcarlos mal cambia cómo se factura.
          div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-5")
            each item in tribSwitches
              label(class="cli-trib")
                span(class="flex items-center gap-1.5 min-w-0")
                  span(class="text-[13px] font-medium text-slate-700 truncate")= item[0]
                  i(class="fi-rr-info text-[11px] text-slate-400 flex-shrink-0" title=item[2])
                span(class="flex items-center flex-shrink-0")
                  input(type="checkbox" name=item[1] class="sr-only cli-trib-sw")
                  span.switch
                    span.switch-thumb

          //- ── Responsabilidad fiscal ────────────────────────────────────
          //- Obligatoria en la factura electrónica y puede aplicar más de una, así que va
          //- como casillas y no como un select. R-99-PN es la que dice "ninguna": marcarla
          //- apaga las demás, porque declarar "no aplica" junto con "gran contribuyente"
          //- es una contradicción que la DIAN rechaza.
          div(class="mt-5")
            label(class=lbl) Responsabilidad fiscal (DIAN)
            div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2")
              each r in respFiscales
                label(class="cli-resp" data-codigo=r[0])
                  input(type="checkbox" name="responsabilidad_fiscal" value=r[0] class="cli-resp-chk sr-only")
                  span(class="cli-resp-marca")
                    i(class="fi-rr-check")
                  span(class="min-w-0")
                    span(class="block text-[12px] font-bold text-slate-700 font-mono")= r[0]
                    span(class="block text-[11px] text-slate-500 truncate")= r[1]
            p(class="text-[11px] text-slate-500 ml-1 mt-1.5") Se puede marcar más de una. Si no aplica ninguna, marcá R-99-PN.

          div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-x-5 gap-y-4 mt-5")
            div(class="lg:col-span-2")
              label(for="cli-ciiu" class=lbl) CIIU
              div(class="cli-wrap")
                i(class="fi-rr-stats cli-icono")
                input(id="cli-ciiu" name="ciiu" type="text" placeholder="Ej: 4771" class=campo + " cli-con-icono")
            div(class="lg:col-span-4")
              label(for="cli-desc-ciiu" class=lbl) Descripción
              input(id="cli-desc-ciiu" name="descripcion_ciiu" type="text" placeholder="Actividad económica" class=campo)
            div(class="lg:col-span-3")
              label(for="cli-fecha-rut" class=lbl) Fecha RUT
              div(class="cli-wrap")
                i(class="fi-rr-calendar cli-icono")
                input(id="cli-fecha-rut" name="fecha_rut" type="date" class=campo + " cli-con-icono")
            div(class="lg:col-span-3")
              label(class=lbl) RUT
              label(for="cli-rut-file" class="cli-archivo")
                i(class="fi-rr-cloud-upload text-gh-primaryHover")
                span(id="cli-rut-nombre-vacio" class="text-[13px] font-semibold text-gh-primaryHover truncate") Cargar archivo
                p(id="cli-rut-nombre" class="hidden text-[13px] font-semibold text-gh-primaryHover truncate")
              input(type="file" id="cli-rut-file" name="rut" accept=".pdf,.jpg,.jpeg,.png,.webp" class="hidden")

          div(class="border-t border-dashed border-slate-200 mt-7 pt-6")
            +cliSeccion('fi-rr-marker', 'Ubicación', 'Dirección y ubicación de la empresa')
            +cliUbicacion(departamentos, 'e')

      //- ── Footer ───────────────────────────────────────────────────────────
      div(class="px-6 md:px-9 py-5 border-t border-slate-100 flex flex-col-reverse sm:flex-row sm:items-center gap-4 flex-shrink-0")
        div(id="cli-aviso" class="cli-aviso flex-1 min-w-0")
          i(class="fi-rr-info cli-aviso-texto text-sm flex-shrink-0 mt-px")
          div(class="min-w-0")
            p(id="cli-aviso-titulo" class="text-[13px] font-semibold cli-aviso-texto leading-snug") Verifica que los datos ingresados sean correctos antes de guardar.
            p(id="cli-aviso-sub" class="hidden text-[12px] cli-aviso-texto leading-snug mt-0.5")

          //- ── Interruptor oculto ────────────────────────────────────────────
          //- Se descubre con tres clics sobre el aviso. Va acá y no a la vista porque es
          //- un atajo para quien ya sabe que existe: el camino normal para registrar una
          //- empresa son las pestañas de arriba. Al encenderlo salta a Empresa llevándose
          //- lo que ya estaba escrito, en vez de obligar a retipear.
          label(id="cli-of-wrap" class="hidden items-center gap-2 flex-shrink-0 ml-auto cursor-pointer select-none" title="Cambia a Empresa conservando lo que ya escribiste")
            span(id="cli-of-label" class="text-[11px] font-bold tracking-widest cli-aviso-texto") OF
            input(type="checkbox" id="cli-of-switch" class="sr-only")
            span.switch
              span.switch-thumb

        div(class="flex items-center gap-3 sm:flex-shrink-0")
          button(type="button" class="btn-cerrar-modal-cliente cli-btn-cancelar cursor-pointer")
            i(class="fi-rr-cross-small text-base")
            span Cancelar
          button(type="button" id="btn-guardar-cliente" class="cli-btn-guardar cursor-pointer")
            i(class="fi-rr-disk text-base")
            span Guardar cliente

//- Encabezado de sección dentro del modal: icono en pastilla + título + subtítulo.
mixin cliSeccion(icono, titulo, sub)
  div(class="flex items-start gap-3 mb-6")
    span(class="w-9 h-9 rounded-xl bg-gh-primary/10 text-gh-primaryHover flex items-center justify-center flex-shrink-0")
      i(class=icono + " text-base")
    div(class="min-w-0")
      p(class="text-[15px] font-bold text-slate-800 leading-tight")= titulo
      p(class="text-[12px] text-slate-500 mt-0.5")= sub

//- Ubicación. Es idéntica en las dos pestañas, así que vive una sola vez. Los ids reales
//- (`cli-departamento`, `cli-municipio`, `cli-direccion`) los lleva SIEMPRE la copia de
//- persona natural; la de empresa es un espejo que el JS mantiene sincronizado. Duplicar
//- los ids rompería `getElementById`, que devuelve el primero que encuentra.
mixin cliUbicacion(departamentos, sufijo)
  - const esReal = sufijo === 'n'
  - const id = (base) => esReal ? base : base + '-espejo'
  - const lbl2 = 'block text-[13px] font-medium text-slate-500 mb-1.5'
  div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-4")
    div
      label(for=id('cli-departamento') class=lbl2) Departamento
      div(class="cli-wrap")
        i(class="fi-rr-map cli-icono")
        select(id=id('cli-departamento') name=esReal ? 'idDepartamento' : null class="cli-campo cli-con-icono cli-select")
          option(value="") Seleccionar...
          each dpto in departamentos
            option(value=dpto.id)= dpto.nombre
        i(class="fi-rr-angle-small-down cli-chevron")
    div
      label(for=id('cli-municipio') class=lbl2) Ciudad
      div(class="cli-wrap")
        i(class="fi-rr-building cli-icono")
        select(id=id('cli-municipio') name=esReal ? 'idMunicipio' : null class="cli-campo cli-con-icono cli-select")
          option(value="") — selecciona una ciudad —
        i(class="fi-rr-angle-small-down cli-chevron")
    div
      label(for=id('cli-direccion') class=lbl2) Dirección
      div(class="cli-wrap")
        i(class="fi-rr-marker cli-icono")
        input(id=id('cli-direccion') name=esReal ? 'direccion' : null type="text" placeholder="Calle, carrera, manzana, etc." class="cli-campo cli-con-icono")


mixin resumenFactura(subtotal, impuestos, descuento)

  - const total = subtotal + impuestos - descuento

  div(class="space-y-3 text-sm")

    div(class="flex justify-between")
      span(class="text-gray-600 font-medium") Subtotal
      span(id="res-subtotal" class="font-semibold text-gray-900") $#{subtotal.toFixed(0)}

    div(class="flex justify-between")
      span(class="text-gray-600 font-medium") Impuestos
      span(id="res-impuestos" class="font-semibold text-gray-900") $#{impuestos.toFixed(0)}

    div(class="flex justify-between")
      span(class="text-gray-600 font-medium") Descuento a mayorista
      span(id="res-descuento" class="font-semibold text-green-600") -$#{descuento.toFixed(0)}

    hr(class="border-gray-200 my-2")

    div(class="flex justify-between text-base")
      span(class="font-bold text-gray-900") Total
      span(id="res-total" class="font-bold text-3xl text-pink-600") $#{total.toFixed(0)}

  
mixin itemCarrito(id, nombre, imagen, talla, color, cantidad, precioUnitario, precioTotal)
  //- Contenedor del Item con ID único para manipulación en el DOM
  div(
    class="flex gap-4 p-2 bg-white rounded-[0.5rem] group border border-white/60 transition-all shadow-sm hover:shadow-md"
    id=`cart-item-${id}`
    data-id=id
  )
    //- Imagen del Producto
    img(
      src=imagen 
      alt=nombre 
      class="w-20 h-20 rounded-2xl object-cover shadow-sm"
    )
    
    div(class="flex-1")
      div(class="flex justify-between items-start")
        div
          h4(class="text-sm font-bold text-gray-900 leading-tight")= nombre
          p(class="text-[10px] text-gray-500 font-medium mt-1 uppercase tracking-wider") 
            | Talla: #{talla} | #{color}
        
        //- Botón Eliminar Item
        button(
          class="btn-remove-item text-gray-400 cursor-pointer hover:text-red-500 transition-colors p-1"
          data-id=id
          title="Eliminar item"
        )
          i.fi-rr-trash-xmark.text-lg
      
      div(class="flex items-center justify-between mt-4")
        //- Selector de Cantidad Dinámico
        div(class="flex items-center gap-3 bg-gray-100/50 rounded-xl px-2.5 py-1.5 border border-gray-100")
          button(
            class="btn-qty-minus text-gray-400 hover:text-gh-primary flex items-center transition-transform active:scale-90"
            data-id=id
          )
            i.fi-rr-minus-small
          
          span(class="text-xs font-black w-5 text-center qty-display text-gh-grayText")= cantidad
          
          button(
            class="btn-qty-plus text-gray-400 hover:text-gh-primary flex items-center transition-transform active:scale-90"
          )
            i.fi-rr-plus-small
        
        //- Precios: Unitario y Total
        div(class="text-right")
          p(class="text-[10px] text-gray-400 font-medium leading-none mb-1") 
            | Unid: $#{precioUnitario}
          p(class="font-bold text-base text-gh-grayText leading-none") 
            | $#{precioTotal}



mixin itemCarritoLista(id, nombre, talla, color, cantidad, precioUnitario, precioTotal)
  div(
    class="cart-item-row group flex items-center justify-between p-3 mb-2 bg-white/70 backdrop-blur-md border border-white/40 rounded-xl transition-all hover:bg-white hover:shadow-md"
    id=`item-${id}`
    data-id=id
    data-nombre=nombre
  )
    //- Información del Producto (Izquierda)
    div(class="flex flex-col min-w-0 flex-1")
      div(class="flex items-center gap-2")
        span(class="w-2 h-2 rounded-full bg-gh-primary shadow-[0_0_8px_rgba(255,94,170,0.5)]")
        h4(class="text-[11px] font-black text-slate-800 uppercase truncate")= nombre
      
      div(class="flex items-center gap-2 mt-0.5 pl-4")
        span(class="text-[9px] font-bold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded")= talla
        span(class="text-[9px] font-bold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded")= color

    //- Controles de Cantidad (Centro)
    div(class="flex items-center bg-slate-100 rounded-lg p-1 mx-4 shadow-inner")
      button(
        class="btn-qty-minus w-6 h-6 flex items-center justify-center text-slate-400 hover:text-gh-primary transition-colors"
        data-id=id
      )
        i(class="fi fi-rr-minus-small text-xs")
      
      span(class="qty-display w-6 text-center text-[11px] font-black text-slate-700")= cantidad
      
      button(
        class="btn-qty-plus w-6 h-6 flex items-center justify-center text-slate-400 hover:text-gh-primary transition-colors"
        data-id=id
      )
        i(class="fi fi-rr-plus-small text-xs")

    //- Precio y Eliminación (Derecha)
    div(class="flex items-center gap-4")
      div(class="text-right min-w-[80px]")
        //- Valor Unitario sutil
        p(class="text-[8px] font-bold text-slate-400 leading-none mb-0.5") U: $#{precioUnitario}
        //- Valor Total resaltado
        p(class="text-[11px] font-black text-slate-900 leading-none") $#{precioTotal}
      
      button(
        class="btn-remove-item w-8 h-8 flex items-center justify-center text-slate-300 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all"
        data-id=id
        title="Quitar de la lista"
      )
        i(class="fi fi-rr-trash-xmark text-sm")


mixin metodosPago()
    div(class="flex items-center gap-3 mb-6")
      div(class="w-10 h-10 bg-gh-primary rounded-2xl flex items-center justify-center text-white shadow-lg shadow-gh-primary/30")
        i.fi-rr-settings-sliders
      h3(class="font-display text-xl text-gray-900") Métodos de Pago
    
    div(class="grid grid-cols-1 gap-4")
      //- 1: EFECTIVO
      div(class="payment-method-card group relative overflow-hidden bg-white p-4 rounded-2xl border border-gray-100 transition-all hover:border-gh-primary/30")
        div(class="flex items-center justify-between")
          div(class="flex items-center gap-3")
            div(class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-600")
              i.fi-rr-money-bill-wave.text-xl
            div
              p(class="text-xs font-black text-gray-900 uppercase") Efectivo
              p(class="text-[10px] text-gray-400 font-medium") Pago físico
          div(class="relative")
            span(class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm") $
            input(type="number" name="pago_efectivo" placeholder="0" class="pl-7 w-32 h-10 bg-gray-50 border-none rounded-xl text-right font-black text-gh-grayText focus:ring-2 focus:ring-green-500/20 focus:outline-none transition-all")

      //- 2: TRANSFERENCIA BANCARIA
      div(class="payment-method-card group bg-white p-4 rounded-2xl border border-gray-100 transition-all hover:border-gh-primary/30")
        div(class="flex items-center justify-between")
          div(class="flex items-center gap-3")
            div(class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600")
              i.fi-rr-bank.text-xl
            div
              p(class="text-xs font-black text-gray-900 uppercase") Transferencia
              p(class="text-[10px] text-gray-400 font-medium") Bancos locales
          div(class="relative")
            span(class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm") $
            input(type="number" name="pago_transferencia" placeholder="0" class="pl-7 w-32 h-10 bg-gray-50 border-none rounded-xl text-right font-black text-gh-grayText focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-all")

      //- 3: BILLETERAS VIRTUALES
      div(class="payment-method-card group bg-white p-4 rounded-2xl border border-gray-100 transition-all hover:border-gh-primary/30")
        div(class="flex items-center justify-between")
          div(class="flex items-center gap-3")
            div(class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600")
              i.fi-rr-smartphone.text-xl
            div
              p(class="text-xs font-black text-gray-900 uppercase") Billeteras
              p(class="text-[10px] text-gray-400 font-medium") Nequi, Daviplata, etc
          div(class="relative")
            span(class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm") $
            input(type="number" name="pago_billetera" placeholder="0" class="pl-7 w-32 h-10 bg-gray-50 border-none rounded-xl text-right font-black text-gh-grayText focus:ring-2 focus:ring-purple-500/20 focus:outline-none transition-all")

      //- 4: CRÉDITO
      div(class="payment-method-card group bg-white p-4 rounded-2xl border border-gray-100 transition-all hover:border-gh-primary/30")
        div(class="flex items-center justify-between")
          div(class="flex items-center gap-3")
            div(class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center text-orange-600")
              i.fi-rr-credit-card.text-xl
            div
              p(class="text-xs font-black text-gray-900 uppercase") Crédito
              p(class="text-[10px] text-gray-400 font-medium") Sistecrédito / Interno
          div(class="relative")
            span(class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm") $
            input(type="number" name="pago_credito" placeholder="0" class="pl-7 w-32 h-10 bg-gray-50 border-none rounded-xl text-right font-black text-gh-grayText focus:ring-2 focus:ring-orange-500/20 focus:outline-none transition-all")

    //- TOTAL ASIGNADO (Resumen dinámico)
    div(class="mt-6 pt-6 border-t border-dashed border-gray-200")
      div(class="flex justify-between items-center")
        p(class="text-sm font-bold text-gray-500") Total Asignado:
        p(class="text-xl font-black text-gh-primary" id="total-asignado") $0