//- ── CALIFICACIÓN DE UN TALLER ───────────────────────────────────────────────────
//- Pinta lo que devuelve `presentarCalificacion` (helpers/confeccionistas.js), o "Sin
//- calificar" cuando llega null. El cálculo lo hace el script de calificación; acá solo se
//- muestra. El detalle por criterio es un `popover` nativo: vive en la capa superior, así
//- que no lo recorta el overflow de la tabla, y src/js/calificacionTaller.js lo ubica junto
//- al botón que lo abrió.
//-
//-     include ../../components/calificacionTaller
//-     +calificacionTaller(c.calificacion, { id: c.idProveedor, nombre: c.nombre })
//-     +calificacionTaller(c.calificacion, { id: …, nombre: …, compacta: true })   // tarjetas

//- Cinco estrellas con relleno parcial: una fila gris de fondo y la ámbar encima, recortada
//- al porcentaje. Estrella dibujada (SVG), no un glifo: la familia de iconos cargada en el
//- panel (regular rounded) no trae estrella rellena. `cantidad` 1 = la estrella sola, de ícono.
mixin estrellasCalificacion(porcentaje, tam, cantidad)
    - var t = tam || 14
    - var n = cantidad || 5
    - var estrella = 'M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z'
    span(class="relative inline-flex shrink-0" aria-hidden="true")
        span(class="flex text-slate-200")
            - for (var i = 0; i < n; i++)
                svg(width=t height=t viewBox="0 0 24 24" fill="currentColor")
                    path(d=estrella stroke="currentColor" stroke-width="1.5" stroke-linejoin="round")
        span(class="absolute inset-0 flex overflow-hidden text-amber-400" style=`width:${porcentaje}%`)
            - for (var j = 0; j < n; j++)
                svg(width=t height=t viewBox="0 0 24 24" fill="currentColor" class="shrink-0")
                    path(d=estrella stroke="currentColor" stroke-width="1.5" stroke-linejoin="round")

mixin calificacionTaller(cal, opts)
    - var o = opts || {}
    - var tonoNivel = { excelente: 'text-emerald-700 bg-emerald-50', bueno: 'text-violet-700 bg-violet-50', regular: 'text-amber-700 bg-amber-50', bajo: 'text-pink-700 bg-pink-50' }
    - var tonoBarra = { excelente: 'bg-emerald-500', bueno: 'bg-violet-500', regular: 'bg-amber-500', bajo: 'bg-pink-500' }
    if !cal
        //- En la tarjeta va centrada y más grande: es lo que se mira al recorrer la cuadrícula.
        div(class=`flex flex-col ${o.compacta ? 'items-center w-full py-1' : ''}`)
            +estrellasCalificacion(0, o.compacta ? 22 : 13)
            span(class=`text-xs font-semibold text-slate-400 ${o.compacta ? 'mt-1' : 'mt-0.5'}`) Sin calificar
    else
        - var idPanel = `calificacion-${o.id}`
        button(type="button" popovertarget=idPanel data-calificacion-btn
            aria-label=`Calificación de ${o.nombre}: ${cal.texto} de 5, ${cal.nivelEtiqueta}. Ver detalle`
            class=`group/cal p-1.5 rounded-lg cursor-pointer hover:bg-slate-100/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gh-primaryHover/40 transition-colors ${o.compacta ? 'w-full flex flex-col items-center text-center' : '-m-1.5 text-left'}`)
            span(class=`flex gap-1.5 ${o.compacta ? 'items-center' : 'items-baseline'}`)
                span(class=`font-bold text-slate-800 tabular-nums leading-none ${o.compacta ? 'text-xl' : 'text-lg'}`)= cal.texto
                +estrellasCalificacion(cal.porcentaje, o.compacta ? 22 : 13)
            span(class="flex items-center gap-1.5 mt-1")
                span(class=`text-[10px] font-bold uppercase tracking-wide rounded px-1.5 py-0.5 ${tonoNivel[cal.nivel]}`)= cal.nivelEtiqueta
                if !o.compacta
                    span(class="text-[11px] text-slate-400 group-hover/cal:text-slate-600")= cal.trabajosTexto

        //- Detalle: puntaje general, cada criterio con su barra y de cuándo es el cálculo.
        div(id=idPanel popover data-calificacion-panel
            class="m-0 w-72 rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-[0_12px_32px_-8px_rgba(36,31,56,0.25)]")
            div(class="flex items-start justify-between gap-3")
                div(class="min-w-0")
                    p(class="text-xs text-slate-500 truncate")= o.nombre
                    p(class="flex items-baseline gap-2 mt-0.5")
                        span(class="text-3xl font-bold text-slate-800 tabular-nums leading-none")= cal.texto
                        span(class="text-xs text-slate-400") de 5
                    div(class="mt-1.5")
                        +estrellasCalificacion(cal.porcentaje, 15)
                span(class=`text-[10px] font-bold uppercase tracking-wide rounded px-1.5 py-0.5 shrink-0 ${tonoNivel[cal.nivel]}`)= cal.nivelEtiqueta
            ul(class="mt-4 flex flex-col gap-3")
                each cr in cal.criterios
                    li
                        div(class="flex items-baseline justify-between gap-2")
                            span(class="text-xs font-semibold text-slate-700")= cr.etiqueta
                            span(class=`text-xs tabular-nums ${cr.puntaje === null ? 'text-slate-400' : 'font-bold text-slate-800'}`)= cr.texto
                        div(class="mt-1 h-1.5 rounded-full bg-slate-100 overflow-hidden"
                            role="meter" aria-valuemin="0" aria-valuemax="5" aria-valuenow=(cr.puntaje === null ? 0 : cr.puntaje) aria-label=cr.etiqueta)
                            div(class=`h-full rounded-full ${tonoBarra[cal.nivel]}` style=`width:${cr.porcentaje}%`)
                        p(class="text-[11px] text-slate-400 mt-1")= cr.ayuda
            p(class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500")
                = cal.trabajosTexto
                if cal.actualizado
                    |  · calculada el #{cal.actualizado}
