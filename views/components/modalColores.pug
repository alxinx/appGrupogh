//- Modal "Elegir colores": buscador + grilla de colores con casilla. Una sola copia para el
//- alta de productos ("Colores para Talla"), la caja de colores de la orden de compra y la
//- orden de producción. La lógica (abrir con lo ya elegido, buscar, devolver lo marcado, dar
//- de alta un color) es src/js/modalColores.js.
//-
//-   +modalColores('op-modal-colores', coloresPrenda, { titulo: 'Colores de la orden' })
//-   +modalColores('modalColores', colores, { titulo: 'Colores para Talla:', textoGuardar: 'Guardar colores para esta talla' })
//-   +modalColores('modal-colores-insumo', colores, { altaColor: '/admin/insumos/compra/colores' })
//-
//- `colores` son filas de ATRIBUTOS tipo COLOR ({ idAtributo, valor, codigo1, codigo2 }); un
//- color combinado (codigo2) se pinta con sus dos tonos. `altaColor` es la ruta que da de alta
//- un color simple nuevo; sin ella no se ofrece. La casilla de cada color está escrita también
//- en src/js/modalColores.js (etiquetaColor) para el que se agrega en vivo: si cambia una,
//- cambia la otra.
mixin modalColores(id, colores, opciones)
    - var o = opciones || {}
    - var fondo = function (c) { return c.codigo2 ? `linear-gradient(135deg, ${c.codigo1} 50%, ${c.codigo2} 50%)` : (c.codigo1 || '#ccc'); }
    div(id=id data-modal-colores role="dialog" aria-modal="true" aria-labelledby=`${id}-titulo` class="fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm")
        div(class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[85vh] overflow-hidden flex flex-col")
            div(class="flex items-center justify-between px-6 py-5 border-b border-slate-100 flex-shrink-0")
                h2(id=`${id}-titulo` class="text-lg font-bold text-slate-800")
                    span(data-titulo-colores)= o.titulo || 'Elegir colores'
                    span(data-titulo-resaltado class="ml-1.5 text-gh-primaryHover")
                button(type="button" data-cerrar-colores aria-label="Cerrar" class="w-9 h-9 flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer")
                    i(class="fi fi-rr-cross-small text-xl")

            div(class="px-6 pt-4 flex-shrink-0")
                input(type="text" data-buscador-colores placeholder="Buscar color..." autocomplete="off" aria-label="Buscar color" class="field-text")

            div(data-grid-colores class="flex-1 overflow-y-auto px-6 py-4 grid grid-cols-2 sm:grid-cols-3 gap-2")
                each c in (colores || [])
                    label(data-item-color data-buscar=String(c.valor).toLowerCase() class="flex items-center gap-2.5 p-2.5 border border-slate-100 rounded-xl cursor-pointer hover:bg-slate-50 has-[:checked]:border-gh-primary has-[:checked]:bg-gh-primarySoft/40")
                        input(type="checkbox" value=c.idAtributo data-nombre=c.valor data-hex1=c.codigo1 || '' data-hex2=c.codigo2 || '' class="w-4 h-4 flex-shrink-0 accent-[#E24C95]")
                        span(class="w-4 h-4 rounded-full border border-black/10 flex-shrink-0" style=`background:${fondo(c)}`)
                        span(class="text-sm font-medium text-slate-700 truncate")= c.valor
                p(data-sin-resultados-colores class="hidden col-span-full text-sm text-slate-400 py-6 text-center") Ningún color coincide con la búsqueda.

            //- Alta de un color simple que no está en la grilla.
            if o.altaColor
                div(data-alta-color=o.altaColor class="px-6 py-4 flex-shrink-0 border-t border-slate-100")
                    button(type="button" data-mostrar-alta-color class="text-xs font-bold text-gh-primaryHover hover:underline flex items-center gap-1")
                        i(class="fi fi-rr-plus-small text-[10px]")
                        | El color que busco no está
                    div(data-form-alta-color class="hidden items-end gap-2 mt-3")
                        label(class="flex-1 flex flex-col gap-1")
                            span(class="text-[11px] font-bold text-slate-500 uppercase tracking-wide") Nombre
                            input(type="text" data-alta-nombre autocomplete="off" placeholder="Ej. Verde Esmeralda" maxlength="100" class="field-text text-sm")
                        label(class="flex flex-col gap-1")
                            span(class="text-[11px] font-bold text-slate-500 uppercase tracking-wide") Color
                            input(type="color" data-alta-hex value="#E24C95" class="w-12 h-10 bg-white border border-slate-200 rounded-xl cursor-pointer")
                        button(type="button" data-guardar-alta-color class="btn btn-secondary text-xs flex-shrink-0 whitespace-nowrap") Agregar
                    p(data-error-alta-color class="label-error text-xs hidden mt-2")

            div(class="px-6 py-4 border-t border-slate-100 flex items-center justify-between gap-3 flex-shrink-0")
                span(data-conteo-colores class="text-xs text-slate-500" aria-live="polite")
                button(type="button" data-guardar-colores class="btn btn-danger")
                    i(class="fi fi-rr-check text-xs")
                    = o.textoGuardar || 'Guardar colores'
