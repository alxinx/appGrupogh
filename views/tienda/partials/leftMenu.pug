// Sidebar container
aside(
  id="sidebar" class="fixed md:static inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-200 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col  shadow-2xl")

  // Logo
  div(class="h-40 flex items-center justify-center border-b  border-gray-300 bg-[#eae1f2]")
    img(
      src="/img/logo.png"
      alt="Logo"
      class="max-w-40 h-30 object-contain"
    ) 

  // Menu
  nav(class="flex-1 px-4 py-6 space-y-1 bg-[#F9F4FD] overflow-y-auto")

    a(
      href="/store"  class=`menu-item ${currentPath === '/' ? 'active' : ''}`)
      i(class="fi fi-rr-point-of-sale-bill text-lg")
    
      span POST DE VENTA


    // Inventario (submenu)
    details(class="group")
      summary(class=`menu-item cursor-pointer flex justify-between items-center menu-item ${currentPath === '/inventario' ? 'active' : ''}`)
        div(class="flex items-center gap-3")
          i(class="fi fi-rr-box text-lg")
          span Inventario y Productos
        i(class="fi fi-rr-angle-small-right transition-transform group-open:rotate-90")

      div(class="ml-9 mt-2 space-y-1 text-sm text-gray-600")
        a(href="/store/inventario/lista" class=`submenu-item`)
          i(class="fi fi-rr-tshirt text-sm mr-2")
          | Ver Existencias
        a(href="" name="buscarExistencia" id="buscarExistencia" class=`submenu-item`)
          i(class="fi fi-rr-eye text-sm mr-2")
          | Buscar Existencia

        

    // Dosificador y traslados (submenu)
    details(class="group")
      summary(class=`menu-item cursor-pointer flex justify-between items-center menu-item ${currentPath === '/dosificaciones' ? 'active' : ''}`)
        div(class="flex items-center gap-3")
          i(class="fi fi-rr -dialogue-exchange")
          span Traslados
        i(class="fi fi-rr-angle-small-right transition-transform group-open:rotate-90")
 
      div(class="ml-9 mt-2 space-y-1 text-sm text-gray-600")
        a(href="/store/traslados/get" class="submenu-item") Recibir Traslados
        a(href="/store/traslados/new" class="submenu-item") Realizar Traslados
        a(href="/store/traslados/history" class="submenu-item") Historial de Traslados
 

    a(href="/admin/configuracion" class=`menu-item ${currentPath === '/configuracion' ? 'active' : ''}`)
      i(class="fi fi-rr-settings text-lg")
      span Settings

   
  // Logout
  div(class="p-4 border-t border-gray-300")
    form(action="/logout" method="POST")
        input(type="hidden" name="_csrf" value=csrfToken)
        button(
        class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium shadow-neutral-500 shadow-2xl cursor-pointer"    )
            i(class="fi fi-rr-sign-out-alt")
            span Cerrar sesión
