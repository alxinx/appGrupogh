- const p   = carpetasPermitidas || []
- const vis = (f) => p.includes(f) ? '' : 'display:none'

// Sidebar container
aside(
  id="sidebar" class="fixed md:static inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-200 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col  shadow-2xl")

  // Logo
  div(class="h-40 flex items-center justify-center border-b  border-gray-300 bg-[#eae1f2]")
    img(
      src="/img/logo.png"
      alt="Logo"
      class="max-w-40 h-30 object-contain"
    )

  // Menu
  nav(class="flex-1 px-4 py-6 space-y-1 bg-[#F9F4FD] overflow-y-auto")

    a(
      href="/store" data-folder="/" style=vis('/')
      class=`menu-item ${currentPath === '/' ? 'active' : ''}`)
      i(class="fi fi-rr-point-of-sale-bill text-lg")
      span POS DE VENTA

    details(class="group" data-folder="/inventario" style=vis('/inventario'))
      summary(class=`menu-item cursor-pointer flex justify-between items-center menu-item ${currentPath === '/inventario' ? 'active' : ''}`)
        div(class="flex items-center gap-3")
          i(class="fi fi-rr-box text-lg")
          span Inventario y Productos
        i(class="fi fi-rr-angle-small-right transition-transform group-open:rotate-90")

      div(class="ml-9 mt-2 space-y-1 text-sm text-gray-600")
        a(href="/store/inventario/lista" class=`submenu-item`)
          i(class="fi fi-rr-tshirt text-sm mr-2")
          | Ver Existencias
        a(href="" name="buscarExistencia" id="buscarExistencia" class=`submenu-item`)
          i(class="fi fi-rr-eye text-sm mr-2")
          | Buscar Existencia

    a(href="/store/traslados/get" data-folder="/traslados" style=vis('/traslados')
      class=`menu-item ${currentPath === '/traslados' ? 'active' : ''}`)
      i(class="fi fi-rr-paper-plane text-lg")
      span Traslados

    if pedidosWebPendientesCount && pedidosWebPendientesCount > 0
      a(href="/store/pedidos-web" class=`menu-item relative h-14 p-0 overflow-hidden ${currentPath === '/pedidos-web' ? 'active' : ''}`)
        div(class="menu-alert-normal absolute inset-0 flex items-center gap-3 px-4")
          i(class="fi fi-rr-shopping-bag text-lg")
          span Pedidos Web
          span(class="animate-badge-pulse ml-auto min-w-[26px] h-[26px] px-1.5 flex items-center justify-center rounded-full bg-gh-primaryHover text-white text-sm font-bold leading-none shadow-sm shadow-pink-300")= pedidosWebPendientesCount
        div(class="menu-alert-banner absolute inset-0 flex items-center gap-2.5 px-4 bg-gh-primaryHover text-white")
          i(class="fi fi-rr-bell text-base flex-shrink-0")
          span(class="text-xs font-semibold leading-snug") Pedidos web por despachar
    else
      a(href="/store/pedidos-web"
        class=`menu-item ${currentPath === '/pedidos-web' ? 'active' : ''}`)
        i(class="fi fi-rr-shopping-bag text-lg")
        span Pedidos Web

    details(class="group" data-folder="/storebehivors" style=vis('/storebehivors'))
      summary(class=`menu-item cursor-pointer flex justify-between items-center menu-item ${currentPath === '/dosificaciones' ? 'active' : ''}`)
        div(class="flex items-center gap-3")
          i(class="fi fi-rr -dialogue-exchange")
          span Caja y ventas
        i(class="fi fi-rr-angle-small-right transition-transform group-open:rotate-90")

      div(class="ml-9 mt-2 space-y-1 text-sm text-gray-600")
        if sinCaja
          if cajaDelDiaAnterior
            a#btn-apertura-caja-menu(href="/store/storebehivors/" class="submenu-item text-amber-600")
              i(class="fi fi-rr-triangle-warning text-sm mr-2")
              | Cerrar Caja Anterior
          else
            button#btn-apertura-caja-menu(
              type="button"
              class="submenu-item w-full text-left"
              onclick="window.abrirModalCaja && window.abrirModalCaja()"
            )
              i(class="fi fi-rr-open text-sm mr-2")
              | Apertura de Caja
        else
          a#btn-apertura-caja-menu(href="/store/storebehivors/" class="submenu-item")
            i(class="fi fi-rr-calculator text-sm mr-2")
            | Cuadrar Caja

        a(href="/store/storebehivors/sales" class="submenu-item")
          i(class="fi fi fi-rr-selling text-sm mr-2")
          | Mis Ventas

        a(href="/store/storebehivors/expenses" class="submenu-item")
          i(class="fi fi fi-rr-expense text-sm mr-2")
          | Egresos

    a(href="/admin/configuracion" data-folder="/configuracion" style=vis('/configuracion')
      class=`menu-item ${currentPath === '/configuracion' ? 'active' : ''}`)
      i(class="fi fi-rr-settings text-lg")
      span Settings

  //- Alerta de traslados pendientes (inyectado dinámicamente por storeGlobal.js)
  div#traslado-alerta-container(class="px-3 pb-3 space-y-2")

  // Logout
  div(class="p-4 border-t border-gray-300")
    form(action="/logout" method="POST")
        input(type="hidden" name="_csrf" value=csrfToken)
        button(
        class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium shadow-neutral-500 shadow-2xl cursor-pointer"    )
            i(class="fi fi-rr-sign-out-alt")
            span Cerrar sesión
