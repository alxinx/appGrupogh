extends ../../layout/index

block contenedor
    div(class="fixed inset-0 flex" style="background:#F4E8FF")
        include ../partials/leftMenu

        div(class="flex-1 flex flex-col min-w-0")
            include ../../partials/header

            main(class="flex-1 overflow-y-auto md:p-4")
                div(class="mainDashboard")

                    //- HEADER
                    div(class="col-span-12 grid grid-cols-1 md:grid-cols-2 bg-white/70 backdrop-blur-md rounded-2xl p-6")
                        div(class="flex items-center gap-4")
                            div(class="w-20 h-20 rounded-full bg-gradient-to-br from-gray-200 to-purple-300 flex items-center justify-center flex-shrink-0 shadow-inner shadow-purple-700")
                                img(src="/img/avatars/existeciasProducto.webp" alt="Inventario" class="w-17 h-17 object-contain")
                            div
                                h1(class="h1") Inventario
                                p(class="text-sm text-slate-400 mt-1") Existencias de productos y packs en esta tienda

                    //- FILTRO + TABLA
                    div(class="col-span-12 grid grid-cols-2 md:grid-cols-4 cards p-6")

                        //- Buscador + acciones sobre lo seleccionado, en una sola fila: son la
                        //- barra de herramientas de la tabla, no dos bloques. Antes el buscador
                        //- tenía 3/4 fijos y los botones 1/4, así que al aparecer el segundo no
                        //- cabían, se apilaban y cada rótulo se partía en dos renglones.
                        div(class="col-span-12 grid grid-cols-1 cards cardSearch")
                            h3.h3.mb-3
                                i.fi-rr-filter-list.mr-2
                                | Filtra la lista
                            div(class="flex flex-wrap items-center gap-3")
                                //- El buscador es lo elástico de la fila: cede ancho a medida que
                                //- aparecen los botones y solo cuando ya no puede encogerse más
                                //- (15rem, el ancho en que su placeholder sigue siendo legible) el
                                //- grupo de acciones baja a su propio renglón.
                                div(class="input-group flex-1 min-w-[15rem]")
                                    i.fi-rr-search.input-icon.input-icon-left
                                    input.input.input-has-icon-left(
                                        type="text"
                                        id="inv-search"
                                        placeholder="Busca por nombre, SKU, EAN o código de pack"
                                    )
                                //- Contenedor y orden del estándar de acciones (components/accionesAdmin.pug):
                                //- secundaria primero, acción principal al final. Desempacar aparece
                                //- recién con dos packs marcados: para uno solo está la acción de su fila.
                                //- `w-full md:w-auto`: en móvil el grupo ocupa su propio renglón y los
                                //- botones se apilan dentro; en escritorio mide lo que miden los botones
                                //- y comparte la fila con el buscador. Con `shrink-0` a secas el grupo no
                                //- podía envolverse y se salía de la tarjeta.
                                div(class="flex items-center gap-3 justify-center md:justify-end flex-wrap w-full md:w-auto")
                                    button(type="button" id="inv-desempacar-seleccionados" class="hidden btn btn-secondary gap-2 cursor-pointer")
                                        i(class="fi fi-rr-box-open-full text-rose-600")
                                        span Desempacar los seleccionados#[span(data-conteo)]
                                    button(type="button" id="inv-trasladar-seleccionados" class="hidden btn btn-primary gap-2 cursor-pointer")
                                        i(class="fi fi-rr-convert-shapes")
                                        span Trasladar packs#[span(data-conteo)]

                        //- Tabla
                        div(class="overflow-x-auto col-span-12 grid grid-cols-1 md:grid-cols-1")
                            table(class="w-full text-left border-collapse")
                                thead(class="bg-gh-primarySoft border-b border-gh-primaryHover")
                                    tr
                                        th(class="p-4 text-center")
                                            input(type="checkbox" id="inv-select-all" title="Seleccionar todos los packs visibles" class="checkbox cursor-pointer")
                                        th(class="p-4 text-sm font-semibold text-gray-600") Imagen
                                        th(class="p-4 text-sm font-semibold text-gray-600") Producto
                                        th(class="p-4 text-sm font-semibold text-gray-600") Precio
                                        th(class="p-4 text-sm font-semibold text-gray-600 text-center") Stock tienda
                                        th(class="p-4 text-sm font-semibold text-gray-600 text-center") Stock global
                                        th(class="p-4 text-sm font-semibold text-gray-600") Acciones
                                tbody#inv-tbody
                                    tr
                                        td(colspan="7" class="p-8 text-center text-gray-500")
                                            i(class="fi fi-rr-spinner animate-spin mr-2")
                                            | Cargando inventario...

                        //- Paginación
                        div(class="col-span-12")
                            div#inv-paginacion

    input#csrf-token(type="hidden" value=csrfToken)

    //- Hoja de la ventana de confirmación: la usan el desempaque y el traslado de packs, con
    //- la misma forma con la que se confirma un abono o un egreso.
    include ../../components/modalConfirmacion
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/js/helpers.js")
    script(src="/js/paginador.js")
    script(src="/js/storeInventario.js")
