extends ../../layout/index

block contenedor
    div(class="fixed inset-0 flex" style="background:#F4E8FF")
        include ../partials/leftMenu

        div(class="flex-1 flex flex-col min-w-0")
            include ../../partials/header

            main(class="flex-1 overflow-y-auto md:p-4")
                div(class="mainDashboard")

                    //- HEADER
                    div(class="col-span-12 grid grid-cols-1 md:grid-cols-2 bg-white/70 backdrop-blur-md rounded-2xl p-6")
                        div(class="flex items-center gap-4")
                            div(class="w-20 h-20 rounded-full bg-gradient-to-br from-fuchsia-500 to-purple-700 flex items-center justify-center flex-shrink-0 shadow-lg shadow-purple-400")
                                img(src="/img/avatars/existeciasProducto.webp" alt="Inventario" class="w-14 h-14 object-contain")
                            div
                                h1(class="h1") Inventario
                                p(class="text-sm text-slate-400 mt-1") Existencias de productos y packs en esta tienda

                    //- FILTRO + TABLA
                    div(class="col-span-12 grid grid-cols-2 md:grid-cols-4 cards p-6")

                        //- Buscador
                        div(class="col-span-12 grid grid-cols-2 md:grid-cols-4 cards cardSearch")
                            h3.h3.col-span-12
                                i.fi-rr-filter-list.mr-2
                                | Filtra la lista
                            div(class="col-span-12 p-2 md:col-span-3")
                                div.input-group
                                    i.fi-rr-search.input-icon.input-icon-left
                                    input.input.input-has-icon-left(
                                        type="text"
                                        id="inv-search"
                                        placeholder="Busca por nombre, SKU, EAN o código de pack"
                                    )

                        //- Tabla
                        div(class="overflow-x-auto col-span-12 grid grid-cols-1 md:grid-cols-1")
                            table(class="w-full text-left border-collapse")
                                thead(class="bg-gh-primarySoft border-b border-gh-primaryHover")
                                    tr
                                        th(class="p-4 text-sm font-semibold text-gray-600") Imagen
                                        th(class="p-4 text-sm font-semibold text-gray-600") Producto
                                        th(class="p-4 text-sm font-semibold text-gray-600") Precio
                                        th(class="p-4 text-sm font-semibold text-gray-600 text-center") Stock tienda
                                        th(class="p-4 text-sm font-semibold text-gray-600 text-center") Stock global
                                        th(class="p-4 text-sm font-semibold text-gray-600") Acciones
                                tbody#inv-tbody
                                    tr
                                        td(colspan="6" class="p-8 text-center text-gray-500")
                                            i(class="fi fi-rr-spinner animate-spin mr-2")
                                            | Cargando inventario...

                        //- Paginación
                        div(class="col-span-12")
                            div#inv-paginacion

    //- ══ MODAL TRASLADO ═════════════════════════════════════════════════════
    div(id="modal-traslado" class="fixed inset-0 z-50 hidden")
        div(id="modal-traslado-overlay" class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm")
        div(class="absolute inset-0 flex items-center justify-center p-4")
            div(class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden")

                div(class="flex items-center justify-between p-6 border-b border-slate-100")
                    div(class="flex items-center gap-3")
                        div(class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center text-purple-600")
                            i(class="fi fi-rr-convert-shapes")
                        h3(class="text-lg font-bold text-slate-800") Trasladar Pack
                    button(type="button" id="tras-cancelar" class="text-slate-400 hover:text-slate-700 cursor-pointer")
                        i(class="fi fi-rr-cross-small text-2xl")

                div(class="p-6 space-y-4")
                    div(class="flex items-center gap-3 bg-purple-50 rounded-2xl p-3")
                        i(class="fi fi-rr-info text-purple-500")
                        p(class="text-sm text-purple-700")
                            | Vas a trasladar
                            strong(id="tras-packs-count" class="mx-1") 0
                            | pack(s) a la tienda seleccionada.

                    div(class="space-y-2")
                        label(class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Destino *
                        div(class="relative")
                            select(id="tras-destino" class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-purple-300/30 transition-all appearance-none")
                                option(value="") Selecciona bodega o almacén...
                            i(class="fi fi-rr-shop absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none")

                    div(class="space-y-2")
                        label(class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Código empleado responsable *
                        div(class="relative")
                            input(
                                type="text"
                                id="tras-empleado"
                                placeholder="Ej: 12345"
                                maxlength="5"
                                autocomplete="new-password"
                                class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm font-mono uppercase tracking-widest focus:outline-none focus:ring-2 focus:ring-purple-300/30 transition-all"
                            )
                            i(class="fi fi-rr-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none")
                        div(id="tras-feedback-emp" class="text-xs ml-1 h-4")

                    div(class="space-y-2")
                        label(class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Notas
                        textarea(
                            id="tras-notas"
                            rows="2"
                            placeholder="Observaciones del traslado..."
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-sm resize-none focus:outline-none focus:ring-2 focus:ring-purple-300/30 transition-all"
                        )

                div(class="p-6 bg-slate-50/50 border-t border-slate-100 flex gap-3")
                    button(type="button" id="tras-cancelar" class="flex-1 btn btn-secondary py-3 cursor-pointer") Cancelar
                    button(type="button" id="tras-confirmar" class="flex-1 btn btn-primary py-3 cursor-pointer")
                        i(class="fi fi-rr-convert-shapes mr-2")
                        | Confirmar Traslado

    input#csrf-token(type="hidden" value=csrfToken)

    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/js/helpers.js")
    script(src="/js/paginador.js")
    script(src="/js/storeInventario.js")
