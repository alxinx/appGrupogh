extends ../../layout/index

block contenedor
    div(class="fixed inset-0 flex" style="background:#F4E8FF")
        include ../partials/leftMenu

        div(class="flex-1 flex flex-col min-w-0")
            include ../../partials/header

            main(class="flex-1 overflow-y-auto p-6 pt-5")

                //- ══ HEADER ═════════════════════════════════════════════════
                div(class="bg-white/70 backdrop-blur-md rounded-2xl p-5 mb-6 flex items-center gap-5 shadow-sm border border-white/60")
                    div(class="w-20 h-20 rounded-full bg-gradient-to-br from-gray-200 to-purple-300 flex items-center justify-center flex-shrink-0 shadow-inner shadow-purple-700")
                        img(src="/img/avatars/pedido.webp" alt="Pedidos Web" class="w-17 h-17 object-contain")
                    div
                        h1(class="text-2xl font-bold text-slate-800") Pedidos Web
                        p(class="text-sm text-slate-400 mt-0.5") Pedidos de la tienda web asignados a esta tienda

                //- ══ FILTROS ════════════════════════════════════════════════
                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-6 flex flex-wrap items-end gap-3")
                    div(class="space-y-1")
                        label(class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Estado
                        select#pw-estado-filtro(class="field-text")
                            option(value="en_revision" selected="selected") Por despachar
                            option(value="facturado") Facturados
                            option(value="cancelado") Cancelados
                            option(value="") Todos

                //- ══ TABLA ══════════════════════════════════════════════════
                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                    div(class="overflow-x-auto")
                        table(class="w-full text-sm text-left")
                            thead
                                tr(class="bg-slate-50 text-xs text-slate-500 uppercase tracking-wider border-b border-slate-100")
                                    th(class="px-4 py-3") Pedido
                                    th(class="px-4 py-3") Cliente
                                    th(class="px-4 py-3") Contacto
                                    th(class="px-4 py-3") Pago
                                    th(class="px-4 py-3") Entrega
                                    th(class="px-4 py-3 text-right") Total
                                    th(class="px-4 py-3 text-center") Estado
                                    th(class="px-4 py-3") Fecha
                                    th(class="px-4 py-3")
                            tbody#pw-tbody(class="divide-y divide-slate-100")
                                tr
                                    td(colspan="9" class="px-4 py-10 text-center text-slate-400 text-sm")
                                        i(class="fi fi-rr-spinner animate-spin mr-2")
                                        | Cargando pedidos...

                    div(class="px-4 py-3 border-t border-slate-100 flex items-center justify-between")
                        p#pw-resumen(class="text-xs text-slate-400") Cargando...
                        div#pw-paginacion

    //- Contenedor de toasts
    div#toast-container(class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none")

    input#csrf-token(type="hidden" value=csrfToken)

    script(src="/js/storeGlobal.js")
    script(src="/js/paginador.js")
    script(src="/js/storePedidosWeb.js")
