div(class="h-full p-4 grid grid-cols-12 gap-6")
    //- SECCIÓN IZQUIERDA: BUSCADOR Y PRODUCTOS (8 Columnas)
    div(class="col-span-12 lg:col-span-8 flex flex-col gap-6 overflow-y-auto")

        //- Pedidos web asignados, pendientes de despachar
        div#pedidos-web-banner(class="hidden bg-gh-primarySoft shadow-inner rounded-2xl p-4")
            div(class="flex items-center gap-2 mb-3")
                i(class="fi fi-rr-shopping-bag text-gh-primaryHover")
                span(class="text-sm font-bold text-gh-grayText") Pedidos web por despachar
            div#pedidos-web-lista(class="flex flex-col gap-2")

        //- Buscador Gigante
        div(class="bg-white/70 backdrop-blur-md rounded-[1.5rem] p-6 shadow-sm border border-white")
            //- Campo de lector de barras: el navegador tapaba el catálogo con dos desplegables
            //- distintos. El historial de formularios se apaga con autocomplete="off" y sin
            //- name= (no hay clave con la que guardarlo; pos.js lo lee por id y nunca se envía
            //- como formulario). El de contraseñas guardadas ignora autocomplete a propósito:
            //- se va con type="search", que Chrome no considera candidato a campo de usuario.
            //- El resto evita que el móvil capitalice o "corrija" un SKU.
            input(
                id="codigo"
                type="search"
                placeholder="Ingresa el SKU, nombre o serial..."
                autofocus
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                class="h-16 w-full text-4xl text-center bg-transparent border-none focus:ring-0 text-gh-grayText font-light focus:outline-none"
            )
            div(class="flex items-center justify-center gap-3 mt-4 pt-3 border-t border-gray-100/80")
                label(class="flex items-center gap-3 cursor-pointer select-none group")
                    input(id="auto-add-toggle" type="checkbox" class="sr-only" checked)
                    span.switch
                        span.switch-thumb
                    span(class="text-xs font-semibold text-gray-400 group-hover:text-gray-600 transition-colors uppercase tracking-wide") Agregar a orden automáticamente   
        //- Catálogo de Productos
        div(id="catalogo-pos" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6")
        //- Imagen decorativa por defecto
        img#pos-escena(
            src="/img/escena_tienda.webp"
            alt=""
            class="w-full rounded-2xl object-cover transition-all duration-500"
            style="max-height:420px;"
        )
        //- SECCIÓN DE RECOMENDACIONES (Estilo Ticket)
        div(class="mt-10")
            h3(class="text-gh-primary font-bold uppercase tracking-tighter mb-4 ml-2")
            div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                //+tarjetaRecomendacion('Onitsuka Tiger - Pijama Conjunto', '21d 12h 23m', 'https://pub-f89c3f57ac314e868860b81774b10373.r2.dev/productos/BDTR001-1771852413584-2.webp', true)
                //+tarjetaRecomendacion('Pijama Soft Dream', '12h 45m', 'https://pub-f89c3f57ac314e868860b81774b10373.r2.dev/productos/BDTR001-1771852413584-2.webp', false)
    
    
    //- SECCIÓN DERECHA: ESTADO DE COMPRA (4 Columnas)
    aside(id="drop-zone" data-wholesale-min=wholesaleMin class="col-span-12 lg:col-span-4 flex flex-col min-h-0")
        div(class="bg-white/40 backdrop-blur-xl p-6 rounded-[1.5rem] border border-white/60 shadow-xl flex flex-col lg:h-full min-h-0 overflow-y-auto lg:overflow-hidden transition-all")

            //- Header de la Orden
            div(class="flex items-center justify-between mb-6")
                div
                    h2(class="font-display text-2xl text-gray-900") Tu Orden
                    div(class="flex items-center gap-1 mt-0.5")
                        p(id="cart-count" class="text-[10px] text-gray-400 font-bold uppercase") 0 items seleccionados
                        span(id="cart-modo-badge" class="hidden")
                button(id="btn-clear-cart" class="p-2 text-gh-primary hover:bg-gh-primary/10 rounded-xl transition-colors cursor-pointer")
                    i(class="fi-rr-trash text-xl")
            //- Lista Scrolleable (Items del Carrito)
            div(class="relative lg:flex-1 lg:min-h-0 flex flex-col mb-4 lg:mb-0")
                div(id="cart-list" class="lg:flex-1 lg:overflow-y-auto custom-scrollbar pr-2 flex flex-col gap-4")
                button(
                    id="cart-scroll-hint"
                    class="hidden absolute bottom-0 left-0 right-0 flex items-center justify-center gap-1.5 py-2 text-xs font-bold text-white shadow-lg cursor-pointer select-none"
                    style="background:#EC5FA3"
                )
                    i(class="fi fi-rr-angle-double-down text-xs")
                    | más items
            //- Resumen y Cliente (Anclados al fondo)
            div(class="space-y-4 mt-4 lg:mt-auto")
                input(type="hidden" id="idCliente" value=clienteGenerico.idCliente)
                - const cliNombre = ((clienteGenerico.primer_nombre || '') + ' ' + (clienteGenerico.primer_apellido || '')).trim()
                - const cliDoc    = (clienteGenerico.tipoDocumento || 'CC') + ' ' + (clienteGenerico.numero_doc || '')
                +tarjetaClienteFidelizado(clienteGenerico.idCliente, cliNombre || 'Cliente Genérico', cliDoc, '/img/avatars/cliente.webp')
                +resumenFactura(0, 0, 0)

                button(id="btn-procesar-factura" class="w-full py-4 bg-gh-primary text-white rounded-2xl font-bold shadow-lg shadow-gh-primary/30 hover:bg-gh-primaryHover transition-all active:scale-95 cursor-pointer")
                    | Procesar Factura