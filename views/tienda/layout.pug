extends ../layout/index

block contenedor
    //- Banner global de controversias (oculto por defecto)
    div(
        id="controversia-banner"
        class="hidden fixed top-0 left-0 right-0 z-50 bg-red-600 text-white text-center py-2 px-4 text-sm font-bold shadow-lg"
    )
        span(class="fi-rr-triangle-warning mr-2")
        span#controversia-texto TIENE 0 CONTROVERSIAS POR RESOLVER — INGRESA A TRASLADOS PARA GESTIONARLAS
        a(href="/store/traslados/get" class="ml-4 underline text-white hover:text-red-200") Ver ahora

    div(class="fixed inset-0 flex" style="background:#F4E8FF")
        include ./partials/leftMenu

        div(class="flex-1 flex flex-col min-w-0 relative")
            include ../partials/header
            include ../components/mixinsPos
            include ../components/modals

            main(class="flex-1 overflow-hidden")
                block contenidoTienda
                    include ./views/pos

            +modalCliente(departamentos || [])

    +modalDetalleProductoTemplate()
    +modalFinalizarVenta()

    //- Contenedor de toasts globales
    div#toast-container(class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none")

    //- Modal apertura de caja — solo cuando no hay cajas de días anteriores pendientes de cierre
    if sinCaja && !cajaDelDiaAnterior
        - const cajaMenorFormateado = (cajaMenorDefault || 0).toLocaleString('es-CO')
        div#modal-apertura-caja(class="fixed inset-0 z-[9999] hidden items-center justify-center p-6 bg-black/30 backdrop-blur-sm")
            div(class="bg-white rounded-[1.5rem] shadow-2xl w-full max-w-md flex flex-col overflow-hidden")

                //- Header
                div(class="flex items-center justify-between px-8 py-5 border-b border-gray-100 flex-shrink-0")
                    div(class="flex items-center gap-4")
                        div(class="w-10 h-10 rounded-2xl bg-gh-primary flex items-center justify-center shadow-lg shadow-gh-primary/30")
                            i(class="fi fi-rr-cash-register text-white text-base flex items-center")
                        div
                            h2(class="font-bold text-gray-900 text-base") Apertura de Caja
                            p(class="text-xs text-gray-400 mt-0.5") Registra la apertura para comenzar a facturar
                    button#btn-cerrar-caja-modal(
                        type="button"
                        class="w-9 h-9 flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer"
                    )
                        i(class="fi fi-rr-cross-small text-xl")

                //- Body
                div(class="px-8 py-6 space-y-5")
                    div
                        label(class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2") Caja Menor
                        p(class="text-xs text-gray-400 mb-2") Doble clic para editar el valor
                        div(class="relative")
                            span(class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold pointer-events-none") $
                            input#input-caja-menor(
                                type="text"
                                inputmode="numeric"
                                class="w-full pl-7 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 font-semibold text-sm focus:outline-none transition-colors cursor-default select-none"
                                value=cajaMenorFormateado
                                readonly
                                title="Doble clic para editar"
                            )

                    div
                        label(class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2") Código de Empleado
                        div(class="relative")
                            i(class="fi fi-rr-user absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none")
                            //- Es un código de empleado, no una credencial: se enmascara para que
                            //- no se lea por encima del hombro, pero no debe guardarse ni
                            //- autocompletarse. Con type="password" a secas Chrome tomaba la
                            //- página por un login y ofrecía contraseñas guardadas en el buscador
                            //- del POS; "one-time-code" le dice que no hay nada que guardar acá.
                            input#input-codigo-apertura(
                                type="password"
                                placeholder="••••••"
                                maxlength="10"
                                autocomplete="one-time-code"
                                class="w-full pl-9 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-mono uppercase tracking-widest focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors"
                            )
                        div#apertura-empleado-info(class="hidden mt-2 text-xs font-medium px-1")

                //- Footer
                div(class="px-8 pb-6")
                    button#btn-abrir-caja(
                        type="button"
                        class="w-full flex items-center justify-center gap-2 py-3.5 rounded-2xl text-white font-bold text-sm transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed bg-gh-primary cursor-pointer"
                        disabled
                    )
                        i(class="fi fi-rr-lock-open-alt")
                        span Abrir Caja

    script.
        window.__SIN_CAJA__          = !{JSON.stringify(!!sinCaja)};
        window.__CAJA_MENOR_DEFAULT__ = !{JSON.stringify(cajaMenorDefault || 0)};
        window.__cajaAbierta          = !window.__SIN_CAJA__;
        window.__CAJAS_PENDIENTES__   = !{JSON.stringify(cajaDelDiaAnterior ? 1 : 0)};
        window.__PUEDE_FACTURAR__     = !{JSON.stringify(!!puedeFacturar)};
        window.__PEDIDOS_WEB_PENDIENTES__ = !{JSON.stringify(pedidosWebPendientes || [])};

    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/js/helpers.js")
    script(src="/js/pos.js")
    script(src="/js/storeGlobal.js")

    if trasladosPendientes && trasladosPendientes > 0
        - const plural = trasladosPendientes > 1 ? 's' : ''
        script.
            Swal.fire({
                icon: 'warning',
                title: '📦 Traslado pendiente',
                html: 'Tienes <strong>!{trasladosPendientes}</strong> traslado!{plural} por recibir.<br><br><a href="/store/traslados/get" style="color:#EC5FA3;font-weight:bold;text-decoration:underline;">Ver traslados →</a>',
                timer: 5000,
                timerProgressBar: true,
                showConfirmButton: false,
                position: 'center'
            });

    if pedidosWebPendientes && pedidosWebPendientes.length > 0
        - const plural = pedidosWebPendientes.length > 1 ? 's' : ''
        script.
            Swal.fire({
                icon: 'info',
                title: '🛍️ Pedido web por despachar',
                html: 'Tienes <strong>!{pedidosWebPendientes.length}</strong> pedido!{plural} web asignado!{plural}, listo!{plural} para cargar al carrito y facturar.',
                timer: 6000,
                timerProgressBar: true,
                showConfirmButton: false,
                position: 'center'
            });

    if cajaDelDiaAnterior
        - const fechaAp = new Date(cajaDelDiaAnterior.fechaApertura).toLocaleDateString('es-CO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
        script.
            Swal.fire({
                icon: 'error',
                title: 'Caja sin cerrar',
                html: 'La caja abierta el <strong>!{fechaAp}</strong> no fue cerrada.<br><br>Debes realizar el cierre de caja antes de continuar.',
                confirmButtonText: 'Ir a cuadre de caja',
                confirmButtonColor: '#EC5FA3',
                showCancelButton: true,
                cancelButtonText: 'Ignorar por ahora',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(result => {
                if (result.isConfirmed) {
                    window.location.href = '/store/storebehivors/';
                }
            });
