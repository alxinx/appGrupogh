extends ../../layout/index

block contenedor
    div(class="fixed inset-0 flex" style="background:#F4E8FF")
        include ../partials/leftMenu

        div(class="flex-1 flex flex-col min-w-0")
            include ../../partials/header

            main(class="flex-1 overflow-y-auto md:p-4")
                div(class="mainDashboard")

                    //- ── HEADER ──────────────────────────────────────────────────────────
                    div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6 flex items-center gap-4")
                        div(class="w-20 h-20 rounded-full bg-gradient-to-br from-pink-500 to-rose-600 flex items-center justify-center flex-shrink-0 shadow-lg shadow-pink-300")
                            i(class="fi fi-rr-expense text-white text-3xl")
                        div
                            h1(class="h1") Egresos
                            p(class="text-sm text-slate-400 mt-1") Registro y seguimiento de egresos de caja del punto de venta

                    //- ── STAT TOTAL HOY ──────────────────────────────────────────────────
                    div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-5 flex items-center gap-4")
                        div(class="w-12 h-12 rounded-xl bg-rose-100 flex items-center justify-center text-rose-600 flex-shrink-0")
                            i(class="fi fi-rr-coins text-xl")
                        div
                            p(class="text-xs text-slate-500 uppercase tracking-wider font-semibold mb-0.5") Total egresos de hoy
                            p(id="stat-total-hoy" class="text-2xl font-bold text-slate-800") —

                    //- ── DOS COLUMNAS ─────────────────────────────────────────────────────
                    div(class="col-span-12 grid grid-cols-1 md:grid-cols-[65fr_35fr] gap-4 items-start")

                        //- ── IZQUIERDA · LISTADO (70%) ──────────────────────────────
                        div(class="bg-white/70 backdrop-blur-md rounded-2xl p-6 flex flex-col gap-4")

                            div(class="flex items-center gap-3 mb-2")
                                div(class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500")
                                    i(class="fi fi-rr-list text-lg")
                                h2(class="h2 !mb-0") Egresos registrados

                            div(class="bg-slate-50 rounded-xl p-4 grid grid-cols-2 gap-3")
                                p(class="text-xs font-bold text-slate-500 uppercase tracking-wider col-span-2")
                                    i(class="fi fi-rr-filter mr-1")
                                    | Filtrar
                                div(class="col-span-1 space-y-1")
                                    label(class="text-xs text-slate-400") Desde
                                    input(
                                        type="date"
                                        id="filtro-fecha-a"
                                        class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-xs focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                                    )
                                div(class="col-span-1 space-y-1")
                                    label(class="text-xs text-slate-400") Hasta
                                    input(
                                        type="date"
                                        id="filtro-fecha-b"
                                        class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-xs focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                                    )
                                div(class="col-span-2")
                                    select(
                                        id="filtro-estado"
                                        class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-xs focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                                    )
                                        option(value="") Todos los estados
                                        option(value="pendiente") Pendiente
                                        option(value="liquidada") Liquidada

                            div(class="overflow-x-auto")
                                table(class="w-full text-left border-collapse")
                                    thead(class="bg-gh-primarySoft border-b border-gh-primaryHover")
                                        tr
                                            th(class="px-3 py-3 text-xs font-semibold text-gray-600") Referencia
                                            th(class="px-3 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Fecha y hora
                                            th(class="px-3 py-3 text-xs font-semibold text-gray-600") Descripción
                                            th(class="px-3 py-3 text-xs font-semibold text-gray-600 text-right") Valor
                                            th(class="px-3 py-3 text-xs font-semibold text-gray-600 text-center") Tipo
                                            th(class="px-3 py-3 text-xs font-semibold text-gray-600 text-center") Estado
                                            th(class="px-3 py-3 text-xs font-semibold text-gray-600 text-center") PDF
                                    tbody#egr-tbody
                                        tr
                                            td(colspan="7" class="px-3 py-8 text-center text-gray-500 text-sm")
                                                i(class="fi fi-rr-spinner animate-spin mr-2")
                                                | Cargando egresos...

                            div#egr-paginacion

                        //- ── DERECHA · NUEVO EGRESO (30%) ──────────────────────────────
                        div(class="bg-white/70 backdrop-blur-md rounded-2xl p-6")
                            div(class="flex items-center gap-3 mb-6")
                                div(class="w-10 h-10 rounded-xl bg-rose-100 flex items-center justify-center text-rose-600")
                                    i(class="fi fi-rr-add-document text-lg")
                                h2#egr-titulo(class="h2 !mb-0") Nuevo Egreso

                            form#form-egreso(class="space-y-4")

                                div(class="space-y-1")
                                    label(class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Tipo de registro *
                                    div(class="grid grid-cols-2 gap-2")
                                        label(class="cursor-pointer")
                                            input#egr-metodo-efectivo(type="radio" name="egr-metodo" value="Efectivo" checked class="peer sr-only")
                                            div(class="flex items-center justify-center gap-2 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-sm font-semibold transition-all peer-checked:border-emerald-400 peer-checked:bg-emerald-50 peer-checked:text-emerald-700")
                                                i(class="fi fi-rr-money-bill-wave")
                                                | Egreso
                                        label(class="cursor-pointer")
                                            input#egr-metodo-electronico(type="radio" name="egr-metodo" value="Electronico" class="peer sr-only")
                                            div(class="flex items-center justify-center gap-2 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-sm font-semibold transition-all peer-checked:border-blue-400 peer-checked:bg-blue-50 peer-checked:text-blue-700")
                                                i(class="fi fi-rr-bank")
                                                | Transferencia
                                    p#egr-ayuda-metodo(class="text-[10px] text-slate-400 mt-1") Sale del cajón de la tienda.

                                div(class="space-y-1")
                                    label#egr-label-valor(for="egr-valor" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Valor del Egreso *
                                    div(class="relative")
                                        span(class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-sm pointer-events-none") $
                                        input(
                                            type="text"
                                            id="egr-valor"
                                            placeholder="0"
                                            inputmode="numeric"
                                            autocomplete="off"
                                            class="w-full pl-8 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all"
                                        )


                                div#egr-bloque-entidad(class="space-y-1 hidden")
                                    label(for="egr-entidad" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") ¿Con qué cuenta? *
                                    select#egr-entidad(class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all")
                                        option(value="") Seleccionar...
                                        each ent in (entidades || [])
                                            option(value=ent.idEntidad)= ent.nombreEntidad
                                    p#egr-error-entidad(class="hidden text-[10px] font-bold text-red-500 mt-1")

                                div(class="space-y-1")
                                    label(for="egr-referencia" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Referencia de Factura
                                    input(
                                        type="text"
                                        id="egr-referencia"
                                        placeholder="Ej: FAC-001, REC-2024..."
                                        maxlength="50"
                                        autocomplete="off"
                                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all"
                                    )

                                div(class="space-y-1")
                                    label(for="egr-empleado" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Código de Empleado *
                                    div(class="relative")
                                        i(class="fi fi-rr-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none")
                                        input(
                                            type="password"
                                            id="egr-empleado"
                                            placeholder="Ej: 00123"
                                            maxlength="5"
                                            autocomplete="one-time-code"
                                            class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono uppercase tracking-widest focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all"
                                        )
                                    p(id="egr-feedback-emp" class="text-xs ml-1 h-4 transition-colors")

                                div(class="space-y-1")
                                    label(for="egr-descripcion" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Descripción
                                    textarea(
                                        id="egr-descripcion"
                                        rows="3"
                                        maxlength="255"
                                        placeholder="Detalle del egreso..."
                                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all"
                                    )

                                button(
                                    type="submit"
                                    id="egr-submit"
                                    disabled
                                    class="w-full btn btn-primary py-3 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
                                )
                                    i(class="fi fi-rr-disk")
                                    | Registrar Egreso

    input#csrf-token(type="hidden" value=csrfToken)
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/js/helpers.js")
    script(src="/js/paginador.js")
    script(src="/js/storeEgresos.js")
