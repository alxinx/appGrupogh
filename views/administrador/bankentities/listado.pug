extends ../../layout/index
block contenedor
    //- Cajas, bancos y billeteras salen de CAJAS_Y_BANCOS; el controlador ya los separa
    //- por tipo (`cajas` = efectivo, `bancos` = banco + billetera).
    -
        var cajasLista  = cajas  || [];
        var bancosLista = bancos || [];
        //- El saldo llega como DECIMAL (string) desde MySQL. Se pasa a Number solo para
        //- darle formato de miles: es presentación, no un cálculo encadenado.
        var pesos = function (v) {
            var n = Number(v || 0);
            return (n < 0 ? '-$' : '$') + Math.abs(n).toLocaleString('es-CO', { maximumFractionDigits: 0 });
        };

        //- Presentación de cada tipo de entidad en la tabla de métodos de pago.
        var estiloTipo = {
            'Banco':              { icono: 'fi-rr-bank',        caja: 'bg-blue-50 text-blue-600',       badge: 'bg-blue-100 text-blue-700',       desc: 'Transferencias y consignaciones' },
            'Billetera Virtual':  { icono: 'fi-rr-wallet',      caja: 'bg-fuchsia-50 text-fuchsia-600', badge: 'bg-fuchsia-100 text-fuchsia-700', desc: 'Nequi, Daviplata y otros' },
            'Entidad Crediticia': { icono: 'fi-rr-coins',       caja: 'bg-indigo-50 text-indigo-600',   badge: 'bg-indigo-100 text-indigo-700',   desc: 'Créditos y financiación' },
            'Tarjeta Credito':    { icono: 'fi-rr-credit-card', caja: 'bg-violet-50 text-violet-600',   badge: 'bg-violet-100 text-violet-700',   desc: 'Tarjetas de crédito' }
        };
        var estiloPorDefecto = { icono: 'fi-rr-money-bill-wave', caja: 'bg-slate-100 text-slate-500', badge: 'bg-slate-100 text-slate-600', desc: 'Método de pago' };

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- HEADER — se conserva el ícono y la distribución original;
                            //- lo único nuevo son las dos pestañas de abajo.
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                div(class="flex items-center justify-between")
                                    div(class="flex items-center gap-4")
                                        div(class="w-20 h-20 rounded-full bg-gradient-to-br from-gray-200 to-purple-300 flex items-center justify-center flex-shrink-0 shadow-inner shadow-purple-700")
                                            img(src="/img/avatars/banco.webp" alt="Cajas, bancos y métodos de pago" class="w-17 h-17 object-contain")
                                        div
                                            h1(class="text-xl font-bold text-slate-800") Cajas, bancos y métodos de pago
                                            p(class="text-xs text-slate-400 mt-0.5") Administra dónde recibes y mueves tu dinero, y cómo pagan tus clientes

                                //- PESTAÑAS
                                div(class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6")
                                    button#tab-btn-cajas(
                                        type="button"
                                        data-tab="cajas"
                                        class="tab-bank flex items-center justify-center gap-2 py-4 rounded-2xl border text-sm font-semibold transition-all cursor-pointer"
                                    )
                                        i(class="fi fi-rr-bank text-base")
                                        | Cajas y bancos
                                    button#tab-btn-metodos(
                                        type="button"
                                        data-tab="metodos"
                                        class="tab-bank flex items-center justify-center gap-2 py-4 rounded-2xl border text-sm font-semibold transition-all cursor-pointer"
                                    )
                                        i(class="fi fi-rr-credit-card text-base")
                                        | Métodos de pago

                            //- ══════════════════════════════════════════════════════════
                            //- PESTAÑA 1 — CAJAS Y BANCOS
                            //- ══════════════════════════════════════════════════════════
                            section#panel-cajas(class="col-span-12 grid grid-cols-12 gap-4 items-start")

                                //- ── CAJAS ─────────────────────────────────────────────
                                //- 50% en escritorio, 100% en móvil (col-span-12 sin prefijo).
                                div(class="col-span-12 md:col-span-6 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                    div(class="p-6 flex flex-wrap items-start justify-between gap-4")
                                        div(class="flex items-center gap-3 flex-wrap")
                                            div(class="w-12 h-12 rounded-2xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0")
                                                img(src="/img/avatars/cajaRegistradora.webp" alt="Cajas" class="w-9 h-9 object-contain")
                                            div
                                                h2(class="text-lg font-bold text-slate-800") Cajas
                                                p(class="text-sm text-slate-400") Dinero en efectivo del negocio
                                        button#btn-nueva-caja(type="button" class="btn btn-sm inline-flex items-center gap-2 rounded-2xl border border-gh-primary/30 bg-gh-primarySoft text-gh-primaryHover font-bold hover:bg-gh-primary hover:text-white transition-colors cursor-pointer")
                                            i(class="fi fi-rr-plus-small text-base")
                                            | Nueva caja

                                    div(class="overflow-x-auto")
                                        table(class="w-full text-left border-collapse")
                                            thead
                                                tr(class="border-b border-gh-primaryHover text-sm")
                                                    th(class="px-4 py-4 text-gray-600 whitespace-nowrap") Caja
                                                    th(class="px-2 py-4 text-center text-gray-600 whitespace-nowrap") Referencia
                                                    th(class="px-2 py-4 text-center text-gray-600 whitespace-nowrap") Saldo
                                                    th(class="px-2 py-4 text-center text-gray-600 whitespace-nowrap") Estado
                                                    th(class="px-4 py-4 text-center text-gray-600 whitespace-nowrap") Acciones

                                            tbody#tabla-cajas(class="divide-y divide-slate-100")
                                                each caja in cajasLista
                                                    tr(class="border-b border-gray-100 hover:bg-gray-50 transition-colors" data-id=caja.idCajaBanco)
                                                        td(class="px-4 py-4")
                                                            div(class="flex items-center gap-3 flex-wrap")
                                                                div(class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0")
                                                                    img(src="/img/avatars/cajaRegistradora.webp" alt="" class="w-7 h-7 object-contain")
                                                                p(class="font-bold text-slate-800 text-sm leading-tight")= tc(caja.nombreCajaBanco)
                                                                //- Campana de traslados por aceptar. Se renderiza siempre —oculta
                                                                //- cuando no hay— para que el aviso que llega por SSE solo tenga
                                                                //- que quitarle una clase, sin armar marcado desde JavaScript.
                                                                span(
                                                                    class=`campana-traslado ${caja.trasladosPendientes ? '' : 'hidden'}`
                                                                    data-caja=caja.idCajaBanco
                                                                    title=`${caja.trasladosPendientes || 0} traslado(s) de efectivo esperando que esta cuenta los acepte`
                                                                )
                                                                    i(class="fi fi-rr-bell")
                                                                    span(class="campana-texto") Traslado pendiente por aceptar
                                                                    span(class="campana-n")= caja.trasladosPendientes || 0

                                                        td(class="px-2 py-4 text-center text-xs font-mono text-slate-500")= caja.referencia || '—'

                                                        //- Sale de MOVIMIENTOS_CAJA_Y_BANCOS: ingresos menos egresos.
                                                        td(class="px-2 py-4 text-center")
                                                            p(class=`font-bold text-sm whitespace-nowrap ${Number(caja.saldo) < 0 ? 'text-red-600' : 'text-slate-800'}`)= pesos(caja.saldo)
                                                            p(class="text-[10px] text-slate-400")= (caja.movimientos || 0) + ' mov.'

                                                        td(class="px-2 py-4 text-center")
                                                            if caja.estado
                                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-emerald-100 text-emerald-600")
                                                                    span(class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2")
                                                                    | Activa
                                                            else
                                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-slate-100 text-slate-500")
                                                                    span(class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2")
                                                                    | Inactiva

                                                        td(class="px-4 py-4 text-center")
                                                            a(href=`/admin/bankentities/cajas/${caja.idCajaBanco}` class="btn btn-secondary btn-sm text-xs whitespace-nowrap")
                                                                i.fi-rr-eye.text-xs
                                                                | Ver más

                                                //- Estado vacío: sin esto la tabla queda como si algo hubiera fallado.
                                                if !cajasLista.length
                                                    tr#vacio-cajas
                                                        td(colspan="5" class="px-4 py-10 text-center")
                                                            i(class="fi fi-rr-inbox text-2xl text-slate-300")
                                                            p(class="text-sm text-slate-400 mt-2") Todavía no hay cajas registradas

                                    div(class="px-6 py-4 bg-slate-50/30 border-t border-slate-100")
                                        p(class="text-xs text-slate-400")
                                            | Mostrando
                                            span#contador-cajas(class="font-bold text-slate-600 mx-1")= cajasLista.length
                                            | cajas registradas

                                //- ── BANCOS ────────────────────────────────────────────
                                div(class="col-span-12 md:col-span-6 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                    div(class="p-6 flex flex-wrap items-start justify-between gap-4")
                                        div(class="flex items-center gap-3 flex-wrap")
                                            div(class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                                                img(src="/img/avatars/banco.webp" alt="Bancos" class="w-9 h-9 object-contain")
                                            div
                                                h2(class="text-lg font-bold text-slate-800") Bancos y billeteras
                                                p(class="text-sm text-slate-400") Cuentas donde entra y sale el dinero del negocio
                                        button#btn-nuevo-banco(type="button" class="btn btn-sm inline-flex items-center gap-2 rounded-2xl border border-gh-primary/30 bg-gh-primarySoft text-gh-primaryHover font-bold hover:bg-gh-primary hover:text-white transition-colors cursor-pointer")
                                            i(class="fi fi-rr-plus-small text-base")
                                            | Nuevo banco

                                    div(class="overflow-x-auto")
                                        table(class="w-full text-left border-collapse")
                                            thead
                                                tr(class="border-b border-gh-primaryHover text-sm")
                                                    th(class="px-4 py-4 text-gray-600 whitespace-nowrap") Cuenta
                                                    th(class="px-2 py-4 text-center text-gray-600 whitespace-nowrap") Tipo
                                                    th(class="px-2 py-4 text-center text-gray-600 whitespace-nowrap") Referencia
                                                    th(class="px-2 py-4 text-center text-gray-600 whitespace-nowrap") Saldo
                                                    th(class="px-2 py-4 text-center text-gray-600 whitespace-nowrap") Estado
                                                    th(class="px-4 py-4 text-center text-gray-600 whitespace-nowrap") Acciones

                                            tbody#tabla-bancos(class="divide-y divide-slate-100")
                                                each banco in bancosLista
                                                    tr(class="border-b border-gray-100 hover:bg-gray-50 transition-colors" data-id=banco.idCajaBanco)
                                                        td(class="px-4 py-4")
                                                            div(class="flex items-center gap-3 flex-wrap")
                                                                div(class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                                                                    img(src="/img/avatars/banco.webp" alt="" class="w-7 h-7 object-contain")
                                                                p(class="font-bold text-slate-800 text-sm leading-tight")= tc(banco.nombreCajaBanco)
                                                                //- Campana de traslados por aceptar. Se renderiza siempre —oculta
                                                                //- cuando no hay— para que el aviso que llega por SSE solo tenga
                                                                //- que quitarle una clase, sin armar marcado desde JavaScript.
                                                                span(
                                                                    class=`campana-traslado ${banco.trasladosPendientes ? '' : 'hidden'}`
                                                                    data-caja=banco.idCajaBanco
                                                                    title=`${banco.trasladosPendientes || 0} traslado(s) de efectivo esperando que esta cuenta los acepte`
                                                                )
                                                                    i(class="fi fi-rr-bell")
                                                                    span(class="campana-texto") Traslado pendiente por aceptar
                                                                    span(class="campana-n")= banco.trasladosPendientes || 0

                                                        td(class="px-2 py-4 text-center")
                                                            span(class=`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap ${banco.tipo === 'billetera' ? 'bg-fuchsia-100 text-fuchsia-700' : 'bg-blue-100 text-blue-700'}`)= banco.tipo === 'billetera' ? 'Billetera' : 'Banco'

                                                        td(class="px-2 py-4 text-center text-xs font-mono text-slate-500")= banco.referencia || '—'

                                                        td(class="px-2 py-4 text-center")
                                                            p(class=`font-bold text-sm whitespace-nowrap ${Number(banco.saldo) < 0 ? 'text-red-600' : 'text-slate-800'}`)= pesos(banco.saldo)
                                                            p(class="text-[10px] text-slate-400")= (banco.movimientos || 0) + ' mov.'

                                                        td(class="px-2 py-4 text-center")
                                                            if banco.estado
                                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-emerald-100 text-emerald-600")
                                                                    span(class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2")
                                                                    | Activa
                                                            else
                                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-slate-100 text-slate-500")
                                                                    span(class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2")
                                                                    | Inactiva

                                                        td(class="px-4 py-4 text-center")
                                                            a(href=`/admin/bankentities/cajas/${banco.idCajaBanco}` class="btn btn-secondary btn-sm text-xs whitespace-nowrap")
                                                                i.fi-rr-eye.text-xs
                                                                | Ver más

                                                if !bancosLista.length
                                                    tr#vacio-bancos
                                                        td(colspan="6" class="px-4 py-10 text-center")
                                                            i(class="fi fi-rr-inbox text-2xl text-slate-300")
                                                            p(class="text-sm text-slate-400 mt-2") Todavía no hay cuentas registradas

                                    div(class="px-6 py-4 bg-slate-50/30 border-t border-slate-100")
                                        p(class="text-xs text-slate-400")
                                            | Mostrando
                                            span#contador-bancos(class="font-bold text-slate-600 mx-1")= bancosLista.length
                                            | cuentas registradas

                            //- ══════════════════════════════════════════════════════════
                            //- PESTAÑA 2 — MÉTODOS DE PAGO (datos reales de ENTIDADES)
                            //- ══════════════════════════════════════════════════════════
                            section#panel-metodos(class="col-span-12 hidden")
                                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                    div(class="p-6 flex flex-wrap items-start justify-between gap-4")
                                        div
                                            h2(class="text-lg font-bold text-slate-800") Métodos de pago
                                            p(class="text-sm text-slate-400") Configura las formas de pago disponibles para tus clientes en toda la plataforma
                                        button#btn-nuevo-metodo(type="button" class="btn btn-sm inline-flex items-center gap-2 rounded-2xl border border-gh-primary/30 bg-gh-primarySoft text-gh-primaryHover font-bold hover:bg-gh-primary hover:text-white transition-colors cursor-pointer")
                                            i(class="fi fi-rr-plus-small text-base")
                                            | Nuevo método de pago

                                    div(class="overflow-x-auto")
                                        table(class="w-full text-left border-collapse")
                                            thead
                                                tr(class="border-b border-gh-primaryHover text-sm")
                                                    th(class="px-6 py-4 text-gray-600") Método de pago
                                                    th(class="px-4 py-4 text-center text-gray-600") Tipo
                                                    th(class="px-4 py-4 text-center text-gray-600") Canal disponible
                                                    th(class="px-4 py-4 text-center text-gray-600") Estado
                                                    th(class="px-6 py-4 text-center text-gray-600") Acciones

                                            tbody#tabla-entidades(class="divide-y divide-slate-100")
                                                each ent in entidades
                                                    - var est = estiloTipo[ent.tipoEntidad] || estiloPorDefecto
                                                    - var admiteQr = ent.tipoEntidad === 'Banco' || ent.tipoEntidad === 'Billetera Virtual'
                                                    tr(class="border-b border-gray-100 hover:bg-gray-50 transition-colors" data-id=ent.idEntidad)

                                                        td(class="px-6 py-4")
                                                            div(class="flex items-center gap-3 flex-wrap")
                                                                div(class=`w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${est.caja}`)
                                                                    i(class=`fi ${est.icono} text-base`)
                                                                div
                                                                    p(class="font-bold text-slate-800 text-sm")= tc(ent.nombreEntidad)
                                                                    p(class="text-[11px] text-slate-400")= est.desc

                                                        td(class="px-4 py-4 text-center")
                                                            span(class=`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${est.badge}`)= ent.tipoEntidad

                                                        //- CANAL DISPONIBLE — POS sale de recibirPagosPos; Web es el QR de pago,
                                                        //- que conserva su switch y su enlace de gestión.
                                                        td(class="px-4 py-4")
                                                            div(class="flex flex-col items-center gap-2")
                                                                div(class="flex items-center justify-center gap-2")
                                                                    if ent.recibirPagosPos
                                                                        span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border border-gh-primary/40 text-gh-primaryHover") POS
                                                                    if admiteQr
                                                                        label(class="flex items-center gap-2 cursor-pointer" title="Activar pago web por QR")
                                                                            input.switch-qr(
                                                                                type="checkbox"
                                                                                class="sr-only"
                                                                                data-id=ent.idEntidad
                                                                                data-nombre=ent.nombreEntidad
                                                                                data-status=ent.qrStatus || ''
                                                                                checked=!!ent.qrEnabled
                                                                            )
                                                                            span.switch
                                                                                span.switch-thumb
                                                                            span(class="text-xs font-bold text-slate-500") Web
                                                                    else if !ent.recibirPagosPos
                                                                        span(class="text-xs text-slate-300") —

                                                                if admiteQr
                                                                    if ent.qrStatus === 'compromised'
                                                                        button(type="button" class="btn-qr-gestionar qr-pie inline-flex items-center gap-1 text-[10px] font-bold text-red-600 bg-red-50 border border-red-200 px-2 py-1 rounded-full" data-id=ent.idEntidad data-nombre=ent.nombreEntidad)
                                                                            i(class="fi fi-rr-exclamation text-[10px]")
                                                                            | Comprometido
                                                                    else if ent.qrStatus
                                                                        button(type="button" class="btn-qr-gestionar qr-pie text-[10px] font-bold text-slate-500 hover:text-gh-primaryHover underline underline-offset-2" data-id=ent.idEntidad data-nombre=ent.nombreEntidad) Ver / cambiar QR
                                                                    else
                                                                        span(class="qr-pie text-[10px] text-slate-400") Sin QR cargado

                                                        td(class="px-4 py-4 text-center")
                                                            if ent.recibirPagosPos || ent.qrEnabled
                                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-600")
                                                                    span(class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2")
                                                                    | Activo
                                                            else
                                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500")
                                                                    span(class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2")
                                                                    | Inactivo

                                                        td(class="px-6 py-4 text-center")
                                                            a(href=`/admin/bankentities/detallesEntidad/${ent.idEntidad}` class="btn btn-secondary text-xs")
                                                                i.fi-rr-eye.text-xs
                                                                | Ver más

                                    div(class="px-6 py-4 bg-slate-50/30 border-t border-slate-100")
                                        p(class="text-xs text-slate-400")
                                            | Mostrando
                                            span(class="font-bold text-slate-600 mx-1")= entidades.length
                                            | métodos registrados

                            //- ── PIE ───────────────────────────────────────────────────
                            div(class="col-span-12 bg-purple-50/60 border border-purple-100 rounded-2xl p-5 flex flex-wrap items-center justify-between gap-4")
                                div(class="flex items-center gap-3 flex-wrap")
                                    div(class="w-11 h-11 rounded-2xl bg-white flex items-center justify-center flex-shrink-0 shadow-sm")
                                        i(class="fi fi-rr-bulb text-purple-500 text-lg")
                                    div
                                        p(class="font-bold text-slate-800 text-sm") Gestiona tus cajas, bancos y métodos de pago
                                        p(class="text-xs text-slate-500 mt-0.5") Mantén actualizada la información para un mejor control de tus transacciones y reportes financieros.
                                button#btn-reportes(type="button" class="btn btn-sm inline-flex items-center gap-2 rounded-2xl bg-white border border-purple-200 text-purple-600 font-bold hover:bg-purple-100 transition-colors cursor-pointer")
                                    i(class="fi fi-rr-stats text-base")
                                    | Ver reportes financieros

        //- ══════════════════════════════════════════════════════════════════════
        //- MODAL: NUEVA CAJA
        //- ══════════════════════════════════════════════════════════════════════
        div#modal-caja(class="hidden fixed inset-0 z-50 flex items-center justify-center p-4")
            div(class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-cerrar-modal)
            div(class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto")
                div(class="px-6 pt-6 pb-4 border-b border-slate-100 flex items-start justify-between gap-3")
                    div(class="flex items-center gap-3 flex-wrap")
                        div(class="w-11 h-11 rounded-2xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0")
                            img(src="/img/avatars/cajaRegistradora.webp" alt="" class="w-8 h-8 object-contain")
                        div
                            h3(class="font-bold text-slate-800") Nueva caja
                            p(class="text-xs text-slate-400 mt-0.5") Registra una caja de efectivo
                    button(type="button" class="text-slate-300 hover:text-slate-500 transition-colors" data-cerrar-modal)
                        i(class="fi fi-rr-cross-small text-xl")

                form#form-nueva-caja(class="px-6 py-5 space-y-4")
                    input(type="hidden" name="_csrf" value=csrfToken)

                    div
                        label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1")
                            | Nombre de la caja
                            span(class="text-gh-primaryHover ml-0.5") *
                        input#caja-nombre(type="text" name="nombreCajaBanco" placeholder="Ej: Caja Principal San Diego" maxlength="50" required autocomplete="off" class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors")
                        p#error-caja-nombre(class="hidden text-[10px] font-bold text-red-500 mt-1")

                    div
                        label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1") Referencia
                        input#caja-referencia(type="text" name="referencia" placeholder="Ej: CAJA-01" maxlength="50" autocomplete="off" class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors")
