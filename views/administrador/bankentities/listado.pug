                div(class="px-6 pb-6 flex gap-2")
                    button(type="button" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-500 hover:bg-slate-50 transition-colors" data-cerrar-qr) Cancelar
                    button#modal-qr-subir(type="button" class="flex-1 py-2.5 rounded-xl text-xs font-bold text-white bg-gh-primary hover:bg-gh-primaryHover transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled) Verificar y subir

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")

        script.
            // ── PESTAÑAS Y MODALES ────────────────────────────────────────────
            (function () {
                const ACTIVA   = 'bg-gh-primarySoft border-gh-primaryHover text-gh-primaryHover shadow-sm';
                const INACTIVA = 'bg-white border-slate-200 text-slate-500 hover:border-gh-primary/40 hover:text-gh-primaryHover';

                const paneles = { cajas: document.getElementById('panel-cajas'), metodos: document.getElementById('panel-metodos') };
                const botones = document.querySelectorAll('.tab-bank');

                const mostrar = (tab) => {
                    if (!paneles[tab]) tab = 'cajas';
                    Object.entries(paneles).forEach(([k, el]) => el.classList.toggle('hidden', k !== tab));
                    botones.forEach(b => {
                        const activa = b.dataset.tab === tab;
                        b.className = 'tab-bank flex items-center justify-center gap-2 py-4 rounded-2xl border text-sm font-semibold transition-all cursor-pointer ' + (activa ? ACTIVA : INACTIVA);
                    });
                    // El hash mantiene la pestaña al recargar o al volver desde "Ver más".
                    if (location.hash.slice(1) !== tab) history.replaceState(null, '', '#' + tab);
                };

                botones.forEach(b => b.addEventListener('click', () => mostrar(b.dataset.tab)));
                mostrar(location.hash.slice(1) || 'cajas');

                // ── Modales ───────────────────────────────────────────────────
                const abrir = (id) => document.getElementById(id)?.classList.remove('hidden');
                const cerrar = (el) => el?.classList.add('hidden');

                document.getElementById('btn-nueva-caja') ?.addEventListener('click', () => abrir('modal-caja'));
                document.getElementById('btn-nuevo-banco')?.addEventListener('click', () => abrir('modal-banco'));
                document.getElementById('btn-nuevo-metodo')?.addEventListener('click', () => abrir('modal-metodo'));

                document.querySelectorAll('[data-cerrar-modal]').forEach(el => {
                    el.addEventListener('click', () => cerrar(el.closest('.fixed')));
                });
                document.addEventListener('keydown', (e) => {
                    if (e.key !== 'Escape') return;
                    ['modal-caja', 'modal-banco', 'modal-metodo'].forEach(id => cerrar(document.getElementById(id)));
                });

                // ── Pendientes de backend ─────────────────────────────────────
                const pendiente = (titulo) => Swal.fire({
                    icon: 'info',
                    title: titulo,
                    text: 'Este módulo todavía no está conectado al backend.',
                    confirmButtonColor: '#EC5FA3'
                });

                document.getElementById('btn-reportes')?.addEventListener('click', () => pendiente('Reportes financieros'));

                // Delegado en document: cubre las filas que ya vienen del servidor y las
                // que se agregan al crear, sin ligar dos veces las primeras.
                document.addEventListener('click', (e) => {
                    const b = e.target.closest('.btn-ver-pendiente');
                    if (b) pendiente(b.dataset.nombre || 'Detalle');
                });

                // ══ CAJAS Y BANCOS — alta contra CAJAS_Y_BANCOS ══════════════
                const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';

                // Marca un campo en rojo con su mensaje. Es la validación del cliente:
                // ahorra un viaje al servidor, pero el que manda es el backend, que valida
                // exactamente lo mismo con express-validator y los validadores del modelo.
                const marcarError = (idCampo, idError, mensaje) => {
                    const campo = document.getElementById(idCampo);
                    const error = document.getElementById(idError);
                    if (mensaje) {
                        campo.classList.add('border-red-400', 'ring-2', 'ring-red-200');
                        error.textContent = mensaje;
                        error.classList.remove('hidden');
                    } else {
                        campo.classList.remove('border-red-400', 'ring-2', 'ring-red-200');
                        error.textContent = '';
                        error.classList.add('hidden');
                    }
                };

                const limpiarErrores = (campos) => campos.forEach(([c, e]) => marcarError(c, e, ''));

                // El error se borra en cuanto la persona corrige, no al reenviar.
                ['caja-nombre', 'caja-referencia', 'banco-nombre', 'banco-referencia'].forEach(id => {
                    document.getElementById(id)?.addEventListener('input', () => marcarError(id, 'error-' + id, ''));
                });
                document.getElementById('banco-tipo')?.addEventListener('change', () => marcarError('banco-tipo', 'error-banco-tipo', ''));

                const guardar = async ({ boton, etiqueta, datos, campos, tabla, pintarFila }) => {
                    boton.disabled = true;
                    boton.textContent = 'Guardando...';
                    try {
                        const r = await fetch('/admin/bankentities/cajas/crear', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
                            body: JSON.stringify(datos)
                        });
                        const d = await r.json();
                        if (!d.success) throw new Error(d.mensaje || 'No se pudo guardar.');

                        // Si la tabla estaba vacía, se quita el cartel de "no hay registros".
                        tabla.querySelector('tr[id^="vacio-"]')?.remove();
                        tabla.appendChild(pintarFila(d.cajaBanco));

                        // El pie se recalcula desde las filas reales: así no puede quedar
                        // diciendo "0 registradas" con una fila a la vista.
                        const contador = document.getElementById(boton.dataset.contador);
                        if (contador) contador.textContent = tabla.querySelectorAll('tr[data-id]').length;

                        document.getElementById(boton.dataset.modal).classList.add('hidden');
                        limpiarErrores(campos);
                        Swal.fire({ icon: 'success', title: etiqueta + ' creada', text: `"${d.cajaBanco.nombreCajaBanco}" quedó registrada.`, confirmButtonColor: '#EC5FA3', timer: 2500, timerProgressBar: true });
                    } catch (err) {
                        Swal.fire({ icon: 'error', title: 'No se pudo guardar', text: err.message, confirmButtonColor: '#EC5FA3' });
                    } finally {
                        boton.disabled = false;
                        boton.textContent = boton.dataset.textoOriginal;
                    }
                };

                // Una cuenta recién creada no tiene movimientos, así que su saldo es 0.
                const saldoCero = () =>
                    `<p class="font-bold text-sm whitespace-nowrap text-slate-800">$0</p><p class="text-[10px] text-slate-400">0 mov.</p>`;

                const badgeEstado = (activo) => activo
                    ? `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-emerald-100 text-emerald-600"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2"></span>Activa</span>`
                    : `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-slate-100 text-slate-500"><span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2"></span>Inactiva</span>`;

                const escapar = (t) => String(t ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

                const botonVerMas = (id) =>
                    `<a href="/admin/bankentities/cajas/${escapar(id)}" class="btn btn-secondary btn-sm text-xs whitespace-nowrap"><i class="fi-rr-eye text-xs"></i>Ver más</a>`;

                // ── Nueva caja ────────────────────────────────────────────────
                const btnCaja = document.getElementById('btn-guardar-caja');
                btnCaja.dataset.modal = 'modal-caja';
                btnCaja.dataset.textoOriginal = 'Guardar caja';
                btnCaja.dataset.contador = 'contador-cajas';
                btnCaja.addEventListener('click', () => {
                    const nombre = document.getElementById('caja-nombre').value.trim();
                    const campos = [['caja-nombre', 'error-caja-nombre'], ['caja-referencia', 'error-caja-referencia']];
                    limpiarErrores(campos);

                    if (!nombre) return marcarError('caja-nombre', 'error-caja-nombre', 'El nombre es obligatorio.');
                    if (nombre.length < 2) return marcarError('caja-nombre', 'error-caja-nombre', 'El nombre debe tener al menos 2 caracteres.');

                    guardar({
                        boton: btnCaja,
                        etiqueta: 'Caja',
                        campos,
                        tabla: document.getElementById('tabla-cajas'),
                        datos: {
                            nombreCajaBanco: nombre,
                            tipo: 'caja',
                            referencia: document.getElementById('caja-referencia').value.trim(),
                            estado: document.getElementById('caja-activa').checked
                        },
                        pintarFila: (c) => {
                            const tr = document.createElement('tr');
                            tr.className = 'border-b border-gray-100 hover:bg-gray-50 transition-colors';
                            tr.dataset.id = c.idCajaBanco;
                            tr.innerHTML = `
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0">
                                            <img src="/img/avatars/cajaRegistradora.webp" alt="" class="w-7 h-7 object-contain">
                                        </div>
                                        <p class="font-bold text-slate-800 text-sm leading-tight">${escapar(tc(c.nombreCajaBanco))}</p>
                                    </div>
                                </td>
                                <td class="px-2 py-4 text-center text-xs font-mono text-slate-500">${escapar(c.referencia || '—')}</td>
                                <td class="px-2 py-4 text-center">${saldoCero()}</td>
                                <td class="px-2 py-4 text-center">${badgeEstado(c.estado)}</td>
                                <td class="px-4 py-4 text-center">${botonVerMas(c.idCajaBanco)}</td>`;
                            return tr;
                        }
                    });
                });

                // ── Nuevo banco / billetera ───────────────────────────────────
                const btnBanco = document.getElementById('btn-guardar-banco');
                btnBanco.dataset.modal = 'modal-banco';
                btnBanco.dataset.textoOriginal = 'Guardar banco';
                btnBanco.dataset.contador = 'contador-bancos';
                btnBanco.addEventListener('click', () => {
                    const nombre = document.getElementById('banco-nombre').value.trim();
                    const tipo   = document.getElementById('banco-tipo').value;
                    const campos = [['banco-nombre', 'error-banco-nombre'], ['banco-tipo', 'error-banco-tipo'], ['banco-referencia', 'error-banco-referencia']];
                    limpiarErrores(campos);

                    if (!nombre) return marcarError('banco-nombre', 'error-banco-nombre', 'El nombre es obligatorio.');
                    if (nombre.length < 2) return marcarError('banco-nombre', 'error-banco-nombre', 'El nombre debe tener al menos 2 caracteres.');
                    if (!tipo) return marcarError('banco-tipo', 'error-banco-tipo', 'Elegí si es banco o billetera.');

                    guardar({
                        boton: btnBanco,
                        etiqueta: tipo === 'billetera' ? 'Billetera' : 'Cuenta',
                        campos,
                        tabla: document.getElementById('tabla-bancos'),
                        datos: {
                            nombreCajaBanco: nombre,
                            tipo,
                            referencia: document.getElementById('banco-referencia').value.trim(),
                            estado: document.getElementById('banco-activa').checked
                        },
                        pintarFila: (c) => {
                            const tr = document.createElement('tr');
                            tr.className = 'border-b border-gray-100 hover:bg-gray-50 transition-colors';
                            tr.dataset.id = c.idCajaBanco;
                            const badgeTipo = c.tipo === 'billetera'
                                ? `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-fuchsia-100 text-fuchsia-700">Billetera</span>`
                                : `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-blue-100 text-blue-700">Banco</span>`;
                            tr.innerHTML = `
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
                                            <img src="/img/avatars/banco.webp" alt="" class="w-7 h-7 object-contain">
                                        </div>
                                        <p class="font-bold text-slate-800 text-sm leading-tight">${escapar(tc(c.nombreCajaBanco))}</p>
                                    </div>
                                </td>
                                <td class="px-2 py-4 text-center">${badgeTipo}</td>
                                <td class="px-2 py-4 text-center text-xs font-mono text-slate-500">${escapar(c.referencia || '—')}</td>
                                <td class="px-2 py-4 text-center">${saldoCero()}</td>
                                <td class="px-2 py-4 text-center">${badgeEstado(c.estado)}</td>
                                <td class="px-4 py-4 text-center">${botonVerMas(c.idCajaBanco)}</td>`;
                            return tr;
                        }
                    });
                });
            })();

        script.
            (function () {
                const csrf       = document.querySelector('meta[name="csrf-token"]')?.content || '';
                const tabla      = document.getElementById('tabla-entidades');
                const btnGuardar = document.getElementById('btn-guardar-entidad');

                const ESTILO = {
                    'Banco':              { icono: 'fi-rr-bank',        caja: 'bg-blue-50 text-blue-600',       badge: 'bg-blue-100 text-blue-700',       desc: 'Transferencias y consignaciones' },
                    'Billetera Virtual':  { icono: 'fi-rr-wallet',      caja: 'bg-fuchsia-50 text-fuchsia-600', badge: 'bg-fuchsia-100 text-fuchsia-700', desc: 'Nequi, Daviplata y otros' },
                    'Entidad Crediticia': { icono: 'fi-rr-coins',       caja: 'bg-indigo-50 text-indigo-600',   badge: 'bg-indigo-100 text-indigo-700',   desc: 'Créditos y financiación' },
                    'Tarjeta Credito':    { icono: 'fi-rr-credit-card', caja: 'bg-violet-50 text-violet-600',   badge: 'bg-violet-100 text-violet-700',   desc: 'Tarjetas de crédito' },
                };
                const POR_DEFECTO = { icono: 'fi-rr-money-bill-wave', caja: 'bg-slate-100 text-slate-500', badge: 'bg-slate-100 text-slate-600', desc: 'Método de pago' };

                // ── CREAR ENTIDAD ─────────────────────────────────────────────
                btnGuardar.addEventListener('click', async () => {
                    const nombre  = document.getElementById('input-nombre-entidad').value.trim();
                    const tipo    = document.getElementById('input-tipo-entidad').value;
                    const recibir = document.getElementById('switch-recibir-pagos').checked;

                    if (!nombre) return Swal.fire({ icon: 'warning', title: 'Falta el nombre', text: 'Ingresa el nombre de la entidad.', confirmButtonColor: '#EC5FA3' });
                    if (!tipo)   return Swal.fire({ icon: 'warning', title: 'Falta el tipo', text: 'Selecciona el tipo de entidad.', confirmButtonColor: '#EC5FA3' });

                    btnGuardar.disabled    = true;
                    btnGuardar.textContent = 'Guardando...';

                    try {
                        const r = await fetch('/admin/bankentities/crear', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
                            body: JSON.stringify({ nombreEntidad: nombre, tipoEntidad: tipo, recibirPagosPos: recibir })
                        });
                        const d = await r.json();
                        if (!d.success) throw new Error(d.mensaje || 'Error al crear');

                        document.getElementById('modal-metodo').classList.add('hidden');

                        await Swal.fire({
                            icon: 'success',
                            title: '¡Método creado!',
                            text: `"${nombre}" fue registrado correctamente.`,
                            confirmButtonColor: '#EC5FA3',
                            timer: 3000,
                            timerProgressBar: true
                        });

                        const ent = d.entidad;
                        const est = ESTILO[ent.tipoEntidad] || POR_DEFECTO;
                        const admiteQr = ent.tipoEntidad === 'Banco' || ent.tipoEntidad === 'Billetera Virtual';

                        const badgePos = ent.recibirPagosPos
                            ? `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border border-gh-primary/40 text-gh-primaryHover">POS</span>`
                            : '';
                        const bloqueQr = admiteQr
                            ? `<label class="flex items-center gap-2 cursor-pointer" title="Activar pago web por QR">
                                   <input type="checkbox" class="switch-qr sr-only" data-id="${ent.idEntidad}" data-nombre="${ent.nombreEntidad}" data-status="">
                                   <span class="switch"><span class="switch-thumb"></span></span>
                                   <span class="text-xs font-bold text-slate-500">Web</span>
                               </label>`
                            : (ent.recibirPagosPos ? '' : `<span class="text-xs text-slate-300">—</span>`);
                        const pieQr = admiteQr ? `<span class="qr-pie text-[10px] text-slate-400">Sin QR cargado</span>` : '';

                        const estado = ent.recibirPagosPos
                            ? `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-600"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2"></span>Activo</span>`
                            : `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500"><span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2"></span>Inactivo</span>`;

                        const fila = document.createElement('tr');
                        fila.className = 'border-b border-gray-100 hover:bg-gray-50 transition-colors';
                        fila.dataset.id = ent.idEntidad;
                        fila.innerHTML = `
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${est.caja}"><i class="fi ${est.icono} text-base"></i></div>
                                    <div>
                                        <p class="font-bold text-slate-800 text-sm">${escapar(tc(ent.nombreEntidad))}</p>
                                        <p class="text-[11px] text-slate-400">${est.desc}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-center"><span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${est.badge}">${ent.tipoEntidad}</span></td>
                            <td class="px-4 py-4">
                                <div class="flex flex-col items-center gap-2">
                                    <div class="flex items-center justify-center gap-2">${badgePos}${bloqueQr}</div>
                                    ${pieQr}
                                </div>
                            </td>
                            <td class="px-4 py-4 text-center">${estado}</td>
                            <td class="px-6 py-4 text-center">
                                <a href="/admin/bankentities/detallesEntidad/${ent.idEntidad}" class="btn btn-secondary text-xs"><i class="fi-rr-eye text-xs"></i>Ver más</a>
                            </td>`;
                        tabla.appendChild(fila);

                        document.getElementById('input-nombre-entidad').value    = '';
                        document.getElementById('input-tipo-entidad').value      = '';
                        document.getElementById('switch-recibir-pagos').checked  = false;
                    } catch (err) {
                        Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#EC5FA3' });
                    } finally {
                        btnGuardar.disabled    = false;
                        btnGuardar.textContent = 'Guardar entidad';
                    }
                });
            })();

        script.
            // ── QR DE PAGO WEB ────────────────────────────────────────────────
            (function () {
                const csrf   = document.querySelector('meta[name="csrf-token"]')?.content || '';
                const tabla  = document.getElementById('tabla-entidades');
                const modal  = document.getElementById('modal-qr');
                if (!tabla || !modal) return;

                const elEntidad  = document.getElementById('modal-qr-entidad');
                const elActual   = document.getElementById('modal-qr-actual');
                const elImg      = document.getElementById('modal-qr-img');
                const elEstado   = document.getElementById('modal-qr-estado');
                const elFecha    = document.getElementById('modal-qr-fecha');
                const elAutor    = document.getElementById('modal-qr-autor');
                const inputFile  = document.getElementById('modal-qr-file');
                const preview    = document.getElementById('modal-qr-preview');
                const icono      = document.getElementById('modal-qr-icono');
                const nombreArch = document.getElementById('modal-qr-nombre-archivo');
                const chkPublicar= document.getElementById('modal-qr-publicar');
                const btnSubir   = document.getElementById('modal-qr-subir');

                let idActivo = null;
                let urlPreviewLocal = null;

                const ETIQUETA_ESTADO = {
                    active:      'Activo',
                    replaced:    'Reemplazado',
                    compromised: 'Comprometido — no se está sirviendo',
                };

                const fmtFecha = (v) => v
                    ? new Date(v).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' })
                    : '—';

                // ── Modal ─────────────────────────────────────────────────────
                const limpiarPreviewLocal = () => {
                    if (urlPreviewLocal) URL.revokeObjectURL(urlPreviewLocal);
                    urlPreviewLocal = null;
                    inputFile.value = '';
                    preview.classList.add('hidden');
                    preview.removeAttribute('src');
                    icono.classList.remove('hidden');
                    nombreArch.textContent = 'Selecciona la imagen del QR';
                    btnSubir.disabled = true;
                };

                const cerrarModal = () => {
                    modal.classList.add('hidden');
                    elActual.classList.add('hidden');
                    elImg.removeAttribute('src');
                    idActivo = null;
                    limpiarPreviewLocal();
                };

                modal.querySelectorAll('[data-cerrar-qr]').forEach(el => el.addEventListener('click', cerrarModal));
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && !modal.classList.contains('hidden')) cerrarModal();
                });

                const abrirModal = async (id, nombre) => {
                    idActivo = id;
                    elEntidad.textContent = nombre;
                    chkPublicar.checked = true;
                    limpiarPreviewLocal();
                    modal.classList.remove('hidden');

                    // El QR actual se pide al abrir: la URL firmada es de corta vida,
                    // así que no tiene sentido tenerla precargada en la página.
                    try {
                        const d = await fetch(`/admin/bankentities/${id}/qr`, { headers: { 'Accept': 'application/json' } }).then(r => r.json());
                        if (!d.success || !d.tieneQr) return;
                        elImg.src            = d.url;
                        elEstado.textContent = ETIQUETA_ESTADO[d.qrStatus] || '—';
                        elEstado.className   = `font-bold ${d.qrStatus === 'compromised' ? 'text-red-600' : 'text-emerald-600'}`;
                        elFecha.textContent  = `Subido: ${fmtFecha(d.qrUploadedAt)}`;
                        elAutor.textContent  = d.subidoPor ? `Por: ${d.subidoPor}` : 'Autor no registrado';
                        elActual.classList.remove('hidden');
                    } catch (_) { /* sin preview, se puede subir igual */ }
                };

                inputFile.addEventListener('change', () => {
                    const file = inputFile.files?.[0];
                    if (!file) return limpiarPreviewLocal();

                    if (file.size > 2 * 1024 * 1024) {
                        limpiarPreviewLocal();
                        return Swal.fire({ icon: 'warning', title: 'Imagen muy pesada', text: 'El máximo permitido es 2 MB.', confirmButtonColor: '#EC5FA3' });
                    }

                    if (urlPreviewLocal) URL.revokeObjectURL(urlPreviewLocal);
                    urlPreviewLocal = URL.createObjectURL(file);
                    preview.src = urlPreviewLocal;
                    preview.classList.remove('hidden');
                    icono.classList.add('hidden');
                    nombreArch.textContent = file.name;
                    btnSubir.disabled = false;
                });

                // ── Estado pintado en la fila ─────────────────────────────────
                // El pie del QR se marca con .qr-pie: buscarlo por su clase de tamaño
                // rompería en cuanto otra etiqueta de la misma celda usara ese tamaño.
                const pintarFila = (id, { qrEnabled, qrStatus }) => {
                    const sw = tabla.querySelector(`.switch-qr[data-id="${id}"]`);
                    if (!sw) return;
                    sw.checked = !!qrEnabled;
                    sw.dataset.status = qrStatus || '';

                    const celda = sw.closest('td');
                    const pie   = celda?.querySelector('.qr-pie');
                    if (!pie) return;

                    const nombre = sw.dataset.nombre;
                    if (qrStatus === 'compromised') {
                        pie.outerHTML = `<button type="button" class="btn-qr-gestionar qr-pie inline-flex items-center gap-1 text-[10px] font-bold text-red-600 bg-red-50 border border-red-200 px-2 py-1 rounded-full" data-id="${id}" data-nombre="${nombre}"><i class="fi fi-rr-exclamation text-[10px]"></i>Comprometido</button>`;
                    } else if (qrStatus) {
                        pie.outerHTML = `<button type="button" class="btn-qr-gestionar qr-pie text-[10px] font-bold text-slate-500 hover:text-gh-primaryHover underline underline-offset-2" data-id="${id}" data-nombre="${nombre}">Ver / cambiar QR</button>`;
                    } else {
                        pie.outerHTML = `<span class="qr-pie text-[10px] text-slate-400">Sin QR cargado</span>`;
                    }
                };

                // ── Subida ────────────────────────────────────────────────────
                btnSubir.addEventListener('click', async () => {
                    const file = inputFile.files?.[0];
                    if (!file || !idActivo) return;

                    btnSubir.disabled    = true;
                    btnSubir.textContent = 'Verificando...';

                    try {
                        const fd = new FormData();
                        fd.append('qr', file);
                        fd.append('qrEnabled', chkPublicar.checked ? 'true' : 'false');

                        const r = await fetch(`/admin/bankentities/${idActivo}/qr`, {
                            method: 'POST',
                            headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' },
                            body: fd
                        });
                        const d = await r.json();
                        if (!d.success) throw new Error(d.mensaje || 'No se pudo subir el QR.');

                        pintarFila(idActivo, d.qr);
                        cerrarModal();
                        Swal.fire({ icon: 'success', title: 'QR verificado', text: d.mensaje, confirmButtonColor: '#EC5FA3', timer: 3500, timerProgressBar: true });
                    } catch (err) {
                        Swal.fire({ icon: 'error', title: 'No se pudo publicar', text: err.message, confirmButtonColor: '#EC5FA3' });
                    } finally {
                        btnSubir.disabled    = !inputFile.files?.[0];
                        btnSubir.textContent = 'Verificar y subir';
                    }
                });

                // ── Switch por fila ───────────────────────────────────────────
                tabla.addEventListener('change', async (e) => {
                    const sw = e.target.closest('.switch-qr');
                    if (!sw) return;

                    const id     = sw.dataset.id;
                    const nombre = sw.dataset.nombre;
                    const status = sw.dataset.status;
                    const quiereEncender = sw.checked;

                    // Encender sin QR cargado no tiene sentido: se abre el selector.
                    if (quiereEncender && !status) {
                        sw.checked = false;
                        return abrirModal(id, nombre);
                    }

                    // Un QR comprometido no se vuelve a encender: hay que reemplazarlo.
                    if (quiereEncender && status === 'compromised') {
                        sw.checked = false;
                        await Swal.fire({
                            icon: 'warning',
                            title: 'QR comprometido',
                            text: 'Este QR fue deshabilitado automáticamente porque el archivo no coincide con el registrado. Sube uno nuevo para reemplazarlo.',
                            confirmButtonColor: '#EC5FA3'
                        });
                        return abrirModal(id, nombre);
                    }

                    try {
                        const r = await fetch(`/admin/bankentities/${id}/qr/toggle`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
                            body: JSON.stringify({ qrEnabled: quiereEncender })
                        });
                        const d = await r.json();
                        if (!d.success) throw new Error(d.mensaje || 'No se pudo actualizar.');
                    } catch (err) {
                        sw.checked = !quiereEncender; // revierte el switch si el backend rechazó
                        Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#EC5FA3' });
                    }
                });

                // ── Botón "Ver / cambiar QR" ──────────────────────────────────
                tabla.addEventListener('click', (e) => {
                    const btn = e.target.closest('.btn-qr-gestionar');
                    if (btn) abrirModal(btn.dataset.id, btn.dataset.nombre);
                });
            })();
