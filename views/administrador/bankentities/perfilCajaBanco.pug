extends ../../layout/index
block contenedor
    //- Formateo local de pesos. Los montos llegan como número desde el controlador de
    //- demostración; cuando esto se conecte, llegarán como DECIMAL (string) y este mismo
    //- helper sirve igual porque Number() maneja las dos formas.
    -
        var pesos = function (v) {
            var n = Number(v || 0);
            return (n < 0 ? '-$' : '$') + Math.abs(n).toLocaleString('es-CO', { maximumFractionDigits: 0 });
        };

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- ── VOLVER ────────────────────────────────────────────────
                            div(class="col-span-12")
                                a(href="/admin/bankentities/listado#cajas" class="inline-flex items-center gap-2 text-sm font-semibold text-purple-600 hover:text-gh-primaryHover transition-colors")
                                    i(class="fi fi-rr-arrow-left")
                                    | Volver a Cajas y bancos

                            //- ── ENCABEZADO DE LA CUENTA ───────────────────────────────
                            div(class="col-span-12 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex flex-wrap items-start justify-between gap-4")
                                div(class="flex items-start gap-4")
                                    div(class=`w-20 h-20 rounded-2xl flex items-center justify-center flex-shrink-0 ${cuenta.tipo === 'caja' ? 'bg-gh-primarySoft' : 'bg-blue-50'}`)
                                        img(src=cuenta.tipo === 'caja' ? '/img/avatars/cajaRegistradora.webp' : '/img/avatars/banco.webp' alt="" class="w-14 h-14 object-contain")
                                    div(class="flex flex-col gap-1.5")
                                        div(class="flex items-center gap-3 flex-wrap")
                                            h1(class="text-2xl font-bold text-slate-800")= tc(cuenta.nombreCajaBanco)
                                            if cuenta.estado
                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-emerald-100 text-emerald-600")
                                                    span(class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2")
                                                    | Activa
                                            else
                                                span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-slate-100 text-slate-500")
                                                    span(class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2")
                                                    | Inactiva
                                        p(class="text-sm text-slate-400")= cuenta.descripcion

                                        div(class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-1.5")
                                            div(class="flex items-center gap-1.5 text-sm")
                                                i(class="fi fi-rr-barcode text-slate-300")
                                                span(class="font-semibold text-slate-600") Referencia:
                                                span(class="font-mono text-slate-500")= cuenta.referencia || '—'
                                            div(class="flex items-center gap-1.5 text-sm")
                                                i(class="fi fi-rr-tags text-slate-300")
                                                span(class="font-semibold text-slate-600") Tipo:
                                                span(class="text-slate-500")= tc(cuenta.tipo)
                                            if cuenta.tienda
                                                div(class="flex items-center gap-1.5 text-sm")
                                                    i(class="fi fi-rr-shop text-slate-300")
                                                    span(class="font-semibold text-slate-600") Tienda:
                                                    span(class="text-slate-500")= tc(cuenta.tienda)

                                button#btn-editar(type="button" class="btn btn-secondary btn-sm text-xs whitespace-nowrap")
                                    i.fi-rr-edit.text-xs
                                    | Editar información

                            //- ── INDICADORES ──────────────────────────────────────────
                            //- El saldo sale de sumar los movimientos; los tres de la
                            //- derecha describen el mes en curso.
                            div(class="col-span-12 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4")

                                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex items-center justify-between gap-3")
                                    div
                                        p(class="text-xs text-slate-400 mb-1") Saldo actual
                                        p(class=`text-2xl font-bold ${resumen.saldo < 0 ? 'text-red-600' : 'text-slate-800'}`)= pesos(resumen.saldo)
                                    div(class="w-11 h-11 rounded-xl bg-purple-50 flex items-center justify-center flex-shrink-0")
                                        i(class="fi fi-rr-wallet text-purple-500")

                                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex items-center justify-between gap-3")
                                    div
                                        p(class="text-xs text-slate-400 mb-1") Ingresos del mes
                                        p(class="text-2xl font-bold text-slate-800")= pesos(resumen.ingresosMes)
                                    div(class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0")
                                        i(class="fi fi-rr-arrow-down text-emerald-500")

                                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex items-center justify-between gap-3")
                                    div
                                        p(class="text-xs text-slate-400 mb-1") Egresos del mes
                                        p(class="text-2xl font-bold text-slate-800")= pesos(resumen.egresosMes)
                                    div(class="w-11 h-11 rounded-xl bg-rose-50 flex items-center justify-center flex-shrink-0")
                                        i(class="fi fi-rr-arrow-up text-rose-500")

                                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex items-center justify-between gap-3")
                                    div
                                        p(class="text-xs text-slate-400 mb-1") Movimientos del mes
                                        p(class="text-2xl font-bold text-slate-800")= resumen.movimientosMes
                                    div(class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                                        i(class="fi fi-rr-receipt text-blue-500")

                            //- ── CUERPO: MOVIMIENTOS (65%) + REGISTRO (35%) ───────────
                            div(class="col-span-12 grid grid-cols-1 lg:grid-cols-[65fr_35fr] gap-4 items-start")

                                //- MOVIMIENTOS
                                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                    div(class="p-6 flex flex-wrap items-start justify-between gap-3")
                                        div
                                            h2(class="text-lg font-bold text-slate-800") Movimientos
                                            p(class="text-sm text-slate-400") Historial de ingresos y egresos de esta caja
                                        div(class="flex flex-wrap items-center gap-2")
                                            div(class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200 bg-white")
                                                i(class="fi fi-rr-calendar text-slate-400 text-xs")
                                                input#mov-desde(type="date" value=filtros.desde class="text-xs text-slate-600 bg-transparent focus:outline-none cursor-pointer")
                                                span(class="text-slate-300 text-xs") –
                                                input#mov-hasta(type="date" value=filtros.hasta class="text-xs text-slate-600 bg-transparent focus:outline-none cursor-pointer")
                                            select#mov-filtro-tipo(class="px-3 py-2 rounded-xl border border-slate-200 bg-white text-xs text-slate-600 focus:outline-none focus:ring-2 focus:ring-pink-300/40 cursor-pointer")
                                                option(value="") Todos los tipos
                                                option(value="ingreso") Ingresos
                                                option(value="egreso") Egresos
                                            button#mov-limpiar(type="button" class="hidden px-3 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-500 hover:bg-slate-50 transition-colors cursor-pointer") Limpiar
                                            button#btn-exportar(type="button" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer")
                                                i(class="fi fi-rr-download")
                                                | Exportar

                                    div(class="overflow-x-auto")
                                        table(class="w-full text-left border-collapse")
                                            thead
                                                tr(class="border-b border-gh-primaryHover text-sm")
                                                    th(class="px-4 py-3 text-gray-600 whitespace-nowrap") Fecha
                                                    th(class="px-3 py-3 text-center text-gray-600 whitespace-nowrap") Tipo
                                                    th(class="px-3 py-3 text-gray-600") Descripción
                                                    th(class="px-3 py-3 text-gray-600 whitespace-nowrap") Referencia
                                                    th(class="px-3 py-3 text-right text-gray-600 whitespace-nowrap") Valor
                                                    th(class="px-3 py-3 text-right text-gray-600 whitespace-nowrap") Saldo
                                                    th(class="px-3 py-3 text-gray-600 whitespace-nowrap") Usuario
                                                    th(class="px-4 py-3 text-center text-gray-600 whitespace-nowrap") Soporte

                                            tbody(class="divide-y divide-slate-100")
                                                //- ── TRASLADOS POR ACEPTAR ─────────────────────────
                                                //- Van fijos arriba y no mezclados en el libro: un traslado
                                                //- en tránsito TODAVÍA NO es un movimiento —no tiene
                                                //- idMovimiento y no entra en ningún saldo—, así que no
                                                //- puede ocupar una fila del libro ni mostrar saldo corrido.
                                                //- Se quedan arriba aunque se filtre por fecha o por tipo:
                                                //- son lo que espera una acción, no historia que se consulta.
                                                each t in (trasladosPendientes || [])
                                                    tr(
                                                        class="fila-traslado"
                                                        tabindex="0"
                                                        role="button"
                                                        aria-label=`Revisar traslado ${t.codigo} por ${pesos(t.valor)}`
                                                        data-traslado=JSON.stringify(t)
                                                    )
                                                        td(class="px-4 py-3 whitespace-nowrap")
                                                            p(class="text-sm font-semibold text-amber-900")= t.fecha
                                                            p(class="text-xs text-amber-700/70")= t.hora

                                                        td(class="px-3 py-3 text-center")
                                                            span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-amber-200 text-amber-900")
                                                                i(class="fi fi-rr-bell text-[10px]")
                                                                | Por aceptar

                                                        td(class="px-3 py-3")
                                                            p(class="text-sm font-bold text-amber-900 leading-tight")= `Traslado de efectivo desde ${tc(t.origen)}`
                                                            p(class="text-xs text-amber-700/80 mt-0.5")= `Despachado por ${tc(t.envia)}`

                                                        td(class="px-3 py-3 text-xs font-mono text-amber-800 whitespace-nowrap")
                                                            p= t.codigo
                                                            if t.referencia
                                                                p(class="text-amber-700/70")= t.referencia

                                                        td(class="px-3 py-3 text-right whitespace-nowrap")
                                                            span(class="text-sm font-bold text-amber-800")= '+' + pesos(t.valor)

                                                        //- Sin saldo: esta plata no entró a la cuenta todavía.
                                                        //- Un número acá sería decir que el saldo ya la incluye.
                                                        td(class="px-3 py-3 text-right text-sm text-amber-700/50") —

                                                        td(class="px-3 py-3 text-sm text-amber-800 whitespace-nowrap")= tc(t.envia)

                                                        td(class="px-4 py-3 text-center")
                                                            if t.adjuntos.length
                                                                span(class="inline-flex items-center gap-1 text-amber-800" title=`${t.adjuntos.length} comprobante(s)`)
                                                                    i(class="fi fi-rr-clip text-sm")
                                                                    span(class="text-xs font-semibold")= t.adjuntos.length
                                                            else
                                                                span(class="text-xs text-amber-700/40") —

                                                each mov in movimientos
                                                    tr(class="mov-fila border-b border-gray-100 hover:bg-gray-50 transition-colors" data-iso=mov.iso data-tipo=mov.tipo)
                                                        td(class="px-4 py-3 whitespace-nowrap")
                                                            p(class="text-sm font-semibold text-slate-700")= mov.fecha
                                                            p(class="text-xs text-slate-400")= mov.hora

                                                        td(class="px-3 py-3 text-center")
                                                            if mov.tipo === 'ingreso'
                                                                span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-emerald-100 text-emerald-700")
                                                                    i(class="fi fi-rr-arrow-down text-[10px]")
                                                                    | Ingreso
                                                            else
                                                                span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-rose-100 text-rose-700")
                                                                    i(class="fi fi-rr-arrow-up text-[10px]")
                                                                    | Egreso

                                                        td(class="px-3 py-3")
                                                            //- `tc` solo cambia cómo se ve: en la base queda lo que
                                                            //- escribió el operador. Sin esto, un "INGRESO SALDO
                                                            //- INICIAL" grita en medio de la tabla.
                                                            p(class="text-sm font-bold text-slate-800 leading-tight")= tc(mov.descripcion)

                                                        td(class="px-3 py-3 text-xs font-mono text-slate-500 whitespace-nowrap")= mov.referencia || '—'

                                                        td(class="px-3 py-3 text-right whitespace-nowrap")
                                                            if mov.tipo === 'ingreso'
                                                                span(class="text-sm font-bold text-emerald-600")= pesos(mov.valor)
                                                            else
                                                                span(class="text-sm font-bold text-rose-600")= '-' + pesos(mov.valor)

                                                        //- Saldo corrido después de este movimiento.
                                                        td(class=`px-3 py-3 text-right text-sm font-semibold whitespace-nowrap ${mov.saldo < 0 ? 'text-red-600' : 'text-slate-700'}`)= pesos(mov.saldo)

                                                        td(class="px-3 py-3 text-sm text-slate-500 whitespace-nowrap")= tc(mov.usuario)

                                                        //- Comprobantes del movimiento. Sin adjuntos no hay botón: un
                                                        //- botón que abre una lista vacía no dice nada.
                                                        td(class="px-4 py-3 text-center")
                                                            if mov.adjuntos.length
                                                                button(
                                                                    type="button"
                                                                    class="btn-mov-adjuntos inline-flex items-center gap-1 px-2 py-1 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-gh-primaryHover transition-colors cursor-pointer"
                                                                    title=`${mov.adjuntos.length} comprobante(s)`
                                                                    data-adjuntos=JSON.stringify(mov.adjuntos)
                                                                )
                                                                    i(class="fi fi-rr-clip text-sm")
                                                                    span(class="text-xs font-semibold")= mov.adjuntos.length
                                                            else
                                                                span(class="text-xs text-slate-300") —

                                                tr#mov-vacio(class="hidden")
                                                    td(colspan="8" class="px-4 py-10 text-center")
                                                        i(class="fi fi-rr-inbox text-2xl text-slate-300")
                                                        p(class="text-sm text-slate-400 mt-2") Ningún movimiento en ese rango

                                    div(class="px-6 py-4 bg-slate-50/30 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3")
                                        p#mov-contador(class="text-xs text-slate-400")= `Mostrando ${movimientos.length} movimiento${movimientos.length === 1 ? '' : 's'}`
                                        //- Paginación por cursor: no hay números de página porque no se
                                        //- conoce el total sin contarlo, y contar una tabla que crece sin
                                        //- techo cuesta más que traer la página.
                                        button#mov-cargar-mas(
                                            type="button"
                                            data-cursor=cursorSiguiente || ''
                                            class=`px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer ${cursorSiguiente ? '' : 'hidden'}`
                                        ) Cargar más

                                //- REGISTRAR MOVIMIENTO
                                //- El resplandor del borde sigue al tipo elegido: verde para
                                //- ingreso, rojo para egreso. Es la señal de qué se va a
                                //- registrar, visible sin leer los botones.
                                //- El saldo y el nombre de la cuenta viajan al cliente porque la
                                //- confirmación muestra contra qué cuenta se va a asentar y en
                                //- cuánto queda: con varias cajas abiertas en pestañas, equivocarse
                                //- de cuenta es el error fácil de cometer y difícil de deshacer.
                                div#card-movimiento(
                                    class=`bg-white rounded-2xl p-6 border transition-all duration-300 ${cuenta.estado ? '' : 'gh-card-bloqueada'}`
                                    data-saldo=resumen.saldo
                                    data-cuenta=cuenta.nombreCajaBanco
                                    data-referencia=cuenta.referencia || ''
                                    data-tipo-cuenta=cuenta.tipo
                                    data-cajas=JSON.stringify(cajasDestino || [])
                                    data-activa=cuenta.estado ? '1' : '0'
                                )
                                    //- ── CUENTA INACTIVA ───────────────────────────────
                                    //- El cristal tapa el formulario, pero lo que de verdad lo
                                    //- inhabilita es `inert`: sin eso los campos se siguen
                                    //- alcanzando con el tabulador y se puede escribir a ciegas
                                    //- detrás del velo. Y aun así, la garantía está en el
                                    //- servidor, que rechaza el movimiento con 422.
                                    if !cuenta.estado
                                        div(class="gh-bloqueo")
                                            div(class="gh-bloqueo-panel")
                                                div(class="gh-bloqueo-icono")
                                                    i(class="fi fi-rr-lock")
                                                p(class="gh-bloqueo-titulo")= `${cuenta.tipo === 'caja' ? 'Caja' : 'Cuenta'} inactiva`
                                                p(class="gh-bloqueo-texto") No se pueden registrar ingresos ni egresos hasta que se active.
                                                p(class="gh-bloqueo-pista")
                                                    i(class="fi fi-rr-edit")
                                                    | Activala desde "Editar información".

                                    h2(class="text-lg font-bold text-slate-800") Registrar movimiento
                                    p(class="text-sm text-slate-400 mb-5") Ingresa un nuevo ingreso o egreso

                                    form#form-movimiento(class="space-y-4" inert=!cuenta.estado)
                                        input(type="hidden" name="_csrf" value=csrfToken)

                                        //- Ingreso o egreso: define el sentido del movimiento.
                                        div(class="grid grid-cols-2 gap-2")
                                            label(class="cursor-pointer")
                                                input#mov-tipo-ingreso(type="radio" name="mov-tipo" value="ingreso" checked class="peer sr-only")
                                                div(class="flex items-center justify-center gap-2 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-sm font-semibold transition-all peer-checked:border-emerald-400 peer-checked:bg-emerald-50 peer-checked:text-emerald-700")
                                                    i(class="fi fi-rr-arrow-down")
                                                    | Ingreso
                                            label(class="cursor-pointer")
                                                input#mov-tipo-egreso(type="radio" name="mov-tipo" value="egreso" class="peer sr-only")
                                                div(class="flex items-center justify-center gap-2 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-sm font-semibold transition-all peer-checked:border-rose-400 peer-checked:bg-rose-50 peer-checked:text-rose-700")
                                                    i(class="fi fi-rr-arrow-up")
                                                    | Egreso

                                        div(class="space-y-1")
                                            label(for="mov-fecha" class="text-xs font-bold text-slate-500 block") Fecha del movimiento
                                            //- `max` evita fechas futuras desde el navegador; el servidor las rechaza
                                            //- igual, porque un movimiento adelantado descuadra el saldo corrido.
                                            input#mov-fecha(type="datetime-local" name="fecha" value=filtros.ahora max=filtros.ahora required class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors")
                                            p(class="text-[10px] text-slate-400") Cuándo ocurrió, no cuándo se registra.

                                        div(class="space-y-1")
                                            label(for="mov-descripcion" class="text-xs font-bold text-slate-500 block") Descripción *
                                            input#mov-descripcion(type="text" name="descripcion" placeholder="Ej: Venta mostrador, Pago proveedor..." maxlength="150" required autocomplete="off" class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors")

                                        div(class="space-y-1")
                                            label(for="mov-monto" class="text-xs font-bold text-slate-500 block") Monto
                                            div(class="relative")
                                                span(class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-sm pointer-events-none") $
                                                input#mov-monto(type="text" name="valor" placeholder="0" inputmode="numeric" autocomplete="off" class="w-full pl-8 pr-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-mono text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors")

                                        div(class="space-y-1")
                                            label(for="mov-referencia" class="text-xs font-bold text-slate-500 block")
                                                | Referencia
                                                span(class="font-normal text-slate-400")  (opcional)
                                            input#mov-referencia(type="text" placeholder="Ej: FAC-1258, REC-003..." maxlength="50" autocomplete="off" class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors")

                                        div(class="space-y-1")
                                            label(class="text-xs font-bold text-slate-500 block")
                                                | Comprobante
                                                span(class="font-normal text-slate-400")  (opcional)
                                            label(for="mov-comprobantes" class="w-full inline-flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer")
                                                i(class="fi fi-rr-cloud-upload")
                                                | Subir archivos
                                            input#mov-comprobantes(type="file" name="comprobantes" multiple accept="image/jpeg,image/png,image/webp,application/pdf" class="hidden")
                                            p(class="text-[10px] text-slate-400") PDF, JPG o PNG. Máx. 5MB cada uno, hasta 10 archivos.
                                            //- Lista de lo seleccionado: sin esto no hay forma de saber qué se va a subir.
                                            ul#mov-lista-archivos(class="hidden flex flex-col gap-1 pt-1")

                                        button#btn-guardar-movimiento(type="button" class="w-full py-3 rounded-2xl font-bold text-sm text-white bg-gh-primary hover:bg-gh-primaryHover transition-colors cursor-pointer") Guardar movimiento

        //- La hoja de la ventana de confirmación vive aparte: la comparten esta
        //- pantalla y la de egresos de tienda.
        include ../../components/modalConfirmacion

        //- Lo que sigue es solo de esta pantalla: el formulario de edición que va
        //- dentro de la ventana y el cristal que sella una cuenta inactiva.
        style.

            /* ── Formulario de edición ─────────────────────────────────────── */
            .gh-form        { padding: 1.25rem 1.75rem 0; display: flex; flex-direction: column; gap: 1rem; }
            .gh-form-campo  { display: flex; flex-direction: column; gap: 0.375rem; }
            .gh-form-label  { font-size: 0.6875rem; font-weight: 700; color: #64748B; }
            .gh-form-label span { font-weight: 400; color: #94A3B8; }
            .gh-form-input {
                width: 100%; padding: 0.625rem 0.75rem;
                border: 1px solid #E2E8F0; border-radius: var(--radius-gh, 12px);
                font-size: 0.875rem; color: #1E293B; background: #fff;
                transition: border-color .15s ease, box-shadow .15s ease;
            }
            .gh-form-input:focus {
                outline: none; border-color: var(--color-gh-primary, #F794C9);
                box-shadow: 0 0 0 3px rgb(247 148 201 / 0.28);
            }
            .gh-form-input::placeholder { color: #94A3B8; }
            .gh-form-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

            /* Segmentado: mismo gesto que el selector de ingreso/egreso del formulario
               de registro, para que la pantalla no tenga dos vocabularios de control. */
            .gh-form-seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.5rem; }
            .gh-form-seg input { position: absolute; opacity: 0; pointer-events: none; }
            .gh-form-seg label { cursor: pointer; }
            .gh-form-seg span {
                display: flex; align-items: center; justify-content: center; gap: 0.375rem;
                padding: 0.5rem 0.5rem; border-radius: var(--radius-gh, 12px);
                border: 1px solid #E2E8F0; background: #F8FAFC; color: #64748B;
                font-size: 0.8125rem; font-weight: 600;
                transition: border-color .15s ease, background-color .15s ease, color .15s ease;
            }
            .gh-form-seg input:checked + span { border-color: #A7F3D0; background: #ECFDF5; color: #047857; }
            .gh-form-seg input:focus-visible + span { outline: 2px solid var(--color-gh-primaryHover, #E24C95); outline-offset: 2px; }
            /* "Inactiva" toma el rosa/rojo con el que esta pantalla marca lo que resta o
               frena: el egreso, el saldo en negativo. Dejar la cuenta inactiva le corta los
               movimientos nuevos, así que se ve como lo que es y no como un gris más.
               Mismos tonos que el selector de egreso; #9F1239 sobre #FFF1F2 da 7.3:1. */
            .gh-form-seg input.gh-seg-apagar:checked + span { border-color: #FECDD3; background: #FFF1F2; color: #9F1239; }
            .gh-form-seg input.gh-seg-marca:checked  + span { border-color: var(--color-gh-primary, #F794C9); background: var(--color-gh-primarySoft, #FDE7F2); color: #C43B7E; }

            /* Aviso de campos sellados por el historial. */
            .gh-form-sellado {
                display: flex; gap: 0.625rem; align-items: flex-start;
                padding: 0.75rem 0.875rem; border-radius: var(--radius-gh, 12px);
                background: #F8FAFC; border: 1px solid #E2E8F0;
                font-size: 0.75rem; line-height: 1.45; color: #475569;
            }
            .gh-form-sellado i { color: #94A3B8; font-size: 0.875rem; flex-shrink: 0; margin-top: 0.0625rem; }
            .gh-form-sellado b { color: #1E293B; }
            /* ── CUENTA INACTIVA: FORMULARIO SELLADO ───────────────────────── */
            .gh-card-bloqueada { position: relative; overflow: hidden; }

            .gh-bloqueo {
                position: absolute; inset: 0; z-index: 5;
                display: flex; align-items: center; justify-content: center;
                padding: 1.5rem;
                /* Vidrio: el desenfoque es fuerte pero el tinte deja pasar la forma del
                   formulario, así se ve QUÉ está sellado y no solo que hay algo detrás.
                   El degradado en diagonal imita cómo la luz cae sobre un panel real; un
                   tinte plano se lee como un velo gris. */
                background: linear-gradient(148deg, rgb(255 255 255 / 0.58) 0%, rgb(241 245 249 / 0.40) 55%, rgb(255 255 255 / 0.52) 100%);
                backdrop-filter: blur(14px) saturate(150%);
                -webkit-backdrop-filter: blur(14px) saturate(150%);
                /* El filo claro del borde superior es lo que hace leer la capa como vidrio
                   y no como opacidad: es el reflejo del canto. */
                box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.85),
                            inset 0 0 0 1px rgb(255 255 255 / 0.45);
            }

            /* Sin backdrop-filter (navegadores viejos) el tinte translúcido dejaría el
               formulario legible detrás. Ahí se cae a un velo casi sólido: se pierde el
               efecto, no la función. */
            @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
                .gh-bloqueo { background: rgb(248 250 252 / 0.96); }
            }
            .gh-bloqueo-panel {
                max-width: 17rem; text-align: center;
                display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
            }
            .gh-bloqueo-icono {
                width: 3.25rem; height: 3.25rem; margin-bottom: 0.25rem;
                border-radius: 999px; display: grid; place-items: center;
                background: #FFF1F2; border: 1px solid #FECDD3; color: #9F1239;
                font-size: 1.125rem;
                box-shadow: 0 6px 16px -8px rgb(159 18 57 / 0.35);
            }
            .gh-bloqueo-titulo { font-size: 1rem; font-weight: 700; color: #1E293B; margin: 0; }
            .gh-bloqueo-texto  { font-size: 0.8125rem; line-height: 1.5; color: #475569; margin: 0; }
            .gh-bloqueo-pista {
                display: inline-flex; align-items: center; gap: 0.375rem;
                margin: 0.375rem 0 0; padding: 0.375rem 0.625rem;
                border-radius: 999px; background: #F1F5F9;
                font-size: 0.6875rem; font-weight: 600; color: #64748B;
            }

            .gh-form-error {
                margin: 0 1.75rem; padding: 0.625rem 0.75rem;
                border-radius: var(--radius-gh, 12px);
                background: #FFF1F2; border: 1px solid #FECDD3;
                font-size: 0.75rem; color: #9F1239;
            }


            /* ── TRASLADOS POR ACEPTAR ─────────────────────────────────────── */
            /* Ámbar en toda la fila, no solo en el badge: no es una fila más del libro,
               es plata que todavía no entró a la cuenta. El mismo ámbar con el que el
               resto del sistema marca los traslados. */
            .fila-traslado {
                background: #FFFBEB;
                border-bottom: 1px solid #FDE68A;
                cursor: pointer;
                transition: background-color .15s ease;
            }
            .fila-traslado:hover { background: #FEF3C7; }
            .fila-traslado:focus-visible {
                outline: 2px solid #B45309;
                outline-offset: -2px;
            }
            /* Corte visible entre lo que espera acción y el libro que ya está asentado. */
            .fila-traslado:last-of-type { border-bottom: 2px solid #FCD34D; }

            /* ── VENTANA DE ACEPTACIÓN ─────────────────────────────────────── */
            .gh-tras-cuerpo { padding: 1.25rem 1.75rem 0; text-align: left; }

            /* El valor es lo que hay que releer antes de aceptar, así que ocupa el lugar
               que ocupa. Nace deshabilitado: lo normal es aceptar exactamente lo que
               mandaron, y editarlo es declarar una diferencia. */
            .gh-tras-campo-valor { position: relative; }
            .gh-tras-valor {
                width: 100%;
                padding: 0.875rem 1rem 0.875rem 2.25rem;
                border: 2px solid #E2E8F0;
                border-radius: var(--radius-gh, 12px);
                background: #F8FAFC;
                color: #1E293B;
                font-size: 1.75rem;
                font-weight: 700;
                letter-spacing: -0.02em;
                font-variant-numeric: tabular-nums;
                transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
            }
            /* `readonly` y no `disabled`: un control deshabilitado no despacha eventos de
               mouse, así que el doble clic que lo habilita nunca llegaría. De paso el
               valor se puede seleccionar y copiar. */
            .gh-tras-valor:read-only {
                cursor: pointer;   /* invita al doble clic; no es un campo muerto */
                color: #334155;
            }
            .gh-tras-valor:not(:read-only) {
                background: #fff;
                border-color: #F59E0B;
                box-shadow: 0 0 0 3px rgb(245 158 11 / 0.18);
            }
            .gh-tras-peso {
                position: absolute; left: 0.875rem; top: 50%; transform: translateY(-50%);
                font-size: 1.25rem; font-weight: 700; color: #94A3B8; pointer-events: none;
            }

            .gh-tras-pista {
                display: flex; align-items: center; gap: 0.375rem;
                margin-top: 0.375rem; font-size: 0.6875rem; color: #64748B;
            }
            .gh-tras-pista i { font-size: 0.75rem; }
            /* Cuando el valor quedó editable el aviso cambia de tono: ya no explica cómo
               abrirlo, advierte que se va a asentar una diferencia. */
            .gh-tras-pista--activa { color: #B45309; font-weight: 600; }

            /* La diferencia va en rojo lleno y centrada: es lo único de esta ventana que
               dice que algo no cuadra, y en ámbar sobre ámbar se perdía contra la
               cabecera. Blanco sobre #BE123C da 6.5:1, bien por encima del piso.
               El rojo es el mismo con el que el resto del sistema marca lo que sale. */
            .gh-tras-dif {
                margin-top: 0.5rem; padding: 0.5rem 0.75rem;
                border-radius: var(--radius-gh, 12px);
                background: #BE123C;
                font-size: 0.8125rem; font-weight: 600; color: #fff;
                text-align: center;
            }
            /* El monto se separa del resto por peso, no por color: sobre rojo, cualquier
               otro color pierde contraste. */
            .gh-tras-dif b { font-weight: 800; }

            /* Redirigir el traslado a otra caja. El botón es discreto a propósito: la
               acción esperada es aceptar donde lo mandaron, y esto es la excepción. */
            .gh-tras-cambiar {
                margin-left: 0.5rem;
                padding: 0.0625rem 0.375rem;
                border: 1px solid #E2E8F0; border-radius: 999px;
                background: #fff; color: #64748B;
                font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
                cursor: pointer;
                transition: background-color .15s ease, border-color .15s ease, color .15s ease;
            }
            .gh-tras-cambiar:hover { background: #F1F5F9; border-color: #CBD5E1; color: #334155; }
            .gh-tras-cambiar:focus-visible { outline: 2px solid var(--color-gh-primaryHover, #E24C95); outline-offset: 2px; }

            .gh-tras-select {
                width: 100%;
                padding: 0.4375rem 0.625rem;
                border: 1px solid #F59E0B; border-radius: 0.625rem;
                background: #fff; color: #1E293B; font-size: 0.8125rem;
            }
            .gh-tras-select:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgb(245 158 11 / 0.18);
            }

            /* Mismo tratamiento que el aviso de diferencia de monto: es el otro modo en
               que lo asentado deja de coincidir con lo que se envió. */
            .gh-tras-redirige {
                margin-top: 0.375rem; padding: 0.4375rem 0.625rem;
                border-radius: 0.625rem;
                background: #FFFBEB; border: 1px solid #FDE68A;
                font-size: 0.75rem; color: #92400E;
            }

            .gh-tras-emp {
                width: 100%; margin-top: 0.25rem;
                padding: 0.625rem 0.75rem;
                border: 1px solid #E2E8F0; border-radius: var(--radius-gh, 12px);
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.9375rem; letter-spacing: 0.25em; text-transform: uppercase;
                color: #1E293B; background: #fff;
            }
            .gh-tras-emp:focus {
                outline: none; border-color: var(--color-gh-primary, #F794C9);
                box-shadow: 0 0 0 3px rgb(247 148 201 / 0.25);
            }

            .gh-tras-emp-estado {
                min-height: 1rem; margin-top: 0.25rem;
                font-size: 0.6875rem; font-weight: 600; color: #64748B;
            }
            .gh-tras-emp-ok  { color: #047857; }
            .gh-tras-emp-mal { color: #BE123C; }

            /* Un botón apagado tiene que verse apagado: si solo deja de responder, el
               operador cree que la pantalla se colgó. */
            .gh-tras-btn:disabled {
                opacity: 0.45;
                cursor: not-allowed;
            }
            .gh-tras-aceptar:disabled:hover  { background: #047857; }
            .gh-tras-rechazar:disabled:hover { background: #fff; border-color: #FECDD3; }

            .gh-tras-error {
                margin-top: 0.5rem; padding: 0.5rem 0.75rem;
                border-radius: var(--radius-gh, 12px);
                background: #FFF1F2; border: 1px solid #FECDD3;
                font-size: 0.75rem; font-weight: 600; color: #9F1239;
            }

            .gh-tras-obs {
                width: 100%; margin-top: 0.25rem;
                padding: 0.625rem 0.75rem;
                border: 1px solid #E2E8F0; border-radius: var(--radius-gh, 12px);
                font-size: 0.8125rem; color: #1E293B; background: #fff;
                resize: vertical; min-height: 4.5rem;
            }
            .gh-tras-obs:focus {
                outline: none; border-color: var(--color-gh-primary, #F794C9);
                box-shadow: 0 0 0 3px rgb(247 148 201 / 0.25);
            }

            .gh-tras-rotulo {
                display: block; margin: 1rem 0 0.375rem;
                font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em;
                text-transform: uppercase; color: #64748B;
            }
            .gh-tras-rotulo span { font-weight: 400; text-transform: none; letter-spacing: 0; color: #94A3B8; }

            .gh-tras-adjuntos { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.25rem; }
            .gh-tras-adjunto {
                display: inline-flex; align-items: center; gap: 0.375rem;
                padding: 0.3125rem 0.625rem; border-radius: var(--radius-gh, 12px);
                background: #F8FAFC; border: 1px solid #E2E8F0;
                font-size: 0.75rem; font-weight: 600; color: #475569;
                text-decoration: none;
            }
            .gh-tras-adjunto:hover { background: #F1F5F9; border-color: #CBD5E1; }

            /* Aceptar es la acción esperada y va en verde —entra plata—; rechazar es la
               excepción y va en contorno, no en rojo lleno: rechazar no es destruir, es
               devolver, y un botón rojo al lado de uno verde empuja a leer la pantalla
               como una alarma. */
            .gh-tras-acciones {
                display: flex; gap: 0.625rem; padding: 1.25rem 1.75rem 1.75rem; margin: 0;
            }
            .gh-tras-btn {
                flex: 1; padding: 0.75rem 1rem; border-radius: var(--radius-gh, 12px);
                font-size: 0.875rem; font-weight: 700; cursor: pointer;
                border: 1px solid transparent; margin: 0;
                display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
                transition: background-color .15s ease, border-color .15s ease, color .15s ease;
            }
            .gh-tras-btn:focus-visible { outline: 2px solid var(--color-gh-primaryHover, #E24C95); outline-offset: 2px; }
            .gh-tras-aceptar { background: #047857; color: #fff; }
            .gh-tras-aceptar:hover { background: #065F46; }
            .gh-tras-rechazar { background: #fff; border-color: #FECDD3; color: #9F1239; }
            .gh-tras-rechazar:hover { background: #FFF1F2; border-color: #FDA4AF; }

            @media (max-width: 480px) {
                .gh-tras-cuerpo  { padding: 1rem 1.25rem 0; }
                .gh-tras-acciones { padding: 1.125rem 1.25rem 1.25rem; flex-direction: column-reverse; }
                .gh-tras-btn     { width: 100%; }
                .gh-tras-valor   { font-size: 1.5rem; }
            }

            /* Solo los dos campos del formulario de edición: el resto de lo que
               cambia en pantalla chica va en la hoja compartida. */
            @media (max-width: 480px) {
                .gh-form       { padding: 1rem 1.25rem 0; }
                .gh-form-error { margin: 0 1.25rem; }
            }

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        //- window.initMoneyInput / window.parseMoney: el mismo formateo de miles que usan
        //- el POS, egresos y cuadre de caja. No se reimplementa acá.
        script(src="/js/helpers.js")
        script.
            (function () {
                const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
                const idCuenta = location.pathname.split('/').pop();
                const pesos = (n) => (n < 0 ? '-$' : '$') + Math.abs(Number(n) || 0).toLocaleString('es-CO', { maximumFractionDigits: 0 });
                const esc = (t) => String(t ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

                // ── MONTO CON SEPARADOR DE MILES AL ESCRIBIR ──────────────
                // initMoneyInput (helpers.js) formatea en cada tecla y recoloca el cursor:
                // sin ese ajuste, insertar un punto lo empuja al final y escribir se
                // vuelve imposible. Es el mismo campo de dinero del resto del panel.
                const monto = document.getElementById('mov-monto');
                window.initMoneyInput(monto);

                // ── RESPLANDOR SEGÚN EL TIPO ──────────────────────────────
                const card = document.getElementById('card-movimiento');
                const INGRESO = ['border-emerald-300', 'ring-2', 'ring-emerald-100', 'shadow-lg', 'shadow-emerald-500/20'];
                const EGRESO  = ['border-rose-300',    'ring-2', 'ring-rose-100',    'shadow-lg', 'shadow-rose-500/20'];
                const esEgreso = () => document.getElementById('mov-tipo-egreso')?.checked;
                const pintarTipo = () => {
                    card.classList.remove(...INGRESO, ...EGRESO);
                    card.classList.add(...(esEgreso() ? EGRESO : INGRESO));
                };
                document.querySelectorAll('input[name="mov-tipo"]').forEach(r => r.addEventListener('change', pintarTipo));
                pintarTipo();

                // ── ARCHIVOS SELECCIONADOS ────────────────────────────────
                const inputArchivos = document.getElementById('mov-comprobantes');
                const listaArchivos = document.getElementById('mov-lista-archivos');
                inputArchivos?.addEventListener('change', () => {
                    const files = [...(inputArchivos.files || [])];
                    listaArchivos.classList.toggle('hidden', !files.length);
                    listaArchivos.innerHTML = files.map(f =>
                        `<li class="flex items-center gap-1.5 text-[11px] text-slate-500">
                            <i class="fi fi-rr-clip text-slate-300"></i>
                            <span class="truncate">${esc(f.name)}</span>
                            <span class="text-slate-300 whitespace-nowrap">${(f.size / 1024 / 1024).toFixed(1)} MB</span>
                         </li>`).join('');
                });

                // ── COMPROBANTES DE UN MOVIMIENTO ─────────────────────────
                // Delegado en el tbody: las filas que trae "Cargar más" nacen después de
                // este script y no habría dónde colgarles un listener propio.
                document.querySelector('tbody.divide-y')?.addEventListener('click', (ev) => {
                    const btn = ev.target.closest('.btn-mov-adjuntos');
                    if (!btn) return;

                    let adjuntos = [];
                    try { adjuntos = JSON.parse(btn.dataset.adjuntos || '[]'); } catch (_) { return; }
                    if (!adjuntos.length) return;

                    Swal.fire({
                        title: 'Comprobantes',
                        html: `<ul class="flex flex-col gap-2 text-left">${adjuntos.map(a => `
                            <li class="flex items-center gap-2 bg-slate-50 border border-slate-100 rounded-xl px-3 py-2.5">
                                <i class="fi ${window.iconoDoc(a.formato)} text-base flex-shrink-0 text-slate-500"></i>
                                <a href="${esc(a.url)}" target="_blank" rel="noopener"
                                   class="text-xs font-medium truncate flex-1 hover:underline" style="color:#EC5FA3">${esc(a.nombreDocumento)}</a>
                                <span class="text-[10px] text-slate-400 uppercase flex-shrink-0">${esc(a.formato)}</span>
                            </li>`).join('')}</ul>`,
                        confirmButtonColor: '#EC5FA3',
                        confirmButtonText: 'Cerrar'
                    });
                });

                // ── FILTROS ───────────────────────────────────────────────
                const desde  = document.getElementById('mov-desde');
                const hasta  = document.getElementById('mov-hasta');
                const tipoEl = document.getElementById('mov-filtro-tipo');
                const limpiar= document.getElementById('mov-limpiar');
                const vacio  = document.getElementById('mov-vacio');
                const contador = document.getElementById('mov-contador');
                const tbody  = document.querySelector('tbody.divide-y');
                const btnMas = document.getElementById('mov-cargar-mas');

                const params = () => {
                    const p = new URLSearchParams();
                    if (desde.value) p.set('desde', desde.value);
                    if (hasta.value) p.set('hasta', hasta.value);
                    if (tipoEl.value) p.set('tipo', tipoEl.value);
                    return p;
                };

                const filaHTML = (m) => `
                    <tr class="mov-fila border-b border-gray-100 hover:bg-gray-50 transition-colors" data-iso="${m.iso}" data-tipo="${m.tipo}">
                        <td class="px-4 py-3 whitespace-nowrap">
                            <p class="text-sm font-semibold text-slate-700">${esc(m.fecha)}</p>
                            <p class="text-xs text-slate-400">${esc(m.hora)}</p>
                        </td>
                        <td class="px-3 py-3 text-center">
                            ${m.tipo === 'ingreso'
                                ? '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-emerald-100 text-emerald-700"><i class="fi fi-rr-arrow-down text-[10px]"></i>Ingreso</span>'
                                : '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-rose-100 text-rose-700"><i class="fi fi-rr-arrow-up text-[10px]"></i>Egreso</span>'}
                        </td>
                        <td class="px-3 py-3"><p class="text-sm font-bold text-slate-800 leading-tight">${esc(tc(m.descripcion))}</p></td>
                        <td class="px-3 py-3 text-xs font-mono text-slate-500 whitespace-nowrap">${esc(m.referencia || '—')}</td>
                        <td class="px-3 py-3 text-right whitespace-nowrap">
                            <span class="text-sm font-bold ${m.tipo === 'ingreso' ? 'text-emerald-600' : 'text-rose-600'}">${m.tipo === 'ingreso' ? pesos(m.valor) : '-' + pesos(m.valor)}</span>
                        </td>
                        <td class="px-3 py-3 text-right text-sm font-semibold whitespace-nowrap ${m.saldo < 0 ? 'text-red-600' : 'text-slate-700'}">${pesos(m.saldo)}</td>
                        <td class="px-3 py-3 text-sm text-slate-500 whitespace-nowrap">${esc(m.usuario)}</td>
                        <td class="px-4 py-3 text-center">
                            ${m.adjuntos && m.adjuntos.length
                                ? `<button type="button" class="btn-mov-adjuntos inline-flex items-center gap-1 px-2 py-1 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-gh-primaryHover transition-colors cursor-pointer" title="${m.adjuntos.length} comprobante(s)" data-adjuntos="${esc(JSON.stringify(m.adjuntos))}"><i class="fi fi-rr-clip text-sm"></i><span class="text-xs font-semibold">${m.adjuntos.length}</span></button>`
                                : '<span class="text-xs text-slate-300">—</span>'}
                        </td>
                    </tr>`;

                const actualizarPie = () => {
                    const n = document.querySelectorAll('.mov-fila').length;
                    vacio.classList.toggle('hidden', n > 0);
                    contador.textContent = n ? `Mostrando ${n} movimiento${n === 1 ? '' : 's'}` : 'Ningún movimiento en el rango seleccionado';
                    const filtrado = desde.value || hasta.value || tipoEl.value;
                    limpiar.classList.toggle('hidden', !filtrado);
                };

                // El filtro va al servidor: filtrar solo lo que está en pantalla escondería
                // los movimientos que todavía no se trajeron.
                const recargar = async () => {
                    const r = await fetch(`/admin/bankentities/cajas/${idCuenta}/movimientos?${params()}`);
                    const d = await r.json();
                    if (!d.success) return;
                    tbody.querySelectorAll('.mov-fila').forEach(f => f.remove());
                    vacio.insertAdjacentHTML('beforebegin', d.movimientos.map(filaHTML).join(''));
                    btnMas.dataset.cursor = d.cursorSiguiente || '';
                    btnMas.classList.toggle('hidden', !d.cursorSiguiente);
                    actualizarPie();
                };

                [desde, hasta, tipoEl].forEach(el => el?.addEventListener('change', recargar));
                limpiar?.addEventListener('click', () => { desde.value = ''; hasta.value = ''; tipoEl.value = ''; recargar(); });

                btnMas?.addEventListener('click', async () => {
                    const cursor = btnMas.dataset.cursor;
                    if (!cursor) return;
                    btnMas.disabled = true; btnMas.textContent = 'Cargando...';
                    try {
                        const p = params(); p.set('cursor', cursor);
                        const d = await (await fetch(`/admin/bankentities/cajas/${idCuenta}/movimientos?${p}`)).json();
                        if (d.success) {
                            vacio.insertAdjacentHTML('beforebegin', d.movimientos.map(filaHTML).join(''));
                            btnMas.dataset.cursor = d.cursorSiguiente || '';
                            btnMas.classList.toggle('hidden', !d.cursorSiguiente);
                            actualizarPie();
                        }
                    } finally { btnMas.disabled = false; btnMas.textContent = 'Cargar más'; }
                });


                // ── TRASLADO DE EFECTIVO: REVISIÓN ────────────────────────
                // La fila entera abre la ventana. Delegado en el tbody porque las filas
                // de traslado se repintan cuando llega uno nuevo por SSE, y un listener
                // por fila moriría con la fila.
                // A qué cuenta entra la plata. En un banco la referencia es el número de
                // cuenta, y sin él "Bancolombia" no alcanza cuando el negocio tiene más de
                // una: quien acepta necesita saber en cuál va a buscar el movimiento.
                const nombreCuentaActual = () => {
                    const nombre = esc(tc(card.dataset.cuenta || ''));
                    const ref    = (card.dataset.referencia || '').trim();
                    return ref
                        ? `${nombre} <span class="gh-conf-mono">${esc(ref)}</span>`
                        : nombre;
                };

                // Cajas a las que se puede redirigir. Solo hay lista si esta cuenta es una
                // caja: el servidor no la manda en otro caso.
                const cajasDestino = (() => {
                    try { return JSON.parse(card.dataset.cajas || '[]'); } catch (_) { return []; }
                })();
                const puedeRedirigir = card.dataset.tipoCuenta === 'caja' && cajasDestino.length > 0;

                // El destino se muestra como texto y solo se vuelve editable si alguien lo
                // pide: lo normal es aceptar la plata en la cuenta a la que la mandaron, y
                // redirigirla es la excepción. Un selector abierto de entrada invita a
                // tocar lo que casi siempre está bien.
                const destinoRotulo = () => {
                    if (!puedeRedirigir) return nombreCuentaActual();

                    const opciones = [
                        `<option value="">${esc(tc(card.dataset.cuenta || ''))} (como se envió)</option>`,
                        ...cajasDestino.map(c => `<option value="${esc(c.idCajaBanco)}">${esc(tc(c.nombreCajaBanco))}${c.referencia ? ` — ${esc(c.referencia)}` : ''}</option>`)
                    ].join('');

                    return `
                        <span id="tras-destino-texto">${nombreCuentaActual()}
                            <button type="button" id="tras-cambiar-destino" class="gh-tras-cambiar">Cambiar</button>
                        </span>
                        <select id="tras-destino" class="gh-tras-select" style="display:none">${opciones}</select>
                        <p id="tras-destino-aviso" class="gh-tras-redirige" style="display:none"></p>`;
                };

                const abrirTraslado = async (t) => {
                    const adjuntos = t.adjuntos.length
                        ? `<div class="gh-tras-adjuntos">${t.adjuntos.map(a => `
                               <a class="gh-tras-adjunto" href="${esc(a.url)}" target="_blank" rel="noopener">
                                   <i class="fi ${window.iconoDoc ? window.iconoDoc(a.formato) : 'fi-rr-document'}"></i>
                                   ${esc(a.nombreDocumento)}
                               </a>`).join('')}</div>`
                        : '<p class="text-xs text-slate-400">Sin comprobante adjunto</p>';

                    const fila = (etiqueta, valorHTML, vacio) =>
                        `<div class="gh-conf-fila"><dt>${etiqueta}</dt><dd class="${vacio ? 'gh-conf-vacio' : ''}">${valorHTML}</dd></div>`;

                    const { isConfirmed, isDenied, value } = await Swal.fire({
                        html: `
                            <div class="gh-conf-html">
                                <div class="gh-conf-cabecera">
                                    <span class="gh-conf-badge">
                                        <i class="fi fi-rr-exchange" style="font-size:.625rem"></i>Traslado por aceptar
                                    </span>
                                    <p class="gh-conf-monto">${pesos(t.valor)}</p>
                                    <p class="gh-conf-cuenta">llega desde <strong>${esc(tc(t.origen))}</strong></p>
                                </div>

                                <dl class="gh-conf-detalle">
                                    ${fila('Código', `<span class="gh-conf-mono">${esc(t.codigo)}</span>`)}
                                    ${t.referencia ? fila('Referencia', `<span class="gh-conf-mono">${esc(t.referencia)}</span>`) : ''}
                                    ${fila('Despachado', esc(`${t.fecha}, ${t.hora}`))}
                                    ${fila('Responsable', esc(tc(t.envia)) + (t.codigoEnvia ? ` <span class="gh-conf-mono">(${esc(t.codigoEnvia)})</span>` : ''))}
                                    ${fila('Entra a', destinoRotulo())}
                                    ${fila('Observación', t.observacion ? esc(t.observacion) : 'Sin observación', !t.observacion)}
                                </dl>

                                <div class="gh-tras-cuerpo">
                                    <label class="gh-tras-rotulo" for="tras-valor">
                                        Valor que se asienta
                                    </label>
                                    <div class="gh-tras-campo-valor">
                                        <span class="gh-tras-peso">$</span>
                                        <input id="tras-valor" class="gh-tras-valor" type="text" inputmode="numeric"
                                               autocomplete="off" readonly
                                               value="${Math.round(t.valor).toLocaleString('es-CO')}">
                                    </div>
                                    <p id="tras-pista" class="gh-tras-pista">
                                        <i class="fi fi-rr-lock"></i>
                                        <span>Doble clic para corregirlo si recibiste un monto distinto.</span>
                                    </p>
                                    <div id="tras-dif" class="gh-tras-dif" style="display:none"></div>

                                    <label class="gh-tras-rotulo" for="tras-obs">
                                        Observaciones <span>(opcional)</span>
                                    </label>
                                    <textarea id="tras-obs" class="gh-tras-obs" maxlength="500"
                                              placeholder="Qué se recibió, en qué condiciones, o el motivo del rechazo..."></textarea>

                                    <label class="gh-tras-rotulo">Comprobante del envío</label>
                                    ${adjuntos}

                                    <label class="gh-tras-rotulo" for="tras-emp">Código de empleado *</label>
                                    <input id="tras-emp" class="gh-tras-emp" type="password" maxlength="5"
                                           inputmode="numeric" autocomplete="one-time-code"
                                           placeholder="Ej: 00123">
                                    <p id="tras-emp-estado" class="gh-tras-emp-estado"></p>
                                    <p id="tras-error" class="gh-tras-error" style="display:none"></p>
                                </div>
                            </div>`,
                        // showDenyButton en vez de un cancel disfrazado: rechazar es una
                        // decisión, no salirse de la ventana. Cerrar con Esc o el fondo
                        // no decide nada, que es lo correcto para plata.
                        showConfirmButton: true,
                        showDenyButton: true,
                        confirmButtonText: '<i class="fi fi-rr-check"></i> Aceptar traslado',
                        denyButtonText: '<i class="fi fi-rr-cross-circle"></i> Rechazar',
                        buttonsStyling: false,
                        // El Enter no debe asentar plata de un teclazo.
                        focusConfirm: false,
                        reverseButtons: true,
                        width: '32rem',
                        customClass: {
                            popup:         'gh-conf-popup gh-conf--traslado',
                            htmlContainer: 'gh-conf-html-container',
                            actions:       'gh-tras-acciones',
                            confirmButton: 'gh-tras-btn gh-tras-aceptar',
                            denyButton:    'gh-tras-btn gh-tras-rechazar'
                        },
                        showClass: { popup: 'gh-conf-entra', backdrop: 'swal2-backdrop-show' },
                        didOpen: () => {
                            // Los dos botones nacen apagados. Aceptar y rechazar pasan por
                            // el MISMO endpoint y exigen el MISMO permiso de bancos, así
                            // que dejar rechazar encendido solo serviría para que el
                            // servidor devolviera 403 después de llenar el formulario.
                            const btnOk = Swal.getConfirmButton();
                            const btnNo = Swal.getDenyButton();
                            const estado = document.getElementById('tras-emp-estado');
                            const campoEmp = document.getElementById('tras-emp');

                            const habilitar = (puede) => {
                                btnOk.disabled = !puede;
                                btnNo.disabled = !puede;
                            };
                            habilitar(false);

                            // Se valida contra el servidor —código, empleado habilitado y
                            // permiso sobre Bancos— con la misma comprobación que después
                            // hace la ruta que asienta la plata. Acá es cortesía; la que
                            // manda es la del servidor.
                            let temporizador = null;
                            campoEmp.addEventListener('input', () => {
                                clearTimeout(temporizador);
                                habilitar(false);
                                estado.textContent = '';
                                estado.className = 'gh-tras-emp-estado';

                                const codigo = campoEmp.value.trim();
                                if (codigo.length < 3) return;

                                temporizador = setTimeout(async () => {
                                    try {
                                        const r = await fetch(`/admin/bankentities/empleado/validar/${encodeURIComponent(codigo.toUpperCase())}`);
                                        const d = await r.json();
                                        // El código pudo cambiar mientras viajaba la
                                        // consulta; si ya no es el mismo, la respuesta no
                                        // corresponde y se descarta.
                                        if (campoEmp.value.trim().toUpperCase() !== codigo.toUpperCase()) return;

                                        if (d.success) {
                                            estado.textContent = `✓ ${tc(d.nombre)} puede resolver traslados`;
                                            estado.className = 'gh-tras-emp-estado gh-tras-emp-ok';
                                            habilitar(true);
                                        } else {
                                            estado.textContent = d.mensaje || 'Código inválido.';
                                            estado.className = 'gh-tras-emp-estado gh-tras-emp-mal';
                                        }
                                    } catch (_) {
                                        estado.textContent = 'No se pudo verificar el código.';
                                        estado.className = 'gh-tras-emp-estado gh-tras-emp-mal';
                                    }
                                }, 400);
                            });

                            const btnDestino = document.getElementById('tras-cambiar-destino');
                            const selDestino = document.getElementById('tras-destino');
                            const avisoDest  = document.getElementById('tras-destino-aviso');

                            btnDestino?.addEventListener('click', () => {
                                document.getElementById('tras-destino-texto').style.display = 'none';
                                selDestino.style.display = 'block';
                                selDestino.focus();
                            });

                            selDestino?.addEventListener('change', () => {
                                const elegida = cajasDestino.find(c => c.idCajaBanco === selDestino.value);
                                if (!elegida) { avisoDest.style.display = 'none'; return; }
                                avisoDest.style.display = 'block';
                                avisoDest.innerHTML = `El traslado se asienta en <b>${esc(tc(elegida.nombreCajaBanco))}</b>, no en la cuenta a la que se envió. El cambio queda anotado en la bitácora.`;
                            });

                            const campo = document.getElementById('tras-valor');
                            const pista = document.getElementById('tras-pista');
                            const dif   = document.getElementById('tras-dif');

                            // Doble clic para habilitar. Aceptar lo que mandaron es lo
                            // normal; tocar el monto es declarar una diferencia, y por eso
                            // cuesta un gesto deliberado en vez de estar abierto de entrada.
                            campo.addEventListener('dblclick', () => {
                                if (!campo.readOnly) return;
                                campo.readOnly = false;
                                campo.focus();
                                campo.select();
                                pista.classList.add('gh-tras-pista--activa');
                                pista.innerHTML = '<i class="fi fi-rr-pencil"></i><span>Estás cambiando el monto: la diferencia queda anotada en la bitácora.</span>';
                            });

                            campo.addEventListener('input', () => {
                                const n = parseInt(campo.value.replace(/\D/g, ''), 10) || 0;
                                campo.value = n ? n.toLocaleString('es-CO') : '';
                                const delta = n - Math.round(t.valor);
                                if (!delta) { dif.style.display = 'none'; return; }
                                dif.style.display = 'block';

                                if (delta < 0 && t.destinoCaja) {
                                    dif.innerHTML = `Faltan <b>${pesos(-delta)}</b> respecto de lo despachado.`;
                                    return;
                                }

                                // Sobrante. Se dice qué va a hacer el sistema ANTES de
                                // confirmar: que entra en un movimiento aparte y que esa
                                // plata salió de la caja menor de la tienda. Enterarse
                                // después, viendo dos líneas en el libro, es peor.
                                // Cuenta bancaria: no hay conteo ni sobrante. El monto del
                                // comprobante es el único que existe, así que cambiarlo es
                                // corregir el registro del punto de venta. El techo lo pone
                                // el servidor —cuánto efectivo llegó a haber en ese cajón—,
                                // que es lo único que acá no se puede saber.
                                if (!t.destinoCaja) {
                                    dif.innerHTML = `El banco recibió <b>${pesos(n)}</b> y no los ${pesos(t.valor)} registrados. Se corrige el traslado y el egreso del punto de venta a ${pesos(n)}; el monto original queda en la bitácora.`;
                                    return;
                                }
                                if (n > t.maximo) {
                                    dif.innerHTML = t.baseTurno > 0
                                        ? `<b>${pesos(delta)}</b> de más superan la caja menor de ese turno (<b>${pesos(t.baseTurno)}</b>). Un sobrante mayor no salió del cajón: hay que registrarlo aparte.`
                                        : `Esa caja abrió sin caja menor, así que no hay de dónde pudiera salir un sobrante.`;
                                    return;
                                }
                                dif.innerHTML = `Llegaron <b>${pesos(delta)}</b> de más. Se registran en un <b>movimiento aparte</b> de esta cuenta; el traslado queda intacto en ${pesos(t.valor)}.`;
                            });
                        },
                        preConfirm: () => validarDecision(t, 'aceptar'),
                        preDeny:    () => validarDecision(t, 'rechazar')
                    });

                    if (!isConfirmed && !isDenied) return;
                    enviarDecision(t, isConfirmed ? 'aceptar' : 'rechazar', value);
                };

                // Lo que el operador dejó en la ventana, sin importar qué botón apretó.
                const leerDecision = () => ({
                    valor:       parseInt((document.getElementById('tras-valor').value || '').replace(/\D/g, ''), 10) || 0,
                    observacion: document.getElementById('tras-obs').value.trim(),
                    codigoEmpleado: document.getElementById('tras-emp').value.trim().toUpperCase(),
                    // Vacío = se asienta donde se envió. Solo lleva id cuando el operador
                    // eligió otra caja, así el backend distingue "no se tocó" de "se
                    // redirigió a la misma", que no son lo mismo en la bitácora.
                    idCajaBancoDestino: document.getElementById('tras-destino')?.value || null
                });

                // Validación en la ventana: devolver false la deja abierta con todo lo que
                // el operador ya escribió. `showValidationMessage` rompería el estilo.
                const validarDecision = (t, decision) => {
                    const aviso = document.getElementById('tras-error');
                    const fallar = (m) => { aviso.textContent = m; aviso.style.display = 'block'; return false; };
                    aviso.style.display = 'none';

                    const d = leerDecision();
                    if (!d.codigoEmpleado) return fallar('Ingresá tu código de empleado.');

                    if (decision === 'aceptar') {
                        if (d.valor <= 0) return fallar('El valor recibido debe ser mayor que cero. Si no recibiste nada, rechazá el traslado.');
                        // El techo es lo despachado MÁS la caja menor del turno. Un fajo
                        // armado desde ese cajón solo puede llevar de más lo que había
                        // ahí como fondo de cambio; por encima de eso es plata que nunca
                        // fue del negocio y meterla acá la vuelve un ingreso sin dueño.
                        // El servidor lo vuelve a verificar: esto es comodidad.
                        // En una cuenta bancaria el techo depende de cuánto efectivo llegó
                        // a haber en el cajón de ese turno, que solo el servidor sabe: acá
                        // no se limita y él responde con el motivo si no alcanza.
                        if (t.destinoCaja && d.valor > t.maximo)
                            return fallar(t.baseTurno > 0
                                ? `No podés registrar más de ${pesos(t.maximo)}: lo despachado (${pesos(t.valor)}) más la caja menor de ese turno (${pesos(t.baseTurno)}).`
                                : `Esa caja abrió sin caja menor: no podés registrar más de ${pesos(t.valor)}.`);
                    }
                    return d;
                };

                const enviarDecision = async (t, decision, datos) => {
                    Swal.fire({ title: 'Registrando...', didOpen: () => Swal.showLoading(), allowOutsideClick: false });
                    try {
                        const r = await fetch(`/admin/bankentities/traslados/${t.idTraslado}/decidir`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf, Accept: 'application/json' },
                            body: JSON.stringify({ decision, ...datos })
                        });
                        const d = await r.json();

                        if (!d.success) {
                            // El middleware del código de empleado cierra la sesión tras
                            // cinco intentos fallidos; ahí no hay nada que reintentar.
                            if (d.logout) { window.location.href = '/'; return; }
                            return Swal.fire({ icon: 'error', title: 'No se pudo registrar', text: d.mensaje || 'Intentá de nuevo.', confirmButtonColor: '#EC5FA3' });
                        }

                        // El comprobante con el estado final se abre solo.
                        window.open(d.pdf, '_blank', 'noopener');

                        const titulo = d.corregido > 0
                            ? 'Consignación corregida'
                            : ({ Recibido: 'Traslado aceptado', Controversia: 'Traslado en controversia', Rechazado: 'Traslado rechazado' }[d.estado] || 'Traslado resuelto');
                        // Los tres desenlaces dicen cosas distintas y el operador tiene
                        // que poder distinguirlos de un vistazo. En la controversia lo
                        // importante es que la diferencia NO se pierde: vuelve a quedar a
                        // cargo del punto de venta, que la va a ver como faltante en su
                        // cuadre.
                        const cuerpo =
                            d.estado === 'Rechazado'   ? `No entró nada. <strong>${pesos(d.devuelto)}</strong> vuelven a quedar a cargo del punto de venta.`
                          : d.estado === 'Controversia' ? `Entraron <strong>${pesos(d.aceptado)}</strong> de <strong>${pesos(d.aceptado + d.devuelto)}</strong>. Los <strong>${pesos(d.devuelto)}</strong> restantes vuelven a quedar a cargo del punto de venta, que los verá como faltante en su cuadre.`
                          : d.corregido > 0
                              ? `El punto de venta había registrado <strong>${pesos(d.despachado)}</strong> y realmente se consignaron <strong>${pesos(d.corregido)}</strong>.<br><br>Se corrigió el traslado y el egreso de la tienda a ${pesos(d.corregido)}. El monto original queda en la bitácora y ya se le avisó al operador.`
                          : d.excedente > 0
                              // Se detallan las DOS líneas porque en el libro van a
                              // aparecer separadas, y quien las vea mañana tiene que
                              // reconocerlas como una sola operación.
                              ? `Entraron <strong>${pesos(d.aceptado + d.excedente)}</strong> en dos movimientos: <strong>${pesos(d.aceptado)}</strong> del traslado y <strong>${pesos(d.excedente)}</strong> de excedente.<br><br>El traslado queda intacto en ${pesos(d.aceptado)}. Los ${pesos(d.excedente)} de más salieron de la caja menor del punto de venta, que queda corta por ese monto hasta que la repongan; ya se le avisó al operador.`
                              : `Entraron <strong>${pesos(d.aceptado)}</strong> a esta cuenta.`;
                        // Si la caja del turno ya había cerrado, el egreso no se pudo
                        // ajustar y alguien tiene que hacerlo a mano. Callarlo dejaría un
                        // descuadre que nadie sabría explicar.
                        const extra = d.avisoCajaCerrada
                            ? '<br><br><b>La caja de ese turno ya estaba cerrada</b>, así que su cuadre no se modificó. Esa plata figura como salida y hay que ajustarla a mano.'
                            : '';

                        await Swal.fire({ icon: 'success', title: titulo, html: cuerpo + extra, confirmButtonColor: '#EC5FA3' });
                        location.reload();   // el traslado sale de la lista y el saldo cambió
                    } catch (_) {
                        Swal.fire({ icon: 'error', title: 'Error de red', text: 'No se pudo conectar con el servidor.', confirmButtonColor: '#EC5FA3' });
                    }
                };

                tbody?.addEventListener('click', (ev) => {
                    // Un clic sobre el enlace de un comprobante abre el comprobante, no la
                    // ventana: son dos intenciones distintas sobre la misma fila.
                    if (ev.target.closest('a, button')) return;
                    const fila = ev.target.closest('.fila-traslado');
                    if (fila) abrirTraslado(JSON.parse(fila.dataset.traslado));
                });

                // Teclado: la fila es un `role="button"`, así que tiene que responder
                // igual que uno.
                tbody?.addEventListener('keydown', (ev) => {
                    if (ev.key !== 'Enter' && ev.key !== ' ') return;
                    const fila = ev.target.closest('.fila-traslado');
                    if (!fila) return;
                    ev.preventDefault();
                    abrirTraslado(JSON.parse(fila.dataset.traslado));
                });

                // ── EXPORTAR A EXCEL ──────────────────────────────────────
                document.getElementById('btn-exportar')?.addEventListener('click', () => {
                    location.href = `/admin/bankentities/cajas/${idCuenta}/movimientos/export?${params()}`;
                });

                // ── CONFIRMAR ANTES DE ASENTAR ────────────────────────────
                // El libro es append-only: lo que se confirma acá no se puede editar ni
                // borrar después. Por eso la ventana no pregunta "¿estás seguro?" sino que
                // muestra el asiento tal como va a quedar —monto, cuenta y en cuánto queda
                // el saldo— para que se relea antes de escribirlo.
                // El monto de la cabecera lleva un signo menos tipográfico (−, U+2212), que
                // tiene el ancho de un dígito. `pesos` usa el guion del teclado, más corto:
                // los dos juntos en la misma ventana se ven desparejos.
                const pesosConf = (n) => pesos(n).replace('-', '−');

                const fechaLarga = (valorInput) => {
                    const d = new Date(valorInput);
                    if (isNaN(d)) return valorInput;
                    return d.toLocaleDateString('es-CO', { day: '2-digit', month: 'long', year: 'numeric' }) +
                           ', ' + d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
                };

                const confirmarMovimiento = async ({ tipo, valor, fecha, descripcion, referencia, comprobantes }) => {
                    const esIngreso = tipo === 'ingreso';
                    const saldoActual = Number(card.dataset.saldo) || 0;
                    const saldoFinal  = saldoActual + (esIngreso ? valor : -valor);

                    const fila = (etiqueta, valorHTML, vacio) =>
                        `<div class="gh-conf-fila"><dt>${etiqueta}</dt><dd class="${vacio ? 'gh-conf-vacio' : ''}">${valorHTML}</dd></div>`;

                    const soportes = comprobantes.length
                        ? `${comprobantes.length} archivo${comprobantes.length === 1 ? '' : 's'}: ${comprobantes.map(f => esc(f.name)).join(', ')}`
                        : 'Ninguno';

                    const { isConfirmed } = await Swal.fire({
                        html: `
                            <div class="gh-conf-html">
                                <div class="gh-conf-cabecera">
                                    <span class="gh-conf-badge">
                                        <i class="fi ${esIngreso ? 'fi-rr-arrow-down' : 'fi-rr-arrow-up'}" style="font-size:.625rem"></i>
                                        ${esIngreso ? 'Ingreso' : 'Egreso'}
                                    </span>
                                    <p class="gh-conf-monto">${esIngreso ? '+' : '−'} ${pesosConf(valor)}</p>
                                    <p class="gh-conf-cuenta">${esIngreso ? 'entra a' : 'sale de'} <strong>${esc(card.dataset.cuenta)}</strong></p>
                                </div>

                                <div class="gh-conf-saldo">
                                    <div class="gh-conf-saldo-bloque">
                                        <span class="gh-conf-saldo-label">Saldo actual</span>
                                        <span class="gh-conf-saldo-valor ${saldoActual < 0 ? 'gh-conf-negativo' : ''}">${pesosConf(saldoActual)}</span>
                                    </div>
                                    <i class="fi fi-rr-arrow-right gh-conf-flecha"></i>
                                    <div class="gh-conf-saldo-bloque gh-conf-saldo-bloque--final">
                                        <span class="gh-conf-saldo-label">Queda en</span>
                                        <span class="gh-conf-saldo-valor ${saldoFinal < 0 ? 'gh-conf-negativo' : ''}">${pesosConf(saldoFinal)}</span>
                                    </div>
                                </div>

                                <dl class="gh-conf-detalle">
                                    ${fila('Fecha', esc(fechaLarga(fecha)))}
                                    ${fila('Descripción', esc(descripcion))}
                                    ${fila('Referencia', referencia ? `<span class="gh-conf-mono">${esc(referencia)}</span>` : 'Sin referencia', !referencia)}
                                    ${fila('Comprobantes', soportes, !comprobantes.length)}
                                </dl>

                                <p class="gh-conf-aviso">
                                    <i class="fi fi-rr-lock"></i>
                                    <span>Una vez asentado no se puede editar ni eliminar. Para corregirlo habría que registrar un movimiento en sentido contrario.</span>
                                </p>
                            </div>`,
                        showCancelButton: true,
                        confirmButtonText: esIngreso ? 'Registrar ingreso' : 'Registrar egreso',
                        cancelButtonText: 'Volver',
                        // El Enter no debe asentar plata de un teclazo: el foco arranca en Volver.
                        focusCancel: true,
                        reverseButtons: true,
                        buttonsStyling: false,
                        width: '30rem',
                        customClass: {
                            popup:        `gh-conf-popup gh-conf--${tipo}`,
                            htmlContainer: 'gh-conf-html-container',
                            actions:      'gh-conf-acciones',
                            confirmButton: 'gh-conf-btn gh-conf-confirmar',
                            cancelButton:  'gh-conf-btn gh-conf-cancelar'
                        },
                        // Solo la entrada es propia. La salida la maneja SweetAlert2 con su `swal2-hide`:
                        // una clase de cierre propia que comparta @keyframes con la de entrada no
                        // dispara `animationend` y deja el contenedor tapando la página.
                        showClass: { popup: 'gh-conf-entra', backdrop: 'swal2-backdrop-show' }
                    });

                    return isConfirmed;
                };

                // ── GUARDAR MOVIMIENTO ────────────────────────────────────
                const btnGuardar = document.getElementById('btn-guardar-movimiento');
                btnGuardar?.addEventListener('click', async () => {
                    // Tercer cerrojo, después del cristal y de `inert`. Los tres son
                    // comodidad: el que manda es el servidor, que revalida el estado de la
                    // cuenta dentro de la transacción y devuelve 422 si está inactiva.
                    if (card.dataset.activa !== '1') {
                        return Swal.fire({
                            icon: 'warning', title: 'Cuenta inactiva',
                            text: 'No se pueden registrar movimientos hasta que se active.',
                            confirmButtonColor: '#EC5FA3'
                        });
                    }

                    const descripcion = document.getElementById('mov-descripcion').value.trim();
                    const fecha = document.getElementById('mov-fecha').value;
                    // parseMoney deshace el formato de miles: "1.250.000" → 1250000.
                    const valor = window.parseMoney(monto.value);

                    if (!fecha)
                        return Swal.fire({ icon: 'warning', title: 'Falta la fecha', text: 'Indicá cuándo ocurrió el movimiento.', confirmButtonColor: '#EC5FA3' });
                    if (valor <= 0)
                        return Swal.fire({ icon: 'warning', title: 'Falta el monto', text: 'Ingresá un valor mayor que cero.', confirmButtonColor: '#EC5FA3' });
                    if (!descripcion)
                        return Swal.fire({ icon: 'warning', title: 'Falta la descripción', text: 'Contá de qué se trata el movimiento.', confirmButtonColor: '#EC5FA3' });

                    const referencia = document.getElementById('mov-referencia').value.trim();
                    const comprobantes = [...(inputArchivos.files || [])];

                    if (!await confirmarMovimiento({ tipo: esEgreso() ? 'egreso' : 'ingreso', valor, fecha, descripcion, referencia, comprobantes })) return;

                    const fd = new FormData();
                    fd.append('tipo', esEgreso() ? 'egreso' : 'ingreso');
                    fd.append('fecha', fecha);
                    fd.append('valor', valor);
                    fd.append('descripcion', descripcion);
                    fd.append('referencia', referencia);
                    comprobantes.forEach(f => fd.append('comprobantes', f));

                    btnGuardar.disabled = true; btnGuardar.textContent = 'Guardando...';
                    try {
                        const r = await fetch(`/admin/bankentities/cajas/${idCuenta}/movimientos`, {
                            method: 'POST', headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }, body: fd
                        });
                        const d = await r.json();
                        if (!d.success) throw new Error(d.mensaje || 'No se pudo registrar.');

                        await Swal.fire({
                            icon: 'success', title: 'Movimiento registrado',
                            text: d.adjuntos.length ? `Se adjuntaron ${d.adjuntos.length} comprobante(s).` : 'Quedó asentado en el libro.',
                            confirmButtonColor: '#EC5FA3', timer: 2200, timerProgressBar: true
                        });
                        // Se recarga: el saldo de las tarjetas y el corrido de la tabla
                        // cambian con cada movimiento nuevo.
                        location.reload();
                    } catch (err) {
                        Swal.fire({ icon: 'error', title: 'No se pudo guardar', text: err.message, confirmButtonColor: '#EC5FA3' });
                    } finally {
                        btnGuardar.disabled = false; btnGuardar.textContent = 'Guardar movimiento';
                    }
                });

                // ── EDITAR LA CUENTA ──────────────────────────────────────
                // El nombre y el estado se pueden cambiar siempre. El tipo y la referencia
                // solo mientras la cuenta no tenga ni un movimiento: definen qué es la
                // cuenta y contra qué se concilia, y con historial adentro cambiarlas
                // reescribiría el significado de lo ya asentado.
                //
                // Ocultar los campos acá es comodidad, no seguridad: quién puede editarlos
                // lo decide el servidor cada vez, y vuelve a comprobarlo al guardar.
                const TIPOS_CUENTA = [
                    { valor: 'caja',      etiqueta: 'Caja',      icono: 'fi-rr-cash' },
                    { valor: 'banco',     etiqueta: 'Banco',     icono: 'fi-rr-bank' },
                    { valor: 'billetera', etiqueta: 'Billetera', icono: 'fi-rr-wallet' }
                ];

                document.getElementById('btn-editar')?.addEventListener('click', async () => {
                    let datos;
                    try {
                        const r = await fetch(`/admin/bankentities/cajas/${idCuenta}/editar`, { headers: { Accept: 'application/json' } });
                        datos = await r.json();
                        if (!datos.success) throw new Error(datos.mensaje || 'No se pudo cargar la cuenta.');
                    } catch (err) {
                        return Swal.fire({ icon: 'error', title: 'No se pudo abrir', text: err.message, confirmButtonColor: '#EC5FA3' });
                    }

                    const c = datos.cuenta;
                    const editable = datos.puedeEditarEstructura;

                    const bloqueEstructura = editable
                        ? `<div class="gh-form-campo">
                               <label class="gh-form-label" for="ed-tipo-caja">Tipo de cuenta</label>
                               <div class="gh-form-seg">
                                   ${TIPOS_CUENTA.map(t => `
                                       <label>
                                           <input type="radio" name="ed-tipo" id="ed-tipo-${t.valor}" value="${t.valor}" class="gh-seg-marca" ${c.tipo === t.valor ? 'checked' : ''}>
                                           <span><i class="fi ${t.icono}"></i>${t.etiqueta}</span>
                                       </label>`).join('')}
                               </div>
                           </div>
                           <div class="gh-form-campo">
                               <label class="gh-form-label" for="ed-referencia">Número o referencia <span>(opcional)</span></label>
                               <input id="ed-referencia" class="gh-form-input gh-form-mono" type="text" maxlength="50" autocomplete="off"
                                      placeholder="Ej: 4821, 3167386129" value="${esc(c.referencia || '')}">
                           </div>`
                        : `<p class="gh-form-sellado">
                               <i class="fi fi-rr-lock"></i>
                               <span>El tipo (<b>${esc(tc(c.tipo))}</b>) y la referencia (<b>${esc(c.referencia || 'sin referencia')}</b>) quedaron fijos: esta cuenta ya tiene movimientos asentados y cambiarlos alteraría el significado de su historial.</span>
                           </p>`;

                    const { isConfirmed } = await Swal.fire({
                        html: `
                            <div class="gh-conf-html">
                                <div class="gh-conf-cabecera">
                                    <span class="gh-conf-badge"><i class="fi fi-rr-edit" style="font-size:.625rem"></i>Editar cuenta</span>
                                    <p class="gh-conf-monto">${esc(tc(c.nombreCajaBanco))}</p>
                                </div>

                                <div class="gh-form">
                                    <div class="gh-form-campo">
                                        <label class="gh-form-label" for="ed-nombre">Nombre de la cuenta</label>
                                        <input id="ed-nombre" class="gh-form-input" type="text" maxlength="50" autocomplete="off"
                                               placeholder="Ej: Caja Principal San Diego" value="${esc(c.nombreCajaBanco)}">
                                    </div>

                                    <div class="gh-form-campo">
                                        <label class="gh-form-label" for="ed-estado-activa">Estado</label>
                                        <div class="gh-form-seg">
                                            <label>
                                                <input type="radio" name="ed-estado" id="ed-estado-activa" value="true" ${c.estado ? 'checked' : ''}>
                                                <span><i class="fi fi-rr-check"></i>Activa</span>
                                            </label>
                                            <label>
                                                <input type="radio" name="ed-estado" id="ed-estado-inactiva" value="false" class="gh-seg-apagar" ${c.estado ? '' : 'checked'}>
                                                <span><i class="fi fi-rr-ban"></i>Inactiva</span>
                                            </label>
                                        </div>
                                        <p style="font-size:.6875rem;color:#94A3B8;margin:0">Una cuenta inactiva no admite movimientos nuevos, pero su historial sigue disponible.</p>
                                    </div>

                                    ${bloqueEstructura}
                                </div>

                                <p id="ed-error" class="gh-form-error" style="display:none;margin-top:1rem"></p>
                            </div>`,
                        showCancelButton: true,
                        confirmButtonText: 'Guardar cambios',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true,
                        buttonsStyling: false,
                        width: '30rem',
                        customClass: {
                            popup:         'gh-conf-popup gh-conf--neutro',
                            htmlContainer: 'gh-conf-html-container',
                            actions:       'gh-conf-acciones',
                            confirmButton: 'gh-conf-btn gh-conf-confirmar',
                            cancelButton:  'gh-conf-btn gh-conf-cancelar'
                        },
                        // Solo la entrada es propia. La salida la maneja SweetAlert2 con su `swal2-hide`:
                        // una clase de cierre propia que comparta @keyframes con la de entrada no
                        // dispara `animationend` y deja el contenedor tapando la página.
                        showClass: { popup: 'gh-conf-entra', backdrop: 'swal2-backdrop-show' },
                        didOpen: () => document.getElementById('ed-nombre')?.focus(),
                        showLoaderOnConfirm: true,
                        allowOutsideClick: () => !Swal.isLoading(),
                        preConfirm: async () => {
                            const aviso = document.getElementById('ed-error');
                            // Devolver false deja el modal abierto con lo que el usuario ya
                            // escribió. El motivo se pinta en el aviso propio y no con
                            // showValidationMessage, que rompería el estilo de la ventana.
                            const fallar = (m) => { aviso.textContent = m; aviso.style.display = 'block'; return false; };
                            aviso.style.display = 'none';

                            const nombre = document.getElementById('ed-nombre').value.trim();
                            if (nombre.length < 2) return fallar('El nombre debe tener al menos 2 caracteres.');

                            const cuerpo = {
                                nombreCajaBanco: nombre,
                                estado: document.querySelector('input[name="ed-estado"]:checked').value
                            };
                            // Solo se mandan si el servidor dijo que se pueden editar. Si no,
                            // ni siquiera viajan: mandarlos iguales pasaría, pero es ruido.
                            if (editable) {
                                cuerpo.tipo = document.querySelector('input[name="ed-tipo"]:checked').value;
                                cuerpo.referencia = document.getElementById('ed-referencia').value.trim();
                            }

                            try {
                                const r = await fetch(`/admin/bankentities/cajas/${idCuenta}/editar`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf, Accept: 'application/json' },
                                    body: JSON.stringify(cuerpo)
                                });
                                const d = await r.json();
                                if (!d.success) return fallar(d.mensaje || 'No se pudo guardar.');
                                return d;
                            } catch (_) {
                                return fallar('No se pudo conectar con el servidor.');
                            }
                        }
                    });

                    if (isConfirmed) {
                        await Swal.fire({
                            icon: 'success', title: 'Cuenta actualizada',
                            confirmButtonColor: '#EC5FA3', timer: 1600, timerProgressBar: true
                        });
                        // Se recarga: el nombre viaja al título, la miga y el encabezado, y
                        // el estado cambia el badge. Repintar todo eso a mano sería peor.
                        location.reload();
                    }
                });

                actualizarPie();
            })();
