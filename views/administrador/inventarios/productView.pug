extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")
                            //******************[CUERPO PANELES]*********************//
                            
                            //HEADER
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-2  bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                include  ./headers/headerProductProprietary.pug
                                include  ./headers/actionBtns.pug

                            
                            //FORMULARIO
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-4 gap-4 border-b-1 pb-4 border-dotted border-b-gray-400")
                                include ./stats/saleToday.pug
                                include ./stats/unitSold.pug
                                include ./stats/selfThrough.pug
                                include ./stats/inventoryDays.pug
                            div(class="col-span-12 grid grid-cols-12 items-start")
                                include ./view/product.pug

                input#producto-id(type="hidden" value=producto.idProducto)
                input#csrf-token-admin(type="hidden" value=csrfToken)

                //- ── MODAL HACER TRASLADO ─────────────────────────────────────
                div#modal-traslado(class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background:rgba(0,0,0,0.45)")
                    div(class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 flex flex-col gap-4")
                        div(class="flex items-center justify-between")
                            div(class="flex items-center gap-3")
                                div(class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#EC5FA3,#d44a8a)")
                                    i(class="fi fi-rr-convert-shapes text-white")
                                h3(class="text-lg font-bold text-slate-800") Hacer Traslado
                            button#modal-traslado-cerrar(type="button" class="text-slate-400 hover:text-slate-600 transition-colors cursor-pointer")
                                i(class="fi fi-rr-cross text-lg")

                        //- Origen
                        div(class="space-y-1")
                            label(for="trl-origen" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block") Origen (tienda con stock)
                            select#trl-origen(class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all")
                                option(value="") Cargando tiendas...

                        //- Cantidad
                        div(class="space-y-1")
                            label(for="trl-cantidad" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider flex items-center justify-between")
                                span Cantidad
                                span#trl-max(class="text-pink-500 font-semibold normal-case text-[11px]")
                            input#trl-cantidad(
                                type="number"
                                min="1"
                                value="1"
                                class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all"
                            )

                        //- Destino
                        div(class="space-y-1")
                            label(for="trl-destino" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block") Destino
                            select#trl-destino(class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all")
                                option(value="") Selecciona destino...

                        //- Notas
                        div(class="space-y-1")
                            label(for="trl-notas" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block") Notas (opcional)
                            textarea#trl-notas(
                                rows="2"
                                maxlength="255"
                                placeholder="Observaciones del traslado..."
                                class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm resize-none focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-all"
                            )

                        //- Submit
                        button#trl-submit(
                            type="button"
                            disabled
                            class="w-full flex items-center justify-center gap-2 py-3 rounded-xl text-white font-bold text-sm transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                            style="background:#EC5FA3"
                        )
                            i(class="fi fi-rr-paper-plane")
                            | Confirmar Traslado

                script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
                script(src="/js/dropdownBtn.js")
                script(src="/js/adminProductoView.js")
                 