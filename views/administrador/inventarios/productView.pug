extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")
                            //******************[CUERPO PANELES]*********************//
                            
                            //HEADER
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-2  bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                include  ./headers/headerProductProprietary.pug
                                include  ./headers/actionBtns.pug

                            
                            //FORMULARIO
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-4 gap-4 border-b-1 pb-4 border-dotted border-b-gray-400")
                                include ./stats/saleToday.pug
                                include ./stats/unitSold.pug
                                include ./stats/selfThrough.pug
                                include ./stats/inventoryDays.pug
                            div(class="col-span-12 grid grid-cols-12 items-start")
                                include ./view/product.pug

                script(src="/js/dropdownBtn.js")
                script.
                    // ── Stock total ──────────────────────────────────────────
                    fetch(`/admin/api/inventario/#{producto.idProducto}/stock-total`)
                        .then(r => r.json())
                        .then(({ stockTotal }) => {
                            document.getElementById('stockTotalGlobal').textContent =
                                stockTotal.toLocaleString('es-CO');
                        })
                        .catch(() => {
                            document.getElementById('stockTotalGlobal').textContent = '—';
                        });

                    // ── Unidades Vendidas (30d) ───────────────────────────────
                    const actualizarUnidadesVendidas = () => {
                        fetch(`/admin/api/inventario/#{producto.idProducto}/unidades-vendidas`)
                            .then(r => r.json())
                            .then(({ success, actual, variacion, tendencia }) => {
                                if (!success) return;

                                const elValor  = document.getElementById('stat-unidades-valor');
                                const elBadge  = document.getElementById('stat-unidades-badge');
                                const elPct    = document.getElementById('stat-unidades-pct');
                                const elIcon   = document.getElementById('stat-unidades-icon');

                                if (elValor) elValor.textContent = actual.toLocaleString('es-CO');

                                const signo = variacion > 0 ? '+' : '';
                                const color = tendencia === 'up' ? '#078859' : tendencia === 'down' ? '#e53e3e' : '#6b7280';

                                if (elBadge) {
                                    elBadge.textContent = `${signo}${variacion}% vs mes ant.`;
                                    elBadge.style.color = color;
                                    elBadge.closest('div').style.background = color + '1a';
                                }
                                if (elPct) {
                                    elPct.textContent = `${signo}${variacion}%`;
                                    elPct.style.color = color;
                                }
                                if (elIcon) {
                                    elIcon.className = tendencia === 'down'
                                        ? 'fi-rr-arrow-trend-down text-3xl'
                                        : 'fi-rr-arrow-trend-up text-3xl';
                                    elIcon.style.color = color;
                                }
                            })
                            .catch(() => {});
                    };

                    actualizarUnidadesVendidas();
                    setInterval(actualizarUnidadesVendidas, 30000);

                    // ── Días de Inventario ───────────────────────────────────
                    const COLORES = {
                        critico:    { bg: '#fef2f2', icon: '#dc2626', badge: '#dc2626', badgeBg: '#fee2e2', texto: '#dc2626', iconFooter: 'fi-rr-triangle-warning' },
                        alerta:     { bg: '#fffbeb', icon: '#d97706', badge: '#d97706', badgeBg: '#fef3c7', texto: '#d97706', iconFooter: 'fi-rr-triangle-warning' },
                        suficiente: { bg: '#f0fdf4', icon: '#16a34a', badge: '#16a34a', badgeBg: '#dcfce7', texto: '#16a34a', iconFooter: 'fi-rr-check-circle'     }
                    };
                    const LABELS = { critico: 'CRÍTICO', alerta: 'ALERTA', suficiente: 'SUFICIENTE' };

                    const actualizarDiasInventario = () => {
                        fetch(`/admin/api/inventario/#{producto.idProducto}/dias-inventario`)
                            .then(r => r.json())
                            .then(({ success, dias, estado, mensaje }) => {
                                if (!success) return;
                                const c = COLORES[estado];
                                const emergencia = dias <= 5;

                                const card    = document.getElementById('inv-days-card');
                                const wrap    = document.getElementById('inv-days-icon-wrap');
                                const badge   = document.getElementById('inv-days-badge');
                                const badgeW  = document.getElementById('inv-days-badge-wrap');
                                const valor   = document.getElementById('inv-days-valor');
                                const label   = document.getElementById('inv-days-label');
                                const footerI = document.getElementById('inv-days-icon-footer-i');
                                const msg     = document.getElementById('inv-days-mensaje');
                                const border  = document.getElementById('inv-days-border');

                                if (emergencia && card) {
                                    // Tarjeta en modo emergencia: fondo rojo, todo en blanco
                                    card.style.background   = '#dc2626';
                                    card.style.borderColor  = '#b91c1c';
                                    card.style.boxShadow    = '0 0 0 3px #fca5a5, 0 10px 30px rgba(220,38,38,0.4)';
                                    const blanco = '#ffffff';
                                    if (wrap)    { wrap.style.background = 'rgba(255,255,255,0.2)'; wrap.style.color = blanco; }
                                    if (badgeW)  { badgeW.style.background = 'rgba(255,255,255,0.25)'; }
                                    if (badge)   { badge.textContent = '⚠ URGENTE'; badge.style.color = blanco; }
                                    if (valor)   { valor.textContent = dias; valor.style.color = blanco; }
                                    if (label)   { label.style.color = 'rgba(255,255,255,0.85)'; }
                                    if (footerI) { footerI.className = 'fi-rr-triangle-warning text-xl'; footerI.style.color = blanco; }
                                    if (msg)     { msg.textContent = mensaje; msg.style.color = blanco; msg.style.fontWeight = '700'; }
                                } else {
                                    if (card)    { card.style.background = ''; card.style.borderColor = ''; card.style.boxShadow = ''; }
                                    if (wrap)    { wrap.style.background = c.bg; wrap.style.color = c.icon; }
                                    if (badgeW)  { badgeW.style.background = c.badgeBg; }
                                    if (badge)   { badge.textContent = LABELS[estado]; badge.style.color = c.badge; }
                                    if (valor)   { valor.textContent = dias >= 999 ? '∞' : dias; valor.style.color = c.icon; }
                                    if (label)   { label.style.color = c.texto; }
                                    if (footerI) { footerI.className = `${c.iconFooter} text-xl`; footerI.style.color = c.texto; }
                                    if (msg)     { msg.textContent = mensaje; msg.style.color = c.texto; msg.style.fontWeight = ''; }
                                }
                            })
                            .catch(() => {});
                    };

                    actualizarDiasInventario();
                    setInterval(actualizarDiasInventario, 30000);
                 