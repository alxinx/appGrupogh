include ../../../components/headerAdmin

//- El avatar depende de la pantalla; el marcado lo pone el mixin.
- var avatar = '/img/avatars/nuevoProducto.png'
if subPath === 'listado'
    - avatar = '/img/avatars/listado.webp'
else if subPath === 'dosificar'
    - avatar = '/img/avatars/doscificacion.webp'

+headerAdmin({
    avatar:    avatar,
    titulo:    dato ? tc(dato.nombreComercial) : subPagina,
    subtitulo: dato ? dato.direccionPrincipal : null,
    iconoSub:  dato ? 'fi-rr-marker' : null
})
