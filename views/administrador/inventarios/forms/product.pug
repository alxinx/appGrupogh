form(action="", method="post" id="formularioProducto" enctype="multipart/form-data" class="col-span-12 grid grid-cols-12 gap-6 items-start")


    //- COLUMNA IZQUIERDA
    input(type="hidden", name="_csrf" value = csrfToken)
    input(type="hidden", name="idProducto" value=producto ? producto.idProducto : '')
    input(type="hidden", name="variantes_sku" id="variantes_sku" value="{}")
    input(type="hidden", name="imagenes_color_nuevas" id="imagenes_color_nuevas" value="{}")
    input(type="hidden", name="imagenes_color_existentes" id="imagenes_color_existentes" value="{}")


    div(class="col-span-12 md:col-span-8 grid grid-cols-12 gap-4 cards cardsWhite p-6")
        
        //- Nombre del Producto
        //- SEPARADOR 100% (ATRIBUTOS)
        div(class="col-span-12 -mx-6 mt-4")
            
            h1.h1(class="text-left pl-11 flex items-center text-gray-700")
                i.fi-rr-features.pr-2
                | Datos Básicos


        div(class="col-span-12")
            label.label Nombre Del Producto
                input(class="field-text" type="text" name="nombreProducto" id="nombreProducto" placeholder="Cómo se llama el producto?" value = (producto && producto.nombreProducto) ? producto.nombreProducto : "")
                #divError
                //if errores && errores.nombreProducto
                    
                    //- p(class="label-error pl-2.5")=errores.nombreProducto
                    //-     i.fi-rr-light-emergency-on
        //- Categoría
        //- Columna de Categorías
        div(class="col-span-12 md:col-span-5")
            label.label Categoría
            div(class="flex flex-wrap gap-2 mt-2")
                each categoria in categorias
                    if(categoria.tipo === "CATEGORIA")
                        label(class="subItems")
                            input(type="checkbox" name="categorias" value=categoria.idCategoria  
                            checked=categoriasSeleccionadas.includes(categoria.idCategoria)    
                            class="categoria-checkbox checkbox")
                            span(class="text-xs font-bold text-gray-700 uppercase")= categoria.nombreCategoria

        //- Columna de SubCategorías
        div(class="col-span-12 md:col-span-7")
            label.label SubCategorías
            //- Punto clave:
            //- El ID debe ser exactamente 'SubCategorias' (con la S mayúscula como en el JS)
            div(id="SubCategorias" class="flex flex-wrap gap-3 p-4 border-2 border-dashed border-gray-100 rounded-2xl min-h-[110px] items-start content-start")
                //- Aquí es donde el JS inyectará los divs 'grupo-sub-cat-ID'


        //- SEPARADOR (CÓDIGOS Y FAMILIA)
        div(class="col-span-12 -mx-6 mt-4")
            div(class="border-b border-gray-200 w-full")
                h1.h1(class="text-left pl-11 py-4 flex items-center text-gray-700")
                    i.fi-rr-barcode.pr-2
                    | Códigos y Familia

        //- SKU
        div(class="col-span-12 md:col-span-4")
            label.label SKU
                input(class="field-text" type="text" name="sku" id="sku" maxlength="20" placeholder="Código interno" value = (producto && producto.sku) ? producto.sku : "")
                #errorSku

        //- EAN
        div(class="col-span-12 md:col-span-4")
            label.label EAN
                input(class="field-text" type="text" name="ean" id="ean" placeholder="Código de barras" value = (producto && producto.ean) ? producto.ean : "")
                #errorEan

        //- FAMILIA
        div(class="col-span-12 md:col-span-4")
            label.label FAMILIA
                //- Agrupa las variantes del mismo artículo: "Blusa Greicy - Rojo" y
                //- "- Negro" comparten BLUSA GREICY. Se envía el NOMBRE; el backend lo
                //- resuelve a una fila de FAMILIA (la crea si no existe) y guarda la FK.
                //- Vacío NO queda sin familia: el backend la deduce del nombre del producto.
                input(class="field-text uppercase" type="text" name="familia" id="familia" maxlength="100" placeholder="Se deduce del nombre" list="familias-existentes" value = (producto && producto.familia) ? producto.familia.nombreFamilia : "")
                p(class="text-[10px] text-gray-400 mt-1") Si lo dejás vacío se toma del nombre del producto.
                //- Autocompletado nativo con las familias que ya existen: evita crear
                //- "BLUSA GREICY 2" por no recordar el nombre exacto.
                datalist#familias-existentes
                    each f in (familias || [])
                        option(value=f.nombreFamilia)
                #errorFamilia
                //- Lo llena productDataForm.js con lo que responde /admin/json/familia/sugerencias
                #sugerenciaFamilia(class="hidden mt-2")

        //- SEPARADOR (FINANZAS Y PRECIOS)
        div(class="col-span-12 -mx-6 mt-4")
            div(class="border-b border-gray-200 w-full")
                h1.h1(class="text-left pl-11 py-4 flex items-center text-gray-700")
                    i.fi-rr-money-bill-wave.pr-2
                    | Finanzas y Precios

        //- COSTO (temporal)
        div(class="col-span-12 md:col-span-3")
            label.label COSTO
                input(class="field-text" type="text" id="costo" name="costo" placeholder="Ej : $8.000" value = (producto && producto.costo) ? producto.costo : "")

        //- PRECIOS PARA MINORISTA!
        div(class="col-span-12 md:col-span-3")
            label.label P. PÚBLICO FINAL
                input(class="field-text" type="text" id="precioVentaPublicoFinal" name="precioVentaPublicoFinal" placeholder="Ej : $80.000" value = (producto && producto.precioVentaPublicoFinal) ? producto.precioVentaPublicoFinal : "" )

        //- PRECIOS PARA MAYORISTA
        div(class="col-span-12 md:col-span-3")
            label.label P. MAYORISTA
                input(class="field-text" type="text" id="precioVentaMayorista" name="precioVentaMayorista" placeholder="Ej : $40.000" value = (producto && producto.precioVentaMayorista) ? producto.precioVentaMayorista : "")

        //- PRECIO MAYORISTA SURTIDO
        div(class="col-span-12 md:col-span-3")
            label.label MAYORISTA SURTIDO
                input(class="field-text" type="text" id="precioVentaMayoristaSurtido" name="precioVentaMayoristaSurtido" placeholder="Ej : $35.000" value = (producto && producto.precioVentaMayoristaSurtido) ? producto.precioVentaMayoristaSurtido : "")

        //- SEPARADOR 100% (ATRIBUTOS)
        div(class="col-span-12 -mx-6 mt-4")
            div(class="border-b border-gray-200 w-full")
                h1.h1(class="text-left pl-11 py-4 flex items-center text-gray-700")
                    i.fi-rr-features.pr-2
                    | Atributos

        
        div(class="col-span-12")
        //- SECCIÓN DE TALLAS
        div.col-span-12
            h3.text-lg.font-bold.text-gray-700.mb-4 Tallas Disponibles
            div(class="flex flex-wrap gap-4 p-4 bg-gray-50 rounded-2xl")
                each atributo in atributos
                    if atributo.tipo === 'TALLA'
                        label(class="flex items-center gap-2 bg-white border border-gray-200 px-4 py-2 rounded-xl cursor-pointer hover:border-indigo-500 transition-all")
                            //- Agregamos clase 'talla-trigger' y data-id
                            input(type="checkbox" class="talla-trigger w-5 h-5" value=atributo.idAtributo checked=atributosSeleccionados.includes(atributo.idAtributo) data-nombre=atributo.valor)
                            span(class="font-bold text-gray-700")= atributo.valor

                           

        
        div(class="col-span-12 mt-4")
            h4(class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3") Resumen de Combinaciones
            input(type="hidden" name="variantes_finales" id="variantes_finales" value = (variantesJson) ? variantesJson : "{}" )
            div#resumenVariantes(class="flex flex-wrap gap-2 min-h-[40px] p-4 bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl")
                span(class="text-gray-400 text-sm italic") No has seleccionado colores para las tallas...

        //- MODAL DE COLORES 
        div#modalColores(class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center")
            div(class="bg-white rounded-3xl p-8 w-full max-w-2xl shadow-2xl")
                div.flex.justify-between.items-center.mb-6
                    h2.h2 
                        | Colores para Talla: 
                        span#tallaTitulo.text-pink-600 ---
                    button#cerrarModal(type="button" class="text-gray-400 cursor-pointer hover:text-red-500") 
                        i.fi-rr-cross-circle.text-2xl

                //- Buscador de colores
                div(class="mb-4")
                    input#buscadorColor(type="text" placeholder="Buscar color..." class="input input-bordered w-full rounded-xl text-sm")

                //- Contenedor donde se cargarán los colores
                div(class="grid grid-cols-2 md:grid-cols-3 gap-4 max-h-[60vh] overflow-y-auto p-2" id="gridColores")
                    each atributo in atributos
                        if atributo.tipo === 'COLOR'
                            label(class="flex items-center gap-3 p-3 border border-gray-100 rounded-2xl cursor-pointer hover:bg-gray-50")
                                input(type="checkbox" value=atributo.idAtributo class="color-checkbox checkbox w-4 h-4" data-nombre=atributo.valor)
                                //- Circulito de color 
                                div(class="w-4 h-4 rounded-full  shadow-sm" style=`background-color: ${atributo.codigo1 || '#ccc'}`)

                                if atributo.codigo2 != NULL
                                    div(class="w-4 h-4 rounded-full  shadow-sm" style=`background-color: ${atributo.codig2 || '#ccc'}`)


                                span(class="text-sm font-medium")= atributo.valor

                button#guardarColores(type="button" class="w-full mt-8 b btn btn-primary") Guardar Colores para esta Talla


        //- MODAL DE CONFIRMACIÓN DE SKU AUTOGENERADO
        div#modalConfirmSku(class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4")
            div(class="bg-white rounded-3xl p-8 w-full max-w-3xl shadow-2xl max-h-[90vh] overflow-y-auto")
                div.flex.justify-between.items-center.mb-6
                    h2.h2 Confirma los SKU generados
                    button#cerrarModalSku(type="button" class="text-gray-400 cursor-pointer hover:text-red-500")
                        i.fi-rr-cross-circle.text-2xl

                p(class="text-sm text-gray-500 mb-4") Detectamos varias combinaciones de talla y color. Revisa o ajusta el SKU de cada una antes de guardar.

                div#listaSkuCombinaciones(class="space-y-2 mb-6")
                    //- JS inyecta aquí un input por combinación

                div(class="border-t border-gray-100 pt-4")
                    h3(class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3") Emparejar imágenes por color (opcional)
                    p(class="text-xs text-gray-400 mb-3") Elige qué imágenes ya subidas corresponden a cada color. Se comparten entre todas las tallas de ese color.
                    div#listaColoresImagenes(class="space-y-4")
                        //- JS inyecta aquí un bloque por color con las miniaturas para elegir

                button#confirmarSkuGuardar(type="button" class="w-full mt-8 btn btn-primary") Confirmar y Guardar







                            
    //- COLUMNA DERECHA
    div(class="col-span-12 cards cardsWhite md:col-span-4 flex flex-col gap-4")
        div(class="p-6")
            h1.h1
                i.fi-rr-eyes.pr-2
                |Visibilidad del producto
            //- Contenedor Flex para ponerlos uno al lado del otro
            div(class="flex flex-row flex-wrap gap-2")
                label(class="subItems")
                    div(class="checkbox-group mr-2")
                        input.checkbox(type="checkbox"  id="activo" name ="activo" checked=(producto.activo !== false) )

                    span(class="text-[10px] font-bold text-gray-700 uppercase whitespace-nowrap") Producto Activo

                label(class="subItems")
                   
                    div(class="checkbox-group mr-2")
                        //input.checkbox(type="checkbox" id="disponible_web" name="web" checked )
                        input.checkbox(type="checkbox"  id="disponible_web" name ="web" checked=producto.web === true )
                        
                    span(class="text-[10px] font-bold text-gray-700 uppercase whitespace-nowrap") Disponible en web

        //- Dentro del div de Visibilidad, después de los labels
        div#seccion-web-seo(class="hidden mt-6 pt-4 border-t border-dashed border-gray-100 animate-fade-in")
            div(class="grid grid-cols-1 gap-4")
                div
                    h1.h1
                        i.fi-rr-site-browser.pr-2.mt-5
                        | Datos Para Seo Y Web
                div
                    label(class="label uppercase") Slug (URL Amigable)
                    input#slug(type="text" name="slug" class="field-text field-text-disabled" value = (producto && producto.slug) ? producto.slug : ""  readonly )
                div
                    label(class="label uppercase") Etiquetas / Tags
                    input#tags(type="text" name="tags" class="field-text w-full" placeholder="ej: seda, nuevo, oferta" value = (producto && producto.tags) ? producto.tags : "")
                div
                    label(class="label uppercase") Meta Descripción
                    //- Barra de formato. Inserta las etiquetas en el textarea; el HTML queda
                    //- a la vista para poder corregirlo a mano.
                    div#meta-toolbar(class="flex flex-wrap items-center gap-1 mb-2")
                        each b in [{a:'negrita',t:'B',c:'font-black',d:'Negrita'},{a:'cursiva',t:'I',c:'italic font-serif',d:'Cursiva'},{a:'parrafo',t:'¶',c:'',d:'Párrafo'},{a:'subtitulo',t:'H3',c:'font-bold',d:'Subtítulo'},{a:'lista',t:'• —',c:'',d:'Lista'},{a:'salto',t:'↵',c:'',d:'Salto de línea'},{a:'enlace',t:'🔗',c:'',d:'Enlace'}]
                            button(type="button" data-accion=b.a title=b.d class="h-8 min-w-8 px-2 rounded-lg border border-gh-grayBorder bg-white text-xs text-gh-grayText hover:border-gh-primary hover:text-gh-primaryHover transition-colors cursor-pointer " + b.c)= b.t
                    //- El '=' de Pug escapa el contenido: dentro del textarea las etiquetas se
                    //- ven como texto editable y nunca se interpretan como HTML de esta página.
                    textarea#meta_descripcion(name="descripcion" class="input-gray w-full h-28 resize-y field-text font-mono text-xs" placeholder="Breve descripción para buscadores. Podés usar <strong>, <em>, <p>, <ul>…")=(producto && producto.descripcion) ? producto.descripcion : ""
                    div(class="flex items-center justify-between mt-1")
                        span#meta-contador(class="text-[10px] text-gray-400")
                        span(class="text-[10px] text-gray-400") Se permiten: b · i · em · strong · p · br · ul · ol · li · h3 · h4 · a
                    //- Vista previa con el MISMO filtro que aplica el servidor al guardar.
                    div(class="mt-2")
                        span(class="text-[10px] uppercase tracking-widest text-gray-400") Vista previa
                        div#meta-preview(class="mt-1 p-3 rounded-xl border border-dashed border-gh-grayBorder bg-white text-sm text-gh-grayText [&_p]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_h3]:font-bold [&_h3]:mb-1 [&_a]:text-gh-primaryHover [&_a]:underline")

        
        div(class="min-h-[150px]")
            h1.h1
                i.fi-rr-picture.pr-2
                |Imágenes Del Producto
            //- Card de Carga de Imágenes
            div(class="shadow-sm")
                //- Área de Drag & Drop
                div(class="relative group")
                    input(type="file" multiple class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" name="imagenes" id="upload-images")

                    div(class="inputUpload")
                        //- Icono de Cámara (Estilo GH)
                        div(class="w-16 h-16 bg-white shadow-sm rounded-full flex items-center justify-center mb-4 text-pink-400")
                            svg(xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z")
                                circle(cx="12" cy="13" r="3")
                        
                        span(class="text-sm font-bold text-gray-600") Sube o arrastra tu imagen
                        span(class="text-xs text-gray-400 mt-1") PNG, JPG hasta 5MB

                div(class="mt-6 flex flex-wrap gap-3 m-2 p-5" id="preview-container")

                    //- Precarga de las imagenes que ya estan en server.
                    if producto.imagenes
                        each imagen in producto.imagenes
                            div(class="w-20 h-20 rounded-xl border border-b-gh-primaryHover relative group animate-fade-in")
                                img(src=`${subPath}/productos/${imagen.nombreImagen}`  class="w-full h-full object-cover rounded-xl")
                                button(
                                    type="button" 
                                    class="btn-delete-existente absolute -top-2 -right-2 bg-white text-gh-grayText rounded-full p-1 shadow-md cursor-pointer hover:text-red-500"
                                    data-id =imagen.idMultimedia
                                    data-nombreimg=imagen.nombreImagen
                                )
                                    i.fi-rr-trash-xmark
                    
                    
                    //- Slot vacío para invitar a subir más
                    div(class="w-20 h-20 rounded-xl border-2 border-dotted border-gray-200 flex items-center justify-center text-gray-300")
                        svg(class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")

    div(class="col-span-12")
        div(class="flex  justify-center")
            button(class="btn btn-primary w-full"  type="submit" id="guardar" )
                i.fi-rr-disk
                | #{btnName}

script.
    // Inyectamos el array de IDs de categorías y subcategorías que procesamos en el controlador
    const categoriasSeleccionadas = !{JSON.stringify(categoriasSeleccionadas)};


script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")           