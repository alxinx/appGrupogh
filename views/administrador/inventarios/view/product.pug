
//- ── GRÁFICAS DE VENTAS ──────────────────────────────────────────────────────
div(class="col-span-12 grid grid-cols-1 lg:grid-cols-[70%_30%] gap-4 mt-2 cards")
    //- Línea: comportamiento histórico
    div(class="bg-white/50 backdrop-blur-xl border border-white shadow-xl rounded-2xl p-6 flex flex-col gap-4")
        div(class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3")
            div
                h3(class="text-lg font-bold text-slate-800") Comportamiento de Ventas
                p(class="text-xs text-slate-400 mt-0.5") Unidades vendidas en el periodo seleccionado
            div(class="flex items-center gap-2 flex-wrap")
                input#graf-desde(
                    type="date"
                    class="text-xs border border-slate-200 rounded-lg px-2 py-1.5 text-slate-600 focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/30"
                )
                span(class="text-xs text-slate-400") —
                input#graf-hasta(
                    type="date"
                    class="text-xs border border-slate-200 rounded-lg px-2 py-1.5 text-slate-600 focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/30"
                )
                button#graf-filtrar(
                    class="text-xs font-semibold px-3 py-1.5 rounded-lg text-white cursor-pointer transition-opacity hover:opacity-80"
                    style="background:#EC5FA3"
                ) Filtrar
        div(class="relative h-64")
            canvas#graf-linea
    //- Dona: participación por tienda
    div(class="bg-white/50 backdrop-blur-xl border border-white shadow-xl rounded-2xl p-6 flex flex-col gap-4")
        div
            h3(class="text-lg font-bold text-slate-800") Participación por Tienda
            p(class="text-xs text-slate-400 mt-0.5") Distribución de ventas (%)
        div(class="relative flex items-center justify-center" style="height:180px")
            canvas#graf-dona
            div(class="absolute flex flex-col items-center pointer-events-none")
                span#graf-dona-total(class="text-2xl font-black text-slate-800") —
                span(class="text-[10px] font-bold text-slate-400 uppercase tracking-wider") Total
        ul#graf-dona-leyenda(class="space-y-2 mt-2")

//- ── BOTÓN HACER TRASLADO ────────────────────────────────────────────────────
div(class="col-span-12 flex justify-end mt-1")
    button#btn-hacer-traslado(
        type="button"
        class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-semibold text-sm shadow-md transition-all hover:opacity-85 active:scale-95 cursor-pointer"
        style="background:#EC5FA3"
    )
        i(class="fi fi-rr-convert-shapes")
        | Hacer Traslado

//- ── STOCK POR PUNTO DE VENTA ────────────────────────────────────────────────
div(class="col-span-12 bg-white/50 backdrop-blur-xl border border-white shadow-xl rounded-2xl overflow-hidden mt-2")
    div(class="flex items-center justify-between px-6 py-4 border-b border-slate-100")
        div
            h3(class="text-base font-bold text-slate-800") Stock por punto de venta
            p(class="text-xs text-slate-400 mt-0.5") Existencias actuales del producto por ubicación
        span#stock-tiendas-total(class="text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full") —
    div(class="overflow-x-auto")
        table(class="w-full text-sm text-left")
            thead
                tr(class="bg-slate-50 text-xs text-slate-500 uppercase tracking-wider border-b border-slate-100")
                    th(class="px-6 py-3") Punto de venta
                    th(class="px-6 py-3") Tipo
                    th(class="px-6 py-3 text-center") Unidades
                    th(class="px-6 py-3 text-center") Estado
            tbody#stock-tiendas-body(class="divide-y divide-slate-100")
                tr
                    td(colspan="4" class="px-6 py-8 text-center text-slate-400 text-sm")
                        i(class="fi fi-rr-spinner animate-spin mr-2")
                        | Cargando...