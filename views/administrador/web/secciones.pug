extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- ── HEADER ─────────────────────────────────────────────────────────────
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-5 flex items-center justify-between gap-4")
                                div(class="flex items-center gap-4")
                                    a(href="/admin/web/" class="w-9 h-9 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 transition-colors flex-shrink-0")
                                        i(class="fi fi-rr-arrow-left text-slate-600")
                                    div(class="w-10 h-10 rounded-full bg-gradient-to-br from-pink-200 to-pink-400 flex items-center justify-center flex-shrink-0")
                                        i(class="fi fi-rr-apps text-white")
                                    div
                                        h1(class="font-bold text-slate-800 text-lg leading-tight") Secciones destacadas
                                        p(class="text-xs text-slate-400") Bloques visuales que enlazan a categorías del catálogo
                                button#btn-nueva-seccion(type="button" class="btn btn-primary text-xs py-1.5 px-4")
                                    i(class="fi fi-rr-add")
                                    | Nueva sección

                            //- ── GRID SECCIONES ──────────────────────────────────────────────────────
                            div(class="col-span-12 cards cardsWhite p-6")
                                if secciones.length === 0
                                    div(class="flex flex-col items-center justify-center py-16 text-center")
                                        i(class="fi fi-rr-apps text-5xl text-slate-200 mb-3")
                                        p(class="text-sm font-semibold text-slate-400") Sin secciones registradas

                                else
                                    div(class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4")
                                        each s in secciones
                                            div(class="rounded-xl border border-slate-100 overflow-hidden group")
                                                //- Imagen
                                                div(class="relative h-36 bg-slate-100")
                                                    if s.imagenUrl
                                                        img(src=s.imagenUrl alt=s.titulo class="w-full h-full object-cover")
                                                    else
                                                        div(class="flex items-center justify-center h-full text-slate-300")
                                                            i(class="fi fi-rr-apps text-3xl")
                                                    span(class=`absolute top-2 right-2 text-[10px] font-bold px-2 py-0.5 rounded-full ${s.activo ? 'bg-green-100 text-green-700' : 'bg-slate-200 text-slate-500'}`)
                                                        = s.activo ? 'Activa' : 'Inactiva'
                                                    span(class="absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded-full bg-black/50 text-white") ##{s.orden}
                                                div(class="p-3")
                                                    p(class="font-bold text-slate-700 text-sm truncate")= s.titulo
                                                    p(class="text-xs text-slate-400 truncate mt-0.5")= s.categoria ? s.categoria.nombreCategoria : 'Sin categoría'
                                                    div(class="flex items-center gap-2 mt-2")
                                                        button(
                                                            type="button"
                                                            class="btn-editar-seccion flex-1 text-xs py-1.5 px-2 rounded-lg border border-pink-200 text-pink-600 hover:bg-pink-50 transition-colors font-semibold"
                                                            data-seccion=JSON.stringify({ idSeccion: s.idSeccion, titulo: s.titulo, idCategoria: s.idCategoria, orden: s.orden, activo: s.activo })
                                                        )
                                                            i(class="fi fi-rr-edit")
                                                            |  Editar
                                                        button(
                                                            type="button"
                                                            class="btn-eliminar-seccion text-xs py-1.5 px-2 rounded-lg border border-red-200 text-red-500 hover:bg-red-50 transition-colors"
                                                            data-id=s.idSeccion
                                                        )
                                                            i(class="fi fi-rr-trash")

                            //- ── MODAL ───────────────────────────────────────────────────────────────
                            div#modal-seccion(class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4")
                                div(class="bg-white rounded-2xl w-full max-w-md shadow-2xl")
                                    div(class="flex items-center justify-between p-5 border-b border-slate-100")
                                        h2#modal-seccion-title(class="font-bold text-slate-800") Nueva sección
                                        button#btn-cerrar-modal-seccion(type="button" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100")
                                            i(class="fi fi-rr-cross text-slate-500 text-sm")

                                    form#form-seccion(class="p-5 space-y-4" enctype="multipart/form-data")
                                        input(type="hidden" name="_csrf" value=csrfToken)
                                        input#seccion-id(type="hidden")

                                        div
                                            label.label Imagen de la sección
                                                input.field-text(type="file" name="imagen" accept="image/*")
                                            p(class="text-[10px] text-slate-400 mt-1") Tamaño recomendado: 800×600px

                                        div
                                            label.label Título
                                                input.field-text#seccion-titulo(type="text" name="titulo" placeholder="Nueva colección")

                                        div
                                            label.label Categoría vinculada
                                                div(class="select-wrapper")
                                                    select.field-text#seccion-categoria(name="idCategoria")
                                                        option(value="") Sin categoría
                                                        each cat in categorias
                                                            option(value=cat.idCategoria)= cat.nombreCategoria
                                                    span.select-icon
                                                        i.fi-rr-chevron-double-down

                                        div(class="grid grid-cols-2 gap-4")
                                            div
                                                label.label Orden
                                                    input.field-text#seccion-orden(type="number" name="orden" value="0" min="0")
                                            div(class="flex items-end pb-1")
                                                label(class="flex items-center gap-2 cursor-pointer")
                                                    input(type="checkbox" name="activo" id="seccion-activo" value="true" class="checkbox" checked)
                                                    span(class="text-sm font-semibold text-slate-700") Activa

                                        div(class="flex justify-end gap-3 pt-2 border-t border-slate-100")
                                            button(type="button" id="btn-cancelar-seccion" class="btn text-sm py-2 px-4 bg-slate-100 text-slate-600 hover:bg-slate-200") Cancelar
                                            button#btn-guardar-seccion(type="submit" class="btn btn-primary text-sm py-2 px-4")
                                                i(class="fi fi-rr-disk")
                                                | Guardar

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script.
            const modal = document.getElementById('modal-seccion');
            const form  = document.getElementById('form-seccion');

            function abrirModal(datos) {
                document.getElementById('modal-seccion-title').textContent = datos ? 'Editar sección' : 'Nueva sección';
                document.getElementById('seccion-id').value = datos?.idSeccion || '';
                document.getElementById('seccion-titulo').value = datos?.titulo || '';
                document.getElementById('seccion-categoria').value = datos?.idCategoria || '';
                document.getElementById('seccion-orden').value = datos?.orden ?? 0;
                document.getElementById('seccion-activo').checked = datos ? datos.activo : true;
                modal.classList.remove('hidden');
            }

            document.getElementById('btn-nueva-seccion').addEventListener('click', () => abrirModal(null));
            document.getElementById('btn-cerrar-modal-seccion').addEventListener('click', () => modal.classList.add('hidden'));
            document.getElementById('btn-cancelar-seccion').addEventListener('click', () => modal.classList.add('hidden'));

            document.querySelectorAll('.btn-editar-seccion').forEach(btn => {
                btn.addEventListener('click', () => abrirModal(JSON.parse(btn.dataset.seccion)));
            });

            document.querySelectorAll('.btn-eliminar-seccion').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const { isConfirmed } = await Swal.fire({ icon: 'warning', title: '¿Eliminar sección?', showCancelButton: true, confirmButtonText: 'Sí', cancelButtonText: 'Cancelar', confirmButtonColor: '#ef4444' });
                    if (!isConfirmed) return;
                    const csrf = document.querySelector('[name=_csrf]').value;
                    const resp = await fetch(`/admin/web/secciones/eliminar/${btn.dataset.id}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ _csrf: csrf }) });
                    const data = await resp.json();
                    if (data.success) location.reload();
                    else Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje });
                });
            });

            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btn-guardar-seccion');
                btn.disabled = true;
                const id = document.getElementById('seccion-id').value;
                const url = id ? `/admin/web/secciones/editar/${id}` : '/admin/web/secciones/crear';
                const fd = new FormData(this);
                if (!document.getElementById('seccion-activo').checked) fd.set('activo', 'false');
                try {
                    const resp = await fetch(url, { method: 'POST', body: fd });
                    const data = await resp.json();
                    if (data.success) {
                        modal.classList.add('hidden');
                        Swal.fire({ icon: 'success', title: data.mensaje, timer: 1800, showConfirmButton: false }).then(() => location.reload());
                    } else Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje });
                } catch { Swal.fire({ icon: 'error', title: 'Error de red' }); }
                finally { btn.disabled = false; }
            });
