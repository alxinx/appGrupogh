extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- HEADER
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6 flex items-center gap-4")
                                a(href="/admin/web/" class="w-9 h-9 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 transition-colors flex-shrink-0")
                                    i(class="fi fi-rr-arrow-left text-slate-600")
                                div
                                    h1(class="text-xl font-bold text-slate-800") Categorías en web
                                    p(class="text-xs text-slate-400 mt-0.5") Activa las categorías que quieres mostrar en el catálogo online

                            //- CONTENEDOR PRINCIPAL
                            div(class="col-span-12 bg-gray-50 rounded-t-2xl p-3 shadow-sm border border-slate-100 overflow-hidden")

                                //- TÍTULO DESCRIPTIVO
                                div(class="flex items-start gap-3 px-4 pt-3 pb-5 border-b border-slate-100 mb-5")
                                    i(class="fi fi-rr-tags text-gh-primaryHover text-xl flex-shrink-0 mt-0.5")
                                    div
                                        h2(class="font-bold text-slate-700 text-sm") Visibilidad de categorías en el catálogo web
                                        p(class="text-xs text-slate-400 mt-1 leading-relaxed") Los productos de las categorías activas aparecen en el catálogo web cuando tienen stock disponible. Las subcategorías se activan individualmente.

                                //- GRID DE TARJETAS
                                if categorias.length === 0
                                    div(class="flex flex-col items-center justify-center py-16 text-center")
                                        i(class="fi fi-rr-tags text-4xl text-slate-200 mb-3 block")
                                        p(class="text-sm text-slate-400") No hay categorías registradas

                                else
                                    div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 px-4 pb-4")
                                        each cat in categorias
                                            div(class="bg-white rounded-xl border border-slate-200 overflow-hidden flex flex-col")

                                                //- Categoría padre
                                                div(class="flex items-center justify-between gap-2 px-4 py-3 bg-slate-50 border-b border-slate-100")
                                                    div(class="flex items-center gap-2 min-w-0")
                                                        i(class="fi fi-rr-folder text-pink-400 flex-shrink-0")
                                                        span(class="font-bold text-slate-700 text-sm truncate")= cat.nombreCategoria
                                                    label(class="relative inline-flex items-center cursor-pointer flex-shrink-0")
                                                        input(
                                                            type="checkbox"
                                                            class="sr-only peer toggle-categoria"
                                                            data-id=cat.idCategoria
                                                            checked=cat.webActiva
                                                        )
                                                        div(class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-pink-500")

                                                //- Portada para el home de la tienda web ("Comprá por estilo").
                                                //- Solo las categorías padre aparecen en esa sección.
                                                div(class="px-4 pt-3 pb-2")
                                                    div(class="flex items-start gap-3")
                                                        //- El tamaño va en `style` a propósito, no solo en clases: si output.css
                                                        //- queda desactualizado (falta correr `npm run css`), las clases
                                                        //- arbitrarias no existen, la caja se queda sin alto y la imagen se
                                                        //- pinta a tamaño natural, desbordando la tarjeta y tapando los botones.
                                                        div(
                                                            class=`portada-cat-${cat.idCategoria} relative rounded-lg overflow-hidden flex-shrink-0 border border-slate-200 ${cat.imagen ? '' : 'bg-gradient-to-b from-slate-100 to-slate-300'}`
                                                            style="width:54px;height:72px;overflow:hidden;flex:none"
                                                        )
                                                            if cat.imagen
                                                                img(
                                                                    src=cat.imagen
                                                                    alt=cat.nombreCategoria
                                                                    class="w-full h-full object-cover"
                                                                    style="width:100%;height:100%;object-fit:cover;display:block"
                                                                )
                                                            else
                                                                span(class="absolute inset-0 flex items-center justify-center text-slate-400")
                                                                    i(class="fi fi-rr-picture text-sm")
                                                        div(class="min-w-0 flex-1")
                                                            p(class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1") Portada web
                                                            div(class="flex flex-wrap items-center gap-1.5")
                                                                label(class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-gh-primarySoft text-gh-primaryHover text-[11px] font-bold cursor-pointer hover:brightness-95 transition")
                                                                    i(class="fi fi-rr-upload text-[10px]")
                                                                    span= cat.imagen ? 'Cambiar' : 'Subir'
                                                                    input(
                                                                        type="file"
                                                                        accept="image/*"
                                                                        class="hidden input-portada-cat"
                                                                        data-id=cat.idCategoria
                                                                        data-nombre=cat.nombreCategoria
                                                                    )
                                                                if cat.imagen
                                                                    button(
                                                                        type="button"
                                                                        class="btn-quitar-portada inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-500 text-[11px] font-bold hover:border-red-300 hover:text-red-500 transition"
                                                                        data-id=cat.idCategoria
                                                                    )
                                                                        i(class="fi fi-rr-trash text-[10px]")
                                                                        | Quitar
                                                            p(class="text-[10px] text-slate-400 mt-1.5 leading-snug") Vertical (3:4). Sin imagen se muestra el recuadro gris.

                                                //- Subcategorías
                                                if cat.Subcategorias && cat.Subcategorias.length > 0
                                                    div(class="divide-y divide-slate-50 flex-1")
                                                        each sub in cat.Subcategorias
                                                            div(class="flex items-center justify-between gap-2 px-4 py-2.5 hover:bg-slate-50/60 transition-colors")
                                                                div(class="flex items-center gap-2 min-w-0")
                                                                    i(class="fi fi-rr-angle-right text-slate-300 text-xs flex-shrink-0")
                                                                    span(class="text-xs text-slate-600 truncate")= sub.nombreCategoria
                                                                label(class="relative inline-flex items-center cursor-pointer flex-shrink-0")
                                                                    input(
                                                                        type="checkbox"
                                                                        class="sr-only peer toggle-categoria"
                                                                        data-id=sub.idCategoria
                                                                        checked=sub.webActiva
                                                                    )
                                                                    div(class="w-8 h-4 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-pink-500")
                                                else
                                                    div(class="px-4 py-3 flex-1")
                                                        p(class="text-[10px] text-slate-300 italic") Sin subcategorías

                                //- FOOTER conteo
                                div(class="px-6 py-4 border-t border-slate-100 flex items-center justify-between mt-1")
                                    p(class="text-xs text-slate-400")
                                        | Mostrando
                                        span(class="font-bold text-slate-600 mx-1")= categorias.length
                                        | categoría(s) registrada(s)
                                    p(class="text-xs text-slate-400")
                                        span(class="font-bold text-gh-primaryHover mx-1")= categorias.filter(c => c.webActiva).length
                                        | activa(s) en el catálogo web

        input(type="hidden" id="csrf-token" value=csrfToken)
        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script.
            const csrfToken = document.getElementById('csrf-token').value;
            document.querySelectorAll('.toggle-categoria').forEach(toggle => {
                toggle.addEventListener('change', async function() {
                    const idCategoria = this.dataset.id;
                    try {
                        const resp = await fetch(`/admin/web/categorias/toggle/${idCategoria}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ _csrf: csrfToken })
                        });
                        const data = await resp.json();
                        if (!data.success) {
                            this.checked = !this.checked;
                            Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje, timer: 2000, showConfirmButton: false });
                        }
                    } catch {
                        this.checked = !this.checked;
                    }
                });
            });

            // ── Portada de categoría ────────────────────────────────────────
            const MAX_MB = 2;   // mismo tope que multer en el backend

            function pintarPortada(id, url) {
                const caja = document.querySelector('.portada-cat-' + id);
                if (!caja) return;
                caja.classList.remove('bg-gradient-to-b', 'from-slate-100', 'to-slate-300');
                // style inline igual que en el markup: garantiza la miniatura aunque
                // output.css no tenga las clases arbitrarias compiladas.
                caja.innerHTML = '<img src="' + url + '?v=' + Date.now() + '" class="w-full h-full object-cover"'
                               + ' style="width:100%;height:100%;object-fit:cover;display:block">';
            }

            document.querySelectorAll('.input-portada-cat').forEach(input => {
                input.addEventListener('change', async function () {
                    const archivo = this.files[0];
                    if (!archivo) return;
                    const id = this.dataset.id;

                    if (archivo.size > MAX_MB * 1024 * 1024) {
                        Swal.fire({ icon: 'warning', title: 'Imagen muy pesada', text: 'El máximo es ' + MAX_MB + ' MB.' });
                        this.value = '';
                        return;
                    }

                    const datos = new FormData();
                    datos.append('imagen', archivo);
                    datos.append('_csrf', csrfToken);

                    try {
                        const resp = await fetch('/admin/web/categorias/' + id + '/imagen', { method: 'POST', body: datos });

                        // Si la respuesta no es JSON (403 de CSRF, 413 de tamaño, error del proxy),
                        // resp.json() reventaria y el catch mostraria "error de red", que despista.
                        // Mejor leer el codigo y decir que paso de verdad.
                        const tipo = resp.headers.get('content-type') || '';
                        if (!tipo.includes('application/json')) {
                            const motivo = resp.status === 403 ? 'Tu sesión expiró. Recargá la página e intentá de nuevo.'
                                         : resp.status === 413 ? 'La imagen supera el tamaño permitido (2 MB).'
                                         : 'El servidor respondió ' + resp.status + '.';
                            Swal.fire({ icon: 'error', title: 'No se pudo subir', text: motivo });
                            return;
                        }

                        const data = await resp.json();
                        if (data.success) {
                            pintarPortada(id, data.imagen);
                            Swal.fire({ icon: 'success', title: 'Portada actualizada', timer: 1400, showConfirmButton: false })
                                .then(() => location.reload());
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje });
                        }
                    } catch (e) {
                        Swal.fire({ icon: 'error', title: 'Error de conexión', text: 'No se pudo contactar al servidor: ' + e.message });
                    }
                    this.value = '';
                });
            });

            document.querySelectorAll('.btn-quitar-portada').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.dataset.id;
                    const { isConfirmed } = await Swal.fire({
                        icon: 'warning',
                        title: '¿Quitar la portada?',
                        text: 'La categoría volverá a mostrarse con el recuadro gris en la tienda web.',
                        showCancelButton: true,
                        confirmButtonText: 'Quitar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#ef4444'
                    });
                    if (!isConfirmed) return;

                    try {
                        const resp = await fetch('/admin/web/categorias/' + id + '/imagen/quitar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ _csrf: csrfToken })
                        });
                        const data = await resp.json();
                        if (data.success) location.reload();
                        else Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje });
                    } catch {
                        Swal.fire({ icon: 'error', title: 'Error de red' });
                    }
                });
            });
