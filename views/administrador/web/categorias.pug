extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- ── HEADER ─────────────────────────────────────────────────────────────
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-5 flex items-center justify-between gap-4")
                                div(class="flex items-center gap-4")
                                    a(href="/admin/web/" class="w-9 h-9 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 transition-colors flex-shrink-0")
                                        i(class="fi fi-rr-arrow-left text-slate-600")
                                    div(class="w-10 h-10 rounded-full bg-gradient-to-br from-pink-200 to-pink-400 flex items-center justify-center flex-shrink-0")
                                        i(class="fi fi-rr-tags text-white")
                                    div
                                        h1(class="font-bold text-slate-800 text-lg leading-tight") Categorías en web
                                        p(class="text-xs text-slate-400") Activa las categorías que quieres mostrar en el catálogo online

                            //- ── LISTA ───────────────────────────────────────────────────────────────
                            div(class="col-span-12 cards cardsWhite p-6")
                                p(class="text-xs text-slate-400 mb-4") Los productos de las categorías activas aparecen en el catálogo web cuando tienen stock disponible. Las subcategorías se activan individualmente.

                                div(class="space-y-3")
                                    each cat in categorias
                                        div(class="rounded-xl border border-slate-100 overflow-hidden")
                                            //- Categoría padre
                                            div(class="flex items-center justify-between p-4 bg-slate-50")
                                                div(class="flex items-center gap-3")
                                                    i(class="fi fi-rr-folder text-pink-400")
                                                    span(class="font-bold text-slate-700 text-sm")= cat.nombreCategoria
                                                    if cat.Subcategorias && cat.Subcategorias.length > 0
                                                        span(class="text-[10px] text-slate-400 bg-slate-200 px-2 py-0.5 rounded-full")= `${cat.Subcategorias.length} subcategorías`
                                                label(class="relative inline-flex items-center cursor-pointer")
                                                    input(
                                                        type="checkbox"
                                                        class="sr-only peer toggle-categoria"
                                                        data-id=cat.idCategoria
                                                        checked=cat.webActiva
                                                    )
                                                    div(class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-500")

                                            //- Subcategorías
                                            if cat.Subcategorias && cat.Subcategorias.length > 0
                                                div(class="divide-y divide-slate-50")
                                                    each sub in cat.Subcategorias
                                                        div(class="flex items-center justify-between px-4 py-3 bg-white hover:bg-slate-50/50 transition-colors")
                                                            div(class="flex items-center gap-3 pl-4")
                                                                i(class="fi fi-rr-angle-right text-slate-300 text-xs")
                                                                span(class="text-sm text-slate-600")= sub.nombreCategoria
                                                            label(class="relative inline-flex items-center cursor-pointer")
                                                                input(
                                                                    type="checkbox"
                                                                    class="sr-only peer toggle-categoria"
                                                                    data-id=sub.idCategoria
                                                                    checked=sub.webActiva
                                                                )
                                                                div(class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-pink-500")

        input(type="hidden" id="csrf-token" value=csrfToken)
        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script.
            const csrfToken = document.getElementById('csrf-token').value;
            document.querySelectorAll('.toggle-categoria').forEach(toggle => {
                toggle.addEventListener('change', async function() {
                    const idCategoria = this.dataset.id;
                    try {
                        const resp = await fetch(`/admin/web/categorias/toggle/${idCategoria}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ _csrf: csrfToken })
                        });
                        const data = await resp.json();
                        if (!data.success) {
                            this.checked = !this.checked;
                            Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje, timer: 2000, showConfirmButton: false });
                        }
                    } catch {
                        this.checked = !this.checked;
                    }
                });
            });
