extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- ── HEADER ─────────────────────────────────────────────────────────────
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-5 flex items-center gap-4")
                                a(href="/admin/web/" class="w-9 h-9 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 transition-colors flex-shrink-0")
                                    i(class="fi fi-rr-arrow-left text-slate-600")
                                div(class="w-10 h-10 rounded-full bg-gradient-to-br from-pink-200 to-pink-400 flex items-center justify-center flex-shrink-0")
                                    i(class="fi fi-rr-browser text-white")
                                div
                                    h1(class="font-bold text-slate-800 text-lg leading-tight") Pop-up de bienvenida
                                    p(class="text-xs text-slate-400") Modal que aparece al entrar a la tienda web

                            //- ── FORMULARIO ──────────────────────────────────────────────────────────
                            div(class="col-span-12 grid grid-cols-12 gap-4 items-start")

                                div(class="col-span-12 md:col-span-7")
                                    form#form-popup(action=`/admin/web/popup/editar/${popup.idPopup}` method="post" class="cards cardsWhite p-6 space-y-4" enctype="multipart/form-data")
                                        input(type="hidden" name="_csrf" value=csrfToken)

                                        div
                                            label.label Imagen del popup
                                                input.field-text(type="file" name="imagen" accept="image/*" id="popup-imagen-input")
                                            p(class="text-[10px] text-slate-400 mt-1") Tamaño recomendado: 600×600px. Se convierte a WebP automáticamente.

                                        div
                                            label.label Título (opcional)
                                                input.field-text(type="text" name="titulo" value=popup.titulo || '' placeholder="¡Oferta especial!")

                                        div
                                            label.label Link al hacer clic (opcional)
                                                input.field-text(type="text" name="link" value=popup.link || '' placeholder="/catalogo")

                                        div
                                            label.label Delay antes de aparecer (segundos)
                                                input.field-text(type="number" name="delaySegundos" value=popup.delaySegundos min="0" max="30")

                                        div(class="flex items-center gap-3 p-3 rounded-xl border border-slate-100")
                                            input(type="checkbox" name="activo" id="popup-activo" value="true" class="checkbox" checked=popup.activo)
                                            label(for="popup-activo" class="cursor-pointer")
                                                p(class="font-semibold text-slate-700 text-sm") Mostrar popup en la tienda web
                                                p(class="text-xs text-slate-400") Si está activo, aparecerá a los visitantes según el delay configurado

                                        div(class="flex justify-end pt-2 border-t border-slate-100")
                                            button#btn-guardar-popup(type="submit" class="btn btn-primary")
                                                i(class="fi fi-rr-disk")
                                                | Guardar cambios

                                //- Preview
                                div(class="col-span-12 md:col-span-5")
                                    div(class="cards cardsWhite p-5")
                                        div(class="flex items-center gap-2 mb-4")
                                            i(class="fi fi-rr-eye text-pink-400")
                                            h2(class="font-bold text-slate-700 text-sm") Vista previa actual
                                        if popup.imagenUrl
                                            div(class="rounded-xl overflow-hidden border border-slate-100")
                                                img(src=popup.imagenUrl alt="Popup actual" class="w-full object-cover")
                                            p(class="text-xs text-slate-400 mt-2 text-center") Imagen actual del popup
                                        else
                                            div(class="flex flex-col items-center justify-center py-12 bg-slate-50 rounded-xl text-center")
                                                i(class="fi fi-rr-browser text-4xl text-slate-200 mb-2")
                                                p(class="text-sm text-slate-400") Sin imagen configurada

                                        if popup.activo
                                            div(class="mt-3 flex items-center gap-2 text-xs font-bold text-green-700 bg-green-50 p-2 rounded-lg")
                                                i(class="fi fi-rr-check-circle text-green-500")
                                                span Popup activo — aparece a los #{popup.delaySegundos}s de entrar
                                        else
                                            div(class="mt-3 flex items-center gap-2 text-xs font-medium text-slate-500 bg-slate-50 p-2 rounded-lg")
                                                i(class="fi fi-rr-eye-crossed")
                                                span Popup inactivo — no se muestra

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script.
            document.getElementById('form-popup').addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btn-guardar-popup');
                btn.disabled = true;
                btn.innerHTML = '<i class="fi fi-rr-spinner animate-spin"></i> Guardando...';
                const fd = new FormData(this);
                if (!document.getElementById('popup-activo').checked) fd.set('activo', 'false');
                try {
                    const resp = await fetch(this.action, { method: 'POST', body: fd });
                    const data = await resp.json();
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: data.mensaje, timer: 1800, showConfirmButton: false }).then(() => location.reload());
                    } else Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje });
                } catch { Swal.fire({ icon: 'error', title: 'Error de red' }); }
                finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fi fi-rr-disk"></i> Guardar cambios';
                }
            });
