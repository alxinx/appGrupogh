extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- HEADER
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6 flex items-center gap-4")
                                a(href="/admin/web/" class="w-9 h-9 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 transition-colors flex-shrink-0")
                                    i(class="fi fi-rr-arrow-left text-slate-600")
                                div
                                    h1(class="text-xl font-bold text-slate-800") Pop-up de bienvenida
                                    p(class="text-xs text-slate-400 mt-0.5") Modal que aparece al entrar a la tienda web

                            //- CUERPO: dos columnas
                            div(class="col-span-12 grid grid-cols-12 gap-4 items-start")

                                //- COLUMNA IZQUIERDA — Formulario
                                div(class="col-span-12 md:col-span-7 bg-gray-50 rounded-t-2xl p-3 shadow-sm border border-slate-100 overflow-hidden")
                                    h2(class="h2 text-gh-primaryHover")
                                        i.fi-rr-browser
                                        |  Configuración del popup
                                    p(class="text-sm text-slate-400 mb-4") Ajusta el contenido y comportamiento del modal

                                    form#form-popup(
                                        action=`/admin/web/popup/editar/${popup.idPopup}`
                                        method="post"
                                        class="flex flex-col gap-4 px-4 pb-4"
                                        enctype="multipart/form-data"
                                    )
                                        input(type="hidden" name="_csrf" value=csrfToken)

                                        div
                                            label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1") Imagen del popup
                                            input#popup-imagen-input(
                                                type="file"
                                                name="imagen"
                                                accept="image/*"
                                                class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-pink-50 file:text-pink-600 hover:file:bg-pink-100"
                                            )
                                            p(class="text-[10px] text-slate-400 mt-1") Tamaño recomendado: 600×600px. Se convierte a WebP automáticamente.

                                        div
                                            label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1") Título (opcional)
                                            input(
                                                type="text"
                                                name="titulo"
                                                value=popup.titulo || ''
                                                placeholder="¡Oferta especial!"
                                                maxlength="120"
                                                autocomplete="off"
                                                class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors"
                                            )

                                        div
                                            label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1") Link al hacer clic (opcional)
                                            input(
                                                type="text"
                                                name="link"
                                                value=popup.link || ''
                                                placeholder="/catalogo"
                                                class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors"
                                            )

                                        div
                                            label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1") Delay antes de aparecer (segundos)
                                            input(
                                                type="number"
                                                name="delaySegundos"
                                                value=popup.delaySegundos
                                                min="0"
                                                max="30"
                                                class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300/40 transition-colors"
                                            )

                                        div(class="flex items-center justify-between px-3 py-3 bg-white rounded-xl border border-slate-200")
                                            div
                                                p(class="text-xs font-semibold text-slate-700") Mostrar popup en la tienda web
                                                p(class="text-[10px] text-slate-400 mt-0.5") Aparecerá a los visitantes según el delay configurado
                                            label(class="flex items-center cursor-pointer")
                                                input#popup-activo(type="checkbox" name="activo" value="true" class="sr-only" checked=popup.activo)
                                                span.switch
                                                    span.switch-thumb

                                        button#btn-guardar-popup(
                                            type="submit"
                                            class="w-full py-3 bg-gh-primary text-white rounded-2xl font-bold text-sm hover:bg-gh-primaryHover transition-all active:scale-95 cursor-pointer"
                                        ) Guardar cambios

                                //- COLUMNA DERECHA — Vista previa
                                div(class="col-span-12 md:col-span-5 bg-gray-50 rounded-t-2xl p-3 shadow-sm border border-slate-100 overflow-hidden")
                                    h2(class="h2 text-gh-primaryHover")
                                        i.fi-rr-eye
                                        |  Vista previa actual
                                    p(class="text-sm text-slate-400 mb-4") Imagen configurada actualmente

                                    div(class="px-4 pb-4 flex flex-col gap-4")
                                        if popup.imagenUrl
                                            div(class="rounded-xl overflow-hidden border border-slate-200")
                                                img(src=popup.imagenUrl alt="Popup actual" class="w-full object-cover")
                                        else
                                            div(class="flex flex-col items-center justify-center py-16 bg-white rounded-xl border border-slate-200 text-center")
                                                i(class="fi fi-rr-browser text-4xl text-slate-200 mb-3 block")
                                                p(class="text-sm text-slate-400") Sin imagen configurada
                                                p(class="text-xs text-slate-300 mt-1") Sube una imagen desde el formulario

                                        if popup.activo
                                            div(class="flex items-center gap-3 px-4 py-3 bg-emerald-50 rounded-xl border border-emerald-100")
                                                i(class="fi fi-rr-check-circle text-emerald-500 text-lg flex-shrink-0")
                                                div
                                                    p(class="text-xs font-bold text-emerald-700") Popup activo
                                                    p(class="text-[10px] text-emerald-600 mt-0.5") Aparece a los #{popup.delaySegundos}s de entrar a la tienda
                                        else
                                            div(class="flex items-center gap-3 px-4 py-3 bg-slate-50 rounded-xl border border-slate-200")
                                                i(class="fi fi-rr-eye-crossed text-slate-400 text-lg flex-shrink-0")
                                                div
                                                    p(class="text-xs font-bold text-slate-600") Popup inactivo
                                                    p(class="text-[10px] text-slate-400 mt-0.5") No se muestra a los visitantes

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script.
            document.getElementById('form-popup').addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btn-guardar-popup');
                btn.disabled    = true;
                btn.textContent = 'Guardando...';

                const fd = new FormData(this);
                if (!document.getElementById('popup-activo').checked) fd.set('activo', 'false');

                try {
                    const resp = await fetch(this.action, { method: 'POST', body: fd });
                    const data = await resp.json();
                    if (data.success) {
                        await Swal.fire({ icon: 'success', title: data.mensaje, timer: 1800, showConfirmButton: false, confirmButtonColor: '#EC5FA3' });
                        location.reload();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje, confirmButtonColor: '#EC5FA3' });
                    }
                } catch {
                    Swal.fire({ icon: 'error', title: 'Error de red', confirmButtonColor: '#EC5FA3' });
                } finally {
                    btn.disabled    = false;
                    btn.textContent = 'Guardar cambios';
                }
            });
