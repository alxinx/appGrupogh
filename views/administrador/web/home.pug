extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- ── ENCABEZADO + ESTADO DE LA TIENDA ────────────────────────────────────
                            div(class="col-span-12 flex flex-col lg:flex-row gap-4")
                                div(class="flex-1 bg-white/70 backdrop-blur-md rounded-2xl p-5 flex items-center gap-4")
                                    div(class="w-20 h-20 rounded-full bg-gradient-to-br from-gray-200 to-purple-300 flex items-center justify-center flex-shrink-0 shadow-inner shadow-purple-700")
                                        img(src="/img/avatars/paginaWeb.webp" alt="Tienda Web" class="w-20 h-20 object-contain")
                                    div
                                        h1(class="font-bold text-slate-800 text-2xl leading-tight") Tienda Web
                                        p(class="text-xs text-slate-400") Gestiona y personaliza el contenido visual de tu sitio

                                div(class="lg:w-80 flex-shrink-0 bg-white rounded-2xl border border-slate-100 shadow-sm p-5 flex items-start gap-3")
                                    div(class="w-10 h-10 rounded-xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0")
                                        i(class="fi fi-rr-laptop text-gh-primaryHover")
                                    div(class="min-w-0")
                                        p(class="text-sm text-slate-600 flex items-center gap-1.5 flex-wrap")
                                            | Tu tienda está
                                            span(class="status-active inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-semibold border")
                                                span(class="status-dot")
                                                | activa
                                        p(class="text-xs text-slate-400 truncate mt-1")= webStoreUrl.replace(/^https?:\/\//, '')
                                        a(href=webStoreUrl target="_blank" rel="noopener" class="text-xs font-semibold text-gh-primaryHover hover:text-gh-primary inline-flex items-center gap-1 mt-1.5")
                                            | Visitar tienda
                                            i(class="fi fi-rr-arrow-up-right-from-square text-[10px]")

                            //- ── RESUMEN DE PEDIDOS + PRODUCTOS MÁS VISTOS (simulado) ────────────────
                            div(class="col-span-12 grid grid-cols-1 lg:grid-cols-[70%_30%] gap-4")

                                //- Resumen de pedidos
                                div(class="bg-gradient-to-br from-pink-50 via-white to-pink-50 rounded-3xl border border-pink-100 shadow-sm p-6")
                                    div(class="flex items-start justify-between mb-5")
                                        div(class="flex items-center gap-3")
                                            i(class="fi fi-rr-shopping-bag text-gh-primaryHover text-3xl leading-none")
                                            div
                                                h2(class="font-bold text-slate-800 text-lg") Resumen de pedidos
                                                p(class="text-xs text-slate-400") Monitorea los pedidos en tiempo real

                                    div(class="flex flex-col md:flex-row gap-3")
                                        div(class="md:w-[30%] flex-shrink-0 bg-white rounded-2xl border-2 border-gh-primary/50 shadow-lg shadow-pink-200/60 p-5 flex flex-col items-center text-center justify-center")
                                            p(class="text-lg font-bold text-gh-primaryHover mb-2") Pedidos nuevos
                                            p(class="text-5xl font-black text-gh-primaryHover mb-1")= resumenPedidos.nuevos
                                            p(class="text-xs text-slate-400 mb-4") Requieren atención
                                            a(href="/admin/web/pedidos" class="btn btn-sm inline-flex items-center gap-2 bg-gh-primaryHover text-white hover:bg-gh-primary focus-visible:ring-gh-primaryHover shadow-sm")
                                                | Ver pedidos
                                                i(class="fi fi-rr-arrow-right")

                                        div(class="flex-1 grid grid-cols-2 gap-3")
                                            div(class="bg-white rounded-2xl shadow-sm p-4")
                                                div(class="flex items-start justify-between mb-2")
                                                    p(class="text-sm text-slate-500") En proceso
                                                    div(class="w-9 h-9 rounded-full bg-amber-50 flex items-center justify-center flex-shrink-0")
                                                        i(class="fi fi-rr-time-fast text-amber-500 text-sm leading-none")
                                                p(class="text-2xl font-bold text-slate-800 mb-1")= resumenPedidos.enProceso
                                                a(href="/admin/web/pedidos?estado=trasladado" class="text-xs font-semibold text-amber-500 hover:underline") Ver detalles →

                                            div(class="bg-white rounded-2xl shadow-sm p-4")
                                                div(class="flex items-start justify-between mb-2")
                                                    p(class="text-sm text-slate-500") Pendientes de pago
                                                    div(class="w-9 h-9 rounded-full bg-blue-50 flex items-center justify-center flex-shrink-0")
                                                        i(class="fi fi-rr-credit-card text-blue-500 text-sm leading-none")
                                                p(class="text-2xl font-bold text-slate-800 mb-1")= resumenPedidos.pendientesPago
                                                a(href="/admin/web/pedidos?estado=pendiente_pago" class="text-xs font-semibold text-blue-500 hover:underline") Ver detalles →

                                            div(class="bg-white rounded-2xl shadow-sm p-4")
                                                div(class="flex items-start justify-between mb-2")
                                                    p(class="text-sm text-slate-500") Completados hoy
                                                    div(class="w-9 h-9 rounded-full bg-emerald-50 flex items-center justify-center flex-shrink-0")
                                                        i(class="fi fi-rr-check text-emerald-500 text-sm leading-none")
                                                p(class="text-2xl font-bold text-slate-800 mb-1")= resumenPedidos.completadosHoy
                                                a(href="/admin/web/pedidos?estado=facturado&fecha=hoy" class="text-xs font-semibold text-emerald-500 hover:underline") Ver detalles →

                                            div(class="bg-white rounded-2xl shadow-sm p-4")
                                                div(class="flex items-start justify-between mb-2")
                                                    p(class="text-sm text-slate-500") Cancelados hoy
                                                    div(class="w-9 h-9 rounded-full bg-red-50 flex items-center justify-center flex-shrink-0")
                                                        i(class="fi fi-rr-cross-circle text-red-500 text-sm leading-none")
                                                p(class="text-2xl font-bold text-slate-800 mb-1")= resumenPedidos.canceladosHoy
                                                a(href="/admin/web/pedidos?estado=cancelado&fecha=hoy" class="text-xs font-semibold text-red-500 hover:underline") Ver detalles →

                                //- Productos más vistos
                                div(class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5")
                                    div(class="flex items-center justify-between mb-4")
                                        div(class="flex items-center gap-2")
                                            i(class="fi fi-rr-eye text-gh-lila text-3xl leading-none")
                                            div
                                                h2(class="font-bold text-slate-800 text-lg") Productos más vistos
                                                p(class="text-xs text-slate-400") Top 5 productos con más visualizaciones

                                    if productosMasVistos.length
                                        div(class="space-y-4")
                                            each producto, index in productosMasVistos
                                                div(class="flex items-center gap-3")
                                                    div(class="w-10 h-10 rounded-lg bg-slate-100 flex-shrink-0 overflow-hidden flex items-center justify-center")
                                                        if producto.imagen
                                                            img(src=producto.imagen alt=producto.nombreProducto class="w-full h-full object-cover")
                                                        else
                                                            i(class="fi fi-rr-picture text-slate-300")
                                                    div(class="flex-1 min-w-0")
                                                        div(class="flex items-center justify-between gap-2 mb-1")
                                                            p(class="text-xs font-semibold text-slate-700 truncate")= producto.nombre
                                                            span(class="text-xs font-bold text-slate-500 flex-shrink-0")= `${producto.vistas.toLocaleString('es-CO')}`
                                                        div(class="h-1.5 bg-slate-100 rounded-full overflow-hidden")
                                                            div(class="h-full bg-gh-lila rounded-full" style=`width: ${Math.round((producto.vistas / maxVistas) * 100)}%`)
                                    else
                                        div(class="flex flex-col items-center justify-center py-10 text-center")
                                            i(class="fi fi-rr-chart-simple text-3xl text-slate-200 mb-2")
                                            p(class="text-xs text-slate-400") Todavía no hay vistas registradas en el sitio web.

                            //- ── GESTIONA TU TIENDA ──────────────────────────────────────────────────
                            div(class="col-span-12")
                                h2(class="text-xl font-bold text-slate-800 mb-3 px-1") Gestiona tu tienda
                                div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4")

                                    //- Pedidos
                                    a(href="/admin/web/pedidos" class="tarjetaBase border border-slate-100 hover:border-pink-200 transition-colors flex flex-col items-center text-center group")
                                        div(class="w-20 h-20 rounded-full bg-emerald-50 flex items-center justify-center mb-4")
                                            i(class="fi fi-rr-shopping-bag text-emerald-500 text-3xl leading-none")
                                        p(class="text-base font-bold text-slate-700 mb-1") Pedidos
                                        p(class="text-xs text-slate-400 leading-relaxed mb-4") Revisa y gestiona los pedidos hechos desde la tienda web.
                                        div(class="w-full mt-auto pt-3 border-t border-slate-100")
                                            span(class="inline-flex items-center gap-1 text-sm font-semibold text-gh-primaryHover group-hover:text-gh-primary")
                                                | Gestionar
                                                i(class="fi fi-rr-arrow-right text-xs")

                                    //- Banners y Cenefas
                                    a(href="/admin/web/banners" class="tarjetaBase border border-slate-100 hover:border-pink-200 transition-colors flex flex-col items-center text-center group")
                                        div(class="w-20 h-20 rounded-full bg-gh-primarySoft flex items-center justify-center mb-4")
                                            i(class="fi fi-rr-picture text-gh-primaryHover text-3xl leading-none")
                                        p(class="text-base font-bold text-slate-700 mb-1") Banners y Cenefas
                                        p(class="text-xs text-slate-400 leading-relaxed mb-4") Administra los banners principales y las cenefas informativas.
                                        div(class="w-full mt-auto pt-3 border-t border-slate-100")
                                            span(class="inline-flex items-center gap-1 text-sm font-semibold text-gh-primaryHover group-hover:text-gh-primary")
                                                | Gestionar
                                                i(class="fi fi-rr-arrow-right text-xs")

                                    //- Categorías
                                    a(href="/admin/web/categorias" class="tarjetaBase border border-slate-100 hover:border-pink-200 transition-colors flex flex-col items-center text-center group")
                                        div(class="w-20 h-20 rounded-full bg-purple-50 flex items-center justify-center mb-4")
                                            i(class="fi fi-rr-tags text-gh-lila text-3xl leading-none")
                                        p(class="text-base font-bold text-slate-700 mb-1") Categorías
                                        p(class="text-xs text-slate-400 leading-relaxed mb-4") Organiza las categorías y subcategorías de tus productos.
                                        div(class="w-full mt-auto pt-3 border-t border-slate-100")
                                            span(class="inline-flex items-center gap-1 text-sm font-semibold text-gh-primaryHover group-hover:text-gh-primary")
                                                | Gestionar
                                                i(class="fi fi-rr-arrow-right text-xs")

                                    //- Secciones y Pop-ups
                                    a(href="/admin/web/secciones" class="tarjetaBase border border-slate-100 hover:border-pink-200 transition-colors flex flex-col items-center text-center group")
                                        div(class="w-20 h-20 rounded-full bg-blue-50 flex items-center justify-center mb-4")
                                            i(class="fi fi-rr-apps text-blue-400 text-3xl leading-none")
                                        p(class="text-base font-bold text-slate-700 mb-1") Secciones y Pop-ups
                                        p(class="text-xs text-slate-400 leading-relaxed mb-4") Secciones destacadas y modal de bienvenida de la tienda.
                                        div(class="w-full mt-auto pt-3 border-t border-slate-100")
                                            span(class="inline-flex items-center gap-1 text-sm font-semibold text-gh-primaryHover group-hover:text-gh-primary")
                                                | Gestionar
                                                i(class="fi fi-rr-arrow-right text-xs")

                                    //- Tracking y Etiquetas
                                    a(href="/admin/web/tracking" class="tarjetaBase border border-slate-100 hover:border-pink-200 transition-colors flex flex-col items-center text-center group")
                                        div(class="w-20 h-20 rounded-full bg-amber-50 flex items-center justify-center mb-4")
                                            i(class="fi fi-rr-cursor text-amber-400 text-3xl leading-none")
                                        p(class="text-base font-bold text-slate-700 mb-1") Tracking y Etiquetas
                                        p(class="text-xs text-slate-400 leading-relaxed mb-4") Agrega y administra códigos de seguimiento y etiquetas.
                                        div(class="w-full mt-auto pt-3 border-t border-slate-100")
                                            span(class="inline-flex items-center gap-1 text-sm font-semibold text-gh-primaryHover group-hover:text-gh-primary")
                                                | Gestionar
                                                i(class="fi fi-rr-arrow-right text-xs")

                                    //- Páginas secundarias
                                    a(href="/admin/web/paginas" class="tarjetaBase border border-slate-100 hover:border-pink-200 transition-colors flex flex-col items-center text-center group")
                                        div(class="w-20 h-20 rounded-full bg-emerald-50 flex items-center justify-center mb-4")
                                            i(class="fi fi-rr-document text-emerald-400 text-3xl leading-none")
                                        p(class="text-base font-bold text-slate-700 mb-1") Páginas secundarias
                                        p(class="text-xs text-slate-400 leading-relaxed mb-4") Administra páginas informativas como FAQ, Términos, etc.
                                        div(class="w-full mt-auto pt-3 border-t border-slate-100")
                                            span(class="inline-flex items-center gap-1 text-sm font-semibold text-gh-primaryHover group-hover:text-gh-primary")
                                                | Gestionar
                                                i(class="fi fi-rr-arrow-right text-xs")

                            //- ── RESUMEN RÁPIDO ──────────────────────────────────────────────────────
                            div(class="col-span-12")
                                div(class="flex items-center gap-2 mb-3 px-1")
                                    h2(class="text-xl font-bold text-slate-800") Resumen rápido

                                div(class="grid grid-cols-2 lg:grid-cols-4 gap-4")
                                    div(class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex items-center gap-3")
                                        div(class="w-10 h-10 rounded-xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0")
                                            i(class="fi fi-rr-box text-gh-primaryHover")
                                        div
                                            p(class="text-xs text-slate-400") Productos activos
                                            p(class="text-xl font-bold text-slate-800")= resumenRapido.productosActivos

                                    div(class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex items-center gap-3")
                                        div(class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                                            i(class="fi fi-rr-users text-blue-400")
                                        div
                                            p(class="text-xs text-slate-400") Visitas hoy
                                            p(class="text-xl font-bold text-slate-800")= resumenRapido.visitasHoy.toLocaleString('es-CO')

                                    div(class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex items-center gap-3")
                                        div(class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0")
                                            i(class="fi fi-rr-sack-dollar text-emerald-400")
                                        div
                                            p(class="text-xs text-slate-400") Ventas hoy
                                            p(class="text-xl font-bold text-slate-800")= `$${resumenRapido.ventasHoy.toLocaleString('es-CO')}`

                                    div(class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex items-center gap-3")
                                        div(class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0")
                                            i(class="fi fi-rr-chart-line-up text-amber-400")
                                        div
                                            p(class="text-xs text-slate-400") Tasa de conversión
                                            p(class="text-xl font-bold text-slate-800")= `${resumenRapido.tasaConversion}%`
