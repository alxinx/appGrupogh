extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- HEADER
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                div(class="flex flex-row items-center justify-between gap-4")
                                    div(class="flex flex-row items-center gap-4")
                                        div(class="w-14 h-14 rounded-full bg-gradient-to-br from-pink-100 to-purple-200 flex items-center justify-center flex-shrink-0 shadow-inner shadow-purple-400")
                                            i(class="fi fi-rr-user-add text-2xl text-pink-400")
                                        div(class="flex flex-col gap-0.5 text-left")
                                            h1.h1= modoEdicion ? 'Editar Cliente' : 'Nuevo Cliente'
                                            p(class="text-sm text-slate-400")= modoEdicion ? 'Actualiza los datos del cliente' : 'Registra un cliente persona natural o empresa'
                                    a(href="/admin/clientes" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-slate-500 bg-white border border-slate-200 hover:bg-slate-50 transition-colors")
                                        i(class="fi fi-rr-arrow-left text-sm")
                                        span Volver

                            //- FORMULARIO
                            include ./forms/nuevoCliente.pug

                script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
                script(src="/js/dataCliente.js")
