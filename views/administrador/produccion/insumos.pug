extends ../../layout/index
block contenedor
    include ../../components/headerAdmin
    include ../../components/modalConfirmacion

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- HEADER
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                +headerAdmin({
                                    avatar:    '/img/avatars/insumos.webp',
                                    titulo:    subPagina,
                                    subtitulo: subtitulo
                                })
                                //- Estándar de botones de header (views/components/accionesAdmin.pug):
                                //- la acción principal de la pantalla, sola, a la derecha.
                                if puede('Insumos', 'CREATE')
                                    div(class="flex items-center gap-3 justify-center md:justify-end flex-wrap mt-4")
                                        button#btn-nuevo-insumo(type="button" class="btn btn-danger flex items-center gap-2")
                                            i(class="fi fi-rr-box-open-full")
                                            | Nuevo insumo

                            //- CATÁLOGO
                            div(class="col-span-12")
                                section(class="cards cardsWhite p-6 flex flex-col gap-4")
                                    div(class="flex items-center justify-between gap-4 mb-4")
                                        h2(class="text-lg font-bold text-slate-800") Catálogo
                                        p(id="conteo-materiales" class="text-sm text-slate-500")
                                            = materiales.length === 1 ? '1 material' : `${materiales.length} materiales`

                                    //- Filtra sobre las filas ya renderizadas: el catálogo se trae completo
                                    //- (es chico, ver produccionController.js), así que no hace falta una
                                    //- consulta nueva por cada búsqueda — src/js/insumos.js solo muestra u
                                    //- oculta <tr>, los cuatro filtros se combinan entre sí.
                                    div(class="flex flex-wrap items-center gap-3 mb-2")
                                        div(class="relative flex-1 min-w-[180px]")
                                            input(type="text" id="busqueda-material" placeholder="Buscar por nombre o código..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            i(class="fi-rr-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs")
                                        select#filtro-tipo-material(class="py-2 px-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            option(value="") Todos los tipos
                                            each t in tiposInsumo
                                                option(value=t.valor)= t.etiqueta
                                        select#filtro-unidad-material(class="py-2 px-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            option(value="") Todas las unidades
                                            each u in unidadesCompra
                                                option(value=u.valor)= u.etiqueta
                                        select#filtro-estado-material(class="py-2 px-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            option(value="") Todos los estados
                                            option(value="activo") Activo
                                            option(value="inactivo") Inactivo
                                        button#limpiar-filtros-material(type="button" class="hidden text-xs text-gh-primaryHover hover:underline cursor-pointer") Limpiar

                                    div(class="overflow-x-auto")
                                        table(class="w-full text-sm")
                                            thead
                                                tr(class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200")
                                                    th(class="py-2 pr-3 font-semibold") Material
                                                    th(class="py-2 pr-3 font-semibold text-center") Código DXF
                                                    th(class="py-2 pr-3 font-semibold") Unidad
                                                    th(class="py-2 pr-3 font-semibold text-center") Cantidad
                                                    th(class="py-2 pr-3 font-semibold") Estado
                                                    th(class="py-2 font-semibold text-right") Acción
                                            tbody(id="tabla-materiales")
                                                if materiales.length
                                                    each m in materiales
                                                        tr(
                                                            class="border-b border-slate-100 hover:bg-slate-50 transition-colors"
                                                            data-nombre=m.nombre.toLowerCase()
                                                            data-codigo=m.codigoMaterial
                                                            data-tipo=m.tipo
                                                            data-unidad=m.unidadCompra || ''
                                                            data-activo=m.activo ? '1' : '0'
                                                        )
                                                            td(class="py-3 pr-3")
                                                                div(class="flex items-center gap-3")
                                                                    img(src=m.imagenUrl || m.icono alt=m.tipoEtiqueta loading="lazy" class="w-14 h-14 rounded-xl bg-slate-100 p-2 object-contain flex-shrink-0")
                                                                    div(class="min-w-0")
                                                                        p(class="font-semibold text-slate-800")= m.nombre
                                                                        p(class="text-xs text-slate-500")= m.tipoEtiqueta
                                                            td(class="py-3 pr-3 font-semibold text-slate-800 tabular-nums text-center")= m.codigoMaterial
                                                            td(class="py-3 pr-3 text-slate-600")= m.unidadEtiqueta
                                                            td(class="py-3 pr-3 text-slate-600 tabular-nums text-center")= m.cantidadFicticia
                                                            td(class="py-3 pr-3")
                                                                span(class=`status-chip ${m.activo ? 'status-active' : 'bg-slate-100 border-slate-200 text-slate-500'}`)= m.activo ? 'Activo' : 'Inactivo'
                                                            td(class="py-3 text-right")
                                                                a(href=`/admin/insumos/${m.idMaterial}` class="btn btn-secondary")
                                                                    i(class="fi fi-rr-arrow-right text-xs")
                                                                    | Ver perfil
                                                else
                                                    tr
                                                        td(colspan="6" class="py-12 text-center text-sm text-slate-400")
                                                            | Todavía no hay materiales en el catálogo. Agrega el primero desde el formulario.
                                            tbody
                                                tr#sin-resultados-material(class="hidden")
                                                    td(colspan="6" class="py-12 text-center text-sm text-slate-400")
                                                        | Ningún material coincide con el filtro.

                            //- MODAL — alta de insumo. Mismo estilo de modal que el resto del panel
                            //- (views/components/modals.pug, "Finalizar Venta"/"Hacer Traslado"): overlay
                            //- oscuro con blur + tarjeta blanca redondeada, cabecera con icono y cierre.
                            //- Lo abre el botón del header, el submenu "Nuevo insumo" (?nuevo=1, ver
                            //- src/js/insumos.js) o queda cerrado por defecto.
                            div#modal-nuevo-insumo(class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/40 backdrop-blur-md")
                                div(class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden")

                                    //- Header
                                    div(class="flex items-center justify-between px-8 py-5 border-b border-gray-100 flex-shrink-0")
                                        div(class="flex items-center gap-4")
                                            div(class="w-10 h-10 rounded-2xl bg-gh-primary flex items-center justify-center shadow-lg shadow-gh-primary/30")
                                                i(class="fi fi-rr-boxes text-white")
                                            div
                                                h2(class="text-lg font-bold text-slate-800") Nuevo insumo
                                                p(class="text-sm text-slate-500") Se agrega al catálogo al confirmar.
                                        button#modal-nuevo-insumo-cerrar(type="button" class="w-9 h-9 flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer")
                                            i(class="fi fi-rr-cross-small text-xl")

                                    //- FORMULARIO DE ALTA
                                    form(id="form-insumo" novalidate class="flex-1 overflow-y-auto px-8 py-6 flex flex-col gap-5"
                                        data-csrf=csrfToken
                                        data-codigo-min=limites.codigoMin
                                        data-codigo-max=limites.codigoMax
                                        data-nombre-max=limites.nombreMax)

                                        //- Código y nombre en una misma fila: el código es corto, el nombre ocupa el resto.
                                        div(class="grid grid-cols-12 gap-4 items-start")
                                            div(class="col-span-4 flex flex-col gap-1")
                                                label(class="label label-required" for="codigoMaterial") Código DXF
                                                input#codigoMaterial.field-text(name="codigoMaterial" type="text" inputmode="numeric" autocomplete="off" placeholder="1" maxlength="10")
                                                p#error-codigoMaterial(class="label-error text-xs hidden")

                                            div(class="col-span-8 flex flex-col gap-1")
                                                label#label-nombre(class="label label-required" for="nombre") Nombre insumo / materia prima
                                                input#nombre.field-text(name="nombre" type="text" autocomplete="off" placeholder="Ej. Tela algodón blanca" maxlength=limites.nombreMax)
                                                p#error-nombre(class="label-error text-xs hidden")

                                        p(class="helper-text") Es el número de Material que trae el archivo de corte (1, 2, 3…).

                                        fieldset(class="flex flex-col gap-2")
                                            legend(class="label label-required") Tipo
                                            div(class="grid grid-cols-1 sm:grid-cols-2 gap-3")
                                                each t in tiposInsumo
                                                    label(class="cursor-pointer")
                                                        input(type="radio" name="tipo" value=t.valor data-etiqueta=t.etiqueta data-etiqueta-nombre=t.etiquetaNombre class="peer sr-only")
                                                        div(class="flex items-center gap-3 h-full rounded-xl border-2 border-slate-200 bg-white p-3 transition peer-checked:border-gh-primary peer-checked:bg-gh-primarySoft peer-focus-visible:ring-2 peer-focus-visible:ring-gh-primary")
                                                            img(src=t.icono alt=t.etiqueta class="w-11 h-11 rounded-lg bg-slate-100 p-1.5 object-contain flex-shrink-0")
                                                            div(class="min-w-0")
                                                                p(class="text-sm font-semibold text-slate-800")= t.etiqueta
                                                                p(class="text-xs text-slate-500 leading-snug")= t.detalle
                                            p#error-tipo(class="label-error text-xs hidden")

                                        div(class="flex flex-col gap-1")
                                            label(class="label" for="unidadCompra") Unidad de compra
                                            div(class="select-wrapper")
                                                select#unidadCompra.field-text.appearance-none.pr-10(name="unidadCompra")
                                                    option(value="") Sin unidad
                                                    each u in unidadesCompra
                                                        option(value=u.valor)= u.etiqueta
                                                span(class="select-icon")
                                                    i(class="fi-rr-chevron-double-down")
                                            p#error-unidadCompra(class="label-error text-xs hidden")

                                        //- Mismo patrón de carga con vista previa real que el modal de QR de
                                        //- pago (views/administrador/bankentities/listado.pug): caja punteada,
                                        //- input invisible encima, y al elegir archivo la imagen de verdad
                                        //- reemplaza el ícono — no solo cambia de color.
                                        div(class="flex flex-col gap-1")
                                            label(class="label") Foto (opcional)
                                            div(class="relative group")
                                                input#imagen(type="file" name="imagen" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" accept=".jpg,.jpeg,.png,.webp")
                                                div(class="inputUpload_mini")
                                                    img#preview-imagen(class="hidden w-20 h-20 object-contain mb-2 rounded-lg bg-white border border-slate-200")
                                                    div#icono-imagen(class="w-14 h-14 bg-white shadow-sm rounded-full flex items-center justify-center mb-2 text-purple-500")
                                                        i.fi-rr-picture.text-2xl
                                                    span#nombre-archivo-imagen(class="text-sm font-bold text-gray-600") Sube o arrastra la foto del material
                                                    span(class="text-xs text-gray-400 mt-1") JPG, PNG o WebP, hasta 2MB
                                            p#error-imagen(class="label-error text-xs hidden")

                                        div(class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100")
                                            button(type="button" id="btn-limpiar-insumo" class="btn btn-secondary") Limpiar
                                            button(type="submit" id="btn-guardar-insumo" class="btn btn-danger") Guardar insumo

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script(src="/js/insumos.js")
