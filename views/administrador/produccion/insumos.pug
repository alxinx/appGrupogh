extends ../../layout/index
block contenedor
    include ../../components/headerAdmin
    include ../../components/modalConfirmacion
    include ../../components/modalNuevoInsumo.pug
    include ../../components/existenciaInsumo.pug

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- HEADER
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-2 bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                +headerAdmin({
                                    avatar:    '/img/avatars/insumos.webp',
                                    titulo:    subPagina,
                                    subtitulo: subtitulo
                                })
                                //- Estándar de botones de header (views/components/accionesAdmin.pug):
                                //- la acción principal de la pantalla, sola, a la derecha.
                                if puede('Insumos', 'CREATE')
                                    div(class="flex items-center gap-3 justify-center md:justify-end flex-wrap")
                                        button#btn-nuevo-insumo(type="button" class="btn btn-danger flex items-center gap-2")
                                            i(class="fi fi-rr-box-open-full")
                                            | Nuevo insumo

                            //- CATÁLOGO
                            div(class="col-span-12")
                                section(class="cards cardsWhite p-6 flex flex-col gap-4")
                                    div(class="flex items-center justify-between gap-4 mb-4")
                                        h2(class="text-lg font-bold text-slate-800") Catálogo
                                        div(class="flex items-center gap-4")
                                            p(id="conteo-materiales" class="text-sm text-slate-500")
                                                = materiales.length === 1 ? '1 material' : `${materiales.length} materiales`
                                            //- Lista o cuadrícula: lo elige el operador y su navegador lo recuerda
                                            //- (src/js/insumos.js). Las dos vistas son el mismo catálogo y los
                                            //- mismos filtros.
                                            div(class="inline-flex p-1 rounded-xl bg-slate-100" role="group" aria-label="Vista del catálogo")
                                                button(type="button" data-vista="lista" aria-pressed="true" title="Ver como lista"
                                                    class="vista-catalogo-btn w-9 h-8 rounded-lg flex items-center justify-center text-slate-500 cursor-pointer")
                                                    i(class="fi fi-rr-list")
                                                button(type="button" data-vista="cuadricula" aria-pressed="false" title="Ver como cuadrícula"
                                                    class="vista-catalogo-btn w-9 h-8 rounded-lg flex items-center justify-center text-slate-500 cursor-pointer")
                                                    i(class="fi fi-rr-apps")

                                    //- Filtra sobre las filas ya renderizadas: el catálogo se trae completo
                                    //- (es chico, ver produccionController.js), así que no hace falta una
                                    //- consulta nueva por cada búsqueda — src/js/insumos.js solo muestra u
                                    //- oculta <tr>, los cuatro filtros se combinan entre sí.
                                    div(class="flex flex-wrap items-center gap-3 mb-2")
                                        div(class="relative flex-1 min-w-[180px]")
                                            input(type="text" id="busqueda-material" placeholder="Buscar por nombre o código..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            i(class="fi-rr-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs")
                                        select#filtro-tipo-material(class="py-2 px-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            option(value="") Todos los tipos
                                            each t in tiposInsumo
                                                option(value=t.valor)= t.etiqueta
                                        select#filtro-unidad-material(class="py-2 px-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            option(value="") Todas las unidades
                                            each u in unidadesCompra
                                                option(value=u.valor)= u.etiqueta
                                        select#filtro-estado-material(class="py-2 px-3 bg-slate-50 border border-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gh-primaryHover/20")
                                            option(value="") Todos los estados
                                            option(value="activo") Activo
                                            option(value="inactivo") Inactivo
                                        button#limpiar-filtros-material(type="button" class="hidden text-xs text-gh-primaryHover hover:underline cursor-pointer") Limpiar

                                    div#vista-lista-materiales(class="overflow-x-auto")
                                        table(class="w-full text-sm")
                                            thead
                                                tr(class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200")
                                                    th(class="py-2 pr-3 font-semibold") Material
                                                    th(class="py-2 pr-3 font-semibold text-center") Código DXF
                                                    th(class="py-2 pr-3 font-semibold") Unidad
                                                    th(class="py-2 pr-3 font-semibold text-center") Existencia
                                                    th(class="py-2 pr-3 font-semibold") Estado
                                                    th(class="py-2 font-semibold text-right") Acción
                                            tbody(id="tabla-materiales")
                                                if materiales.length
                                                    each m in materiales
                                                        tr(
                                                            class=`border-b border-slate-100 hover:bg-slate-50 transition-colors ${m.esVariante ? 'bg-slate-50/40' : ''}`
                                                            data-nombre=m.nombre.toLowerCase()
                                                            data-codigo=m.codigoMaterial
                                                            data-tipo=m.tipo
                                                            data-unidad=m.unidadCompra || ''
                                                            data-activo=m.activo ? '1' : '0'
                                                            data-material
                                                        )
                                                            td(class="py-3 pr-3")
                                                                div(class=`flex items-center gap-3 ${m.esVariante ? 'pl-6' : ''}`)
                                                                    if m.esVariante
                                                                        //- Conector visual de jerarquía
                                                                        span(class="text-slate-300 text-base select-none flex-shrink-0 -ml-5 mr-1") ↳
                                                                    img(src=m.imagenUrl || m.icono alt=m.tipoEtiqueta loading="lazy" class="w-14 h-14 rounded-xl bg-slate-100 p-2 object-contain flex-shrink-0")
                                                                    div(class="min-w-0")
                                                                        p(class="font-semibold text-slate-800")= m.nombre
                                                                        if m.esVariante && m.padreNombre
                                                                            p(class="text-xs text-gh-primaryHover font-medium")
                                                                                | Variante de #{m.padreNombre}
                                                                        else
                                                                            p(class="text-xs text-slate-500")= m.tipoEtiqueta
                                                            td(class="py-3 pr-3 font-semibold text-slate-800 tabular-nums text-center")= m.codigoMaterial
                                                            td(class="py-3 pr-3 text-slate-600")= m.unidadEtiqueta
                                                            td(class="py-3 pr-3")
                                                                +existenciaInsumo(m)
                                                            td(class="py-3 pr-3")
                                                                span(class=`status-chip ${m.activo ? 'status-active' : 'bg-slate-100 border-slate-200 text-slate-500'}`)= m.activo ? 'Activo' : 'Inactivo'
                                                            td(class="py-3 text-right")
                                                                a(href=`/admin/insumos/${m.idMaterial}` class="btn btn-secondary")
                                                                    i(class="fi fi-rr-arrow-right text-xs")
                                                                    | Ver perfil
                                                else
                                                    tr
                                                        td(colspan="6" class="py-12 text-center text-sm text-slate-400")
                                                            | Todavía no hay materiales en el catálogo. Agrega el primero desde el formulario.

                                    //- Cuadrícula: las mismas tarjetas que filas, con los mismos data-* para
                                    //- que los filtros las alcancen igual.
                                    div#vista-cuadricula-materiales(class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4")
                                        each m in materiales
                                            a(href=`/admin/insumos/${m.idMaterial}`
                                                class="group flex flex-col rounded-2xl border border-slate-100 bg-white overflow-hidden hover:border-gh-primary hover:shadow-md transition-all"
                                                data-nombre=m.nombre.toLowerCase()
                                                data-codigo=m.codigoMaterial
                                                data-tipo=m.tipo
                                                data-unidad=m.unidadCompra || ''
                                                data-activo=m.activo ? '1' : '0'
                                                data-material)
                                                //- Cuadrado fijo: la imagen va absoluta adentro, así una foto alta o ancha no
                                                //- estira la tarjeta (con la imagen en el flujo, su alto le ganaba al
                                                //- aspect-square y la cuadrícula quedaba desalineada).
                                                div(class="relative aspect-square overflow-hidden bg-slate-50")
                                                    //- Una tela es textura: se recorta para llenar el cuadrado. Un insumo
                                                    //- (herraje, cierre) se ve entero, con aire alrededor.
                                                    - const ajusteFoto = !m.imagenUrl ? 'object-contain p-8' : m.tipo === 'materia_prima' ? 'object-cover' : 'object-contain p-4 bg-white'
                                                    img(src=m.imagenUrl || m.icono alt=m.nombre loading="lazy" class=`absolute inset-0 w-full h-full ${ajusteFoto}`)
                                                    span(class=`absolute top-2 left-2 status-chip text-[10px] py-0.5 ${m.activo ? 'status-active' : 'bg-slate-100 border-slate-200 text-slate-500'}`)= m.activo ? 'Activo' : 'Inactivo'
                                                    span(class="absolute top-2 right-2 px-2 py-0.5 rounded-lg bg-white/90 text-[11px] font-bold text-slate-700 tabular-nums")= m.codigoMaterial
                                                div(class="p-3 flex flex-col gap-2 flex-1")
                                                    div(class="min-w-0")
                                                        p(class="font-semibold text-slate-800 truncate group-hover:text-gh-primaryHover")= m.nombre
                                                        if m.esVariante && m.padreNombre
                                                            p(class="text-xs text-gh-primaryHover font-medium truncate") Variante de #{m.padreNombre}
                                                        else
                                                            p(class="text-xs text-slate-500")= `${m.tipoEtiqueta} · ${m.unidadEtiqueta}`
                                                    div(class="mt-auto pt-2 border-t border-slate-100")
                                                        +existenciaInsumo(m, { centrado: false })

                                    p#sin-resultados-material(class="hidden py-12 text-center text-sm text-slate-400") Ningún material coincide con el filtro.

                            +modalNuevoInsumo({ tiposInsumo, unidadesCompra, unidadesConsumo, limites })

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        //- helpers.js antes: el formulario lee cantidades con window.leerDecimal.
        script(src="/js/helpers.js")
        script(src="/js/insumos.js")
