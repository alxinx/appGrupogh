extends ../../layout/index
block contenedor
    //- Listado de órdenes de corte (controller/ordenCorteController.js homeCortes). Las más
    //- recientes primero.
    include ../../components/headerAdmin

    - var claseEstado = { borrador: 'table-badge-pending', cortada: 'table-badge-active', cancelada: 'table-badge-low' }
    - var etiquetaFiltro = { abiertos: 'Por cortar', cortada: 'Cortados', cancelada: 'Cancelados', todos: 'Todos' }
    - var fechaCorta = function (f) { return new Date(f).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'America/Bogota' }); }
    - var fechaDia = function (f) { return new Date(`${f}T12:00:00-05:00`).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'America/Bogota' }); }

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4")
                                +headerAdmin({
                                    icono:     'fi-rr-scissors',
                                    titulo:    'Órdenes de corte',
                                    subtitulo: 'Del trazo de Optitex a las prendas cortadas',
                                    iconoSub:  'fi-rr-ruler-combined'
                                })
                                if puedeAdmin('Procesos', 'CREATE')
                                    div(class="flex items-center gap-2 flex-shrink-0")
                                        a(href="/admin/procesos/cortes/nuevo" class="btn btn-danger flex items-center gap-2")
                                            i(class="fi fi-rr-upload")
                                            | Subir trazo

                            div(class="col-span-12 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                div(class="p-4 flex flex-wrap items-center justify-between gap-3 border-b border-slate-100")
                                    nav(class="flex flex-wrap gap-1.5" aria-label="Filtrar por estado")
                                        each f in filtros
                                            a(href=`/admin/procesos/cortes?estado=${f}`
                                              aria-current=f === filtro ? 'page' : false
                                              class=`text-xs font-semibold px-3 py-1.5 rounded-full border transition-colors ${f === filtro ? 'bg-gh-primarySoft border-gh-primary text-gh-primaryHover' : 'border-slate-200 text-slate-600 hover:border-gh-primary'}`)= etiquetaFiltro[f]
                                    span(class="text-sm text-slate-500")= `${total.toLocaleString('es-CO')} ${total === 1 ? 'corte' : 'cortes'}`

                                if !cortes.length
                                    div(class="px-6 py-14 flex flex-col items-center text-center gap-2")
                                        i(class="fi fi-rr-scissors text-2xl text-slate-300")
                                        span(class="text-sm font-semibold text-slate-500") No hay cortes en este filtro
                                        span(class="text-xs text-slate-400") Un corte empieza subiendo el trazo que armaste en Optitex.
                                else
                                    div(class="overflow-x-auto")
                                        table(class="w-full text-sm")
                                            thead
                                                tr(class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 bg-slate-50")
                                                    th(class="py-3 px-5") Corte
                                                    th(class="py-3 px-5") Referencias
                                                    th(class="py-3 px-5 text-right") Capas
                                                    th(class="py-3 px-5 text-right") Prendas
                                                    th(class="py-3 px-5") Para
                                                    th(class="py-3 px-5") Estado
                                                    th(class="py-3 px-5 text-right") Ver
                                            tbody
                                                each c in cortes
                                                    tr(class="border-b border-slate-100 last:border-0")
                                                        td(class="py-3.5 px-5")
                                                            span(class="font-bold text-slate-800")= c.numeroCorte
                                                            div(class="text-xs text-slate-400")= `${c.tela} · ${c.largoM.toLocaleString('es-CO', { maximumFractionDigits: 2 })} m · ${fechaCorta(c.createdAt)}`
                                                        td(class="py-3.5 px-5 text-slate-700")
                                                            each r, i in c.referencias
                                                                span(class="block text-xs")= r
                                                        td(class="py-3.5 px-5 text-right text-slate-700")= c.capas.toLocaleString('es-CO')
                                                        td(class="py-3.5 px-5 text-right font-semibold text-slate-800")= c.prendas.toLocaleString('es-CO')
                                                        td(class="py-3.5 px-5 text-slate-600")= fechaDia(c.fechaRequerida)
                                                        td(class="py-3.5 px-5")
                                                            span(class=`table-badge ${claseEstado[c.estado]}`)
                                                                span(class="table-badge-dot")
                                                                = etiquetaEstado[c.estado]
                                                        td(class="py-3.5 px-5 text-right")
                                                            a(href=`/admin/procesos/cortes/${c.idOrdenCorte}` class="inline-flex items-center gap-1.5 text-xs font-bold text-gh-primaryHover hover:underline")
                                                                i(class="fi fi-rr-eye text-xs")
                                                                | Ver
                                    if totalPaginas > 1
                                        nav(class="p-4 flex items-center justify-center gap-2 border-t border-slate-100" aria-label="Páginas")
                                            if paginaActual > 1
                                                a(href=`/admin/procesos/cortes?estado=${filtro}&pagina=${paginaActual - 1}` class="btn btn-secondary btn-sm text-xs") Anterior
                                            span(class="text-xs text-slate-500")= `Página ${paginaActual} de ${totalPaginas}`
                                            if paginaActual < totalPaginas
                                                a(href=`/admin/procesos/cortes?estado=${filtro}&pagina=${paginaActual + 1}` class="btn btn-secondary btn-sm text-xs") Siguiente
