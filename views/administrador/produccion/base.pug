extends ../../layout/index
block contenedor
    include ../../components/headerAdmin

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- HEADER
                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                +headerAdmin({
                                    icono:     icono,
                                    titulo:    titulo,
                                    subtitulo: subtitulo,
                                    iconoSub:  'fi-rr-wrench'
                                })

                            //- ESTADO VACÍO — base del módulo, sin listado ni formulario todavía.
                            div(class="col-span-12 animate-fade-in")
                                div(class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                    div(class="flex flex-col items-center text-center gap-4 px-6 py-16")
                                        div(class="w-16 h-16 rounded-2xl bg-gh-primarySoft flex items-center justify-center")
                                            i(class=`fi ${icono} text-2xl text-gh-primaryHover`)
                                        div(class="max-w-md")
                                            h2(class="text-lg font-bold text-slate-800")= `${titulo} está en construcción`
                                            p(class="text-sm text-slate-400 mt-1") Todavía no tiene listado ni formulario propio. Esta pantalla es la base sobre la que se va a construir el módulo.
