extends ../../layout/index
block contenedor
    //- Primer paso de una orden nueva: elegir la ficha de confección (solo activas). Lleva a
    //- /admin/procesos/ordenes/nueva?ficha=<id>. Desde el editor de una ficha se llega directo.
    include ../../components/headerAdmin

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4")
                                +headerAdmin({
                                    icono:     'fi-rr-list-check',
                                    titulo:    'Nueva orden de producción',
                                    subtitulo: 'Elige la ficha de la prenda que se va a producir',
                                    iconoSub:  'fi-rr-tshirt'
                                })
                                div(class="flex items-center gap-2 flex-shrink-0")
                                    a(href="/admin/procesos/ordenes" class="btn btn-secondary btn-sm text-xs whitespace-nowrap")
                                        i(class="fi fi-rr-arrow-left text-xs")
                                        | Volver

                            div(class="col-span-12 bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-4")
                                if !fichas.length
                                    div(class="py-10 flex flex-col items-center text-center gap-2")
                                        i(class="fi fi-rr-document-signed text-2xl text-slate-300")
                                        span(class="text-sm font-semibold text-slate-500") No hay fichas de confección activas
                                        a(href="/admin/procesos/fichas-confeccion/nueva" class="text-xs font-bold text-gh-primaryHover hover:underline") Crear una ficha
                                else
                                    input#buscar-ficha-orden(type="search" autocomplete="off" placeholder="Buscar por referencia o tela…" aria-label="Buscar ficha" class="field-text")
                                    div#lista-fichas-orden(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3")
                                        each f in fichas
                                            a(href=`/admin/procesos/ordenes/nueva?ficha=${f.idFicha}`
                                              data-texto=`${f.referencia} ${f.materialNombre}`.toLowerCase()
                                              class="flex items-center gap-3 p-3 border border-slate-100 rounded-2xl hover:bg-gh-primarySoft/40 hover:border-gh-primary/30 transition-colors")
                                                span(class="w-12 h-12 rounded-xl bg-slate-100 flex-shrink-0 overflow-hidden flex items-center justify-center text-slate-400")
                                                    img(src=`/admin/procesos/fichas-confeccion/${f.idFicha}/imagen` alt="" loading="lazy" class="w-full h-full object-cover" onerror="this.remove()")
                                                span(class="min-w-0")
                                                    span(class="block text-sm font-semibold text-slate-800 truncate")= f.referencia
                                                    span(class="block text-xs text-slate-400 truncate")= f.materialNombre
                                    p#sin-resultados-ficha(class="hidden text-sm text-slate-400") Ninguna ficha coincide con la búsqueda.

        script.
            (function () {
                var input = document.getElementById('buscar-ficha-orden');
                if (!input) return;
                var items = document.querySelectorAll('#lista-fichas-orden [data-texto]');
                var vacio = document.getElementById('sin-resultados-ficha');
                input.addEventListener('input', function () {
                    var t = input.value.toLowerCase().trim();
                    var visibles = 0;
                    items.forEach(function (a) { var ok = a.dataset.texto.indexOf(t) !== -1; a.style.display = ok ? '' : 'none'; if (ok) visibles++; });
                    vacio.classList.toggle('hidden', visibles > 0);
                });
            })();
