extends ../../layout/index
block contenedor
    //- Estilos de las ventanas de confirmación (gh-conf-*): las usan "Editar insumo" y
    //- "Suspender/Reactivar" (src/js/insumoPerfil.js, vía modalConfirmacion.js).
    include ../../components/modalConfirmacion

    //- Mismo estilo de "perfil" que ya usa el panel (views/administrador/bankentities/
    //- perfilCajaBanco.pug): tarjeta de identidad con imagen + estado + acciones, grilla de
    //- indicadores debajo. No usa el mixin headerAdmin porque esta cabecera lleva imagen,
    //- insignias, descripción y composición — más de lo que ese mixin resuelve.
    //-
    //- Casi todo acá es dato de relleno (ver el comentario grande en helpers/insumos.js,
    //- `datosFicticiosInsumo`): no hay todavía stock real, costos de compra ni proveedores
    //- por insumo. Lo real (nombre, tipo, código DXF, estado, fechas) viene de `material`;
    //- de `datos`, todo es relleno a reemplazar SALVO `historialCompras`, que ya sale de
    //- ORDENES_COMPRA/DETALLES_ORDEN_COMPRA (helpers/insumos.js, historialComprasInsumo).

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- ── MIGA DE PAN ───────────────────────────────────────────
                            div(class="col-span-12 flex items-center gap-2 text-sm")
                                a(href="/admin/insumos" class="flex items-center gap-1.5 text-slate-500 hover:text-gh-primaryHover transition-colors")
                                    i(class="fi fi-rr-boxes text-xs")
                                    | Insumos
                                i(class="fi fi-rr-angle-small-right text-[10px] text-slate-300")
                                span(class="text-slate-700 font-semibold") Detalle de insumo

                            div(class="col-span-12 grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-4 items-start")

                                //- ══════════════════════════ COLUMNA IZQUIERDA ══════════════════════════
                                div(class="flex flex-col gap-4 min-w-0")

                                    //- ── IDENTIDAD DEL MATERIAL (real) ─────────────────────
                                    div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex flex-col gap-4")
                                        div(class="flex flex-wrap items-start justify-between gap-4")
                                            div(class="flex items-start gap-4 min-w-0")
                                                div(class="w-24 h-24 rounded-2xl bg-slate-50 flex items-center justify-center flex-shrink-0 overflow-hidden")
                                                    img(src=material.imagenUrl || material.icono alt=material.nombre class="w-full h-full object-contain p-2")
                                                div(class="flex flex-col gap-2 min-w-0 pt-1")
                                                    div(class="flex items-center gap-3 flex-wrap")
                                                        h1(class="text-2xl font-bold text-slate-800 truncate")= material.nombre
                                                        if material.activo
                                                            span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-emerald-100 text-emerald-600")
                                                                span(class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2")
                                                                | Activo
                                                        else
                                                            span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-slate-100 text-slate-500")
                                                                span(class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2")
                                                                | Inactivo
                                                    span(class="inline-flex items-center gap-1.5 w-fit px-2.5 py-1 rounded-full text-xs font-bold bg-gh-primarySoft text-gh-primaryHover")
                                                        i(class=`fi ${material.tipo === 'materia_prima' ? 'fi-rr-scissors' : 'fi-rr-box'} text-[11px]`)
                                                        | #{material.tipoEtiqueta}
                                            div(class="flex items-center gap-2 flex-shrink-0")
                                                a(href="/admin/insumos" class="btn btn-secondary btn-sm text-xs whitespace-nowrap")
                                                    i(class="fi fi-rr-arrow-left text-xs")
                                                    | Volver al catálogo

                                                //- Editar y suspender/reactivar: datos básicos y sensibles (código DXF,
                                                //- disponibilidad). Exigen permiso de EDIT — quien solo tiene READ no ve
                                                //- estos botones, igual que el resto del panel (CLAUDE.md §13: esto es
                                                //- comodidad, la garantía real es el middleware de la ruta).
                                                if puede('Insumos', 'EDIT')
                                                    button#btn-editar-insumo(type="button" class="btn btn-secondary btn-sm text-xs whitespace-nowrap")
                                                        i(class="fi fi-rr-edit text-xs")
                                                        | Editar

                                                    div(class="relative")
                                                        button#btn-mas-insumo(type="button" class="btn btn-secondary btn-sm text-xs whitespace-nowrap flex items-center gap-1")
                                                            i(class="fi fi-rr-menu-dots text-xs")
                                                        div#menu-mas-insumo(role="menu" class="hidden absolute right-0 top-[calc(100%+6px)] w-56 bg-white rounded-xl shadow-lg border border-slate-100 py-1.5 z-20")
                                                            if material.activo
                                                                button#opcion-suspender-insumo(type="button" role="menuitem"
                                                                    class="w-full flex items-center gap-2.5 px-3.5 py-2.5 text-sm font-semibold text-rose-600 hover:bg-rose-50 text-left cursor-pointer")
                                                                    i(class="fi fi-rr-ban w-4 text-center")
                                                                    | Suspender insumo
                                                            else
                                                                button#opcion-reactivar-insumo(type="button" role="menuitem"
                                                                    class="w-full flex items-center gap-2.5 px-3.5 py-2.5 text-sm font-semibold text-emerald-600 hover:bg-emerald-50 text-left cursor-pointer")
                                                                    i(class="fi fi-rr-check-circle w-4 text-center")
                                                                    | Reactivar insumo

                                        //- Descripción y composición: relleno (MATERIAL no tiene estos campos todavía).
                                        p(class="text-sm text-slate-500 leading-relaxed")= datos.descripcion
                                        div(class="flex flex-wrap items-center gap-2")
                                            each c in datos.composicion
                                                span(class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-500") #{c}

                                    //- ── INDICADORES (relleno) ─────────────────────────────
                                    div(class="grid grid-cols-1 sm:grid-cols-3 gap-4")
                                        div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-3")
                                            div(class="flex items-center justify-between")
                                                p(class="text-xs text-slate-400") Existencia actual
                                                div(class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-box text-emerald-500 text-sm")
                                            p(class="text-2xl font-bold text-slate-800 tabular-nums")
                                                = `${datos.existencia.toLocaleString('es-CO')} `
                                                span(class="text-sm font-semibold text-slate-400")= datos.unidadCorta
                                            if datos.existencia > datos.stockMinimo
                                                span(class="status-chip status-active w-fit text-xs py-1")
                                                    span(class="status-dot")
                                                    | Disponible
                                            else
                                                span(class="status-chip status-low w-fit text-xs py-1")
                                                    span(class="status-dot")
                                                    | Bajo el mínimo

                                        div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-3")
                                            div(class="flex items-center justify-between")
                                                p(class="text-xs text-slate-400") Stock mínimo
                                                div(class="w-9 h-9 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-triangle-warning text-amber-500 text-sm")
                                            p(class="text-2xl font-bold text-slate-800 tabular-nums")
                                                = `${datos.stockMinimo.toLocaleString('es-CO')} `
                                                span(class="text-sm font-semibold text-slate-400")= datos.unidadCorta
                                            p(class="text-xs text-slate-400") Se recomienda pedir antes de llegar a este nivel.

                                        div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-3")
                                            div(class="flex items-center justify-between")
                                                p(class="text-xs text-slate-400") Costo promedio
                                                div(class="w-9 h-9 rounded-xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-dollar text-gh-primaryHover text-sm")
                                            p(class="text-2xl font-bold text-slate-800 tabular-nums")
                                                = `$${datos.costoPromedio.toLocaleString('es-CO')} `
                                                span(class="text-sm font-semibold text-slate-400")= `/ ${datos.unidadCorta}`
                                            p(class="text-xs text-slate-400")
                                                | Última compra: $#{datos.ultimaCompraCosto.toLocaleString('es-CO')} / #{datos.unidadCorta}

                                    //- ── PROCESOS INVOLUCRADOS (relleno) ───────────────────
                                    div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex flex-col gap-4")
                                        div(class="flex items-center justify-between gap-4")
                                            div(class="flex items-center gap-3")
                                                div(class="w-10 h-10 rounded-xl bg-violet-50 flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-workflow-setting text-violet-500")
                                                div
                                                    h3(class="text-base font-bold text-slate-800") Procesos involucrados
                                                    p(class="text-xs text-slate-400") Este insumo se usa en los siguientes procesos de producción.
                                            a(href="/admin/procesos" class="text-xs font-bold text-gh-primaryHover hover:underline whitespace-nowrap flex items-center gap-1")
                                                | Ver procesos
                                                i(class="fi fi-rr-angle-small-right text-[10px]")
                                        div(class="flex flex-wrap gap-2")
                                            each p in datos.procesos
                                                span(class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-violet-50 text-violet-600")
                                                    i(class=`fi ${p.icono} text-[11px]`)
                                                    | #{p.nombre}

                                    //- ── PROVEEDORES (relleno) ─────────────────────────────
                                    div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex flex-col gap-4")
                                        div(class="flex items-center justify-between gap-4")
                                            div(class="flex items-center gap-3")
                                                div(class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-truck-side text-blue-500")
                                                div
                                                    h3(class="text-base font-bold text-slate-800") Proveedores
                                                    p(class="text-xs text-slate-400") Proveedores con los que se ha comprado este insumo.
                                            a(href="/admin/provedores" class="text-xs font-bold text-gh-primaryHover hover:underline whitespace-nowrap flex items-center gap-1")
                                                | Ver todos
                                                i(class="fi fi-rr-angle-small-right text-[10px]")
                                        div(class="flex flex-col divide-y divide-slate-100")
                                            each p in datos.proveedores
                                                div(class="flex flex-wrap items-center justify-between gap-4 py-3")
                                                    div(class="flex items-center gap-3 min-w-0")
                                                        div(class="w-10 h-10 rounded-xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0 text-xs font-bold text-gh-primaryHover")= p.iniciales
                                                        div(class="min-w-0")
                                                            p(class="text-sm font-bold text-slate-800 truncate")= p.nombre
                                                            p(class="text-xs text-slate-400 truncate")= p.ciudad
                                                    div(class="text-xs text-slate-400 whitespace-nowrap")
                                                        | Última compra
                                                        p(class="text-slate-700 font-semibold")= p.ultimaCompra
                                                    div(class="text-xs text-slate-400 whitespace-nowrap")
                                                        | Precio promedio
                                                        p(class="text-slate-700 font-semibold")= `$${p.precioPromedio.toLocaleString('es-CO')} / ${datos.unidadCorta}`
                                                    div(class="text-xs text-slate-400 whitespace-nowrap")
                                                        | Calificación
                                                        p(class="text-slate-700 font-semibold flex items-center gap-1")
                                                            i(class="fi fi-rr-star text-amber-400 text-[11px]")
                                                            = p.calificacion
                                                    button(type="button" class="btn btn-secondary btn-sm text-xs whitespace-nowrap") Ver historial

                                    //- ── DATO ÚTIL (relleno) ───────────────────────────────
                                    div(class="bg-gh-primarySoft/60 border border-gh-primary/20 rounded-2xl p-5 flex items-center justify-between gap-4")
                                        div(class="flex items-center gap-3 min-w-0")
                                            div(class="w-10 h-10 rounded-xl bg-white flex items-center justify-center flex-shrink-0")
                                                i(class="fi fi-rr-bulb text-gh-primaryHover")
                                            div(class="min-w-0")
                                                p(class="text-sm font-bold text-slate-800") Dato útil
                                                p(class="text-xs text-slate-500")= datos.datoUtil
                                        button(type="button" class="btn btn-secondary btn-sm text-xs whitespace-nowrap flex-shrink-0") Ver notas

                                //- ══════════════════════════ COLUMNA DERECHA ═══════════════════════════
                                div(class="flex flex-col gap-4 min-w-0")

                                    //- ── CÓDIGO DXF (real) + ÚLTIMA ACTUALIZACIÓN (real) ────
                                    div(class="bg-white rounded-2xl shadow-sm border border-slate-100 flex divide-x divide-slate-100 overflow-hidden")
                                        div(class="flex-1 p-5 flex flex-col gap-2 min-w-0")
                                            div(class="flex items-center gap-2")
                                                div(class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-barcode text-slate-400 text-xs")
                                                p(class="text-xs text-slate-400") Código DXF
                                            p(class="text-lg font-bold text-slate-800 tabular-nums truncate")= material.codigoMaterial
                                            button#btn-copiar-codigo(type="button" data-codigo=material.codigoMaterial class="w-fit text-xs font-bold text-gh-primaryHover hover:underline flex items-center gap-1 cursor-pointer")
                                                i(class="fi fi-rr-copy text-[10px]")
                                                | Copiar
                                        div(class="flex-1 p-5 flex flex-col gap-2 min-w-0")
                                            div(class="flex items-center gap-2")
                                                div(class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-calendar-clock text-slate-400 text-xs")
                                                p(class="text-xs text-slate-400") Última actualización
                                            p(class="text-lg font-bold text-slate-800")= actualizado

                                    //- ── TIEMPO DE ENTREGA (relleno) ────────────────────────
                                    div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex items-center justify-between gap-3")
                                        div(class="flex items-center gap-3 min-w-0")
                                            div(class="w-11 h-11 rounded-xl bg-sky-50 flex items-center justify-center flex-shrink-0")
                                                i(class="fi fi-rr-clock text-sky-500")
                                            div(class="min-w-0")
                                                p(class="text-xs text-slate-400") Tiempo de entrega promedio
                                                p(class="text-lg font-bold text-slate-800")= `${datos.tiempoEntregaDias} días`
                                                p(class="text-xs text-slate-400") Según proveedores
                                        button(type="button" class="text-xs font-bold text-gh-primaryHover hover:underline whitespace-nowrap flex items-center gap-1 flex-shrink-0")
                                            i(class="fi fi-rr-edit text-[10px]")
                                            | Editar

                                    //- ── HISTORIAL DE COMPRAS (real) ─────────────────────────
                                    //- Solo órdenes que llegaron al menos a 'confirmada'
                                    //- (helpers/insumos.js, historialComprasInsumo) — una
                                    //- fila lleva a su orden de compra.
                                    div(class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                        div(class="flex items-center justify-between gap-3 px-5 py-4 border-b border-slate-100")
                                            div(class="flex items-center gap-2.5")
                                                div(class="w-9 h-9 rounded-xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-shopping-bag text-gh-primaryHover text-sm")
                                                h3(class="text-sm font-bold text-slate-800") Historial de compras
                                            a(href="/admin/insumos/compra" class="text-xs font-bold text-gh-primaryHover hover:underline whitespace-nowrap flex items-center gap-1")
                                                | Ver todas
                                                i(class="fi fi-rr-angle-small-right text-[10px]")
                                        div(class="divide-y divide-slate-50")
                                            if datos.historialCompras.length
                                                each h in datos.historialCompras
                                                    a(href=`/admin/insumos/compra/${h.idOrdenCompra}` class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-slate-50 transition-colors")
                                                        div(class="min-w-0")
                                                            div(class="flex items-center gap-2")
                                                                p(class="text-sm font-semibold text-slate-700 truncate")= h.proveedor
                                                                span(class=`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold whitespace-nowrap flex-shrink-0 ${h.estadoClase}`)= h.estadoEtiqueta
                                                            p(class="text-xs text-slate-400")= `${h.numeroOrden} · ${h.fecha} · ${h.cantidad.toLocaleString('es-CO')} ${datos.unidadCorta}`
                                                        div(class="text-right flex-shrink-0")
                                                            p(class="text-sm font-bold text-slate-800 tabular-nums")= `$${h.total.toLocaleString('es-CO')}`
                                                            p(class="text-xs text-slate-400 tabular-nums")= `$${h.precioUnit.toLocaleString('es-CO')} / ${datos.unidadCorta}`
                                            else
                                                p(class="px-5 py-6 text-center text-sm text-slate-400") Todavía no hay compras confirmadas de este insumo.

                                    //- ── RESUMEN DE COMPRAS (relleno, donut) ────────────────
                                    div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-4")
                                        div(class="flex items-center justify-between gap-3")
                                            div(class="flex items-center gap-2.5")
                                                div(class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0")
                                                    i(class="fi fi-rr-chart-pie-alt text-emerald-500 text-sm")
                                                h3(class="text-sm font-bold text-slate-800") Resumen de compras
                                            span(class="text-[11px] font-bold text-slate-400 bg-slate-50 px-2.5 py-1 rounded-full") Últimos movimientos

                                        div(
                                            id="resumen-compras-donut"
                                            class="relative flex items-center justify-center"
                                            style="height:160px"
                                            data-resumen=JSON.stringify(datos.resumenCompras)
                                        )
                                            canvas#grafico-resumen-compras
                                            div(class="absolute flex flex-col items-center pointer-events-none")
                                                span(class="text-[10px] font-bold text-slate-400 uppercase tracking-wider") Total comprado
                                                span(class="text-lg font-black text-slate-800")= `$${datos.totalComprado.toLocaleString('es-CO')}`

                                        ul(class="space-y-2")
                                            each p in datos.resumenCompras
                                                li(class="flex items-center justify-between text-xs")
                                                    span(class="flex items-center gap-2 min-w-0")
                                                        span(class="w-2.5 h-2.5 rounded-full flex-shrink-0" style=`background:${p.color}`)
                                                        span(class="text-slate-600 font-medium truncate")= p.nombre
                                                    span(class="font-bold text-slate-700 whitespace-nowrap")
                                                        = `${p.pct}% · $${p.total.toLocaleString('es-CO')}`

                                        div(class="flex items-start gap-2 pt-3 border-t border-slate-100")
                                            i(class="fi fi-rr-stats text-slate-300 mt-0.5")
                                            p(class="text-xs text-slate-500")
                                                | El proveedor con mejor precio promedio es #[strong.text-slate-700= datos.mejorProveedor.nombre]
                                                = ` ($${datos.mejorProveedor.precioPromedio.toLocaleString('es-CO')} / ${datos.unidadCorta})`

                            if puede('Insumos', 'EDIT')
                                //- ── MODAL "EDITAR INSUMO" ───────────────────────────────────
                                //- Mismos campos y mismo formulario que "Nuevo insumo" (admin/insumos),
                                //- precargados con los valores actuales — src/js/formularioInsumo.js
                                //- comparten la validación. A diferencia del alta, guardar acá exige el
                                //- código de un empleado con permiso de EDIT (lo arma
                                //- src/js/insumoPerfil.js al llamar a activarFormularioInsumo).
                                div#modal-editar-insumo(class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/40 backdrop-blur-md")
                                    div(class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden")

                                        //- Header
                                        div(class="flex items-center justify-between px-8 py-5 border-b border-gray-100 flex-shrink-0")
                                            div(class="flex items-center gap-4")
                                                div(class="w-10 h-10 rounded-2xl bg-gh-primary flex items-center justify-center shadow-lg shadow-gh-primary/30")
                                                    i(class="fi fi-rr-edit text-white")
                                                div
                                                    h2(class="text-lg font-bold text-slate-800") Editar insumo
                                                    p(class="text-sm text-slate-500") Los cambios quedan a nombre del empleado que autoriza.
                                            button#modal-editar-insumo-cerrar(type="button" class="w-9 h-9 flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer")
                                                i(class="fi fi-rr-cross-small text-xl")

                                        form(id="form-editar-insumo" novalidate class="flex-1 overflow-y-auto px-8 py-6 flex flex-col gap-5"
                                            data-csrf=csrfToken
                                            data-codigo-min=limites.codigoMin
                                            data-codigo-max=limites.codigoMax
                                            data-nombre-max=limites.nombreMax
                                            data-id-material=material.idMaterial)

                                            div(class="grid grid-cols-12 gap-4 items-start")
                                                div(class="col-span-4 flex flex-col gap-1")
                                                    label(class="label label-required" for="codigoMaterial") Código DXF
                                                    input#codigoMaterial.field-text(name="codigoMaterial" type="text" inputmode="numeric" autocomplete="off" value=material.codigoMaterial maxlength="10")
                                                    p#error-codigoMaterial(class="label-error text-xs hidden")

                                                div(class="col-span-8 flex flex-col gap-1")
                                                    label#label-nombre(class="label label-required" for="nombre") Nombre insumo / materia prima
                                                    input#nombre.field-text(name="nombre" type="text" autocomplete="off" value=material.nombre maxlength=limites.nombreMax)
                                                    p#error-nombre(class="label-error text-xs hidden")

                                            p(class="helper-text") Es el número de Material que trae el archivo de corte (1, 2, 3…).

                                            fieldset(class="flex flex-col gap-2")
                                                legend(class="label label-required") Tipo
                                                div(class="grid grid-cols-1 sm:grid-cols-2 gap-3")
                                                    each t in tiposInsumo
                                                        label(class="cursor-pointer")
                                                            input(type="radio" name="tipo" value=t.valor checked=(t.valor === material.tipo) data-etiqueta=t.etiqueta data-etiqueta-nombre=t.etiquetaNombre class="peer sr-only")
                                                            div(class="flex items-center gap-3 h-full rounded-xl border-2 border-slate-200 bg-white p-3 transition peer-checked:border-gh-primary peer-checked:bg-gh-primarySoft peer-focus-visible:ring-2 peer-focus-visible:ring-gh-primary")
                                                                img(src=t.icono alt=t.etiqueta class="w-11 h-11 rounded-lg bg-slate-100 p-1.5 object-contain flex-shrink-0")
                                                                div(class="min-w-0")
                                                                    p(class="text-sm font-semibold text-slate-800")= t.etiqueta
                                                                    p(class="text-xs text-slate-500 leading-snug")= t.detalle
                                                p#error-tipo(class="label-error text-xs hidden")

                                            div(class="flex flex-col gap-1")
                                                label(class="label" for="unidadCompra") Unidad de compra
                                                div(class="select-wrapper")
                                                    select#unidadCompra.field-text.appearance-none.pr-10(name="unidadCompra")
                                                        option(value="" selected=(!material.unidadCompra)) Sin unidad
                                                        each u in unidadesCompra
                                                            option(value=u.valor selected=(u.valor === material.unidadCompra))= u.etiqueta
                                                    span(class="select-icon")
                                                        i(class="fi-rr-chevron-double-down")
                                                p#error-unidadCompra(class="label-error text-xs hidden")

                                            div(class="flex flex-col gap-1")
                                                label(class="label") Foto (opcional)
                                                div(class="relative group")
                                                    input#imagen(type="file" name="imagen" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" accept=".jpg,.jpeg,.png,.webp")
                                                    div(class="inputUpload_mini")
                                                        img#preview-imagen(src=material.imagenUrl || undefined class=`w-20 h-20 object-contain mb-2 rounded-lg bg-white border border-slate-200 ${material.imagenUrl ? '' : 'hidden'}`)
                                                        div#icono-imagen(class=`w-14 h-14 bg-white shadow-sm rounded-full flex items-center justify-center mb-2 text-purple-500 ${material.imagenUrl ? 'hidden' : ''}`)
                                                            i.fi-rr-picture.text-2xl
                                                        span#nombre-archivo-imagen(class="text-sm font-bold text-gray-600")= material.imagenUrl ? 'Foto actual del material' : 'Sube o arrastra la foto del material'
                                                        span(class="text-xs text-gray-400 mt-1") JPG, PNG o WebP, hasta 2MB — deja esto vacío para conservar la foto actual
                                                p#error-imagen(class="label-error text-xs hidden")

                                            div(class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100")
                                                button(type="button" id="btn-limpiar-insumo" class="btn btn-secondary") Deshacer cambios
                                                button(type="submit" id="btn-guardar-insumo" class="btn btn-danger") Guardar cambios

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script(src="/js/insumoPerfil.js")
