extends ../../layout/index
block contenedor
    //- Biblioteca de fichas de confección (admin/procesos/fichas-confeccion/biblioteca).
    //- `fichas` sale de un solo findAll en produccionController.js (sin joins: referencia y
    //- materialNombre son fotos congeladas en la propia fila, CLAUDE.md §7). Sin paginación
    //- todavía — volumen de un solo negocio (CLAUDE.md §8); se agrega cuando haga falta.
    include ../../components/headerAdmin

    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            div(class="col-span-12 bg-white/70 backdrop-blur-md rounded-2xl p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4")
                                +headerAdmin({
                                    icono:     'fi-rr-books',
                                    titulo:    'Biblioteca de fichas de confección',
                                    subtitulo: 'Fichas ya creadas',
                                    iconoSub:  'fi-rr-document'
                                })
                                a(href="/admin/procesos/fichas-confeccion" class="btn btn-secondary btn-sm text-xs whitespace-nowrap flex-shrink-0")
                                    i(class="fi fi-rr-arrow-left text-xs")
                                    | Volver

                            if !fichas.length
                                div(class="col-span-12 bg-white rounded-2xl shadow-sm border border-slate-100 px-6 py-14 flex flex-col items-center text-center gap-2")
                                    i(class="fi fi-rr-document text-2xl text-slate-300")
                                    span(class="text-sm font-semibold text-slate-500") Todavía no hay fichas guardadas
                                    a(href="/admin/procesos/fichas-confeccion/nueva" class="btn btn-danger btn-sm mt-2") Nueva ficha de confección
                            else
                                div(class="col-span-12 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden")
                                    div(class="overflow-x-auto")
                                        table(class="w-full text-sm")
                                            thead
                                                tr(class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 bg-slate-50")
                                                    th(class="py-3 px-5 font-semibold") Referencia
                                                    th(class="py-3 px-5 font-semibold") Tela
                                                    th(class="py-3 px-5 font-semibold text-right") Cantidad
                                                    th(class="py-3 px-5 font-semibold text-right") Precio confección
                                                    th(class="py-3 px-5 font-semibold text-right") Creada
                                                    th(class="py-3 px-5 font-semibold text-right") PDF
                                            tbody
                                                each f in fichas
                                                    tr(class="border-b border-slate-100 last:border-0")
                                                        td(class="py-3.5 px-5 font-semibold text-slate-800") #{f.referencia}
                                                        td(class="py-3.5 px-5 text-slate-600") #{f.materialNombre}
                                                        td(class="py-3.5 px-5 text-right tabular-nums") #{f.cantidadTotal.toLocaleString('es-CO')}
                                                        td(class="py-3.5 px-5 text-right tabular-nums") $#{Math.round(f.precioConfeccion).toLocaleString('es-CO')}
                                                        td(class="py-3.5 px-5 text-right text-slate-500 text-xs") #{new Date(f.createdAt).toLocaleDateString('es-CO')}
                                                        td(class="py-3.5 px-5 text-right")
                                                            a(href=`/admin/procesos/fichas-confeccion/${f.idFicha}/pdf` target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-bold text-gh-primaryHover hover:underline")
                                                                i(class="fi fi-rr-document-signed text-xs")
                                                                | Ver PDF
