                                        p#modal-ampliar-titulo(class="text-sm font-bold text-white")
                                        button(type="button" data-cerrar-modal class="w-9 h-9 flex items-center justify-center text-white/80 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer" aria-label="Cerrar")
                                            i(class="fi fi-rr-cross-small text-xl")
                                    img#modal-ampliar-img(class="w-full max-h-[80vh] object-contain rounded-2xl bg-white" alt="")

                            //- Reproductor de un video del proceso (Cloudflare Stream en iframe).
                            div#modal-ver-video(class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="modal-video-titulo")
                                div(class="relative w-full max-w-3xl flex flex-col gap-3")
                                    div(class="flex items-center justify-between")
                                        p#modal-video-titulo(class="text-sm font-bold text-white truncate")
                                        button(type="button" data-cerrar-modal class="w-9 h-9 flex items-center justify-center text-white/80 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer" aria-label="Cerrar")
                                            i(class="fi fi-rr-cross-small text-xl")
                                    div(class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black")
                                        iframe#modal-video-iframe(class="absolute inset-0 w-full h-full" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="Video del proceso")

                            include ../../components/modalConfirmacion

