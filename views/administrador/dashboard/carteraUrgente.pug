div(class="tarjetaBase flex flex-col gap-4")
    //- Cabecera
    div
        div(class="flex items-center gap-2 mb-0.5")
            i(class="fi fi-rr-alarm-exclamation" style="color:#EC5FA3;font-size:1.4rem")
            h3(class="text-xl font-bold" style="color:#EC5FA3") Cartera mas urgente
        p(class="text-sm text-slate-400") La cartera sin cobrar con mas tiempo

    //- Tabla
    div(class="overflow-x-auto")
        table(class="w-full text-sm")
            thead
                tr(class="border-b-2" style="border-color:#EC5FA3")
                    th(class="text-left font-bold text-slate-700 pb-2 pr-4") Cliente
                    th(class="text-left font-bold text-slate-700 pb-2 pr-4") Monto
                    th(class="text-left font-bold text-slate-700 pb-2") Días en mora

            tbody#cartera-urgente-body
                tr
                    td(colspan="3" class="py-8 text-center text-slate-300 text-xs")
                        i(class="fi fi-rr-spinner animate-spin mr-2")
                        | Cargando...

    //- Footer
    p#cartera-urgente-footer(class="text-xs text-slate-400 mt-1") &nbsp;
