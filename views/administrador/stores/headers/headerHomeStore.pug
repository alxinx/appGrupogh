include ../../../components/headerAdmin

- var avatar = '/img/avatars/tiendaLila.webp'
if subPagina === "Nueva Tienda"
    - avatar = '/img/avatars/tiendaNueva.webp'
else if subPagina === "Editar Tienda"
    - avatar = '/img/avatars/editStore.webp'

+headerAdmin({
    avatar:    avatar,
    titulo:    subPagina,
    subtitulo: (subPagina === "Editar Tienda" && dato) ? dato.nombreComercial : null,
    iconoSub:  (subPagina === "Editar Tienda" && dato) ? 'fi-rr-shop' : null
})
