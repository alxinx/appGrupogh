extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")
                            //******************[CUERPO PANELES]*********************//

                            //HEADER
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-2  bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                include  ./headers/headerStore.pug
                                include  ./headers/actionBtns.pug

                            //- STATS — 8 tarjetas en 2 filas × 4 columnas, todas del día elegido
                            //- en el selector de arriba (adminStoreStats.js). Hoy se actualizan
                            //- en vivo; un día pasado queda fijo.
                            div(class="col-span-12 grid grid-cols-2 md:grid-cols-4 gap-4 border-b-1 pb-4 border-dotted border-b-gray-400")

                                //- Selector del día. Va a lo ancho de la grilla y sin tarjeta: es
                                //- el encabezado de la franja, no un dato más.
                                div(class="col-span-2 md:col-span-4 flex flex-wrap items-center justify-between gap-3 pb-1")
                                    div(class="min-w-0")
                                        h2(class="text-lg font-semibold text-slate-800 tracking-tight") Resumen del día
                                        div(class="flex items-center gap-2 mt-0.5")
                                            p(id="stats-dia-texto" class="text-sm text-slate-500 first-letter:uppercase") —
                                            //- Solo con hoy elegido: dice que las cifras se mueven solas.
                                            //- `hidden` va en este contenedor y no junto a `inline-flex`: en el CSS
                                            //- compilado inline-flex gana y el aviso no se ocultaba en un día pasado.
                                            span(id="stats-en-vivo" class="hidden")
                                                span(class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full")
                                                    span(class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse")
                                                    | En vivo

                                    div(class="flex items-center gap-2")
                                        div(class="flex items-center gap-0.5 bg-white border border-gh-grayBorder rounded-gh p-1 shadow-sm")
                                            button(type="button" id="stats-dia-anterior" aria-label="Día anterior" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:bg-gh-primarySoft hover:text-gh-primaryHover focus-visible:outline-2 focus-visible:outline-gh-primary transition-colors cursor-pointer")
                                                i(class="fi fi-rr-angle-small-left text-base leading-none")
                                            label(for="stats-fecha" class="sr-only") Día a consultar
                                            input(type="date" id="stats-fecha" class="h-8 px-2 text-sm font-semibold text-slate-700 bg-transparent rounded-lg tabular-nums focus:outline-none focus-visible:ring-2 focus-visible:ring-gh-primary/40 cursor-pointer" style="accent-color: var(--color-gh-primaryHover)")
                                            button(type="button" id="stats-dia-siguiente" aria-label="Día siguiente" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:bg-gh-primarySoft hover:text-gh-primaryHover focus-visible:outline-2 focus-visible:outline-gh-primary transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-slate-500")
                                                i(class="fi fi-rr-angle-small-right text-base leading-none")
                                        button(type="button" id="stats-hoy" class="btn btn-secondary disabled:opacity-40 disabled:cursor-not-allowed") Hoy

                                include ./stats/dailySales.pug
                                include ./stats/cashRegister.pug
                                include ./stats/debitAndCardRegister.pug
                                include ./stats/wallets.pug
                                include ./stats/creditEntity.pug
                                include ./stats/creditCard.pug
                                include ./stats/egresosTraslados.pug
                                include ./stats/efectivoDisponible.pug

                            div(class="col-span-12 grid grid-cols-12 items-start")
                                //COLUMNA 1
                                div(class="col-span-12 md:col-span-8 grid grid-cols-1 gap-4 cards cardsWhite p-6")
                                    include ./headers/navInsideStore.pug

                                    div(class="p-0")
                                        #loadDataStore

                                //COLUMNA 2
                                div(class="col-span-12 md:col-span-4 grid grid-cols-1 gap-4 cards cardsWhite p-6")
                                    include ./views/overdueBills.pug

        //- ID del punto de venta para el JS de stats
        input(type="hidden" id="pdv-current-id" value=dato.idPuntoDeVenta)

        //- Modal: transacciones del día por método de pago
        div#modalPagosMetodo(class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4")
            div(class="bg-white rounded-2xl shadow-2xl w-full max-w-lg flex flex-col overflow-hidden")
                div(class="flex items-center justify-between px-6 py-4 border-b border-gray-100")
                    h2#modalPagosTitulo(class="text-base font-bold text-slate-800") Movimientos del día
                    button.cerrar-modal-pagos(class="text-slate-400 hover:text-slate-600 transition-colors")
                        i.fi-rr-cross
                div#modalPagosBody(class="overflow-y-auto max-h-80 px-6 py-4")
                    p(class="text-sm text-slate-400 text-center py-6") Cargando...
                div(class="px-6 py-4 border-t border-gray-100 flex items-center justify-between")
                    span(class="text-xs text-slate-500")
                        | Total: 
                        strong#modalPagosTotal(class="text-slate-800") —
                    button.cerrar-modal-pagos(class="px-4 py-2 bg-gh-primary text-white rounded-xl text-sm font-semibold hover:bg-gh-primaryHover transition-colors") Cerrar

        script(src="/js/dropdownBtn.js")
        script(src="/js/helpers.js")
        script(src="/js/dataStore.js")
        script(src="/js/paginador.js")
        script(src="/js/storeInventory.js")
        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script(src="/js/adminStoreStats.js")
        script(src="/js/adminStoreBilling.js")
        script(src="/js/adminCierresCaja.js")
        script(src="/js/adminTrasladosTienda.js")
        script(src="/js/adminDocsTienda.js")

        //- Destrabar la caja del cuadre. Va inline y no en un bundle: son veinte líneas
        //- que solo existen si el botón está en la página, y ese botón casi nunca lo está.
        if cajaEnCuadre
            script.
                document.getElementById('btn-destrabar-cuadre')?.addEventListener('click', async (ev) => {
                    const btn  = ev.currentTarget;
                    const { tienda, caja } = btn.dataset;

                    const { isConfirmed } = await Swal.fire({
                        icon: 'warning',
                        title: 'Destrabar la caja',
                        html: `La caja <b>${caja}</b> quedó trabada en cuadre y esta tienda <b>no puede facturar</b>.` +
                              '<br><br>Al destrabarla vuelve a estado abierto y el punto de venta puede vender de nuevo. ' +
                              'No se cierra la caja ni se toca ninguna cifra.' +
                              '<br><br><b>Confirmá que nadie esté contando el cajón en este momento</b>: si alguien lo está haciendo, ' +
                              'las ventas que entren ahora no van a estar en lo que contó.',
                        showCancelButton: true,
                        confirmButtonText: 'Destrabar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#EC5FA3'
                    });
                    if (!isConfirmed) return;

                    btn.disabled = true;
                    try {
                        const r = await fetch(`/admin/tiendas/${tienda}/destrabar-cuadre`, {
                            method: 'POST',
                            //- El panel de admin no publica el token en un <meta>: se
                            //- pasa desde el render, como en el resto de sus vistas.
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '#{csrfToken}' }
                        });
                        const d = await r.json();
                        if (!d.success) {
                            btn.disabled = false;
                            return Swal.fire({ icon: 'error', title: 'No se pudo destrabar', text: d.mensaje, confirmButtonColor: '#EC5FA3' });
                        }
                        await Swal.fire({ icon: 'success', title: 'Caja liberada', text: d.mensaje, confirmButtonColor: '#EC5FA3' });
                        location.reload();
                    } catch (_) {
                        btn.disabled = false;
                        Swal.fire({ icon: 'error', title: 'Error de red', text: 'No se pudo conectar con el servidor.', confirmButtonColor: '#EC5FA3' });
                    }
                });
