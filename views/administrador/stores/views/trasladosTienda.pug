- const pdv = idPuntoDeVenta

//- Filtro de estado
div(class="flex flex-wrap items-end gap-3 mb-4 px-1")
    div(class="space-y-1")
        label(for="traslado-estado-filtro" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Estado
        select#traslado-estado-filtro(class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40")
            option(value="") Todos los estados
            option(value="PENDIENTE") Pendiente
            option(value="EN_TRANSITO") En tránsito
            option(value="RECIBIDO") Recibido
            option(value="ANULADO") Anulado
            option(value="EN_CONTROVERSIA") En controversia
            option(value="DEVUELTO") Devuelto

//- Tabla de traslados
div(class="overflow-x-auto")
    table(class="w-full text-left border-collapse text-sm")
        thead(class="bg-gh-primarySoft border-b border-gh-primaryHover")
            tr
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Código
                th(class="px-4 py-3 text-xs font-semibold text-gray-600") Origen
                th(class="px-4 py-3 text-xs font-semibold text-gray-600") Destino
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Fecha Envío
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Recepción
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-center") Estado
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-center") Items
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-center") Ver
        tbody#traslados-tbody
            tr
                td(colspan="8" class="px-4 py-8 text-center text-slate-400 text-sm")
                    i(class="fi fi-rr-spinner animate-spin mr-2")
                    | Cargando traslados...

div#traslados-paginacion(class="flex justify-center pt-3")

input(type="hidden" id="traslados-pdv-id" value=pdv)
