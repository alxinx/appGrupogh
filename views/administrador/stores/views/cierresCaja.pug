- const pdv = idPuntoDeVenta

//- Cabecera: fecha + date picker + botón PDF + empleados
div(class="mb-5 px-1")
    div(class="flex flex-wrap items-end justify-between gap-4 mb-5")
        div(class="flex flex-wrap items-end gap-4")
            //- Fecha prominente
            div(class="flex items-center gap-3")
                div(class="w-10 h-10 rounded-xl bg-gh-primarySoft flex items-center justify-center flex-shrink-0")
                    i(class="fi fi-rr-calendar text-gh-primary text-xl")
                div
                    p(class="text-xs font-bold text-slate-400 uppercase tracking-wider") Fecha del cierre
                    h3#cc-fecha-display(class="text-base font-bold text-slate-700") —

            //- Date picker
            div(class="space-y-1")
                label(for="cc-fecha-input" class="text-xs font-bold text-slate-400 uppercase tracking-wider block") Seleccionar fecha
                input#cc-fecha-input(
                    type="date"
                    class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                )

        //- Botón imprimir PDF
        a#cc-btn-pdf(
            href="#"
            target="_blank"
            class="hidden inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-white transition-all active:scale-95 select-none"
            style="background:#EC5FA3"
        )
            i(class="fi fi-rr-print")
            | Imprimir cierre PDF

    //- Aviso sin cierre para esa fecha
    div#cc-empty(class="hidden p-10 text-center")
        i(class="fi fi-rr-file-slash text-5xl text-slate-200")
        p(class="mt-3 text-slate-400") No hay cierre de caja registrado para esta fecha.

    //- Empleados apertura / cierre
    div#cc-empleados(class="flex flex-wrap gap-6")
        div(class="flex items-center gap-2")
            div(class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0")
                i(class="fi fi-rr-door-open text-emerald-600 text-sm")
            div
                p(class="text-[10px] text-slate-400 uppercase tracking-wider font-bold") Abrió la caja
                p#cc-empleado-apertura(class="text-sm font-semibold text-slate-700") —
        div(class="flex items-center gap-2")
            div(class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center flex-shrink-0")
                i(class="fi fi-rr-door-closed text-rose-500 text-sm")
            div
                p(class="text-[10px] text-slate-400 uppercase tracking-wider font-bold") Cerró la caja
                p#cc-empleado-cierre(class="text-sm font-semibold text-slate-700") —

//- Stats principales
div#cc-stats(class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4")
    div(class="tarjetaBase")
        p(class="text-xs font-bold text-gh-primaryHover uppercase tracking-wider mb-2") Ingresos del Día
        div(class="flex items-end justify-between")
            h3#cc-stat-ingresos(class="text-2xl font-bold text-slate-800 tabular-nums") —
            div(class="w-9 h-9 rounded-full bg-emerald-50 flex items-center justify-center")
                i(class="fi fi-rr-coins text-emerald-600 text-lg")
        p(class="text-[10px] text-slate-400 mt-2") Total facturado

    div(class="tarjetaBase")
        p(class="text-xs font-bold text-gh-primaryHover uppercase tracking-wider mb-2") Egresos del Día
        div(class="flex items-end justify-between")
            h3#cc-stat-egresos(class="text-2xl font-bold text-slate-800 tabular-nums") —
            div(class="w-9 h-9 rounded-full bg-red-50 flex items-center justify-center")
                i(class="fi fi-rr-arrow-trend-down text-red-500 text-lg")
        p(class="text-[10px] text-slate-400 mt-2") Total gastos

    div(class="tarjetaBase")
        p(class="text-xs font-bold text-gh-primaryHover uppercase tracking-wider mb-2") Ventas Efectivo
        div(class="flex items-end justify-between")
            h3#cc-stat-efectivo(class="text-2xl font-bold text-slate-800 tabular-nums") —
            div(class="w-9 h-9 rounded-full bg-amber-50 flex items-center justify-center")
                i(class="fi fi-rr-money-bill-wave text-amber-600 text-lg")
        p(class="text-[10px] text-slate-400 mt-2") Pagos en efectivo

    div(class="tarjetaBase")
        p(class="text-xs font-bold text-gh-primaryHover uppercase tracking-wider mb-2") Medios Electrónicos
        div(class="flex items-end justify-between")
            h3#cc-stat-electronicos(class="text-2xl font-bold text-slate-800 tabular-nums") —
            div(class="w-9 h-9 rounded-full bg-blue-50 flex items-center justify-center")
                i(class="fi fi-rr-credit-card text-blue-600 text-lg")
        p(class="text-[10px] text-slate-400 mt-2") Total electrónico

//- Desglose por entidad/método electrónico (inyectado dinámicamente)
div#cc-medios-container(class="mb-4")

//- Sub-pestañas: Ingresos / Egresos
div#cc-subtabs(class="border-b border-slate-200 mb-4")
    nav(class="flex")
        button#cc-subtab-ingresos(class="px-5 py-3 text-sm font-bold cursor-pointer tab-active")
            i(class="fi fi-rr-receipt mr-2")
            | Ingresos — Facturas
        button#cc-subtab-egresos(class="px-5 py-3 text-sm font-bold text-slate-400 cursor-pointer hover:text-gh-primary transition-colors")
            i(class="fi fi-rr-arrow-trend-up mr-2")
            | Egresos

//- Panel Ingresos
div#cc-panel-ingresos
    div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse text-sm")
            thead(class="bg-gh-primarySoft border-b border-gh-primaryHover")
                tr
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Nro Factura
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600") Cliente
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Hora
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-right") Valor
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600") Método de Pago
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-center") PDF
            tbody#cc-facturas-tbody
                tr
                    td(colspan="6" class="px-4 py-8 text-center text-slate-400 text-sm")
                        i(class="fi fi-rr-spinner animate-spin mr-2")
                        | Cargando...
    div#cc-facturas-paginacion(class="flex justify-center pt-3")

//- Panel Egresos (oculto por defecto)
div#cc-panel-egresos(class="hidden")
    div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse text-sm")
            thead(class="bg-gh-primarySoft border-b border-gh-primaryHover")
                tr
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Referencia
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600") Descripción
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600") Empleado
                    th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-right") Valor
            tbody#cc-egresos-tbody
                tr
                    td(colspan="4" class="px-4 py-8 text-center text-slate-400 text-sm")
                        i(class="fi fi-rr-spinner animate-spin mr-2")
                        | Cargando...

input(type="hidden" id="cc-pdv-id" value=pdv)
