- const pdv = idPuntoDeVenta

//- Filtro + botón exportar + botones cuadre
div(class="flex flex-wrap items-end gap-3 mb-4 px-1")
    div(class="space-y-1")
        label(for="billing-fecha" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Fecha
        input(
            type="date"
            id="billing-fecha"
            class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40"
        )
    button(
        id="billing-export"
        class="btn btn-secondary flex items-center gap-2 text-sm py-2"
    )
        i(class="fi fi-rr-file-spreadsheet text-emerald-600")
        | Exportar a Excel

    //- Botones "Ver cuadre" — se inyectan dinámicamente por adminStoreBilling.js
    div#billing-cuadre-btns(class="flex flex-wrap gap-2")

//- Tabla
div(class="overflow-x-auto")
    table(class="w-full text-left border-collapse text-sm")
        thead(class="bg-gh-primarySoft border-b border-gh-primaryHover")
            tr
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Nro Factura
                th(class="px-4 py-3 text-xs font-semibold text-gray-600") Cliente
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 whitespace-nowrap") Fecha y hora
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-right") Valor
                th(class="px-4 py-3 text-xs font-semibold text-gray-600 text-center") PDF
        tbody#billing-tbody
            tr
                td(colspan="5" class="px-4 py-8 text-center text-slate-400 text-sm")
                    i(class="fi fi-rr-spinner animate-spin mr-2")
                    | Cargando facturas...

//- Paginación
div#billing-paginacion

//- ID del PDV para el script
input(type="hidden" id="billing-pdv-id" value=pdv)
input(type="hidden" id="billing-csrf-token" value=csrfToken)

//- Modal: Autorizar Facturas Extemporáneas
div#modal-extemporanea(class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm")
    div(class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden")
        div(class="px-6 py-4 border-b border-slate-100 flex items-center justify-between")
            div(class="flex items-center gap-3")
                div(class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:#FFF0F7")
                    i(class="fi fi-rr-clock-five" style="color:#EC5FA3")
                h3(class="font-bold text-slate-800 text-base") Autorizar Facturas Extemporáneas
            button#btn-cerrar-modal-extemporanea(class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-colors")
                i(class="fi fi-rr-cross-small")
        div(class="px-6 py-5 space-y-4")
            div(class="space-y-1")
                label(for="ext-caja-select" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Caja
                select#ext-caja-select(class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40")
                    option(value="" disabled selected) Selecciona una caja...
            div(class="space-y-1")
                label(for="ext-cantidad" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Cantidad de facturas a autorizar
                input#ext-cantidad(
                    type="number" min="1" max="999"
                    placeholder="Ej: 5"
                    class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                )
            div(class="space-y-1")
                label(for="ext-codigo-empleado" class="text-xs font-bold text-slate-500 uppercase tracking-wider block") Código de empleado
                //- "off" lo ignora Chrome para el gestor de contraseñas; con este valor
                //- entiende que no hay credencial que guardar ni autocompletar.
                input#ext-codigo-empleado(
                    type="password" autocomplete="one-time-code"
                    placeholder="Código de acceso"
                    class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300/40"
                )
            p#ext-error-msg(class="hidden text-xs text-red-500")
        div(class="px-6 py-4 border-t border-slate-100 flex justify-end gap-3")
            button#btn-cancelar-extemporanea(class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors") Cancelar
            button#btn-confirmar-extemporanea(class="px-5 py-2 rounded-lg text-sm font-bold text-white transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed" style="background:#EC5FA3")
                | Autorizar
