div(class="tarjetaBase")
    p(class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-3")
        i.fi-rr-expense.text-2xl.mr-2
        | Métodos de pago

    div(class="mt-0.5 flex items-center justify-between text-xs font-medium text-emerald-700 bg-emerald-100 px-3 py-2 rounded-lg hover:bg-gh-primaryHover hover:text-white transition-colors")
        div(class="flex items-center gap-2")
            i.fi-rr-money-bill-wave
            | Efectivo
        span#pm-efectivo(data-val="0") $0

    div(class="mt-0.5 flex items-center justify-between text-xs font-medium text-blue-700 bg-blue-100 px-3 py-2 rounded-lg hover:bg-gh-primaryHover hover:text-white transition-colors")
        div(class="flex items-center gap-2")
            i.fi-rr-bank
            | Trans / Bill
        span#pm-transbill(data-val="0") $0

    div(class="mt-0.5 flex items-center justify-between text-xs font-medium text-purple-700 bg-purple-100 px-3 py-2 rounded-lg hover:bg-gh-primaryHover hover:text-white transition-colors")
        div(class="flex items-center gap-2")
            i.fi-rr-cvv-card
            | T-Crédito
        span#pm-tcredito(data-val="0") $0

    div(class="mt-0.5 flex items-center justify-between text-xs font-medium text-slate-100 bg-slate-800 px-3 py-2 rounded-lg hover:bg-gh-primaryHover transition-colors")
        div(class="flex items-center gap-2")
            i.fi-rr-handshake
            | Créditos
        span#pm-creditos(data-val="0") $0

    //- Crédito en Tienda: cupo propio del cliente (CREDITO_DISPONIBLE_CLIENTE), distinto de
    //- "Créditos" arriba (esa es Entidad Crediticia, un tercero que ya pagó). Acá no entró
    //- plata — es la tienda financiando al cliente, un derecho de cobro pendiente.
    div(class="mt-0.5 flex items-center justify-between text-xs font-medium text-pink-700 bg-pink-100 px-3 py-2 rounded-lg hover:bg-gh-primaryHover hover:text-white transition-colors")
        div(class="flex items-center gap-2")
            i.fi-rr-hand-holding-usd
            | Crédito Tienda
        span#pm-credito-tienda(data-val="0") $0
