div(class="border-slate-100 overflow-hidden")
    h2.h2.text-gh-primaryHover
        i.fi-rr-light-emergency-on.mr-2
        | Facturas Por Pagar

    p(class="text-xs text-slate-400 mb-3") Créditos pendientes de pago

    div(id="lista-facturas-pendientes" class="space-y-2 min-h-[80px]")

    div(class="flex items-center justify-between mt-4 pt-3 border-t border-gray-100")
        button(type="button" id="fpPrev" class="btn text-xs px-3 py-1" disabled)
            i.fi-rr-angle-left
        span(id="fpInfo" class="text-xs text-gray-400")
        button(type="button" id="fpNext" class="btn text-xs px-3 py-1" disabled)
            i.fi-rr-angle-right

//- MODAL DETALLE FACTURA PENDIENTE
div(id="modalFacturaPendiente" class="fixed inset-0 z-50 hidden items-start justify-center pt-10 px-4 bg-black/50")
    div(class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[85vh] overflow-y-auto")

        div(class="flex items-center justify-between px-6 py-4 border-b border-gray-100 sticky top-0 bg-white z-10")
            h3(id="modalFacturaTitulo" class="text-lg font-bold text-gray-800") Detalle Factura
            button(type="button" id="btnCerrarModalFactura" class="text-gray-400 hover:text-gray-600 text-2xl leading-none")
                i.fi-rr-cross-small

        div(class="p-6 space-y-5")

            //- Resumen
            div(id="modalFacturaResumen" class="grid grid-cols-2 gap-4 bg-gray-50 rounded-xl p-4")

            //- Historial abonos
            div
                h4(class="text-sm font-bold text-gray-700 mb-3 flex items-center gap-2")
                    i.fi-rr-receipt
                    | Historial de Abonos
                div(id="modalFacturaAbonos")

            //- Registrar abono
            div(class="pt-4 border-t border-gray-100")
                label.label Registrar Abono
                    div(class="flex gap-2 mt-1")
                        input(type="text" id="inputAbonoFactura" class="field-text flex-1" placeholder="0" inputmode="numeric")
                        button(type="button" id="btnRegistrarAbono" class="btn btn-primary whitespace-nowrap")
                            i.fi-rr-check
                            |  Abonar
