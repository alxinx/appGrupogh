extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")
                            //******************[CUERPO PANELES]*********************//
                            
                            //HEADER
                            //- `relative z-40`: este header lleva `backdrop-blur-md`, que crea contexto
                            //- de apilamiento, y ahí adentro queda encerrado el z-20 del menú "Más".
                            //- Las tarjetas de abajo —con su propio backdrop-filter— lo tapaban.
                            //- z-40 y no z-30 porque `z-30` no está en el CSS compilado.
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-2  bg-white/70 backdrop-blur-md rounded-2xl p-6 relative z-40")
                                include ./headers/headerSupplier.pug
                                include ./headers/actionBtns.pug
                            
                            //STATS
                            //div(class="col-span-12 grid grid-cols-1 md:grid-cols-4 gap-4 border-b-1 pb-4 border-dotted border-b-gray-400")
                            include ./forms/supplier.pug



 
                script(src="/js/dropdownBtn.js")
                script(src="/js/helpers.js")
                script(src="/js/dataSupplier.js")
