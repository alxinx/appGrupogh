extends ../../layout/index
include ../../components/documentoProveedor.pug
include ../../components/cuentasBancariasProveedor.pug
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")

                            //- ── HEADER ─────────────────────────────────────────────────────────────
                            //- `relative z-40`: este header lleva `backdrop-blur-md`, que crea contexto
                            //- de apilamiento, y ahí adentro queda encerrado el z-20 del menú "Más".
                            //- Las tarjetas de abajo —con su propio backdrop-filter— lo tapaban.
                            //- z-40 y no z-30 porque `z-30` no está en el CSS compilado.
                            //- Mismo mixin headerAdmin (avatar de 80px) y mismos botones .btn-secondary/
                            //- .btn-danger que el resto del panel (§4.1.1 de CLAUDE.md) — antes este
                            //- header tenía su propio marcado con avatar de 48px y título más chico.
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-2 bg-white/70 backdrop-blur-md rounded-2xl p-6 relative z-40")
                                include ./headers/headerVerSupplier.pug
                                div(class="flex items-center gap-3 justify-center md:justify-end flex-wrap")
                                    a(onclick='history.back()')
                                        button(class="btn btn-secondary flex items-center gap-2")
                                            i(class="fi fi-rr-arrow-left")
                                            | Volver
                                    a(href="/admin/provedores/new/")
                                        button(class="btn btn-danger flex items-center gap-2")
                                            i(class="fi fi-rr-user-add")
                                            | Nuevo proveedor

                            //- ── BODY ────────────────────────────────────────────────────────────────
                            div(class="col-span-12 grid grid-cols-12 gap-4 items-start")

                                //- ── COLUMNA IZQUIERDA: Formulario ───────────────────────────────────
                                div(class="col-span-12 md:col-span-8")
                                    form#form-proveedor(action=`/admin/provedores/editar/${proveedor.idProveedor}` method="post" class="cards cardsWhite p-6 grid grid-cols-12 gap-x-4 gap-y-3")
                                        input(type="hidden" name="_csrf" value=csrfToken)

                                        //- ── Datos básicos ───────────────────────────────────────────
                                        div(class="col-span-12 -mx-6 pb-3 border-b border-gray-100")
                                            div(class="flex items-center gap-2 px-6")
                                                i(class="fi fi-rr-id-card text-purple-400")
                                                h2(class="font-bold text-slate-700 text-sm") Datos básicos

                                        div(class="col-span-12 md:col-span-6")
                                            label.label Razón social *
                                                input.field-text(type="text" name="razonSocial" value=proveedor.razonSocial placeholder="Nombre del proveedor")

                                        +documentoProveedor({ tipos: tiposDocumento, tipo: proveedor.tipoDocumento, numero: proveedor.taxIdSupplier, nombre: 'taxIdSupplier', idProveedor: proveedor.idProveedor })

                                        //- ── Contacto ────────────────────────────────────────────────
                                        div(class="col-span-12 -mx-6 pb-3 border-b border-gray-100 mt-2")
                                            div(class="flex items-center gap-2 px-6")
                                                i(class="fi fi-rr-customer-service text-purple-400")
                                                h2(class="font-bold text-slate-700 text-sm") Contacto

                                        div(class="col-span-12 md:col-span-6")
                                            label.label Nombre del contacto
                                                input.field-text(type="text" name="nombreContacto" value=proveedor.nombreContacto placeholder="Juan Pérez")

                                        div(class="col-span-12 md:col-span-3")
                                            label.label Teléfono contacto
                                                input.field-text(type="tel" name="telefonoContacto" value=proveedor.telefonoContacto || '' placeholder="300 123 4567")

                                        div(class="col-span-12 md:col-span-3")
                                            label.label Teléfono empresa
                                                input.field-text(type="tel" name="telefonoProvedor" value=proveedor.telefonoProvedor || '' placeholder="(601) 123 4567")

                                        div(class="col-span-12 md:col-span-6")
                                            label.label Correo electrónico
                                                input.field-text(type="email" name="emailProvedor" value=proveedor.emailProvedor placeholder="ventas@proveedor.com")

                                        //- ── Ubicación ───────────────────────────────────────────────
                                        div(class="col-span-12 -mx-6 pb-3 border-b border-gray-100 mt-2")
                                            div(class="flex items-center gap-2 px-6")
                                                i(class="fi fi-rr-marker text-purple-400")
                                                h2(class="font-bold text-slate-700 text-sm") Ubicación

                                        div(class="col-span-12 md:col-span-4")
                                            label.label Departamento
                                                div(class="select-wrapper")
                                                    //- El valor es el código DANE, igual que en el alta. Se acepta también el
                                                    //- nombre para preseleccionar filas viejas que lo guardaron así.
                                                    select.field-text(name="departamento" id="departamentoSelect")
                                                        option(value="") Selecciona el departamento
                                                        each depto in departamentos
                                                            option(value=depto.id selected=(String(proveedor.departamento).trim() === String(depto.id) || String(proveedor.departamento).trim() === depto.nombre))= depto.nombre
                                                    span.select-icon
                                                        i.fi-rr-chevron-double-down

                                        div(class="col-span-12 md:col-span-4")
                                            label.label Ciudad
                                                div(class="select-wrapper")
                                                    select.field-text(name="ciudad" id="ciudadSelect" data-selected=String(proveedor.ciudad || '').trim() disabled)
                                                        option(value="") Cargando ciudades…
                                                    span.select-icon
                                                        i.fi-rr-chevron-double-down

                                        div(class="col-span-12 md:col-span-4")
                                            label.label Dirección
                                                input.field-text(type="text" name="direccionProvedor" value=proveedor.direccionProvedor placeholder="Calle 10 # 20 - 30")

                                        //- ── Categorías ──────────────────────────────────────────────
                                        div(class="col-span-12 -mx-6 pb-3 border-b border-gray-100 mt-2")
                                            div(class="flex items-center gap-2 px-6")
                                                i(class="fi fi-rr-tags text-purple-400")
                                                h2(class="font-bold text-slate-700 text-sm") Categorías que nos vende

                                        div(class="col-span-12")
                                            div(class="flex flex-wrap gap-2 mt-1")
                                                each cat in categoriasProvedores
                                                    label(class="subItems")
                                                        input(type="checkbox" name="categorias" value=cat.idCategoria
                                                            checked=categoriasActivas.includes(cat.idCategoria)
                                                            class="categoria-checkbox checkbox")
                                                        span(class="text-xs font-bold text-gray-700 uppercase")= cat.nombre

                                        //- ── Cuentas bancarias ───────────────────────────────────────
                                        div(class="col-span-12 -mx-6 pb-3 border-b border-gray-100 mt-2")
                                            div(class="flex items-center gap-2 px-6")
                                                i(class="fi fi-rr-bank text-purple-400")
                                                h2(class="font-bold text-slate-700 text-sm") Cuentas bancarias

                                        +cuentasBancariasProveedor({ cuentas: proveedor.cuentasBancarias, clase: 'col-span-12 flex flex-col', idProveedor: proveedor.idProveedor })

                                        //- ── Guardar ─────────────────────────────────────────────────
                                        div(class="col-span-12 flex justify-end pt-2 border-t border-gray-100 mt-2")
                                            button#btn-guardar(type="submit" class="btn btn-primary")
                                                i(class="fi fi-rr-disk")
                                                | Guardar cambios

                                //- ── COLUMNA DERECHA: Historial de compras ───────────────────────────
                                div(class="col-span-12 md:col-span-4 cards cardsWhite p-6 flex flex-col gap-5")

                                    //- Cabecera del panel
                                    div(class="flex items-center gap-2 -mx-6 px-6 pb-4 border-b border-gray-100")
                                        i(class="fi fi-rr-file-invoice-dollar text-purple-400")
                                        h2(class="font-bold text-slate-700 text-sm") Historial de compras

                                    //- Lista de facturas
                                    if facturas.length === 0
                                        div(class="flex flex-col items-center justify-center py-10 text-center")
                                            i(class="fi fi-rr-file-invoice text-4xl text-slate-200 mb-3")
                                            p(class="text-sm font-semibold text-slate-400") Sin compras registradas
                                            p(class="text-xs text-slate-300 mt-1") Las compras a este proveedor aparecerán aquí

                                    else
                                        ul(class="space-y-2")
                                            each f in facturas
                                                - const isVencida = f.vencState === 'vencida'
                                                - const isProxima = f.vencState === 'proxima'
                                                li(class=`rounded-xl p-3 border transition-colors ${isVencida ? 'bg-red-50 border-red-200' : isProxima ? 'bg-amber-50 border-amber-200' : 'bg-slate-50 border-transparent hover:border-slate-200'}`)
                                                    //- Fila 1: número + estado
                                                    div(class="flex items-center justify-between mb-1")
                                                        span(class="text-xs font-bold text-slate-700 font-mono")= f.nroFactura
                                                        - const estadoClasses = f.estado === 'Pagada' ? 'bg-green-100 text-green-700' : f.estado === 'Anulada' ? 'bg-gray-100 text-gray-500' : isVencida ? 'bg-red-500 text-white' : 'bg-amber-100 text-amber-700'
                                                        span(class=`text-[10px] font-bold px-2 py-0.5 rounded-full ${estadoClasses}`)= f.estado

                                                    //- Fila 2: fecha + tienda
                                                    div(class="flex items-center justify-between text-[10px] text-slate-400 mb-1")
                                                        span= f.fechaFactura
                                                        span(class="truncate max-w-[100px] text-right")= f.destino

                                                    //- Fila 3: montos
                                                    div(class="flex items-center justify-between text-xs mt-1")
                                                        span(class="text-slate-500") Total: #[strong(class="text-slate-700")= f.valorTotal]
                                                        if f.saldoPendiente
                                                            span(class=`font-bold ${isVencida ? 'text-red-600' : 'text-amber-600'}`) #{f.saldoPendiente}

                                                    //- Vencimiento
                                                    if f.fechaVencimiento && f.estado === 'Pendiente'
                                                        div(class=`text-[10px] font-semibold mt-1 flex items-center gap-1 ${isVencida ? 'text-red-600' : isProxima ? 'text-amber-600' : 'text-slate-400'}`)
                                                            i(class=`fi ${isVencida ? 'fi-rr-exclamation' : 'fi-rr-clock'}`)
                                                            | #{isVencida ? 'Venció:' : 'Vence:'} #{f.fechaVencimiento}
                                                            if f.nroAbonos > 0
                                                                span(class="ml-auto text-slate-400 font-normal") #{f.nroAbonos} abono#{f.nroAbonos !== 1 ? 's' : ''}

                                    //- ── Documentos ──────────────────────────────────────────────────────
                                    //- Cédula, RUT, certificaciones y fotos del taller. Cada enlace pasa por el backend
                                    //- (verDocumentoProveedor), que revisa el permiso y firma un enlace de cinco minutos:
                                    //- los documentos de identidad viven en el bucket privado y su ruta nunca llega acá.
                                    div(class="flex items-center justify-between gap-2 -mx-6 px-6 pt-4 pb-4 border-y border-gray-100")
                                        div(class="flex items-center gap-2")
                                            i(class="fi fi-rr-folder-open text-purple-400")
                                            h2(class="font-bold text-slate-700 text-sm") Documentos
                                        if documentos.length
                                            span(class="text-[11px] font-semibold text-slate-400 tabular-nums")= documentos.length
                                    if documentos.length === 0
                                        p(class="text-xs text-slate-400 text-center py-4") No tiene documentos cargados.
                                    else
                                        //- Una imagen abre la galería en el momento (#lightbox-documentos-proveedor,
                                        //- documentosProveedorGaleria.js); el resto (PDF, Office) sigue yendo
                                        //- directo a verDocumentoProveedor en pestaña nueva, que firma el enlace.
                                        div(class="flex flex-wrap gap-2.5")
                                            each doc in documentos
                                                - const fmt = String(doc.formato || '').toUpperCase()
                                                - const esImagen = ['WEBP','JPG','JPEG','PNG'].includes(fmt)
                                                - const href = `/admin/provedores/documentos/${doc.idDocumento}`
                                                if esImagen
                                                    button(type="button" data-doc-imagen
                                                        data-href=href
                                                        data-nombre=doc.nombreDocumento
                                                        data-fecha=doc.fecha
                                                        class="group relative w-[140px] h-[140px] flex-shrink-0 rounded-xl overflow-hidden bg-slate-100 border border-slate-100 hover:border-pink-300 transition-colors")
                                                        img(src=href alt=doc.nombreDocumento loading="lazy" class="w-full h-full object-cover")
                                                        div(class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center")
                                                            i(class="fi fi-rr-eye text-white text-lg opacity-0 group-hover:opacity-100 transition-opacity drop-shadow")
                                                        div(class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-2 pt-5 pb-1.5 text-left")
                                                            span(class="block text-[11px] font-semibold text-white truncate")= doc.nombreDocumento
                                                        if doc.privado
                                                            i(class="fi fi-rr-lock absolute top-1.5 right-1.5 text-[11px] text-white drop-shadow" title="Archivo privado: el enlace se firma al abrirlo y vence en minutos")
                                                else
                                                    - const icono = fmt === 'PDF' ? 'fi-rr-file-pdf text-red-500' : ['XLS','XLSX'].includes(fmt) ? 'fi-rr-file-excel text-[#217346]' : ['DOC','DOCX'].includes(fmt) ? 'fi-rr-file-word text-blue-600' : 'fi-rr-document text-slate-400'
                                                    a(href=href target="_blank" rel="noopener"
                                                      class="group relative w-[140px] h-[140px] flex-shrink-0 rounded-xl overflow-hidden bg-slate-50 hover:bg-pink-50 border border-slate-100 hover:border-pink-200 transition-colors flex flex-col items-center justify-center gap-1.5 px-2 text-center")
                                                        i(class=`fi ${icono} text-2xl flex-shrink-0`)
                                                        span(class="block text-[11px] font-semibold text-slate-700 truncate w-full group-hover:text-pink-700")= doc.nombreDocumento
                                                        span(class="block text-[10px] text-slate-400")= doc.fecha
                                                        if doc.privado
                                                            i(class="fi fi-rr-lock absolute top-1.5 right-1.5 text-[11px] text-slate-400" title="Archivo privado: el enlace se firma al abrirlo y vence en minutos")
                                                        i(class="fi fi-rr-arrow-up-right-from-square absolute top-1.5 left-1.5 text-[10px] text-slate-300 group-hover:text-pink-400")

                //- ── GALERÍA DE DOCUMENTOS (imágenes) ─────────────────────────────────
                //- Mismo lenguaje visual que #lightbox-comprobante en pedidoDetalle.pug.
                //- documentosProveedorGaleria.js arma la lista recorriendo [data-doc-imagen]
                //- en el orden en que ya están en el DOM — no hay un JSON aparte que mantener.
                div#lightbox-documentos-proveedor(class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 md:p-8")
                    div(class="absolute inset-0 bg-black/80 backdrop-blur-sm" data-cerrar-galeria-documentos)
                    button(type="button" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors" data-cerrar-galeria-documentos title="Cerrar")
                        i(class="fi fi-rr-cross-small text-xl")
                    button#galeria-documentos-prev(type="button" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors" title="Anterior")
                        i(class="fi fi-rr-angle-small-left text-xl")
                    button#galeria-documentos-next(type="button" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors" title="Siguiente")
                        i(class="fi fi-rr-angle-small-right text-xl")
                    div(class="relative max-w-3xl w-full")
                        img#galeria-documentos-img(src="" alt="" class="w-full max-h-[75vh] object-contain rounded-xl bg-white")
                        div(class="mt-3 flex items-center justify-center gap-3 text-white")
                            span#galeria-documentos-nombre(class="text-sm font-semibold")
                            span#galeria-documentos-contador(class="text-xs text-white/60")
                        div(class="mt-2 flex items-center justify-center")
                            a#galeria-documentos-abrir(href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-colors")
                                i(class="fi fi-rr-expand text-xs")
                                | Abrir en pestaña nueva

                script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
                //- Estilos del buscador de departamento/ciudad (window.enhanceSelectBuscable).
                include ../../components/selectBuscable.pug
                include ../../components/modalConfirmacion.pug
                script(src="/js/helpers.js")
                script(src="/js/documentoProveedor.js")
                script(src="/js/documentosProveedorGaleria.js")
                script(src="/js/ubicacionProveedor.js")
                script(src="/js/cuentasProveedor.js")
                script(src="/js/confirmarProveedor.js")
                script.
                    document.getElementById('form-proveedor').addEventListener('submit', async function(e) {
                        e.preventDefault();
                        if (!(await window.confirmarProveedor(this, { modo: 'edicion' }))) return;
                        const btn = document.getElementById('btn-guardar');
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fi fi-rr-spinner animate-spin"></i> Guardando...';
                        try {
                            const fd = new FormData(this);
                            const body = {};
                            fd.forEach((v, k) => {
                                if (k === 'categorias') {
                                    if (!body.categorias) body.categorias = [];
                                    body.categorias.push(v);
                                } else {
                                    body[k] = v;
                                }
                            });
                            const resp = await fetch(this.action, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(body)
                            });
                            const data = await resp.json();
                            if (data.success) {
                                // Lo guardado pasa a ser el punto de comparación de la próxima confirmación.
                                const cuentas = this.querySelector('[data-cuentas-json]');
                                if (cuentas) cuentas.defaultValue = cuentas.value;
                                Swal.fire({ icon: 'success', title: data.mensaje, timer: 2000, showConfirmButton: false });
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: data.mensaje });
                            }
                        } catch {
                            Swal.fire({ icon: 'error', title: 'Error de red', text: 'No se pudo guardar.' });
                        } finally {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fi fi-rr-disk"></i> Guardar cambios';
                        }
                    });
