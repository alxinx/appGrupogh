extends ../../layout/index
block contenedor
    body(class="bg-gray-100 min-h-screen")
        main(class="flex-1 overflow-y-auto")
            div(class="flex min-h-screen")
                include ../../partials/leftMenu

                div(class="flex-1 flex flex-col")
                    include ../../partials/header
                    main(class="flex-1 overflow-y-auto md:p-4")
                        div(class="mainDashboard")
                            //******************[CUERPO PANELES]*********************//
                            
                            //HEADER
                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-2  bg-white/70 backdrop-blur-md rounded-2xl p-6")
                                include  ./headers/headerDose.pug
                                include  ./headers/actionBtns.pug

                            
                            //STATS

                            div(class="col-span-12 grid grid-cols-1 md:grid-cols-5 gap-4 border-b-1 pb-4 border-dotted border-b-gray-400")
                                //- Card 1
                                
                                include ./stats/dataCreateDose.pug
                                include ./stats/allPackages.pug
                                include ./stats/unitsPerPackage.pug
                                include ./stats/unitsPackagSurpluse.pug
                                include ./stats/allProducts.pug
                                

                            //Listado
                            div(class="col-span-12 grid grid-cols-12 items-start")    
                                //Columna 1
                                include ./views/columBatchByDose.pug 


                                    
                                    
                                    
                                    

    

                                //Columna 2
                                div(class="col-span-12 mt-8")
                                    include ./views/listaPacksDose.pug




                include ./views/modalTraslado.pug

                //- MODAL HISTORIAL DE PACK
                div#modalHistorialPack(class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4")
                    div(class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col")
                        //- Header
                        div(class="flex items-center justify-between p-6 border-b border-slate-100 flex-shrink-0")
                            div(class="flex items-center gap-3")
                                div(class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center text-purple-600")
                                    i(class="fi fi-rr-time-past")
                                div
                                    h3(class="text-lg font-bold text-slate-800") Historial del Paquete
                                    p#historial-codigo(class="text-xs font-mono text-gh-primaryHover font-bold") —
                            button#cerrarModalHistorial(type="button" class="text-slate-400 hover:text-red-500 cursor-pointer transition-colors")
                                i(class="fi fi-rr-cross-circle text-2xl")

                        //- Body (scrollable)
                        div#historial-body(class="overflow-y-auto p-6 flex-1 space-y-4")
                            //- Se rellena desde JS

                script(src="/js/paginador.js")
                script(src="/js/doseView.js")
                script(src="/js/dropdownBtn.js")
