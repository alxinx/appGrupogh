# Este archivo documenta variables de entorno nuevas a medida que se agregan — no es un
# volcado completo de .env (que tiene muchas más, de antes de este archivo). Cada bloque
# nuevo de .env debería sumar su propia sección acá.

##############################IA — GENERACIÓN DE IMAGEN DEL MOLDE (admin/procesos/fichas-confeccion)##############
# controller/fichaConfeccionMoldeController.js, helpers/moldeIa.js, config/openai.js.
# Sin OPENAI_API_KEY, la generación corre en modo simulado (nunca llama a la API real) —
# pedir la clave real al equipo antes de activar la generación de verdad en un ambiente.
OPENAI_API_KEY=
MODEL_IA_IMAGE_OPENAI=gpt-image-1
SIZE_IA_IMAGE_OPENAI=1024x1024
QUALITY_IA_IMAGE_OPENAI=medium
NUMBER_IA_IMAGE_OPENAI=1
##############################CLOUDFLARE STREAM (video del proceso, admin/procesos/fichas-confeccion)##############
# config/cloudflareStream.js, helpers/cloudflareStream.js. Sin CLOUDFLARE_STREAM_API_TOKEN,
# la subida de video corre en modo simulado. CLOUDFLARE_ACCOUNT_ID es opcional — por
# defecto toma R2_ACCOUNT_ID (misma cuenta de Cloudflare). CLOUDFLARE_STREAMING_SUBDOMAIN
# es el que Cloudflare asigna al activar Stream (customer-XXXX.cloudflarestream.com) — sin
# él no se arma el QR "ver video" de la ficha de confección (helpers/fichaConfeccionPdf.js).
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAMING_SUBDOMAIN=